        "liquid_zawwk": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "{% if product.type == 'Mirror' %}\n<p>You want your home to <b>stand out</b> from the rest, don't you?\n</p>\n<p>\nA <b>William Wood Mirror</b> isn't just a purchase; it's the statement piece that makes your home <b>unforgettable</b>. <br> Why settle for<b> ordinary</b>?\n</p>\n\n<p>Your <b>best reflection</b> starts with<b> William Wood.</b></p>\n{% elsif product.title contains \"Coffee Table\" %}\n<p>\nYou want your home to <b>stand out</b> from the rest, don't you?\n</p>\n<p>A <b>William Wood Table</b> isn’t just furniture – it’s the <b>defining piece</b> that brings your home to life, blending <b>elegance</b> and <b>purpose</b> seamlessly. <br>Why settle for<b> ordinary</b>?</p>\n{% else %}\n<img src=\"https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/WW_24_InYourHome_v1.0_1.jpg?v=1728309397\" alt=\"Feel More Proud of Your Home with William Wood\">\n{% endif %}<br>"
          }
        },
        "liquid_dRJt6": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n{% assign in_best_sellers = false %}\n{% for collection in product.collections %}\n    {% if collection.handle == 'best-sellers' %}\n{% unless product.tags contains \"pre-order\" %}\n        {% assign in_best_sellers = true %}\n{% endunless %}\n    {% endif %}\n{% endfor %}\n    <style>\n        @media (max-width: 768px) {\n            .FGbutton--primary {\n                background-color: black;\n                color: white;\n                text-align: center;\n                text-decoration: none;\n                padding: 5px 20px;\n                font-size: 12px;\n                border-radius: 15px;\n                transform: translateY(38%);\n            }\n\n            .Gcontainer {\n\n            }\n.Gcontainer {\n}\n            .Gcontainer p {\n                transform: translateY(-7px);\n            }\n\n            .Gcontainer .delmins {\n                transform: translateY(-5px);\n            }\n\n            .text-button-container {\n                transform: translateY(-5px);\n            }\n        }\n\n        @media (min-width: 1024px) { \n            .Gcontainer p + b {\n                display: block;\n                margin-left: -20px;\n            }\n        }\n        .Gcontainer {\n            display: flex;\n            flex-direction: column;\n            align-items: flex-start;\n            background-color: #efefef !important;\n            padding: 20px;\n        }\n        .Gcontainer img {\n            width: 30px;\n            margin-bottom: 5px; \n        }\n        .Gcontainer p {\n            margin: 0;\n            font-size: 16px;\n        }\n        .Gcontainer .delmins {\n            font-size: 20px;\n            margin-top: 5px;\n        }\n        .text-button-container {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            width: 100%;\n        }\n\n        @media (min-width: 1024px) {\n        .FGbutton--primary {\n            background-color: black;\n            color: white;\n            text-align: center;\n            text-decoration: none;\n            padding: 5px 20px;\n            font-size: 10px;\n            border-radius: 15px;\n            transform: translateY(45%);\n        }\n            .Acontainer {\n                width: 100%;\n                height: 40%;\n                transform: translate(0%, 0%);\n            }\n        }\n    </style>\n</head>\n{% if in_best_sellers %}\n<body>\n    <div class=\"Gcontainer\">\n        <style>\n            @media only screen and (min-width: 1024px) {\n                .bigger-text {\n                    font-size: 20px;\n                }\n            }\n        </style>\n        <div class=\"text-button-container\">\n            <b class=\"bigger-text\">25% Off</b>\n<style>\n\n  .desktop-only {\n    display: none;\n  }\n  @media (min-width: 768px) {\n    .desktop-only {\n      display: inline-block;\n\n    }\n  }\n</style>\n        </span>\n<span class=\"desktop-only\" style=\"\n                text-align: center;\n                text-decoration: none;\n                padding: 5px 20px;\n                font-size: 18px;\n                border-radius: 15px;\n                transform: translateY(38%);\">Code: <b>BEST</b></span>\n        </div>\n        <span class=\"delmins\" style=\"font-size: 13px;\">\n            When you purchase <b>2</b> or more <b>Best Sellers</b>\n        </span>\n        <span class=\"delmins\" style=\"font-size: 10px;\">\n            (This Product Qualifies)\n        </span>\n<span></span>\n        <span class=\"delmins mobile-only\" style=\"font-size: 13px; transform: translateY(5px);\">\n            Code: <b>BEST</b>\n        </span>\n\n<style>\n\n  .mobile-only {\n    display: none;\n  }\n  @media (max-width: 768px) {\n    .mobile-only {\n      display: inline-block;\n    }\n  }\n.desktop-only {\nfont-size: 15px;\n}\n</style>\n    </div>\n</body>\n\n{% endif %}\n<style>\n\n  .mobile-only {\n    display: none;\n  }\n  @media (max-width: 768px) {\n    .mobile-only {\n      display: inline-block;\n    }\n  }\n.desktop-only {\nfont-size: 15px;\n}\n</style>\n    </div>\n</body>\n</html><br>"
          }
