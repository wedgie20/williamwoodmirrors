n-right: 10px;\n        }\n\n        .icon--pulsing:after,\n        .icon--pulsing:before {\n            background: #54c63a;\n            width: 10px;\n            height: 10px;\n            border-radius: 10px;\n            position: absolute;\n            left: 0;\n            top: 0;\n            content: \"\";\n            margin: 5px;\n        }\n\n        @keyframes inventory-pulse{\n          0%{\n            opacity:0.5;\n          }\n          to{\n            transform:scale(2.5);\n            opacity:0;\n          }\n        }\n    {% endif %}\n    {% if product.variants[0].inventory_quantity >= 11 %}\n\n        .icon--pulsing:before {\n            animation: inventory-pulse 2.5s linear infinite;\n        }\n\n        {% elsif product.variants[0].inventory_quantity < 11 and product.variants[0].inventory_quantity > 1 %}\n\n        .icon--pulsing:before {\n            animation: inventory-pulse 1.5s linear infinite;\n        }\n{% else %}\n\n.icon--pulsing:before {\n            animation: inventory-pulse 1s linear infinite;\n        }\n    {% endif %}\n  </style>\n{% endif %}\n{% if product.available %}\n{% unless product.tags contains 'pre-order' %}\n<span style=\"font-size: 11px; color: gray;\">Shipping times for your address calculated at checkout</span>\n{% endunless %}\n{% endif %}\n</div>"
