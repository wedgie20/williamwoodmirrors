          "settings": {
            "liquid": "<div style=\"margin-top: 15px;\">{% if product.variants[0].inventory_quantity > 0 %}\n  {% for tag in product.tags %}\n    {% if tag == 'pre-order' and product.variants[0].inventory_quantity < 16 %}\n      <div class=\"instock-pulse\">\n        <span class=\"icon--pulsing\"></span>\n        <span>Available for pre order, only {{ product.variants[0].inventory_quantity }} left </span>\n      </div>\n    {% elsif tag == 'pre-order' %}\n      <div class=\"instock-pulse\">\n        <span class=\"icon--pulsing\"></span>\n        <span>Available for pre order</span>\n      </div>\n    {% endif %}\n  {% endfor %}\n\n  {% unless product.tags contains 'pre-order' %}\n    {% if product.available and product.variants[0].inventory_quantity < 16 %}\n{% unless product.tags contains 'PF' %}\n      <div class=\"instock-pulse\">\n        <span class=\"icon--pulsing\"></span>\n        <span><b>In stock</b> and ready to ship, <b>only {{ product.variants[0].inventory_quantity }} left </b></span>\n      </div>\n{% else %}\n<div class=\"instock-pulse\">\n        <span class=\"icon--pulsing\"></span>\n        <span>In stock and ready to ship, <b>only {{ product.variants[0].inventory_quantity }} left </b></span>\n      </div>\n{% endunless %}\n    {% else %}\n{% unless product.tags contains 'PF' %}\n      <div class=\"instock-pulse\">\n        <span class=\"icon--pulsing\"></span>\n        <span><b>In stock</b> and ready to ship</span>\n{% else %}\n      <div class=\"instock-pulse\">\n        <span class=\"icon--pulsing\"></span>\n        <span><b>In stock</b> and ready to ship</span>\n{% endunless %}\n      </div>\n    {% endif %}\n  {% endunless %}\n\n  <style>\n    {% if product.available %}\n\n        .instock-pulse {\n          display: flex;\n          flex-wrap: nowrap;\n          align-items: center;          margin: 15px 0 0;\n        }\n\n        .icon--pulsing {\n          position: relative;\n          width: 20px;\n          height: 20px;\n          margin-right: 10px;\n        }\n\n        .icon--pulsing:after,\n        .icon--pulsing:before {\n            background: #54c63a;\n            width: 10px;\n            height: 10px;\n            border-radius: 10px;\n            position: absolute;\n            left: 0;\n            top: 0;\n            content: \"\";\n            margin: 5px;\n        }\n\n        @keyframes inventory-pulse{\n          0%{\n            opacity:0.5;\n          }\n          to{\n            transform:scale(2.5);\n            opacity:0;\n          }\n        }\n    {% endif %}\n    {% if product.variants[0].inventory_quantity >= 11 %}\n\n        .icon--pulsing:before {\n            animation: inventory-pulse 2.5s linear infinite;\n        }\n\n        {% elsif product.variants[0].inventory_quantity < 11 and product.variants[0].inventory_quantity > 1 %}\n\n        .icon--pulsing:before {\n            animation: inventory-pulse 1.5s linear infinite;\n        }\n{% else %}\n\n.icon--pulsing:before {\n            animation: inventory-pulse 1s linear infinite;\n        }\n    {% endif %}\n  </style>\n{% endif %}\n{% if product.available %}\n{% unless product.tags contains 'pre-order' %}\n<span style=\"font-size: 11px; color: gray;\">Shipping times for your address calculated at checkout</span>\n{% endunless %}\n{% endif %}\n</div>"
          }
        },
