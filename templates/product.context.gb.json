      "blocks": {
        "item_FM4iz": {
          "type": "item",
          "disabled": true,
          "settings": {
            "question": "Question",
            "answer": "<p>Answer</p>"
          }
        },
        "tab_TJMrn": {
          "type": "tab",
          "disabled": false,
          "settings": {
            "tab_title": "Returns & Refunds"
          }
        },
        "item_T9Xpa": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I return my order easily?",
            "answer": "<p><strong>Yes</strong>, returns are easy and risk-free. If an item doesn't fit your space or meet your standards, just let us know within 90 days of receiving your order. Your return will be completely free. We’ll arrange a pickup time that works for you and collect it from your delivery address. You won’t need to return anything yourself. </p><p>Once we receive it back at our warehouse, we’ll refund 100% of your money in 1-3 Business Days. Every order is backed by our 100% Money Back Guarantee.</p>"
          }
        },
        "item_wNVRx": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Are returns free?",
            "answer": "<p><strong>Yes</strong>, returns are 100% free. Just let us know within 90 days of receiving your order. We’ll arrange a pickup time that works for you and collect it from your delivery<br/>address. You don’t need to return anything yourself. </p>"
          }
        },
        "item_gbn7U": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "How quickly will I get my refund?",
            "answer": "<p>Once collected, your item(s) will be quickly returned to our warehouse. Once we receive them, we’ll refund 100% of your money within <strong>1-3 Business Days</strong>.<br/><br/><br/><br/></p>"
          }
        },
        "tab_PExMq": {
          "type": "tab",
          "disabled": false,
          "settings": {
            "tab_title": "Delivery"
          }
        },
        "item_3kXJF": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "When will my order be delivered?",
            "answer": "<p><strong>In stock items</strong>: Your order usually ships from our warehouse in 1-3 Business Days. Once it’s dispatched,<br/>we’ll contact you straight away to arrange a delivery date and time.</p><p><strong>Pre order items: </strong>Your pre order will be dispatched on the week displayed underneath the ‘ADD TO BAG’ button. Once it’s dispatched, we’ll contact you to arrange a delivery date and time.<br/><br/><br/><br/></p>"
          }
        },
        "item_X9BQn": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Is delivery free?",
            "answer": "<p><strong>Yes</strong>, delivery to Mainland UK and Northern Ireland is free.</p>"
          }
        },
        "item_JyVEj": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "What if my order arrives damaged?",
            "answer": "<p>In the rare case your order arrives damaged, we’ll fix it quickly. We’ll arrange a replacement and collect the damaged item(s) when we deliver the new item(s). </p>"
          }
        },
        "item_YVFfj": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "What happens if I’m not home for my delivery?",
            "answer": "<p>If you're not home for delivery, you can tell your William Wood Delivery driver where to leave your order. You can do this using the contact number we provide. If there's no safe spot, we'll reschedule your delivery and contact you with a new time. We'll reach out within 24-48 hours to inform you about your first delivery attempt and any redelivery needed.</p>"
          }
        },
        "item_GjYfj": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Is delivery safe?",
            "answer": "<p><strong>Yes</strong>, all orders are delivered by William Wood. This means your order is handled safely by an experienced driver. Each product is securely packaged to reduce the chance of damage during transit. All deliveries are 100% insured in case of rare damage.</p>"
          }
        },
        "item_eHy6F": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I order now and choose a later delivery date?",
            "answer": "<p><strong>Yes</strong>, if you order an in-stock product, you can hold it in our warehouse for up to 90 days from your order date. </p><p>To do this, select the ‘Hold my order in stock for<br/>up to 90 days’ option on the ‘Details’ page at checkout (the first page). </p><p>After that, choose your desired date. If you go straight to the Shop Pay checkout page, this option won’t show up. Just scroll to the bottom and select ‘Checkout as guest.’ Then, the option will appear.<br/></p>"
          }
        },
        "item_pwMfV": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I check my order when the driver delivers it?",
            "answer": "<p><strong>Yes</strong>, our driver will happily unbox and check your item(s)<br/>and dispose of the packaging upon your request. In the unlikely case your item(s) are damaged or faulty, our driver will take them back to William Wood HQ. Our Customer Support Team will then reach out to arrange a replacement or refund based on your preference.</p>"
          }
        },
        "item_BDkpY": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Will you deliver to my room of choice?",
            "answer": "<p>In most cases, your William Wood Dedicated Delivery driver will carry your item(s) into the room of your choice. On the day, your driver will quickly check the access (stairs, doorways, tight turns) and decide what’s safe and possible. <br/><br/>To be clear, in the vast majority of deliveries, we are able to deliver to your room of choice.</p>"
          }
        },
        "item_kic3j": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I track my order?",
            "answer": "<p>We don’t have order tracking yet. However, you will get the contact number for your William Wood Dedicated Delivery driver if you need to reach them. Our logistics team also provide regular updates by phone and text, so you stay informed.</p>"
          }
        },
        "item_NgeCY": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I choose a delivery date / time slot?",
            "answer": "<p>We don’t offer date or time slot selection at checkout. However, you’ll receive a delivery time window 24–48 hours in advance. We’ll also provide our driver’s direct contact number so you can coordinate with them at any point if needed.<br/><br/>Rest assured knowing that we make it our main priority to keep you fully informed.</p>"
          }
        },
        "tab_KN96z": {
          "type": "tab",
          "disabled": false,
          "settings": {
            "tab_title": "Our Products"
          }
        },
        "item_7D6Bq": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Is the quality worth the price?",
            "answer": "<p><strong>Yes</strong>, through our unwavering commitment to quality and design, our products are worth the price. </p><p>We use hand-picked premium materials from trusted suppliers. We also conduct strict quality checks before any product is sold online. Each piece is designed to stand the test of time. </p><p>If it doesn't fit your home or meet your standards, you can return it for free within 90 days of receiving your order. We'll even pick it up from your delivery address at no cost, no need for you to return anything yourself.</p>"
          }
        },
        "item_ggXQY": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "What are your products made from?",
            "answer": "<p>We use a variety of different premium materials to produce different products within our range. Each product that we sell is produced by trusted and vetted suppliers<br/>and goes through a strict quality check before it can be sold online. To find out what specific products are made from, head to the product information section on the product page.</p>"
          }
        },
        "item_i9KVq": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Do your products look the same in real life as they do online?",
            "answer": "<p>Yes, 99% of the time, our products look the same in real life as they do online. We use industry leading production to create high-standard images that show each piece as it truly is. Just keep in mind that colors may vary slightly based on your device screen and brightness settings.</p>"
          }
        },
        "item_UMBGD": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Are the product dimensions accurate?",
            "answer": "<p><strong>Yes</strong>, our product dimensions are accurate. We measure each product with precision and list the dimensions on the product page.</p>"
          }
        },
        "tab_6MpTY": {
          "type": "tab",
          "disabled": false,
          "settings": {
            "tab_title": "Ordering"
          }
        },
        "item_9jwbM": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Are your products in stock / Pre Order information?",
            "answer": "<p>To check if a product is in stock or on Pre Order, go to the ‘ADD TO BAG’ button on the product page. You will see either <strong>‘In stock and ready to ship’ </strong>or <strong>‘Available for pre order'</strong>. </p><p>In stock items usually ship in 1-3 Business Days.<br/></p><p>Pre Order items ship on the week displayed below the ‘ADD TO BAG’ button.<br/><br/>All in stock products are stored at our Cheshire warehouse in Knutsford.</p><p>All pre-order products are on the way to our Cheshire warehouse from trusted suppliers. Many of these<br/>suppliers we have worked alongside for over 10 years.</p>"
          }
        },
        "item_zaDbH": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I change my delivery address after I’ve placed my order?",
            "answer": "<p><strong>Yes</strong>. Please email our Customer Support Team at <a href=\"mailto:hello@williamwoodmirrors.co.uk\" target=\"_blank\">hello@williamwoodmirrors.co.uk </a>within 24 hours of placing your order. We’ll gladly help you change your<br/>delivery address.</p>"
          }
        },
        "item_rQBUi": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I spread the cost with finance?",
            "answer": "<p><strong>Yes</strong>, you can split the cost of your order over 3-12 months at no extra cost.<br/><br/>Available finance partners include:<br/><br/>Klarna<br/>Clearpay<br/>PayPal<br/>Shop Pay Installments<br/><br/>DivideBuy (Pay in 6, £300 GBP minimum spend. Pay in 9, £450 GBP minimum spend.Pay in 12, £600 GBP minimum spend).</p>"
          }
        },
        "item_qAWDg": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Where do I enter promotional codes?",
            "answer": "<p>You can enter a promotional code on the first checkout page. If the advertised promotional code is set to apply automatically, you don’t need to enter it. It will be applied for you.</p>"
          }
        },
        "item_EBe6F": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Do you offer a warranty on your products?",
            "answer": "<p><strong>Yes</strong>, every product is back by our 5-year warranty guarantee. For more information on our warranty, please see here <a href=\"http://www.williamwoodmirrors.co.uk/pages/warranty\">www.williamwoodmirrors.co.uk/pages/warranty</a></p>"
          }
        },
        "item_CFhYx": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I cancel my order / Pre Order?",
            "answer": "<p><strong>Yes</strong>, you always keep full control of your order with us. If you need to cancel your order, contact our Customer Support Team at <a href=\"mailto:hello@williamwoodmirrors.co.uk\" target=\"_blank\">hello@williamwoodmirrors.co.uk</a>. An advisor will be happy to assist you.</p>"
          }
        },
        "item_MXrid": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Do you offer a fitting / assembly service?",
            "answer": "<p><strong>Yes</strong>, once your order is confirmed, you will receive a confirmation email. This email will have a link to schedule your fitting or assembly service with our trusted partner, TaskRabbit.</p><p><strong>Please do not book this service until you have taken delivery of your order.</strong></p>"
          }
        },
        "tab_jyiYq": {
          "type": "tab",
          "disabled": false,
          "settings": {
            "tab_title": "Our Brand"
          }
        },
        "item_Ff4Qp": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Can I trust William Wood?",
            "answer": "<p><strong>Yes</strong>, you can fully trust William Wood. Since 2010, we’ve welcomed over 700,000 customers. We have more than 30,000 five-star product reviews, have a 4.7 rating on Trustpilot and our social media community has a total following of over 840,000. If you ever need us, our team is on hand before, during, and after your order to make sure everything runs smoothly.</p>"
          }
        },
        "item_ydtRD": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "Do you have a shop?",
            "answer": "<p>Not just yet, we are working to open our first location in 2026. Become an Email Member to be the first to know.</p>"
          }
        },
        "tab_eG43j": {
          "type": "tab",
          "disabled": false,
          "settings": {
            "tab_title": "Support"
          }
        },
        "item_dLjPf": {
          "type": "item",
          "disabled": false,
          "settings": {
            "question": "How do I contact Customer Support?",
            "answer": "<p>Our industry leading human Customer Support Team is here to answer and questions you have. <br/><br/>Live Chat: Monday - Friday / 9 AM - 3 PM<br/><br/>WhatsApp: +44 7407 728747<br/><br/>Customer Support: <a href=\"mailto:hello@williamwoodmirrors.co.uk\">hello@williamwoodmirrors.co.uk</a></p>"
          }
        }
      },
