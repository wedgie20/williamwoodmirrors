          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "{% if product.tags contains 'OLV46A24' or\n      product.tags contains 'SXN47A24' or\n      product.tags contains 'PLN48A24' or\n      product.tags contains 'SXN48A24' or\n      product.tags contains 'SXN48B24' or\n      product.tags contains 'DCN48A24' or\n      product.tags contains 'DCN49A24' or\n      product.tags contains 'DCN49B24' or\n      product.tags contains 'DCN49C24' or\n      product.tags contains 'SXN49A24' or\n      product.tags contains 'SXN47B24' or\n      product.tags contains 'PLN50A24' or\n      product.tags contains 'PLN50B24' or\n      product.tags contains 'SXN50A24' or\n      product.tags contains 'PLN50C24' or\n      product.tags contains 'DCN51B24' %}\n<br>\n\n<b>Arrives in time for Christmas.</b> Order any in-stock product by 23:59 PM on Sunday 15th December for Guaranteed Christmas Delivery. (Mainland UK Only).\n\n{% endif %}\n\n{% if product.available %}\n  {% unless product.tags contains 'pre-order' %}\n<br>\n<b>Arrives in time for Christmas.</b> Order any in-stock product by 23:59 PM on Sunday 15th December for Guaranteed Christmas Delivery. (Mainland UK Only).\n\n{% endunless %}\n{% endif %}"
