        "7388b98b-fb77-4c92-895d-9695c498307b": {
          "disabled": true,
          "settings": {
            "content": "<p>Require assistance? Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk</strong> and an advisor will be pleased to assist you. Contact us here - <a href=\"/pages/contact-us\" title=\"CUSTOMER SUPPORT\">/pages/contact-us<br/><br/></a><strong>WhatsApp Support<br/><br/></strong><a href=\"tel:+44 7407 728747\" title=\"tel:+44 7407 728747\">+44 7407 728747<br/><br/></a>(Please note this is a text only service)<br/><br/><strong>Live Chat Support</strong><br/><br/>Mon - Fri <br/>9 AM - 3 PM</p><p><strong><br/>RESPONSE TIMES</strong><br/><br/>Most inquiries are handled within a matter of hours, however please allow up to 1-2 Business Days for a response during busy periods.</p>"
