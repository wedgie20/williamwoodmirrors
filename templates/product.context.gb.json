  <p>Back in stock soon, sign up for restock notifications below</p>\n{% elsif black_friday_launch_date %}\n    <p>Launches 29.11.24</p>\n{% elsif has_launch %}\n    <p>Launches {{ launch_date }}</p>\n{% elsif has_black_friday_restock %}\n    <p>Restocks 29.11.24</p>\n{% elsif has_restock %}\n    <p>Restocks {{ restock_date }} 8PM</p>\n{% elsif product.available == false %}\n    {% comment %} Product is out of stock but no special status {% endcomment %}\n    <p>Currently out of stock</p>\n{% else %}\n    {% comment %} Product is in stock - show promotional content {% endcomment %}\n    {% if has_last_chance or product.tags contains \"__label:LIMITED OFFER\" %}\n        {% unless in_best_sellers %}\n        {% endunless %}\n    {% endif %}\n\n    {% unless product.tags contains 'sale' %}\n        {% if product.tags contains 'pre-order' %}\n            {% unless product.tags contains 'NPRE28' %}\n                {% if product.available %}\n                {% endif %}\n            {% endunless %}\n        {% endif %}\n    {% endunless %}\n\n    {% if product.title contains \"Hudson\" %}\n        <p style=\"transform: translateY(-5px); !important;\">Free cushion included with the Hudson Chair</p>\n    {% endif %}\n\n    {% if product.tags contains 'sale' %}\n        Extra 20% off sale, enter code SE20 at checkout \n    {% else %}\n   Buy 2 items and receive 25% off, no code required<br>or<br>Buy 3 items or more and receive 30% off, no code required\n    {% endif %}\n    <br>+<br>Free Gift with your purchase worth up to £99 GBP when you spend £299 GBP or more\n{% endif %}\n</div>\n{% endunless %}"
