        "liquid_XxpzF": {
          "type": "liquid",
          "disabled": false,
          "settings": {
            "liquid": "<div style=\"\nbackground-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.15)), url('{{ settings.speedsize_url_pfx_https -}}{{ 'Landing Page 4.jpg' | asset_url }}');\nbackground-size: cover;\nbackground-position: center;\ncolor: white;\npadding: 15px;\nborder-radius: 10px;\ntext-align: center;\nfont-weight: 700;\nfont-size: 11px;\n\">\n\n{% comment %} Initialize variables {% endcomment %}\n{% assign has_coming_soon = false %}\n{% assign has_back_soon = false %}\n{% assign has_restock = false %}\n{% assign has_black_friday_restock = false %}\n{% assign has_last_chance = false %}\n{% assign has_launch = false %}\n{% assign restock_date = \"\" %}\n{% assign launch_date = \"\" %}\n{% assign black_friday_launch_date = false %}\n\n{% comment %} Parse product tags {% endcomment %}\n{% for tag in product.tags %}\n{% if tag == \"__label:COMING SOON\" %}\n{% assign has_coming_soon = true %}\n{% elsif tag == \"__label:BACK SOON\" %}\n{% assign has_back_soon = true %}\n{% elsif tag == \"__label:RESTOCKS BLACK FRIDAY\" %}\n{% assign has_black_friday_restock = true %}\n{% elsif tag contains \"__label:RESTOCKS\" %}\n{% assign has_restock = true %}\n{% assign restock_date = tag | remove: \"__label:RESTOCKS \" %}\n{% elsif tag == \"__label:LAUNCHES BLACK FRIDAY\" %}\n{% assign black_friday_launch_date = true %}\n{% elsif tag == \"__label:LAST CHANCE\" %}\n{% assign has_last_chance = true %}\n{% elsif tag contains \"__label:LAUNCHES\" %}\n{% assign has_launch = true %}\n{% assign launch_date = tag | remove: \"__label:LAUNCHES \" %}\n{% endif %}\n{% endfor %}\n\n{% comment %} Check if product is in best-sellers collection {% endcomment %}\n{% assign in_best_sellers = false %}\n{% for collection in product.collections %}\n{% if collection.handle == 'best-sellers' %}\n{% unless product.tags contains \"pre-order\" %}\n{% assign in_best_sellers = true %}\n{% endunless %}\n{% endif %}\n{% endfor %}\n\n{% comment %} Determine if we're in EU region {% endcomment %}\n{% assign is_eu_region = false %}\n{% if current_path contains '/en-fr' or current_path contains '/en-de' or current_path contains '/en-nl' %}\n{% assign is_eu_region = true %}\n{% endif %}\n\n{% comment %} Display status messages {% endcomment %}\n{% if has_coming_soon %}\n<p>Coming Soon</p>\n{% elsif has_back_soon %}\n<p>Back in stock soon, sign up for restock notifications below</p>\n{% elsif black_friday_launch_date %}\n<p>Launches 29.11.24</p>\n{% elsif has_launch %}\n<p>Launches {{ launch_date }}</p>\n{% elsif has_black_friday_restock %}\n<p>Restocks 29.11.24</p>\n{% elsif has_restock %}\n<p>Restocks {{ restock_date }} 8PM</p>\n{% endif %}\n\n{% comment %} Hudson chair special message {% endcomment %}\n{% if product.title contains \"Hudson\" %}\n<p style=\"transform: translateY(-5px) !important;\">Free cushion included with the Hudson Chair</p>\n{% endif %}\n\n{% comment %} Sale and discount messages {% endcomment %}\n{% if product.tags contains 'sale' or product.tags contains 'freegift' %}\n<p>\nExtra 15% off End of Season Sale, enter code SE15 at checkout (Last Chance)\n<br>+<br>\n{% if is_eu_region %}\nFree Gift with your purchase worth up to €120 when you spend €299 or more\n{% else %}\nFree Gift with your purchase worth up to €120 when you spend €299 or more\n{% endif %}\n</p>\n{% else %}\n<p>\n<p style=\"font-family: var(--heading-font-family, Arial, sans-serif); font-size: 15px; text-transform: uppercase; margin: 0; margin-bottom: 5px\">Bundle Offer</p>\n\nBuy 1 item and receive 15% off, enter code SE15 at checkout<br>\nor<br>\nBuy 2 items and receive 28% off, no code required <br>(This Weekend Only)<br>\nor<br>\nBuy 3 items or more and receive 30% off, no code required\n<br>+<br>\n{% if is_eu_region %}\nFree Gift with your purchase worth up to €120 when you spend €359 or more\n{% else %}\nFree Gift with your purchase worth up to €120 when you spend €299 or more\n{% endif %}\n<br>+<br>\n30% Off shipping code: SHIP30\n</p>\n{% endif %}\n\n</div>"
          }
        },
