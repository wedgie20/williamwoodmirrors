.variants[0].inventory_quantity > 1 %}\n.icon--pulsing:before {\nanimation: inventory-pulse 1.5s linear infinite;\n}\n{% else %}\n.icon--pulsing:before {\nanimation: inventory-pulse 1s linear infinite;\n}\n{% endif %}\n</style>\n{% endif %}\n\n{% endcomment %}\n\n{% for tag in product.tags %}\n{% if tag == '#sp' %}\n<div class=\"shattered-glass\">\n<span>Assembled with <b>safe and secure</b></span><br>\n<span>accident preventing shatter proof glass</span>\n</div>\n{% endif %}\n{% endfor %}\n\n{% if product.tags contains 'pre-order' %}\n\n<div class=\"icon-blocks-container\">\n  <div class=\"icon-block\">\n    <div class=\"icon-block__icon\">\n      <img src=\"{{ 'Icons _Order Instantly.svg' | asset_url }}\" alt=\"Free Shipping\" width=\"34\" height=\"34\">\n    </div>\n    <div class=\"icon-block__number\">Step 1</div>\n    <h3 class=\"icon-block__title\">Order instantly today</h3>\n    <div class=\"icon-block__description\">Simply tap the <b>add to bag button</b> and checkout <b>securely</b> today to get your order in progress.</div>\n  </div>\n\n  <div class=\"icon-block\">\n    <div class=\"icon-block__icon\">\n      <img src=\"{{ 'Icons _Fast Delivery.svg' | asset_url }}\" alt=\"Easy Returns\" width=\"34\" height=\"34\">\n    </div>\n\n    <div class=\"icon-block__number\">Step 2</div>\n    <h3 class=\"icon-block__title\">We ship your order from the date above</h3>\n    <div class=\"icon-block__description\">Once the Pre Order date arrives, our warehouse team carefully prepares your order for <b>safe & secure</b> delivery by your dedicated William Wood driver.</div>\n  </div>\n\n  <div class=\"icon-block\">\n    <div class=\"icon-block__icon\">\n      <img src=\"{{ 'Icons _Love Your Home.svg' | asset_url }}\" alt=\"24/7 Support\" width=\"34\" height=\"34\">\n    </div>\n    <div class=\"icon-block__number\">Step 3</div>\n    <h3 class=\"icon-block__title\">Be more proud of your home</h3>\n    <div class=\"icon-block__description\">Feel <b>happier</b> and <b>prouder</b> of your home, every single day.</div>\n  </div>\n</div>\n\n{% else %}\n<div class=\"icon-blocks-container\">\n  <div class=\"icon-block\">\n    <div class=\"icon-block__icon\">\n      <img src=\"{{ 'Icons _Order Instantly.svg' | asset_url }}\" alt=\"Free Shipping\" width=\"34\" height=\"34\">\n    </div>\n    <div class=\"icon-block__number\">Step 1</div>\n    <h3 class=\"icon-block__title\">Order instantly today</h3>\n    <div class=\"icon-block__description\">Simply tap the <b>add to bag button</b> and checkout <b>securely</b> today to get your order in progress.</div>\n  </div>\n\n  <div class=\"icon-block\">\n    <div class=\"icon-block__icon\">\n      <img src=\"{{ 'Icons _Fast Delivery.svg' | asset_url }}\" alt=\"Easy Returns\" width=\"34\" height=\"34\">\n    </div>\n\n    <div class=\"icon-block__number\">Step 2</div>\n    <h3 class=\"icon-block__title\">We usually ship within 7-28 Business Days</h3>\n    <div class=\"icon-block__description\">Our warehouse team carefully prepares your order for <b>safe & secure</b> delivery by your dedicated William Wood driver.</div>\n  </div>\n\n  <div class=\"icon-block\">\n    <div class=\"icon-block__icon\">\n      <img src=\"{{ 'Icons _Love Your Home.svg' | asset_url }}\" alt=\"24/7 Support\" width=\"34\" height=\"34\">\n    </div>\n    <div class=\"icon-block__number\">Step 3</div>\n    <h3 class=\"icon-block__title\">Be more proud of your home</h3>\n    <div class=\"icon-block__description\">Feel <b>happier</b> and <b>prouder</b> of your home, every single day.</div>\n  </div>\n</div>\n\n{% endif %}\n\n<style>\n.cart-return-product-page {\ndisplay: flex\n;\nalign-items: self-end;\njustify-content: left;\ngap: 6px;\n}\n\n.instock-pulse {\njustify-content: left;\n}\n\n.shattered-glass {\nmargin: 15px 0px;\n}\n\n.icon-blocks-container {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 2rem;\n    justify-content: center;\n    margin: 2rem 0px 4rem;\n  }\n\n  .icon-block {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    border-radius: 8px;\n  }\n  .icon-block__icon img {\n    width: 34px;\n    height: 34px;\n    object-fit: contain;\n  }\n  \n  .icon-block__number {\n    font-size: 12px;\n    font-weight: bold;\n    margin-bottom: 0.5rem;\n  }\n  \n  .icon-block__title {\n    font-size: 12px;\n    font-weight: 600;\n    margin-bottom: 0.75rem;\nmargin-top: 0px;\n  }\n  \n  .icon-block__description {\n    font-size: 12px;\n    line-height: 1.5;\n    max-width: 280px;\n  }\n  \n  /* Desktop flex styling */\n  @media (min-width: 768px) {\n    .icon-blocks-container .icon-block {\n      flex: 1;\n      \n    }\n  }\n  \n  /* Mobile stacking */\n  @media (max-width: 767px) {\n    .icon-blocks-container {\n      flex-direction: column;\n      gap: 1rem;\n    }\n    \n  }\n</style>"
