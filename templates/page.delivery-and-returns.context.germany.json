    "rich_text_YMFnH": {
      "type": "rich-text",
      "disabled": false,
      "settings": {
        "subheading": "Available for delivery by the dates below",
        "title": "",
        "content": "<p>If you see this on the product page, the item(s) will be delivered to you with the utmost urgency within the advised shipping week. You can easily locate the shipping week above the <strong>'ADD TO CART' </strong>button.<br/><br/>Cancel anytime. 100% refund guarantee.<br/><br/><strong>MY ORDER CONTAINS AN IN STOCK ITEM & AN ADVANCE DELIVERY DATE ITEM?</strong></p><p>In this case we will ship your in stock item(s) to you within the<strong> </strong>advised shipping times to your area. Once the later item(s) arrive in stock, we'll deliver these to you as fast as possible.</p>",
        "button_text": "",
        "button_link": "",
        "background_type": "full_width",
        "text_width": "medium",
        "text_position": "center",
        "text_alignment": "center",
