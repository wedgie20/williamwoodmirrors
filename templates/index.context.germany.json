            "content": "<p>Discover Premium Home Design at William Wood. Each product is carefully chosen to satisfy our customers' high standards, guaranteeing outstanding quality and craftsmanship.</p>"
          }
        },
        "item_RKQ6p": {
          "type": "item",
          "disabled": false,
          "settings": {
            "icon": "picto-worldwide",
            "custom_icon": null,
            "custom_icon_width": 50,
