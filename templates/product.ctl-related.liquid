{%- layout none -%}
{%- assign _rps = product.metafields.custom.related_products.value -%}
[{%- if _rps != blank -%}
  {%- for rp in _rps -%}
    {"id":{{ rp.id }},"title":{{ rp.title | json }},"url":{{ rp.url | json }},"price":{{ rp.price | money | json }},"image":{%- if rp.featured_image -%}{{ rp.featured_image | image_url: width: 160 | json | replace: settings.speedsize_shopify_cdn_url_escaped, settings.speedsize_url_pfx_shopify_cdn_escaped | replace: settings.speedsize_shop_domain_cdn_escaped, settings.speedsize_url_pfx_shop_domain_cdn_escaped | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated_escaped, settings.speedsize_url_pfx_escaped }}{%- else -%}null{%- endif -%},"available":{{ rp.available }},"default_variant":{{ rp.has_only_default_variant }},"variant_id":{{ rp.selected_or_first_available_variant.id }}}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{%- endif -%}]
