          "type": "liquid",
          "disabled": false,
          "settings": {
            "liquid": "<div style=\"transform: translateY(-10px);\">{% assign has_coming_soon = false %}\n{% assign has_back_soon = false %}\n{% assign has_restock = false %}\n{% assign has_black_friday_restock = false %}\n{% assign has_last_chance = false %}\n{% assign has_launch = false %}\n{% assign restock_date = \"\" %}\n{% assign launch_date = \"\" %}\n{% assign black_friday_launch_date = false %}\n\n{% for tag in product.tags %}\n    {% if tag == \"__label:COMING SOON\" %}\n        {% assign has_coming_soon = true %}\n    {% elsif tag == \"__label:BACK SOON\" %}\n        {% assign has_back_soon = true %}\n    {% elsif tag == \"__label:RESTOCKS BLACK FRIDAY\" %}\n        {% assign has_black_friday_restock = true %}\n    {% elsif tag contains \"__label:RESTOCKS\" %}\n        {% assign has_restock = true %}\n        {% assign restock_date = tag | remove: \"__label:RESTOCKS \" %}\n    {% elsif tag == \"__label:LAUNCHES BLACK FRIDAY\" %}\n        {% assign black_friday_launch_date = true %}\n{% elsif tag == \"__label:LAST CHANCE\" %}\n{% assign has_last_chance = true %}\n    {% elsif tag contains \"__label:LAUNCHES\" %}\n        {% assign has_launch = true %}\n        {% assign launch_date = tag | remove: \"__label:LAUNCHES \" %}\n    {% endif %}\n{% endfor %}\n\n{% assign in_best_sellers = false %}\n{% for collection in product.collections %}\n    {% if collection.handle == 'best-sellers' %}\n{% unless product.tags contains \"pre-order\" %}\n        {% assign in_best_sellers = true %}\n{% endunless %}\n    {% endif %}\n{% endfor %}\n\n{% unless has_back_soon or has_coming_soon or has_restock or has_launch or has_black_friday_restock or black_friday_launch_date %}\n    {% unless product.title contains \"Arcurva\" %}\n        {% if in_best_sellers %}\n            {% unless product.tags contains \"sale\" %}\n<b>Purchase two or more of this product and receive 25% off with code BEST</b>\n            {% else %}\n               <b>Extra 10% off Winter Sale with code WS10 (Ends Midnight Tonight) (Ends Soon)</b><br>or<br><b>Purchase two or more of this product and receive 25% off with code BEST</b>\n            {% endunless %}\n        {% else %}\n            {% unless product.tags contains \"sale\" %}\n{% unless product.tags contains 'pre-order' %}\n<b>April Offer: 20% off this product code APR20</b>\n{% endunless %}\n            {% endunless %}\n        {% endif %}\n    {% endunless %}\n    \n\n{% endunless %}\n{% if has_coming_soon %}\n    <b>Coming Soon</b>\n{% elsif has_back_soon %}\n    <b>Back in stock soon, sign up for restock notifications below </b>\n{% elsif black_friday_launch_date %}\n    <b>Launches 29.11.24 00:00 AM GMT</b>\n{% elsif has_launch %}\n    <b>Launches {{ launch_date }} 8P</b>\n{% elsif has_black_friday_restock %}\n    <b>Restocks 29.11.24 00:00 AM GMT</b>\n{% elsif has_restock %}\n    <b>Restocks {{ restock_date }} 8PM</b>\n{% elsif has_last_chance or product.tags contains \"__label:LIMITED OFFER\" %}\n{% unless in_best_sellers %}\n<b>Extra 10% off Winter Sale with code WS10 (Ends Midnight Tonight) (Ends Soon)</b>\n{% endunless %}\n{% endif %}\n    {% unless product.tags contains 'sale' %}\n{% if product.tags contains 'pre-order' %}\n{% if product.available %}\n<b>Pre Order & Save: 30% off all Pre Order products with code PRE30</b>\n{% endif %}\n{% endif %}\n{% endunless %}</div>"
          }
        },
