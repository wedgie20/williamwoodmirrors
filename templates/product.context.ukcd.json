        "liquid_fFRig": {
          "type": "liquid",
          "disabled": false,
          "settings": {
            "liquid": "{% if product.type == 'Mirror' %}\n<br><p>\nYou want your home to <b>stand out</b> from the rest, don't you?\n</p>\n<p>\nA <b>William Wood Mirror</b> isn't just a purchase; it's the statement piece that makes your home <b>unforgettable</b>. <br> Why settle for<b> ordinary</b>?\n</p>\n\n<p>Your <b>best reflection</b> starts with<b> William Wood.</b></p>\n{% elsif product.title contains \"Coffee Table\" %}\n<br><p>\nYou want your home to <b>stand out</b> from the rest, don't you?\n</p>\n<p>A <b>William Wood Table</b> isn’t just furniture – it’s the <b>defining piece</b> that brings your home to life, blending <b>elegance</b> and <b>purpose</b> seamlessly. <br>Why settle for<b> ordinary</b>?</p>\n{% else %}\n<img src=\"https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/WW_24_InYourHome_v1.0_1.jpg?v=1728309397\" alt=\"Feel More Proud of Your Home with William Wood\">\n{% endif %}"
          }
        },
        "liquid_mEKpB": {
          "type": "liquid",
          "disabled": false,
          "settings": {
            "liquid": "<br>\n<div class=\"description-container\">\n  <div class=\"short-description\">\n    {% if current_path contains '/en-fr/' or current_path contains '/en-de/' or current_path contains '/en-nl/' %}\n    {% assign short_description = product.description \n          | strip_html \n          | replace: 'between', 'from' \n          | split: 'and' \n          | first \n          | strip \n    %}\n    {% else %}\n        {% assign short_description = product.description\n          | strip_html\n          | split: ':'\n          | first\n          | strip\n        %}\n    {% endif %}\n    {% if block.settings.short_description != blank %}\n      <p>{{ block.settings.short_description }}</p>\n    {% else %}\n      <p>{{ short_description }}</p>\n    {% endif %}\n\n    <img \n      src=\"https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/WW_24_QuestionMark-01_1.png?v=1737370952\" \n      alt=\"Question Mark Icon\" \n      class=\"info-icon\" \n      tabindex=\"0\" \n    />\n    <div class=\"tooltip\">This product is currently being crafted by our <br>expert manufacturers and is available for Pre Order.<br>Your order will ship from the date below.\n</div>\n  </div>\n</div>\n\n{% unless product.description contains 'Delivered' %}\n  <style>\n    .short-description {\n      display: none;\n    }\n    .description-container {\n      display: none;\n    }\n  </style>\n{% else %}\n  <style>\n    .short-description {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding-bottom: 0px;  \npadding-top: 12px;\n    position: relative;\n    }\n    .description-container {\n      background-color: #efefef;\n      padding: 0px;\n      border-radius: 25px;\n      display: flex;\n\n      align-items: center;\n      justify-content: center;\n    }\n    .info-icon {\n      margin-left: 8px;\n      width: 15px;\n      height: 15px;\ntransform: translateY(-6px);\n      cursor: pointer;\n      position: relative;\n    }\n    .info-icon:hover + .tooltip,\n    .info-icon:focus + .tooltip {\n      display: block;\n    }\n    .tooltip {\n      display: none;\n      position: absolute;\n      bottom: 120%;\n      left: 50%;\n      transform: translateX(-50%);\n      background-color: #333;\n      color: #fff;\n      padding: 5px 10px;\n      border-radius: 4px;\n      font-size: 12px;\n      white-space: nowrap;\n      z-index: 1000;\n    }\n    .tooltip::after {\n      content: '';\n      position: absolute;\n      top: 100%;\n      left: 50%;\n      transform: translateX(-50%);\n      border-width: 5px;\n      border-style: solid;\n      border-color: #333 transparent transparent transparent;\n    }\n  </style>\n{% endunless %}"
          }
