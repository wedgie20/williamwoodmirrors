            "liquid": "<p></p>{% unless product.tags contains 'bundle' %}\n<style>\n  @media (max-width: 768px) {\n    .product-details {\n      font-size: 11px;\noverflow: visible;\n    }\n  }\n.product-details {\ntransform: translateX(-6px);\n}\n    .product-details .image {\n      transform: translateY(-6px);\nbackground-color: #efefef; padding: 5px 5px; border-radius: 25px;\n    }\n</style>\n\n<div class=\"product-details\">\n  <span style=\"display: flex; margin: 0; text-align: left; padding: 6px 0; transform: translateY(6px); width: 100%; text-wrap: nowrap;\">\n\n    {% if product.metafields.custom.height %}\n      <p><img class=\"image\" src=\"https://cdn.shopify.com/s/files/1/0780/3843/files/icons8-resize-vertical.svg?v=1718024002\"> Height: <b>{{ product.metafields.custom.height }}</b>\n    {% endif %}\n    &nbsp;&nbsp;     \n    {% if product.metafields.custom.width %}\n      <img class=\"image\" src=\"https://cdn.shopify.com/s/files/1/0780/3843/files/icons8-resize-horizontal.svg?v=1718024002\"> Width: <b>{{ product.metafields.custom.width }}</b>\n    {% endif %}\n    &nbsp;&nbsp;\n    {% if product.metafields.custom.depth %}\n      <img class=\"image\" src=\"https://cdn.shopify.com/s/files/1/0780/3843/files/icons8-enlarge.svg?v=1718024002\"> Depth: <b>{{ product.metafields.custom.depth }}</b></p>\n    {% endif %}\n  </span>\n</div>\n{% endunless %}"
          }
