        "235b4bb6-b8c4-44a2-bf0d-eb5306de0cf5": {
          "type": "category",
          "settings": {
            "title": "PLACING YOUR ORDER"
          }
        },
        "98a5b991-54d5-4d5e-800f-a9e7fde5e17c": {
          "type": "question",
          "settings": {
            "title": "Can I use multiple offer codes at one time?",
            "answer": "<p>We do not permit the usage of multiple offer codes at one time.</p>"
          }
        },
        "87accb5c-c861-42d1-a3a4-eb00a3cfdf73": {
          "type": "question",
          "settings": {
            "title": "Can I use offer codes on sale items?",
            "answer": "<p>We do not permit the usage of offer codes on sale items.</p>"
          }
        },
        "bbec5e2f-f7f0-441c-b6aa-ed45411b0229": {
          "type": "question",
          "settings": {
            "title": "Where do I enter an offer code?",
            "answer": "<p><strong>Mobile: </strong>The option to use an offer code becomes available on the <strong>'Payment' </strong>page before entering your payment details.<br/><br/><strong>Desktop: </strong>The option to use an offer code is available on the right hand column of the checkout page.</p>"
          }
        },
        "0df7a99e-f265-4c5f-96ca-5881d0d66911": {
          "type": "question",
          "settings": {
            "title": "How do I get notified of a product restocking?",
            "answer": "<p>Simply head to the product page of your desired item and enter your email address or mobile number into the prompted box. Once we restock, an email/SMS will notify you immediately.</p>"
          }
        },
        "4657d1a7-a5bc-4d6f-b6dc-51468672e2b7": {
          "type": "question",
          "settings": {
            "title": "Are payments for Pre Orders taken upfront?",
            "answer": "<p>Full payment for your Pre Order is taken up front at the point of your order being placed. You can cancel at any point and receive a full refund.<br/><br/>Require assistance? Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk </strong>and an advisor will be pleased to assist you.</p>"
          }
        },
        "eba6b17b-f707-496d-935b-efaf054fce9c": {
          "type": "question",
          "settings": {
            "title": "How does your Pre Order service work?",
            "answer": "<p>Pre Order and reserve some of our best selling products. Full payment is taken upfront to reserve your order. When your order arrives in stock, we'll ship this to you in the fastest and safest possible manner via William Wood Dedicated Delivery Service. </p><p></p><p>Cancel anytime. 100% refund guaranteed.<br/><br/>Require assistance? Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk </strong>and an advisor will be pleased to assist you.</p>"
          }
        },
        "a1c48957-70ba-468e-93a4-553569597bcb": {
          "type": "question",
          "settings": {
            "title": "My order contains and In Stock item & a Pre Order item?",
            "answer": "<p>We will ship your in stock item(s) to you within <strong>1-7 Business Days</strong> shipping times. Once your Pre Order item(s) arrive in stock, a further shipment will be made to you.<br/><br/>Require further assistance? Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk </strong>and an advisor will be pleased to assist you.</p>"
          }
        },
        "398465bc-e2ba-4e89-b4b3-034199a87245": {
          "type": "question",
          "settings": {
            "title": "What payment methods do you accept?",
            "answer": "<p>Apple Pay, Visa, Visa Debit, Mastercard, PayPal, Klarna, Clearpay, Shop Pay, American<br/>Express, Amazon Pay & Google Pay.</p>"
          }
        },
        "61e50c74-6015-4676-8914-72826f627c0b": {
          "type": "question",
          "settings": {
            "title": "How do your E-GIFT cards work?",
            "answer": "<p>E-Gift Cards are delivered to you via email and contain instructions on<br/>how to redeem them at checkout. Our E-Gift Cards have no additional processing<br/>fees and no expiry date.</p>"
          }
        },
        "question_YzQngM": {
          "type": "question",
          "settings": {
            "title": "How do I use store credit?",
            "answer": "<p>To use store credit at checkout, log in with the same email it was issued to. It will then appear at the top of the 'Payment Method' section with the text 'Apply store credit'.</p><p><strong>Note:</strong> If you're not logged into the correct email, you won't be able to use the credit. Select 'Log Out' or 'Checkout as Guest' before logging in again.</p>"
          }
        },
        "af932389-04e9-448c-bd12-b87951afa312": {
          "type": "question",
          "settings": {
            "title": "Do you physically stock products?",
            "answer": "<p>We physically stocks 1000’s of products in our Cheshire based<br/>warehouse, all ready to be shipped immediately. If a product is available to Pre Order, this means that it’s on its way to our warehouse ready to ship as soon as it lands.</p>"
          }
        },
        "060244cf-44e8-4aec-ae16-a112919c5a59": {
          "type": "question",
          "settings": {
            "title": "Can I order and hold my order in stock?",
            "answer": "<p>Yes, please email <strong>hello@williamwoodmirrors.co.uk</strong> with your request. Please note that we are only able to hold orders in stock for up to 90 days after your order is placed.</p>"
          }
        },
        "3ac29fc6-6c20-4f84-b92a-5bec195e4e54": {
          "type": "category",
          "settings": {
            "title": "DELIVERY"
          }
        },
        "627307f6-e9a8-49b6-bf05-d5835d768f98": {
          "type": "question",
          "settings": {
            "title": "How much do you charge for delivery?",
            "answer": "<p><strong>Free</strong> Delivery to Mainland UK & Northern Ireland.</p>"
          }
        },
        "c85cfe87-887f-40fd-aaee-78a50cd855de": {
          "type": "question",
          "settings": {
            "title": "Do you ship overseas?",
            "answer": "<p>Yes, we currently ship to Mainland UK, Northern Ireland, Isle of Man, Channel Islands, Ireland, France, Germany, and the Netherlands. Our team is working tirelessly on increasing the number of locations we ship to. Follow our social @williamwood for all announcements.& Mainland France. Our team is working tirelessly on increasing the number of locations we ship to. Follow our social @williamwood for all announcements.</p>"
          }
        },
        "7d8fc3ec-7ca6-4010-bc53-b95729e58399": {
          "type": "question",
          "settings": {
            "title": "Do you deliver to my room of choice?",
            "answer": "<p><strong>Delivery to front entrance of your property</strong><br/><br/>William Wood Dedicated Delivery service will hand deliver your item(s) with the utmost care to the front entrance of your property.<br/><br/><strong>Delivery to specific room of choice within your property </strong><br/><br/>With a large majority of cases, William Wood Dedicated Delivery service will be able to deliver your item(s) to your room of choice. However, upon inspecting the path to your specific room of choice and whether this may be to difficult, this decision will be at the William Wood Dedicated Delivery drivers discretion.<br/><br/>Require further assistance? Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk </strong>and an advisor will be pleased to assist you.</p>"
          }
        },
        "8d898f58-ff8b-4e28-9d69-5bc6f201fdc0": {
          "type": "question",
          "settings": {
            "title": "Can I check over my order with the driver?",
            "answer": "<p><strong>Yes</strong>, our driver will be more than happy to unbox and check over your item(s) and further dispose of the packaging upon your request.<br/><br/>In the unlikely scenario that your item(s) are damaged or faulty, our driver will return them on his vehicle to the William Wood HQ. Our Customer Support Team will then contact you to arrange an exchange or refund dependant on how you wish to continue with your order.</p>"
          }
        },
        "860f5b4b-294c-4e2b-81b5-150fd0143cf0": {
          "type": "question",
          "settings": {
            "title": "Can I change my shipping address after I've ordered?",
            "answer": "<p>Please update us of any address changes within <strong>24 hours</strong> of<br/>your order being placed. Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk </strong>and an advisor will be pleased to assist you.</p>"
          }
        },
        "22e566ca-c21b-4cba-aab0-0589bccb819a": {
          "type": "question",
          "settings": {
            "title": "How long is shipping?",
            "answer": "<p><strong>IN STOCK ITEM(S) DELIVERY<br/><br/>UK Mainland:</strong> 1-7 Business Days (some small items 1-2 Business Days, please see product page information)<br/><br/><strong>Northern Ireland:</strong> 7-21 Business Days (some small items 1-2 Business Days, please see product page information)<br/><br/><strong>France:</strong> 7-14 Business Days<br/><br/><br/><strong>PRE ORDER ITEM(S) DELIVERY<br/><br/></strong>Your <strong>Pre Order </strong>item(s) will be delivered to you with the utmost urgency within the advised shipping week. You can easily locate the shipping week above the<strong>'ADD TO CART' </strong>button.<br/><br/>Our highly acclaimed Pre Order service is available for customers who wish to purchase and reserve in demand stock.<br/><br/>Cancel anytime. 100% refund guarantee.</p>"
          }
        },
        "21f1e1ec-aa78-42b5-92cf-d5e292e67ed2": {
          "type": "question",
          "settings": {
            "title": "Can I track my order?",
            "answer": "<p>At this stage we’re unable to offer tracking. However, William Wood<br/>Dedicated Delivery is proud to offer an industry leading service with full transparency. All of our in-house courier team understand the importance of delivery when it comes to home design, that in mind<br/>rest assured that our driver will be in contact with you at least 24<br/>hours prior to book your delivery. We also provide our drivers direct contact number, so<br/>if you wish to contact them in regards to your delivery please feel free to do so.</p>"
          }
        },
        "a1cef222-7bba-4a51-8344-a1e13a6ef806": {
          "type": "category",
          "settings": {
            "title": "EXCHANGES/RETURNS & REFUNDS"
          }
        },
        "04087f38-d5c7-4805-b0e2-e7111cd8d05e": {
          "type": "question",
          "settings": {
            "title": "How do I start an exchange?",
            "answer": "<p>When you wish to exchange your item(s) this service is <strong>Free</strong>. To start an exchange (the process of swapping an item for the same item or another choice), please contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk</strong> and an advisor will be pleased to assist you.<br/><br/><strong>PLEASE NOTE: </strong>Unlike refund requests, exchange requests <strong>cannot </strong>be processed through the Customer Portal. It is essential that our Customer Support Team handles these requests strictly through <strong>email only</strong>.<br/><br/>Once your exchange has been accepted and initiated, your William Wood Dedicated driver will contact you 24 hours in advance to book an exchange of your item(s).  <br/><br/><strong>The item I wish to exchange to is more in price than my original order<br/><br/></strong>Upon arranging your exchange, our Customer Support Team will send you a payment request invoice to the email address which you used to place your order.<br/><br/><strong>The item I wish to exchange to is less in price than my original order<br/><br/></strong>Should this be the case, our Customer Support Team will process a partial refund of the difference within 1 working day of your item(s) being collected from your property.</p><p></p><p>International Orders: Due to customs regulations and duties on international orders, we are unable to process exchanges for alternative items on existing orders. Instead, we will be required to cancel your current order, allowing you to place a new one with your preferred items.</p>"
          }
        },
        "cfad3789-f38a-43c3-bbde-6934ac4ffb7d": {
          "type": "question",
          "settings": {
            "title": "How do I start a return?",
            "answer": "<p>We offer <strong>90 Days Free Returns </strong>on all orders. To start a return, head to your <strong>Customer Portal </strong>and select 'Request a return'. Our Customer Support Team will review this request and once accepted produce a collection for your item(s). <br/><br/>To login to your Customer Portal please use the same email address that you used when placing your order. We will then text your a one-time 6 digit passcode to gain access.<br/><br/><strong>Customer Portal Location<br/><br/></strong>Desktop: Top right header menu<br/>Mobile: Bottom left slide out menu</p>"
          }
        },
        "84747063-2f5d-4abf-a6f5-228efe3d98d3": {
          "type": "question",
          "settings": {
            "title": "How do I return my item(s)?",
            "answer": "<p>Returning item(s) will be collected by <strong>William Wood Dedicated Delivery.</strong> Please do not attempt to return item(s) yourself due to the fragile nature of our products. Your William Wood Dedicated driver will contact you 24 hours in advance to book collection of your returning item(s). </p><p>Please ensure that you double check you have provided us with your best and correct contact number.</p>"
          }
        },
        "891d3dce-1a0f-46ab-859c-b031151319e0": {
          "type": "question",
          "settings": {
            "title": "When will I receive my refund?",
            "answer": "<p>We don't believe in making you wait for your money back, therefore your order will be refunded within <strong>1-3 Business Days </strong>of it being collected from your property.</p>"
          }
        },
        "832eb028-7f4f-4a6a-80e2-9e10a7d2e411": {
          "type": "question",
          "settings": {
            "title": "Can I cancel my Order/Pre Order?",
            "answer": "<p>You retain full control of your order with us at all times. Contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk</strong>and an advisor will be pleased to assist you with your request.</p>"
          }
        },
        "17874198-cc63-4c92-8973-05298aee5804": {
          "type": "question",
          "settings": {
            "title": "Can’t find the answer you’re looking for?",
            "answer": "<p>Yes, please contact our Customer Support Team via <strong>hello@williamwoodmirrors.co.uk </strong>and an advisor will be pleased to assist you with your request.</p>"
          }
        }
      },
