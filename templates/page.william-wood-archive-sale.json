        "question_efiegQ": {
          "type": "question",
          "settings": {
            "title": "What social platforms can I post on?",
            "answer": "<p>Instagram, TikTok, or both. Just make sure to tag @williamwood and sync your post through the Social Tip app.</p>"
          }
        },
        "question_AWtiKU": {
          "type": "question",
          "settings": {
            "title": "What should I post?",
            "answer": "<p>Any authentic content featuring your William Wood piece. This could be an unboxing video, a review sharing how much you love your order, a styled outfit shot, or simply a glimpse of how you styled it in your home</p>"
          }
        },
        "question_7TeUkE": {
          "type": "question",
          "settings": {
            "title": "What if I have a private account?",
            "answer": "<p>You can still earn rewards even if you have a private social media account. We respect your privacy and don't expect you to make your account public just to earn money on Social</p>"
          }
        },
        "question_R89NXR": {
          "type": "question",
          "settings": {
            "title": "When do I get paid?",
            "answer": "<p>It can take up to 72 hours to calculate your reward depending on what type of content you post on your social media account. Once that's done, your reward will be paid in to your wallet and you can withdraw it.</p>"
          }
        },
