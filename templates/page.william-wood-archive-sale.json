        "question_TYGKNy": {
          "type": "question",
          "settings": {
            "title": "Do I need a lot of followers?",
            "answer": "<p>No. Social Tip rewards engagement & authenticity -<br/>followers don't matter. That means you can earn just as much with a few hundred<br/>followers as someone with thousands. It's all about the quality of your post<br/>and engagement it gets - not how many followers you have.</p>"
          }
