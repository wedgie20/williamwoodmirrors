          "disabled": false,
          "settings": {
            "image": "shopify://shop_images/icons8-in-transit.svg",
            "image_width": 50,
            "image_border": "rgba(0,0,0,0)",
            "title": "",
            "content": "<h3>Free & Fast Delivery to Mainland UK & Northern Ireland </h3><p>Experience our highly-acclaimed and reliable William Wood Dedicated Delivery Service. All deliveries are pre booked by your own William Wood Dedicated Delivery Driver 24 - 48 hours in advance.</p>",
