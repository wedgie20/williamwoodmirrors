            "link_url": "shopify://pages/faq",
            "link_style": "link",
            "text_alignment": "center",
            "vertical_alignment": "start"
          }
        },
        "item_jfFXh": {
          "type": "item",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/icons8-transaction-24.svg",
            "image_width": 100,
            "image_border": "rgba(0,0,0,0)",
            "title": "",
            "content": "<h3>Industry Leading Instant Refund Service</h3><p>The moment your order is collected, a notification will be sent to our Customer Support Team. Your order will then be refunded instantly. If your order is collected out of working hours (8 AM - 4 PM Monday - Friday), we will refund you the next Business Day - That's our promise.</p>",
            "link_text": "Refund FAQs",
            "link_url": "shopify://pages/faq",
