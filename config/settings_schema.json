  {
    "name": "Swym Wishlist Product Button",
    "settings": [
      {
        "type": "header",
        "content": "Button Placement",
        "info": "We recommend using the Admin App to configure these settings. [Open App](/admin/apps/swym-relay)"
      },
      {
        "type": "select",
        "id": "swym_button_position",
        "label": "Select Position",
        "info": "Choose where the wishlist button appears on your product page. Select 'Custom Placement' to manually specify a location using a CSS selector. [Help](https://help.getswym.com/en/articles/13249541-how-to-find-css-selectors-for-custom-button-placement)",
        "default": "default",
        "options": [
          {
            "value": "default",
            "label": "Inline with Product Details"
          },
          {
            "value": "product_image",
            "label": "Overlay on Product Image"
          },
          {
            "value": "product_title",
            "label": "Near Product Title"
          },
          {
            "value": "custom",
            "label": "Custom Placement"
          }
        ]
      },
      {
        "type": "text",
        "id": "swym_custom_selector",
        "label": "Custom Placement Selector",
        "info": "Enter a CSS selector of the parent element to anchor the button. Only used if Button Position is set to 'Custom' Placement. [Help](https://help.getswym.com/en/articles/13249541-how-to-find-css-selectors-for-custom-button-placement)",
        "default": "#swym-custom-wishlist-button"
      },
      {
        "type": "header",
        "content": "Button Appearance",
        "info": "We recommend using the Admin App to configure these settings. [Open App](/admin/apps/swym-relay)"
      },
      {
        "type": "html",
        "id": "swym_wishlist_custom_button_before_html",
        "label": "Add to Wishlist HTML",
        "info": "Customize the button's appearance for products not yet saved to the wishlist.",
        "default": "<button class=\"swym-icon-text\" type=\"button\">\n\t<svg class=\"swym-icon\" width=\"20\" height=\"20\" viewbox=\"0 0 24 24\">\n\t\t<path d=\"M19.6706 5.4736C17.6806 3.8336 14.7206 4.1236 12.8906 5.9536L12.0006 6.8436L11.1106 5.9536C9.29063 4.1336 6.32064 3.8336 4.33064 5.4736C2.05064 7.3536 1.93063 10.7436 3.97063 12.7836L11.6406 20.4536C11.8406 20.6536 12.1506 20.6536 12.3506 20.4536L20.0206 12.7836C22.0706 10.7436 21.9506 7.3636 19.6706 5.4736Z\" stroke=\"currentColor\" stroke-width=\"1.75px\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\t</svg>\n\t<span class=\"swym-custom-btn-txt\">{{WishlistAddCTA}}</span>\n</button>"
      },
      {
        "type": "html",
        "id": "swym_wishlist_custom_button_after_html",
        "label": "Added to Wishlist HTML",
        "info": "Customize the button's appearance for products already in the wishlist.",
        "default": "<button class=\"swym-icon-text\" type=\"button\">\n\t<svg class=\"swym-icon\" width=\"20\" height=\"20\" viewbox=\"0 0 24 24\">\n\t\t<path d=\"M19.6706 5.4736C17.6806 3.8336 14.7206 4.1236 12.8906 5.9536L12.0006 6.8436L11.1106 5.9536C9.29063 4.1336 6.32064 3.8336 4.33064 5.4736C2.05064 7.3536 1.93063 10.7436 3.97063 12.7836L11.6406 20.4536C11.8406 20.6536 12.1506 20.6536 12.3506 20.4536L20.0206 12.7836C22.0706 10.7436 21.9506 7.3636 19.6706 5.4736Z\" stroke=\"currentColor\" stroke-width=\"1.75px\" fill=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n\t</svg>\n\t<span class=\"swym-custom-btn-txt\">{{WishlistAddedCTA}}</span>\n</button>"
