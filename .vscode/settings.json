{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.shopify/**": true,
    "**/sections/**": true,
    "**/snippets/**": true,
    "**/layout/**": true,
    "**/assets/**": true,
    "**/config/**": true,
    "**/locales/**": true,
    "**/templates/**": true
  },
  "files.autoSave": "off",
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.shopify": true,
    "**/sections": true,
    "**/snippets": true,
    "**/layout": true,
    "**/assets": true,
    "**/config": true
  },
  "git.autorefresh": false,
  "git.autoRepositoryDetection": false,
  "git.enableSmartCommit": false
}