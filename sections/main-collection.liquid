{%- assign collection_sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign active_filters_count = 0 -%}

{%- for filter in collection.filters -%}
  {%- if filter.type == 'list' -%}
    {%- assign active_filters_count = active_filters_count | plus: filter.active_values.size -%}
  {%- elsif filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
    {%- assign active_filters_count = active_filters_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-products-per-row: {{ section.settings.mobile_products_per_row | times: 1 }};
  }

  @media screen and (min-width: 741px) {
    #shopify-section-{{ section.id }} {
      {%- assign remainder_for_two = section.settings.products_per_page | modulo: 2 -%}
      {%- assign remainder_for_desktop_count = section.settings.products_per_page | modulo: section.settings.desktop_products_per_row -%}

      --section-products-per-row: {% if remainder_for_two == 0 and remainder_for_desktop_count == 0 %}2{% else %}3{% endif %};
    }
  }

  {%- if section.settings.filter_position == 'drawer' -%}
    @media screen and (min-width: 1200px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.desktop_products_per_row }};
      }
    }
  {%- else -%}
    @media screen and (min-width: 1400px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.desktop_products_per_row }};
      }
    }
  {%- endif -%}

  {%- for block in section.blocks -%}
    #block-{{ section.id }}-{{ block.id }} {
      --heading-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --text-color: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --section-block-background: {{ block.settings.background.red }}, {{ block.settings.background.green }}, {{ block.settings.background.blue }};
      --primary-button-background: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
      --primary-button-text-color: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};

      {%- assign text_position = block.settings.text_position | split: '_' | first -%}

      {%- case text_position -%}
        {%- when 'top' -%}
          {%- assign section_items_alignment = 'flex-start' -%}
        {%- when 'middle' -%}
          {%- assign section_items_alignment = 'center' -%}
        {%- when 'bottom' -%}
          {%- assign section_items_alignment = 'flex-end' -%}
      {%- endcase -%}

      --section-blocks-alignment: {{ section_items_alignment }};
    }
  {%- endfor -%}

  /*
    IMPLEMENTATION NOTE: due to design requirements, the mobile toolbar (with filters and sort by) had to be moved to the
    layout file. However as section settings cannot be accessed outside the section itself, we simply hide them in CSS.
   */

  {%- if section.settings.show_filters and collection.filters != empty and collection.products_count > 0 -%}
    .mobile-toolbar__item--filters {
      display: flex !important;
    }
  {%- endif -%}

  {%- if section.settings.show_sort_by and collection.products_count > 0 -%}
    .mobile-toolbar__item--sort {
      display: flex !important;
    }
  {%- endif -%}

  {%- if section.settings.show_sort_by or section.settings.show_filters and collection.filters != empty -%}
    @media screen and (max-width: 999px) {
      :root {
        --anchor-offset: 60px;
      }
    }
  {%- endif -%}

   /* Pills */

@media (min-width: 750px) {
  .collection-tags ul.hookpoint-tags {
    justify-content: center;   /* center pills horizontally */
    padding-left: 0;           /* remove the mobile gutter */
    scroll-padding-left: 0;
  }
}

.hookpoint-tags li {
  flex: 0 0 auto;               /* don't shrink */
  padding: 5px 12px 3px;
  margin: 0 8px;
     border-radius: 4px;
  list-style: none;
  background-color: rgb(var(--product-custom-label-background));
  cursor: pointer;
  white-space: nowrap;
}

/* First/last chip margins so edges aren't clipped */
.hookpoint-tags li:first-child { margin-left: 0; }
.hookpoint-tags li:last-child  { margin-right: 0; }

/* Row */
ul.hookpoint-tags {
  display: flex;
  align-items: center;
  justify-content: flex-start;   /* was centering content */
  gap: 0.5rem;
  padding-inline: 12px;          /* breathing room so first pill is fully visible */
  overflow-x: auto;
  flex-wrap: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;         /* Firefox */
  scroll-padding-left: 12px;     /* aligns snap/scroll to the padding */
  padding-block: 0;              /* keep vertical padding unset */
}

  {% comment %} .hookpoint-tags li {
    padding: 5px 12px 3px;
    margin: 0 8px;
    border-radius: 4px;
    list-style: none;
    background-color: rgb(var(--product-custom-label-background));
    cursor: pointer;
}
ul.hookpoint-tags {
  padding: unset;
  display: flex;
  place-items: center;
  place-content: center;
  overflow-x: auto;
  flex-wrap: nowrap;
  gap: 0.5rem;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
} {% endcomment %}
ul.hookpoint-tags::-webkit-scrollbar {
  {% comment %} display: none; /* Chrome, Safari, Opera */ {% endcomment %}
}
.hookpoint-tags li {
  white-space: nowrap;
}
.collection-tags {
    margin-bottom: 30px;
}
.hookpoint-tags li.custom-filter-tag.activetag {
    background-color: black;
    color: white;
}

@media (max-width: 749px) {
  ul.hookpoint-tags {
    overflow-x: auto;
    {% comment %} overflow-y: hidden; {% endcomment %}
    white-space: nowrap;
    -webkit-overflow-scrolling: touch; /* smooth scrolling on iOS */
    scrollbar-width: thin; /* for Firefox */
            padding-bottom: 15px;
  }
  ul.hookpoint-tags::-webkit-scrollbar {
    height: 3px;
    background: #eee;
  }
  ul.hookpoint-tags::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 3px;
  }
   ul.hookpoint-tags::-webkit-scrollbar-track {
    background: #eee;
    border-radius: 6px; /* This is for the track */
  }
}
</style>

<script>
 document.addEventListener('DOMContentLoaded', () => {
  const row = document.querySelector('ul.hookpoint-tags');
  if (row) row.scrollLeft = 0;
});

</script>

<section>
  <div class="container">

    {% if collection.metafields.custom.hookpoint_tags %}
      <div class="collection-tags">
       {% assign hookpoint_tags = collection.metafields.custom.hookpoint_tags | split: ',' %}
       <div class="hookpoint-scrollbar-container">
<ul class="hookpoint-tags">
     {%- assign current_tag = request.path | split: '/' | last -%}
     
     {%- comment -%} Check if any filters are active {%- endcomment -%}
     {%- assign has_filters = false -%}
     {%- if active_filters_count > 0 -%}
       {%- assign has_filters = true -%}
     {%- endif -%}
     
     {%- comment -%} All option - active when no filters are applied {%- endcomment -%}
     <li class="custom-filter-tag custom-filter-all{% unless has_filters %} activetag{% endunless %}" data-tag="__all__">all</li>
     
  {% for tag in hookpoint_tags %}
    {% assign tag_label = tag | strip | replace: '_', ' ' %}
      {% assign tag_value = tag | strip %}
      <li class="custom-filter-tag{% if current_tag == tag_value %} activetag{% endif %}" data-tag="{{ tag_value }}">{{ tag_label }}</li>
  {% endfor %}

</ul>
 <div class="hookpoint-scrollbar-track">
    <div class="hookpoint-scrollbar-thumb"></div>
  </div>
</div>
      </div>
    {% endif %}

    <product-facet section-id="{{ section.id }}" class="product-facet">
      {%- if section.settings.show_filters and collection.filters != empty -%}
        {%- if section.settings.filter_position == 'always_visible' -%}
          <div class="product-facet__aside">
            <safe-sticky offset="30" class="product-facet__aside-inner">
              <div class="product-facet__filters-header hidden-pocket">
                <p class="heading {% if settings.heading_text_transform == 'uppercase' %}h6{% else %}h5{% endif %}">
                  {{ 'collection.general.filters' | t }}
                </p>
              </div>

              {%- render 'facet-filters',
                filters: collection.filters,
                filters_position: section.settings.filter_position
              -%}
            </safe-sticky>
          </div>
        {%- else -%}
          {%- render 'facet-filters',
            filters: collection.filters,
            filters_position: section.settings.filter_position
          -%}
        {%- endif -%}
      {%- endif -%}

      <div id="facet-main" class="product-facet__main anchor" role="region" aria-live="polite">
        {%- if section.blocks.size > 0 -%}
          {%- capture promotion_blocks -%}
            <div class="promotion-block-list promotion-block-list--{{ section.settings.promotion_position }}">
              {%- for block in section.blocks -%}
                {%- capture block_content -%}
                  {%- if block.settings.image != blank -%}
                    <img class="promotion-block__image"
                         loading="lazy"
                         sizes="(max-width: 740px) calc(100vw - 12px * 2), calc(min(100vw, 1560px) / {{ section.blocks.size }} - 20px * {{ section.blocks.size | minus: 1 }})"
                         {% render 'image-attributes', image: block.settings.image, sizes: '200,300,400,500,600,700,800,900,1000,1100,1200,1300,1400,1500,1600' %}>
                  {%- endif -%}

                  <div class="promotion-block__content-wrapper text-container" style="{% if block.settings.text_position contains 'center' %}text-align: center{% elsif block.settings.text_position contains 'right' %}text-align: end{% endif %}">
                    {%- if block.settings.subheading != blank -%}
                      <p class="heading heading--small">{{ block.settings.subheading | escape }}</p>
                    {%- endif -%}

                    {%- if block.settings.title != blank -%}
                      <p class="heading h4">{{ block.settings.title | escape | newline_to_br }}</p>
                    {%- endif -%}

                    {%- if block.settings.link_text != blank -%}
                      {%- if block.settings.link_style == 'link' -%}
                        <span class="heading heading--small link">{{ block.settings.link_text | escape }}</span>
                      {%- else -%}
                        <div class="button-wrapper">
                          <span class="button button--small button--primary">{{ block.settings.link_text | escape }}</span>
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                {%- endcapture -%}

                {%- if block.settings.link_url != blank -%}
                  <a id="block-{{ section.id }}-{{ block.id }}" href="{{ block.settings.link_url  }}" class="promotion-block promotion-block--{{ section.settings.promotion_height }} promotion-block--expand image-zoom" {{ block.shopify_attributes }}>
                    {{- block_content  -}}
                  </a>
                {%- else -%}
                  <div id="block-{{ section.id }}-{{ block.id }}" class="promotion-block promotion-block--{{ section.settings.promotion_height }} promotion-block--expand image-zoom" {{ block.shopify_attributes }}>
                    {{- block_content    -}}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endcapture -%}
        {%- endif -%}

        {%- if section.settings.promotion_position == 'top' -%}
          {{- promotion_blocks -}}
        {%- endif -%}

        {%- if collection.products_count > 0 -%}
          <div class="product-facet__meta-bar anchor">
            {%- if section.settings.filter_position == 'drawer'
              and section.settings.show_filters
              and collection.filters != empty
            -%}
              <button
                type="submit"
                is="toggle-button"
                class="product-facet__meta-bar-item product-facet__meta-bar-item--filter hidden-pocket"
                aria-controls="facet-filters"
                aria-expanded="false"
              >
                {%- render 'icon' with 'filters', inline: true -%}
                {{- 'collection.general.show_filters' | t -}}
                {% if active_filters_count > 0 -%}
                  <span class="product-facet__active-count bubble-count">{{ active_filters_count }}</span>
                {%- endif %}
              </button>
            {%- endif -%}

            <span class="product-facet__meta-bar-item product-facet__meta-bar-item--count" role="status">
              {{- 'collection.general.products_count' | t: count: collection.products_count -}}
            </span>

            {%- if section.settings.show_sort_by -%}
              <div class="product-facet__meta-bar-item product-facet__meta-bar-item--sort">
                <span class="product-facet__sort-by-title text--subdued hidden-pocket">
                  {{- 'collection.general.sort_by' | t -}}
                </span>

                <div class="popover-container">
                  {%- for option in collection.sort_options -%}
                    {%- if option.value == collection_sort_by -%}
                      {%- assign collection_sort_by_name = option.name -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <button
                    type="button"
                    is="toggle-button"
                    class="popover-button hidden-pocket"
                    aria-expanded="false"
                    aria-controls="sort-by-popover"
                  >
                    <span id="sort-by-selected-value" style="pointer-events: none">
                      {{- collection_sort_by_name -}}
                    </span>
                    {%- render 'icon' with 'chevron', inline: true -%}
                  </button>

                  <sort-by-popover id="sort-by-popover" class="popover">
                    <span class="popover__overlay"></span>

                    <header class="popover__header">
                      <span class="popover__title heading h6">{{- 'collection.general.sort_by' | t -}}</span>

                      <button
                        type="button"
                        class="popover__close-button tap-area tap-area--large"
                        data-action="close"
                        title="{{ 'general.accessibility.close' | t | escape }}"
                      >
                        {%- render 'icon' with 'close' -%}
                      </button>
                    </header>

                    <div class="popover__content">
                      <div class="popover__choice-list">
                        {%- for sort_option in collection.sort_options -%}
                          <label class="popover__choice-item">
                            <input
                              type="radio"
                              data-bind-value="sort-by-selected-value"
                              class="visually-hidden"
                              {% if sort_option.value == collection_sort_by %}
                                checked="checked"
                              {% endif %}
                              name="sort_by"
                              value="{{ sort_option.value }}"
                              title="{{ sort_option.name }}"
                            >
                            <span class="popover__choice-label">{{ sort_option.name }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </div>
                  </sort-by-popover>
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if active_filters_count > 0 -%}
            <div class="product-facet__active-list tag-list hidden-tablet-and-up">
              {%- render 'facet-active-filters', filters: collection.filters -%}
            </div>
          {%- endif -%}

          {%- paginate collection.products by section.settings.products_per_page -%}
            <product-list
              {% if settings.stagger_products_apparition %}
                stagger-apparition
              {% endif %}
              class="product-facet__product-list product-list anchor"
            >
              {%- if section.settings.filter_position == 'always_visible'
                and section.settings.show_filters
                and collection.filters != empty
              -%}
                {%- assign sidebar_width = 305 -%}
              {% else %}
                {%- assign sidebar_width = 0 -%}
              {%- endif -%}

              <div class="product-list__inner">
                {%- assign desktop_number_of_products_minus_one = section.settings.desktop_products_per_row
                  | minus: 1
                -%}
                {%- assign gap_width = 24.0
                  | divided_by: section.settings.desktop_products_per_row
                  | times: desktop_number_of_products_minus_one
                -%}
                {%- capture sizes_attribute -%}(max-width: 740px) calc({{ 100.0 | divided_by: section.settings.mobile_products_per_row | ceil }}vw - 24px), calc((min(100vw - 80px, 1520px) - {{ sidebar_width }}px) / {{ section.settings.desktop_products_per_row }} - {{ gap_width | ceil }}px){%- endcapture -%}

                {%- for product in collection.products -%}
                  {% if forloop.index == 25 %}
                    <style>
                      .jdgm-carousel-wrapper {
                        grid-column: 1/3;
                        width: auto !important;
                        max-width: 100%;
                        padding: 2rem 0 0 !important;
                        background: rgb(239, 239, 239);
                        height: 385px;
                      }
                      .jdgm-carousel__right-arrow,
                      .jdgm-carousel__left-arrow {
                        border: 4px none #191919 !important;
                        width: 13px !important;
                        height: 13px !important;
                      }
                      .jdgm-carousel--card-theme .jdgm-carousel-item__inner-wrapper {
                        background-color: #f7f7f7;
                      }
                      .jdgm-carousel__right-arrow {
                        border-style: none solid solid none !important;
                      }
                      .jdgm-carousel__left-arrow {
                        border-style: solid none none solid !important;
                      }
                      .jdgm-carousel__item-wrapper {
                        scrollbar-width: none; /* Firefox */
                        -ms-overflow-style: none; /* IE 10+ */
                      }
                      .jdgm-carousel__item-wrapper::-webkit-scrollbar {
                        width: 0px;
                        background: transparent; /* make scrollbar transparent */
                      }
                      @media (min-width: 741px) {
                        .jdgm-carousel-wrapper {
                          grid-column: 1/4;
                        }
                      }
                    </style>
                    <!-- Start of Judge.me code -->
                    <div class="jdgm-carousel-wrapper">
                      {% assign jm_metafields = shop.metafields.judgeme %}
                      <div class="jdgm-carousel-title-and-link">
                        <h2 class="jdgm-carousel-title">Community Feedback</h2>
                        <span class="jdgm-all-reviews-rating-wrapper" href="javascript:void(0)">
                          <span
                            style="display:block"
                            data-score="{{ jm_metafields.all_reviews_rating }}"
                            class="jdgm-all-reviews-rating" 
                            aria-label="{{ jm_metafields.all_reviews_rating }} stars"
                            tabindex="0"
                            role="img"
                          ></span>
                          <span
                            style="display: block"
                            class="jdgm-carousel-number-of-reviews"
                            data-number-of-reviews="{{ jm_metafields.all_reviews_count }}"
                          >
                            from {{ shop.metafields.judgeme.all_reviews_count }} reviews
                          </span>
                        </span>
                      </div>
                      {{ jm_metafields.featured_carousel }}
                    </div>
                    <!-- End of Judge.me code -->
                    {%- render 'product-card-coll',
                      product: product,
                      collection: collection,
                      block: block,
                      sizes_attribute: sizes_attribute,
                      reveal: settings.stagger_products_apparition,
                      forloop_index: forloop.index
                    -%}
                  {% else %}
                    {%- render 'product-card-coll',
                      product: product,
                      collection: collection,
                      block: block,
                      sizes_attribute: sizes_attribute,
                      reveal: settings.stagger_products_apparition,
                      forloop_index: forloop.index
                    -%}
                  {% endif %}
                {%- endfor -%}
              </div>
            </product-list>

            {%- render 'pagination', paginate: paginate, use_ajax: true -%}
          {%- endpaginate -%}

          {%- if section.settings.promotion_position == 'bottom' -%}
            {{- promotion_blocks -}}
          {%- endif -%}
        {%- else -%}
          <div class="empty-state">
            {%- if collection.all_products_count == 0 -%}
              <h3 class="heading h4">{{ 'collection.general.empty_title' | t }}</h3>
              <p>{{ 'collection.general.empty_label' | t }}</p>

              <div class="button-wrapper">
                <a href="{{ routes.all_products_collection_url  }}" class="button button--primary">
                  {{- 'collection.general.empty_button' | t -}}
                </a>
              </div>
            {%- else -%}
              <h3 class="heading h4">{{ 'collection.general.no_results_title' | t }}</h3>
              <p>{{ 'collection.general.no_results_label' | t }}</p>

              <div class="button-wrapper">
                <a
                  href="{{ collection.url  }}?sort_by={{ collection_sort_by  }}"
                  data-action="clear-filters"
                  class="button button--primary"
                >
                  {{- 'collection.general.no_results_button' | t -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </product-facet>

    {% if collection.metafields.custom.title_text_section or collection.metafields.custom.description_text_section or collection.metafields.custom.link_text_text_section %}
    <div class="metafields_section">
      {% if collection.metafields.custom.title_text_section %}
  <h3 class="heading h2">{{ collection.metafields.custom.title_text_section }}</h3>
{% endif %}

{% if collection.metafields.custom.description_text_section %}
  <div class="collection-description">
    {{ collection.metafields.custom.description_text_section | metafield_tag    }}
  </div>
{% endif %}

{% if collection.metafields.custom.link_text_text_section and collection.metafields.custom.link_text_section %}
  <a href="{{ collection.metafields.custom.link_text_section }}" class="collection-link">
    {{ collection.metafields.custom.link_text_text_section }}
  </a>
{% endif %}
    </div>
    {% endif %}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const customTags = document.querySelectorAll('.custom-filter-tag');
  const allTag = document.querySelector('.custom-filter-all');
  const facetMain = document.getElementById('facet-main');

  customTags.forEach(tag => {
    tag.addEventListener('click', function (e) {
      e.preventDefault();
      const tagValue = tag.getAttribute('data-tag');
      if (!facetMain) return;

      // Handle "All" option - clear all filters using native Shopify mechanism
      if (tagValue === '__all__') {
        // Find and click the "Clear all" link in the native filter system
        const clearAllLink = document.querySelector('a[data-action="clear-filters"]');
        if (clearAllLink) {
          clearAllLink.click();
        } else {
          // Fallback: trigger filter change event with empty params
          const facetFilters = document.querySelector('facet-filters');
          if (facetFilters) {
            const baseUrl = window.location.pathname;
            facetFilters.dispatchEvent(new CustomEvent('facet:criteria-changed', {
              bubbles: true,
              detail: { url: baseUrl }
            }));
          }
        }
        return;
      }

      // For regular filter tags - remove "All" active state when any filter is selected
      if (allTag) {
        allTag.classList.remove('activetag');
      }

      // Toggle activetag class on clicked tag
      tag.classList.toggle('activetag');

      // Find the corresponding label in the filter section
      const hookpointFilterItem = document.querySelector('.product-facet__filter-item.hookpoint-tag');
      if (hookpointFilterItem) {
        const targetLabel = hookpointFilterItem.querySelector(`label[label-value="${tagValue}"]`);
        if (targetLabel) {
          targetLabel.click();
        }
      }
    });
  });
});
</script>

<script>
 function setupAnimateImagesObserver() {
  // Only run on screens smaller than 550px
  if (!window.matchMedia('(max-width: 549px)').matches) return;
  const elements = document.querySelectorAll('.this_is_animate');
  if (!('IntersectionObserver' in window)) return; // Fallback for old browsers
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target;
        
        // Check if container has mobile images
        const mobileImages = el.querySelectorAll('.mobile_images');
        if (mobileImages.length > 0) {
          // Temporarily disable scroll-snap to prevent conflicts with animation
          const originalScrollSnapType = el.style.scrollSnapType;
          el.style.scrollSnapType = 'none';
          
          // Remove and re-add animation class for restart
          el.classList.remove('animate_images');
          // Force reflow to restart the animation
          void el.offsetWidth;
          el.classList.add('animate_images');
          
          // Re-enable scroll-snap after animation completes (1s animation + small buffer)
          setTimeout(() => {
            el.style.scrollSnapType = 'x mandatory';
          }, 3000);
        }
      }
    });
  }, { threshold: 0.1 });
  
  elements.forEach(el => observer.observe(el));
}
document.addEventListener('DOMContentLoaded', function() {
  setupAnimateImagesObserver();
  
  // Call again after infinite scroll setup (with delay to ensure DOM is ready)
  setTimeout(setupAnimateImagesObserver, 1500);
  setTimeout(setupAnimateImagesObserver, 3000);
});
</script>

<style>

  .metafields_section h3.heading.h2{
  margin-bottom: 24px;
  }
  .metafields_section {
    text-align: center;
    margin-bottom: 80px;
}
.metafields_section a{
text-decoration: underline;
}
.metafields_section .collection-description {
    margin-bottom: 20px;
}

@media screen and (max-width: 740px) {
 .metafields_section {
    margin-bottom: 48px;
}
}

  #shopify-section-{{ section.id }} .product-item__cta-wrapper .product-item__cta{
    display: flex;
    width: 22px;
    height: 22px;
    padding: unset;
    place-content: center;
    flex-wrap: wrap;
    border: 1px solid rgb(var(--border-color));
    border-radius: var(--button-border-radius);
    background: rgb(var(--root-background));
    color: rgb(var(--root-text-color));
    transition: opacity 0.25s ease-in-out, visibility 0.25s ease-in-out, transform 0.25s ease-in-out, color 0.25s ease-in-out;
    margin: unset;
  }
  #shopify-section-{{ section.id }} .product-item__cta-wrapper.hereis {
    {% comment %} display: none; {% endcomment %}
    place-content: center;
    flex-wrap: wrap;
    place-items: center;
    {% comment %} position: absolute; {% endcomment %}
        {% comment %} bottom: 15px;
    left: 50%;
    transform: translateX(-50%); {% endcomment %}
    transition-property: transform, translate, scale, rotate;
    transition-timing-function: ease-in-out;
    transition-duration: .28s;
    translate: 0 100%;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
        opacity: 0.8;
}
#shopify-section-{{ section.id }} .product-item__image-wrapper:hover .product-item__cta-wrapper.hereis{
    translate: 0 -200%;
}
@media screen and (max-width: 767px) {
#shopify-section-{{ section.id }} .product-item__cta-wrapper.hereis {
display: flex;
translate: 0 -200%;
}
}
  #shopify-section-{{ section.id }} .product-item__cta-wrapper .product-item__cta:hover{
    border-color: rgb(var(--heading-color));
    color: rgb(var(--heading-color));
    transform: scale(1.1);
  }
  #shopify-section-{{ section.id }} .product-item__cta-wrapper .product-item__cta:focus{
    outline: 2px solid rgb(var(--heading-color));
    outline-offset: 2px;
  }
  #shopify-section-{{ section.id }} .product-item__cta-wrapper .product-item__cta:disabled{
    opacity: 0.5;
    cursor: not-allowed;

}
  @media screen and (min-width: 550px) {
  .updated-product-item.product-item .mobile_images{
  display: none !important;
}
  }
  @media screen and (max-width: 549px) {
     @keyframes peekAnimation {
     0% { transform: translateZ(0); }
  50% { transform: translate3d(-25%, 0, 0); }
  100% { transform: translateZ(0); 
  }
}
.product-item__cta-wrapper .product-item__cta {
    margin-bottom: -8px !important;
  }
.updated-product-item.product-item .product-item__aspect-ratio.animate_images .mobile_images.clc-Items_Items-animate:not(.clone-image) {
  animation: peekAnimation 1s ease-in-out;
  animation-delay: 2s;
}

/* Ensure cloned images don't interfere with animation */
.updated-product-item.product-item .product-item__aspect-ratio.animate_images .mobile_images.clone-image {
  animation: none;
}

/* Prevent scroll-snap during animation to avoid conflicts */
.updated-product-item.product-item .product-item__aspect-ratio.animate_images {
  {% comment %} scroll-snap-type: none !important; {% endcomment %}
}
    .updated-product-item.product-item .product-item__secondary-image, .updated-product-item.product-item .product-item__primary-image {
      display: none !important;
    }
    .updated-product-item.product-item .product-item__aspect-ratio{
      display: flex;
    -ms-overflow-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    }
    .updated-product-item.product-item .mobile_images{
    flex-shrink: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    width: 100%;
    position: unset;
    }
    
    /* Hide scrollbar for infinite scroll */
    .updated-product-item.product-item .product-item__aspect-ratio::-webkit-scrollbar {
      display: none;
    }
    
    /* Smooth scroll behavior for infinite loop - controlled by JavaScript */
    .updated-product-item.product-item .product-item__aspect-ratio {
      scroll-behavior: smooth;
    }
    
    /* Ensure scroll-snap works properly with clones */
    .updated-product-item.product-item .product-item__aspect-ratio {
      scroll-snap-type: x mandatory;
    }
    
    /* Clone images should look identical */
    .updated-product-item.product-item .mobile_images.clone-image {
      flex-shrink: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      width: 100%;
      position: unset;
    }
  }

  @media (max-width: 749px) {
  .hookpoint-scrollbar-container {
    position: relative;
  }
  ul.hookpoint-tags {
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Hide native scrollbar */
    margin-bottom: 0;
    padding-bottom: 18px; /* Space for fake scrollbar */
  }
  ul.hookpoint-tags::-webkit-scrollbar {
    display: none;
  }
  .hookpoint-scrollbar-track {
    position: absolute;
    left: 0; right: 0; bottom: 4px;
    height: 4px;
    background: #eee;
    border-radius: 4px;
    z-index: 2;
    pointer-events: none;
  }
  .hookpoint-scrollbar-thumb {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    height: 4px;
    background: #ccc;
    border-radius: 4px;
    width: 40px; /* JS will update */
    z-index: 3;
    pointer-events: none;
    transition: background 0.2s;
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
  var containers = document.querySelectorAll('.hookpoint-scrollbar-container');
  containers.forEach(function(container) {
    var ul = container.querySelector('.hookpoint-tags');
    var track = container.querySelector('.hookpoint-scrollbar-track');
    var thumb = container.querySelector('.hookpoint-scrollbar-thumb');

    function updateThumb() {
      var scrollWidth = ul.scrollWidth;
      var clientWidth = ul.clientWidth;
      var scrollLeft = ul.scrollLeft;
      if (scrollWidth <= clientWidth) {
        thumb.style.display = 'none';
        return;
      }
      thumb.style.display = 'block';
      var ratio = clientWidth / scrollWidth;
      var thumbWidth = Math.max(clientWidth * ratio, 30); // min width
      var maxScroll = scrollWidth - clientWidth;
      var left = (scrollLeft / maxScroll) * (clientWidth - thumbWidth);
      thumb.style.width = thumbWidth + 'px';
      thumb.style.left = (left || 0) + 'px';
    }

    ul.addEventListener('scroll', updateThumb);
    window.addEventListener('resize', updateThumb);
    updateThumb();
  });
});
</script>

