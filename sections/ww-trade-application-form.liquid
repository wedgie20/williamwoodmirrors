{%- liquid
  assign profession_options = section.settings.profession_options | split: ','
  assign country_options = section.settings.country_options | split: ','
  assign contact_options = section.settings.contact_options | split: ','
  assign address_suggestion_rows = section.settings.address_suggestions | newline_to_br | split: '<br />'
-%}

<section class="ww-trade-application" data-ww-trade-application>
  <div class="ww-trade-application__container">
    <header class="ww-trade-application__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ww-trade-application__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="ww-trade-application__intro">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    <div class="ww-trade-application__panel">
      {%- form 'contact', id: 'ww-trade-application-form', class: 'ww-trade-application__form' -%}
        <input type="hidden" name="contact[Form]" value="Trade application">
        <input type="hidden" name="contact[Trade application source]" value="{{ page.title | default: 'Trade application' | escape }}">
        <input type="hidden" id="trade-application-contact-name" name="contact[name]" value="">
        <input type="hidden" name="contact[body]" value="Trade application submitted.">

        {%- if form.posted_successfully? -%}
          <div class="ww-trade-application__success" role="status" tabindex="-1">
            <h2>{{ section.settings.success_heading }}</h2>
            <div>{{ section.settings.success_text }}</div>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="ww-trade-application__error" role="alert">
              {{- form.errors | default_errors -}}
            </div>
          {%- endif -%}

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.details_heading }}</h2>
            <p class="ww-trade-application__signin">
              {{ section.settings.sign_in_text }}
              <a href="{{ routes.account_login_url }}">{{ section.settings.sign_in_link_text }}</a>
            </p>

            <div class="ww-trade-application__grid">
              <div class="ww-trade-application__field">
                <label for="trade-application-email">Email address <span aria-hidden="true">*</span></label>
                <input id="trade-application-email" type="email" name="contact[email]" autocomplete="off" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-first-name">First name <span aria-hidden="true">*</span></label>
                <input id="trade-application-first-name" type="text" name="contact[First name]" autocomplete="off" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-last-name">Last name <span aria-hidden="true">*</span></label>
                <input id="trade-application-last-name" type="text" name="contact[Last name]" autocomplete="off" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-phone">Phone <span aria-hidden="true">*</span></label>
                <input id="trade-application-phone" type="tel" name="contact[Phone number]" autocomplete="off" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-preferred-contact">Preferred contact <span aria-hidden="true">*</span></label>
                <select id="trade-application-preferred-contact" name="contact[Preferred contact]" required>
                  <option value="" selected disabled></option>
                  {%- for option in contact_options -%}
                    {%- assign trimmed_option = option | strip -%}
                    {%- if trimmed_option != blank -%}
                      <option value="{{ trimmed_option | escape }}">{{ trimmed_option }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            </div>
          </div>

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.company_heading }}</h2>

            <div class="ww-trade-application__grid">
              <div class="ww-trade-application__field">
                <label for="trade-application-company">Company name <span aria-hidden="true">*</span></label>
                <input id="trade-application-company" type="text" name="contact[Company name]" autocomplete="off" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-company-number">Company number</label>
                <input id="trade-application-company-number" type="text" name="contact[Company number]">
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-website">Company website (optional)</label>
                <input id="trade-application-website" type="url" name="contact[Company website]" inputmode="url">
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-profession">Business Type <span aria-hidden="true">*</span></label>
                <select id="trade-application-profession" name="contact[Business Type]" required>
                  <option value="" selected disabled></option>
                  {%- for option in profession_options -%}
                    {%- assign trimmed_option = option | strip -%}
                    {%- if trimmed_option != blank -%}
                      <option value="{{ trimmed_option | escape }}">{{ trimmed_option }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>

              <div class="ww-trade-application__file">
                <label for="trade-application-portfolio">Portfolio (optional)</label>
                <input id="trade-application-portfolio" type="file" name="contact[Portfolio]" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
              </div>
            </div>
          </div>

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.address_heading }}</h2>

            <div class="ww-trade-application__address">
              <div class="ww-trade-application__field ww-trade-application__field--full">
                <label for="trade-application-company-address">Company address <span aria-hidden="true">*</span></label>
                <input id="trade-application-company-address" type="text" name="contact[Company address]" autocomplete="off" required data-address-search>
              </div>

              <div class="ww-trade-application__address-results" data-address-results hidden></div>

              <button type="button" class="ww-trade-application__manual-toggle" data-manual-address-toggle>
                {{ section.settings.manual_address_text }}
              </button>

              <div class="ww-trade-application__manual-address" data-manual-address hidden>
                <div class="ww-trade-application__field">
                  <label for="trade-application-country">Country <span aria-hidden="true">*</span></label>
                  <select id="trade-application-country" name="contact[Country]" autocomplete="off" data-manual-required>
                    <option value="" selected disabled></option>
                    {%- for country in country_options -%}
                      {%- assign trimmed_country = country | strip -%}
                      {%- if trimmed_country != blank -%}
                        <option value="{{ trimmed_country | escape }}">{{ trimmed_country }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>

                <div class="ww-trade-application__field">
                  <label for="trade-application-address-1">Line 1 <span aria-hidden="true">*</span></label>
                  <input id="trade-application-address-1" type="text" name="contact[Line 1]" autocomplete="off" data-manual-required>
                </div>

                <div class="ww-trade-application__field">
                  <label for="trade-application-address-2">Line 2 (optional)</label>
                  <input id="trade-application-address-2" type="text" name="contact[Line 2]" autocomplete="off">
                </div>

                <div class="ww-trade-application__field">
                  <label for="trade-application-city">Town/City <span aria-hidden="true">*</span></label>
                  <input id="trade-application-city" type="text" name="contact[Town/City]" autocomplete="off" data-manual-required>
                </div>

                <div class="ww-trade-application__field">
                  <label for="trade-application-postcode">Postcode <span aria-hidden="true">*</span></label>
                  <input id="trade-application-postcode" type="text" name="contact[Postcode]" autocomplete="off" data-manual-required>
                </div>
              </div>
            </div>
          </div>

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.account_heading }}</h2>

            <div class="ww-trade-application__account">
              <div class="ww-trade-application__field">
                <label for="trade-application-password">Password <span aria-hidden="true">*</span></label>
                <input id="trade-application-password" type="password" autocomplete="off" required data-account-password>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-confirm-password">Confirm Password <span aria-hidden="true">*</span></label>
                <input id="trade-application-confirm-password" type="password" autocomplete="off" required data-account-confirm-password>
              </div>

              <div class="ww-trade-application__marketing">
                <p>{{ section.settings.marketing_question }}</p>
                <div class="ww-trade-application__marketing-options">
                  <label>
                    <input type="radio" name="contact[Marketing opt in]" value="Yes" required>
                    <span>Yes</span>
                  </label>
                  <label>
                    <input type="radio" name="contact[Marketing opt in]" value="No" required>
                    <span>No</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <button type="submit" class="ww-trade-application__submit">
            {{ section.settings.submit_text }}
          </button>

          {%- if section.settings.terms_text != blank -%}
            <div class="ww-trade-application__terms">
              {{ section.settings.terms_text }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-application {
    --ww-trade-text-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-bold-weight: var(--text-font-bold-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    --ww-trade-field-gap: 14px;
    --ww-trade-field-radius: 999px;
    background: {{ section.settings.background_color }};
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.65;
    padding: 70px 0 100px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application *,
  #shopify-section-{{ section.id }} .ww-trade-application *::before,
  #shopify-section-{{ section.id }} .ww-trade-application *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__container {
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-gutter);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__header {
    max-width: 760px;
    margin: 0 auto 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__eyebrow {
    margin: 0 0 14px;
    font-family: var(--ww-trade-text-font);
    font-size: 12px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.4;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-application h1 {
    margin: 0;
    font-family: var(--ww-trade-heading-font);
    font-size: 42px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__intro {
    max-width: 660px;
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__intro p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__panel {
    max-width: 760px;
    margin: 0 auto;
    padding: 0;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__fieldset + .ww-trade-application__fieldset {
    margin-top: 54px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application h2 {
    margin: 0 0 20px;
    font-family: var(--ww-trade-heading-font);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__signin {
    margin: -4px 0 28px;
    font-size: 16px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__signin a {
    color: inherit;
    font-weight: var(--ww-trade-bold-weight);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__grid {
    display: block;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field {
    position: relative;
    display: block;
    margin-top: var(--ww-trade-field-gap);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field--full {
    grid-column: auto;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field > label {
    position: absolute;
    top: 50%;
    left: 16px;
    z-index: 2;
    max-width: calc(100% - 32px);
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    pointer-events: none;
    transform: translateY(-50%);
    transition: top .16s ease, font-size .16s ease, transform .16s ease;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field > label span {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]),
  #shopify-section-{{ section.id }} .ww-trade-application select,
  #shopify-section-{{ section.id }} .ww-trade-application textarea {
    width: 100%;
    min-height: 48px;
    padding: 17px 16px 6px;
    border: 1px solid #bdbdbd;
    border-radius: var(--ww-trade-field-radius);
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
    box-shadow: none;
    outline: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, #000 50%), linear-gradient(135deg, #000 50%, transparent 50%);
    background-position: calc(100% - 24px) 50%, calc(100% - 16px) 50%;
    background-size: 8px 8px, 8px 8px;
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__file {
    margin-top: var(--ww-trade-field-gap);
    padding: 14px 20px 18px;
    border: 1px solid #bdbdbd;
    border-radius: 28px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__file label {
    display: block;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__file input[type="file"] {
    width: auto;
    min-height: 0;
    padding: 0;
    border: 0;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address {
    position: relative;
    display: block;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-results {
    position: absolute;
    top: calc(48px + var(--ww-trade-field-gap));
    right: 0;
    left: 0;
    z-index: 25;
    max-height: 272px;
    overflow-y: auto;
    border: 1px solid #bdbdbd;
    border-radius: 0 0 22px 22px;
    background: #fff;
    box-shadow: 0 8px 18px rgba(0, 0, 0, .16);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-results[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-option,
  #shopify-section-{{ section.id }} .ww-trade-application__address-message {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    min-height: 38px;
    padding: 8px 14px;
    border: 0;
    border-radius: 0;
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-option {
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-option:hover,
  #shopify-section-{{ section.id }} .ww-trade-application__address-option:focus-visible {
    background: #efefef;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-option strong {
    font-weight: var(--ww-trade-bold-weight);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__address-option span:last-child {
    color: #7d7d7d;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__manual-toggle {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-top: var(--ww-trade-field-gap);
    padding: 14px 20px;
    border: 1px solid #bdbdbd;
    border-radius: 999px;
    background: #efefef;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 14px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.35;
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__manual-toggle[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__manual-address {
    margin-top: var(--ww-trade-field-gap);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__manual-address[hidden] {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application textarea {
    min-height: 86px;
    padding-top: 22px;
    padding-bottom: 10px;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .ww-trade-application input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]):focus,
  #shopify-section-{{ section.id }} .ww-trade-application select:focus,
  #shopify-section-{{ section.id }} .ww-trade-application textarea:focus {
    border-color: #000;
    border-width: 2px;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field:focus-within > label,
  #shopify-section-{{ section.id }} .ww-trade-application__field.ww-field-focused > label,
  #shopify-section-{{ section.id }} .ww-trade-application__field.ww-field-filled > label {
    top: -6px;
    left: 14px;
    padding: 0 4px;
    background: #fff;
    font-size: 10px;
    transform: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__account {
    border: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__account .ww-trade-application__field {
    margin-top: var(--ww-trade-field-gap);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__account .ww-trade-application__field:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing {
    margin-top: var(--ww-trade-field-gap);
    padding: 14px 20px 12px;
    border: 1px solid #bdbdbd;
    border-radius: 28px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing p {
    max-width: 760px;
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing-options label {
    position: relative;
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing-options input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing-options span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 64px;
    min-height: 34px;
    padding: 8px 22px;
    border-radius: 999px;
    background: #efefef;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__marketing-options input:checked + span,
  #shopify-section-{{ section.id }} .ww-trade-application__marketing-options input:focus-visible + span {
    outline: 1px solid #000;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    min-height: 52px;
    margin-top: 44px;
    padding: 15px 32px;
    border: 1px solid #000;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-family: var(--ww-trade-text-font);
    font-size: 12px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__terms {
    max-width: 760px;
    margin-top: 22px;
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__terms p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__terms a,
  #shopify-section-{{ section.id }} .ww-trade-application__terms strong {
    color: inherit;
    font-weight: var(--ww-trade-bold-weight);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__success,
  #shopify-section-{{ section.id }} .ww-trade-application__error {
    padding: 26px;
    border: 1px solid #000;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__success h2 {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__success p,
  #shopify-section-{{ section.id }} .ww-trade-application__error p,
  #shopify-section-{{ section.id }} .ww-trade-application__error ul {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-application {
      padding: 48px 0 68px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application,
    #shopify-section-{{ section.id }} .ww-trade-application p,
    #shopify-section-{{ section.id }} .ww-trade-application span,
    #shopify-section-{{ section.id }} .ww-trade-application a,
    #shopify-section-{{ section.id }} .ww-trade-application button,
    #shopify-section-{{ section.id }} .ww-trade-application input,
    #shopify-section-{{ section.id }} .ww-trade-application select,
    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      font-family: var(--ww-trade-text-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-application h1,
    #shopify-section-{{ section.id }} .ww-trade-application h2,
    #shopify-section-{{ section.id }} .ww-trade-application h3 {
      font-family: var(--ww-trade-heading-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-application h1 {
      font-size: 34px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__intro,
    #shopify-section-{{ section.id }} .ww-trade-application__signin {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application h2 {
      font-size: 26px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__field > label {
      left: 14px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]),
    #shopify-section-{{ section.id }} .ww-trade-application select,
    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      min-height: 46px;
      padding: 16px 14px 6px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      min-height: 78px;
      padding-top: 21px;
      padding-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__address-results {
      top: calc(46px + var(--ww-trade-field-gap));
    }

    #shopify-section-{{ section.id }} .ww-trade-application__submit {
      width: 100%;
