</style>

<script>
  (function() {
    var section = document.querySelector('#shopify-section-{{ section.id }} [data-ww-trade-application]');
    if (!section) {
      return;
    }

    var form = section.querySelector('#ww-trade-application-form');
    var firstName = section.querySelector('#trade-application-first-name');
    var lastName = section.querySelector('#trade-application-last-name');
    var contactName = section.querySelector('#trade-application-contact-name');
    var password = section.querySelector('[data-account-password]');
    var confirmPassword = section.querySelector('[data-account-confirm-password]');
    var addressSearch = section.querySelector('[data-address-search]');
    var addressResults = section.querySelector('[data-address-results]');
    var manualAddress = section.querySelector('[data-manual-address]');
    var manualAddressToggle = section.querySelector('[data-manual-address-toggle]');
    var manualRequiredFields = manualAddress ? manualAddress.querySelectorAll('[data-manual-required]') : [];
    var addressSuggestions = {{ section.settings.address_suggestions | json }}
      .split(/\r?\n/)
      .map(function(row) {
        var parts = row.split('|').map(function(part) {
          return part.trim();
        });

        return {
          label: parts[0] || '',
          line1: parts[1] || '',
          line2: parts[2] || '',
          city: parts[3] || '',
          postcode: parts[4] || '',
          country: parts[5] || ''
        };
      })
      .filter(function(address) {
        return address.label;
      });
    var addressLookupEnabled = {{ section.settings.address_lookup_enabled | json }};
    var addressLookupEndpoint = {{ section.settings.address_lookup_endpoint | json }};
    var addressLookupTimer = null;
    var addressLookupController = null;

    section.querySelectorAll('.ww-trade-application__field').forEach(function(field) {
      var control = field.querySelector('input, select, textarea');

      if (!control) {
        return;
      }

      function syncFieldState() {
        field.classList.toggle('ww-field-filled', Boolean(control.value));
      }

      control.addEventListener('focus', function() {
        field.classList.add('ww-field-focused');
      });

      control.addEventListener('blur', function() {
        field.classList.remove('ww-field-focused');
        syncFieldState();
      });

      control.addEventListener('input', syncFieldState);
      control.addEventListener('change', syncFieldState);
      syncFieldState();
    });

    function syncControl(control) {
      if (!control) {
        return;
      }

      control.dispatchEvent(new Event('input', { bubbles: true }));
      control.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function openManualAddress() {
      if (!manualAddress) {
        return;
      }

      manualAddress.hidden = false;
      if (manualAddressToggle) {
        manualAddressToggle.hidden = true;
      }
      manualRequiredFields.forEach(function(field) {
        field.required = true;
      });
    }

    function setAddressControl(selector, value) {
      var control = section.querySelector(selector);

      if (!control || !value) {
        return;
      }

      control.value = value;
      syncControl(control);
    }

    function closeAddressResults() {
      if (!addressResults) {
        return;
      }

      addressResults.hidden = true;
      addressResults.innerHTML = '';
    }

    function normalizeAddressText(value) {
      return String(value || '').trim().toLowerCase();
    }

    function fillAddress(address) {
      if (!address || !address.label) {
        return;
      }

      if (addressSearch) {
        addressSearch.value = address.label;
        syncControl(addressSearch);
      }

      openManualAddress();
      setAddressControl('#trade-application-address-1', address.line1);
      setAddressControl('#trade-application-address-2', address.line2);
      setAddressControl('#trade-application-city', address.city);
      setAddressControl('#trade-application-postcode', address.postcode);
      setAddressControl('#trade-application-country', address.country || 'United Kingdom');
      closeAddressResults();
    }

    function createAddressResult(address) {
      var button = document.createElement('button');
      var primary = document.createElement('strong');
      var secondary = document.createElement('span');

      button.type = 'button';
      button.className = 'ww-trade-application__address-option';
      primary.textContent = address.primary || address.line1 || address.label;
      secondary.textContent = address.secondary || [address.city, address.postcode].filter(Boolean).join(', ');
      button.appendChild(primary);

      if (secondary.textContent) {
        button.appendChild(secondary);
      }

      button.addEventListener('click', function() {
        fillAddress(address);
      });

      return button;
    }

    function renderAddressResults(addresses, message) {
      if (!addressResults) {
        return;
      }

      addressResults.innerHTML = '';

      if (message) {
        var messageElement = document.createElement('div');
        messageElement.className = 'ww-trade-application__address-message';
        messageElement.textContent = message;
        addressResults.appendChild(messageElement);
        addressResults.hidden = false;
        return;
      }

      if (!addresses.length) {
        closeAddressResults();
        return;
      }

      addresses.slice(0, 7).forEach(function(address) {
        addressResults.appendChild(createAddressResult(address));
      });
      addressResults.hidden = false;
    }

    function getLocalAddressResults(query) {
      var normalizedQuery = normalizeAddressText(query);

      if (!normalizedQuery) {
        return [];
      }

      return addressSuggestions.filter(function(address) {
        return normalizeAddressText(address.label).indexOf(normalizedQuery) !== -1;
      });
    }

    function mapLookupAddress(item) {
      var address = item.address || {};
      var houseNumber = address.house_number || '';
      var road = address.road || address.pedestrian || address.footway || address.path || address.neighbourhood || '';
      var line1 = [houseNumber, road].filter(Boolean).join(' ') || item.name || item.display_name || '';
      var city = address.city || address.town || address.village || address.hamlet || address.county || '';
      var postcode = address.postcode || '';
      var country = address.country || 'United Kingdom';
      var label = item.display_name || [line1, city, postcode].filter(Boolean).join(', ');

      return {
        label: label,
        primary: line1,
        secondary: [city, postcode].filter(Boolean).join(', '),
        line1: line1,
        line2: '',
        city: city,
        postcode: postcode,
        country: country
      };
    }

    function fetchAddressResults(query) {
      var localResults = getLocalAddressResults(query);

      if (!addressLookupEnabled || !addressLookupEndpoint || query.trim().length < 3) {
        renderAddressResults(localResults);
        return;
      }

      if (addressLookupController) {
        addressLookupController.abort();
      }

      addressLookupController = new AbortController();

      fetch(addressLookupEndpoint + encodeURIComponent(query.trim()), {
        method: 'GET',
        signal: addressLookupController.signal,
        headers: {
          Accept: 'application/json'
        }
      })
        .then(function(response) {
          if (!response.ok) {
            throw new Error('Address lookup failed');
          }

          return response.json();
        })
        .then(function(data) {
          var remoteResults = Array.isArray(data)
            ? data.map(mapLookupAddress)
            : [];

          renderAddressResults(remoteResults.length ? remoteResults : localResults);
        })
        .catch(function(error) {
          if (error.name === 'AbortError') {
          return;
        }

          renderAddressResults(localResults);
        });
    }

    if (manualAddressToggle) {
      manualAddressToggle.addEventListener('click', openManualAddress);
    }

    if (addressSearch) {
      function handleAddressInput() {
        var query = addressSearch.value.trim();
        var selectedAddress = addressSuggestions.find(function(address) {
          return normalizeAddressText(address.label) === normalizeAddressText(query);
        });

        window.clearTimeout(addressLookupTimer);

        if (selectedAddress) {
          fillAddress(selectedAddress);
          return;
        }

        if (query.length < 2) {
          closeAddressResults();
          return;
        }

        addressLookupTimer = window.setTimeout(function() {
          fetchAddressResults(query);
        }, 250);
      }

      addressSearch.addEventListener('input', handleAddressInput);
      addressSearch.addEventListener('focus', handleAddressInput);
    }

    function validatePasswords() {
      if (!password || !confirmPassword) {
        return;
      }

      confirmPassword.setCustomValidity(
        password.value && confirmPassword.value && password.value !== confirmPassword.value
          ? 'Passwords do not match.'
          : ''
      );
    }

    if (password && confirmPassword) {
      password.addEventListener('input', validatePasswords);
      confirmPassword.addEventListener('input', validatePasswords);
    }

    document.addEventListener('click', function(event) {
      if (addressResults && addressSearch && !addressResults.contains(event.target) && event.target !== addressSearch) {
        closeAddressResults();
      }
    });

    if (!form || !firstName || !lastName || !contactName) {
      return;
    }

    form.addEventListener('submit', function() {
      validatePasswords();
      contactName.value = [firstName.value, lastName.value].filter(Boolean).join(' ').trim();
    });
  })();
</script>

