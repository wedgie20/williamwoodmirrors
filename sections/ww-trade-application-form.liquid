{%- liquid
  assign profession_options = section.settings.profession_options | split: ','
  assign country_options = section.settings.country_options | split: ','
-%}

<section class="ww-trade-application" data-ww-trade-application>
  <div class="ww-trade-application__container">
    <header class="ww-trade-application__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ww-trade-application__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="ww-trade-application__intro">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    <div class="ww-trade-application__panel">
      {%- form 'contact', id: 'ww-trade-application-form', class: 'ww-trade-application__form' -%}
        <input type="hidden" name="contact[Form]" value="Trade application">
        <input type="hidden" name="contact[Trade application source]" value="{{ page.title | default: 'Trade application' | escape }}">
        <input type="hidden" id="trade-application-contact-name" name="contact[name]" value="">

        {%- if form.posted_successfully? -%}
          <div class="ww-trade-application__success" role="status" tabindex="-1">
            <h2>{{ section.settings.success_heading }}</h2>
            <div>{{ section.settings.success_text }}</div>
          </div>
        {%- else -%}
          {%- if form.errors -%}
            <div class="ww-trade-application__error" role="alert">
              {{- form.errors | default_errors -}}
            </div>
          {%- endif -%}

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.details_heading }}</h2>

            <div class="ww-trade-application__grid">
              <div class="ww-trade-application__field">
                <label for="trade-application-first-name">First name <span aria-hidden="true">*</span></label>
                <input id="trade-application-first-name" type="text" name="contact[First name]" autocomplete="given-name" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-last-name">Last name <span aria-hidden="true">*</span></label>
                <input id="trade-application-last-name" type="text" name="contact[Last name]" autocomplete="family-name" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-email">Email address <span aria-hidden="true">*</span></label>
                <input id="trade-application-email" type="email" name="contact[email]" autocomplete="email" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-phone">Phone number <span aria-hidden="true">*</span></label>
                <input id="trade-application-phone" type="tel" name="contact[Phone number]" autocomplete="tel" required>
              </div>
            </div>
          </div>

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.company_heading }}</h2>

            <div class="ww-trade-application__grid">
              <div class="ww-trade-application__field">
                <label for="trade-application-company">Company name <span aria-hidden="true">*</span></label>
                <input id="trade-application-company" type="text" name="contact[Company name]" autocomplete="organization" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-website">Website</label>
                <input id="trade-application-website" type="url" name="contact[Website]" inputmode="url" placeholder="https://">
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-profession">Profession / business type <span aria-hidden="true">*</span></label>
                <select id="trade-application-profession" name="contact[Profession or business type]" required>
                  <option value="" selected disabled>Please select</option>
                  {%- for option in profession_options -%}
                    {%- assign trimmed_option = option | strip -%}
                    {%- if trimmed_option != blank -%}
                      <option value="{{ trimmed_option | escape }}">{{ trimmed_option }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-company-number">Company registration number</label>
                <input id="trade-application-company-number" type="text" name="contact[Company registration number]">
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-vat">VAT number</label>
                <input id="trade-application-vat" type="text" name="contact[VAT number]">
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-instagram">Instagram / social profile</label>
                <input id="trade-application-instagram" type="text" name="contact[Instagram or social profile]">
              </div>
            </div>
          </div>

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.address_heading }}</h2>

            <div class="ww-trade-application__grid">
              <div class="ww-trade-application__field ww-trade-application__field--full">
                <label for="trade-application-address-1">Address line 1 <span aria-hidden="true">*</span></label>
                <input id="trade-application-address-1" type="text" name="contact[Address line 1]" autocomplete="address-line1" required>
              </div>

              <div class="ww-trade-application__field ww-trade-application__field--full">
                <label for="trade-application-address-2">Address line 2</label>
                <input id="trade-application-address-2" type="text" name="contact[Address line 2]" autocomplete="address-line2">
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-city">Town / city <span aria-hidden="true">*</span></label>
                <input id="trade-application-city" type="text" name="contact[Town or city]" autocomplete="address-level2" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-postcode">Postcode <span aria-hidden="true">*</span></label>
                <input id="trade-application-postcode" type="text" name="contact[Postcode]" autocomplete="postal-code" required>
              </div>

              <div class="ww-trade-application__field">
                <label for="trade-application-country">Country <span aria-hidden="true">*</span></label>
                <select id="trade-application-country" name="contact[Country]" autocomplete="country-name" required>
                  <option value="" selected disabled>Please select</option>
                  {%- for country in country_options -%}
                    {%- assign trimmed_country = country | strip -%}
                    {%- if trimmed_country != blank -%}
                      <option value="{{ trimmed_country | escape }}">{{ trimmed_country }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </div>
            </div>
          </div>

          <div class="ww-trade-application__fieldset">
            <h2>{{ section.settings.project_heading }}</h2>

            <div class="ww-trade-application__field">
              <label for="trade-application-body">Tell us about your business and projects <span aria-hidden="true">*</span></label>
              <textarea id="trade-application-body" name="contact[body]" rows="6" required></textarea>
            </div>

            <label class="ww-trade-application__check" for="trade-application-marketing">
              <input id="trade-application-marketing" type="checkbox" name="contact[Marketing opt in]" value="Yes">
              <span>{{ section.settings.marketing_label }}</span>
            </label>
          </div>

          <button type="submit" class="ww-trade-application__submit">
            {{ section.settings.submit_text }}
          </button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-application {
    --ww-trade-text-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-bold-weight: var(--text-font-bold-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    background: {{ section.settings.background_color }};
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.65;
    padding: 72px 0 96px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application *,
  #shopify-section-{{ section.id }} .ww-trade-application *::before,
  #shopify-section-{{ section.id }} .ww-trade-application *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__container {
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-gutter);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__header {
    max-width: 760px;
    margin-bottom: 42px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__eyebrow {
    margin: 0 0 14px;
    font-family: var(--ww-trade-text-font);
    font-size: 12px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.4;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-application h1 {
    margin: 0;
    font-family: var(--ww-trade-heading-font);
    font-size: 44px;
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.12;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__intro {
    max-width: 650px;
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__intro p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__panel {
    max-width: 980px;
    padding: clamp(28px, 4vw, 56px);
    background: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__fieldset + .ww-trade-application__fieldset {
    margin-top: 42px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application h2 {
    margin: 0 0 22px;
    font-family: var(--ww-trade-heading-font);
    font-size: 22px;
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 28px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field--full {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .ww-trade-application label {
    font-family: var(--ww-trade-text-font);
    font-size: 12px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .ww-trade-application label span {
    color: #a3403a;
  }

  #shopify-section-{{ section.id }} .ww-trade-application input:not([type="checkbox"]),
  #shopify-section-{{ section.id }} .ww-trade-application select,
  #shopify-section-{{ section.id }} .ww-trade-application textarea {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid #cfcfcf;
    border-radius: 0;
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 14px;
    line-height: 1.45;
    box-shadow: none;
    outline: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application textarea {
    min-height: 150px;
    padding-top: 16px;
    padding-bottom: 16px;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .ww-trade-application input:not([type="checkbox"]):focus,
  #shopify-section-{{ section.id }} .ww-trade-application select:focus,
  #shopify-section-{{ section.id }} .ww-trade-application textarea:focus {
    border-color: #000;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 700px;
    margin-top: 18px;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__check input {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 220px;
    min-height: 52px;
    margin-top: 42px;
    padding: 15px 32px;
    border: 1px solid #000;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-family: var(--ww-trade-text-font);
    font-size: 12px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1;
    letter-spacing: .03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__success,
  #shopify-section-{{ section.id }} .ww-trade-application__error {
    padding: 26px;
    border: 1px solid #000;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__success h2 {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__success p,
  #shopify-section-{{ section.id }} .ww-trade-application__error p,
  #shopify-section-{{ section.id }} .ww-trade-application__error ul {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-application {
      padding: 48px 0 68px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application,
    #shopify-section-{{ section.id }} .ww-trade-application p,
    #shopify-section-{{ section.id }} .ww-trade-application span,
    #shopify-section-{{ section.id }} .ww-trade-application a,
    #shopify-section-{{ section.id }} .ww-trade-application button,
    #shopify-section-{{ section.id }} .ww-trade-application input,
    #shopify-section-{{ section.id }} .ww-trade-application select,
    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      font-family: var(--ww-trade-text-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-application h1,
    #shopify-section-{{ section.id }} .ww-trade-application h2,
    #shopify-section-{{ section.id }} .ww-trade-application h3 {
      font-family: var(--ww-trade-heading-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-application h1 {
      font-size: 34px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__panel {
      padding: 28px 18px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__submit {
      width: 100%;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('#shopify-section-{{ section.id }} [data-ww-trade-application]');
    if (!section) {
      return;
    }

    var form = section.querySelector('#ww-trade-application-form');
    var firstName = section.querySelector('#trade-application-first-name');
    var lastName = section.querySelector('#trade-application-last-name');
    var contactName = section.querySelector('#trade-application-contact-name');

    if (!form || !firstName || !lastName || !contactName) {
      return;
    }

    form.addEventListener('submit', function() {
      contactName.value = [firstName.value, lastName.value].filter(Boolean).join(' ').trim();
    });
  })();
</script>

{% schema %}
{
  "name": "Trade application form",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f2f2f2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "William Wood Trade"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trade application"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro text",
      "default": "<p>Complete the form below and our trade team will review your application before coming back to you.</p>"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details heading",
      "default": "Your details"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Company heading",
      "default": "Company details"
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address heading",
      "default": "Address"
    },
    {
      "type": "text",
      "id": "project_heading",
      "label": "Project heading",
      "default": "Project details"
    },
    {
      "type": "textarea",
      "id": "profession_options",
      "label": "Profession options",
      "default": "Interior designer, Architect, Stylist, Hotelier, Property developer, Retailer, Procurement, Other"
    },
    {
      "type": "textarea",
      "id": "country_options",
      "label": "Country options",
      "default": "United Kingdom, Ireland, United States, France, Germany, Netherlands, Spain, Italy, Other"
    },
    {
      "type": "text",
      "id": "marketing_label",
      "label": "Marketing opt-in label",
      "default": "I would like to receive William Wood trade updates, collection previews and offers."
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit button text",
      "default": "Submit application"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "Trade account application created"
    },
    {
      "type": "richtext",
      "id": "success_text",
      "label": "Success text",
      "default": "<p>Thank you. Your trade account application has been created. Our team will review your details and come back to you later.</p>"
    }
  ],
  "presets": [
    {
      "name": "Trade application form"
    }
  ]
}
{% endschema %}
