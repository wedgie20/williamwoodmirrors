<section class="ww-trade-application" data-ww-trade-application>
  <div class="ww-trade-application__container">
    <header class="ww-trade-application__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ww-trade-application__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="ww-trade-application__intro">{{ section.settings.body }}</div>
      {%- endif -%}
    </header>

    <div class="ww-trade-application__panel">
      {%- if section.settings.details_heading != blank -%}
        <h2>{{ section.settings.details_heading }}</h2>
      {%- endif -%}

      <p class="ww-trade-application__signin">
        {{ section.settings.sign_in_text }}
        <a href="{{ routes.account_login_url }}">{{ section.settings.sign_in_link_text }}</a>
      </p>

      {%- comment -%}
        Submits via the Hulk form app (form id Az-QKwOpUDJom6HimmxUTQ) instead of Shopify's
        native {% form 'contact' %}, so this form's notification recipient can be set
        independently (inside the Hulk app) without touching the site-wide Contact form
        notification email that other {% form 'contact' %} instances (e.g. /pages/contact-us)
        still rely on. Field list, validation and the success state are all controlled inside
        the Hulk app, not here - this section only mounts the widget and restyles whatever
        it renders to match the page's existing look.
      {%- endcomment -%}
      <div class="ww-trade-application__hulk" data-ww-trade-application-hulk>
        <div class="pxFormGenerator" id="Az-QKwOpUDJom6HimmxUTQ"></div>
      </div>

      {%- if section.settings.terms_text != blank -%}
        <div class="ww-trade-application__terms">
          {{ section.settings.terms_text }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-application {
    --ww-trade-text-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-bold-weight: var(--text-font-bold-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    --ww-trade-field-gap: 14px;
    --ww-trade-field-radius: 999px;
    background: #efefef;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.65;
    padding: 70px 0 100px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application *,
  #shopify-section-{{ section.id }} .ww-trade-application *::before,
  #shopify-section-{{ section.id }} .ww-trade-application *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__container {
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-gutter);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__header {
    max-width: 760px;
    margin: 0 auto 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__eyebrow {
    margin: 0 0 14px;
    font-family: var(--ww-trade-text-font);
    font-size: 12px;
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.4;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-application h1 {
    margin: 0;
    font-family: var(--ww-trade-heading-font);
    font-size: 42px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__intro {
    max-width: 660px;
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__intro p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__panel {
    max-width: 760px;
    margin: 0 auto;
    padding: 0;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .ww-trade-application h2 {
    margin: 0 0 20px;
    font-family: var(--ww-trade-heading-font);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__signin {
    margin: -4px 0 28px;
    font-size: 16px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__signin a {
    color: inherit;
    font-weight: var(--ww-trade-bold-weight);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field {
    position: relative;
    display: block;
    margin-top: var(--ww-trade-field-gap);
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field:first-child {
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field > label {
    position: absolute;
    top: 50%;
    left: 16px;
    z-index: 2;
    max-width: calc(100% - 32px);
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.2;
    pointer-events: none;
    transform: translateY(-50%);
    transition: top .16s ease, font-size .16s ease, transform .16s ease;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field > label span {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]),
  #shopify-section-{{ section.id }} .ww-trade-application select,
  #shopify-section-{{ section.id }} .ww-trade-application textarea {
    width: 100%;
    min-height: 48px;
    padding: 17px 16px 6px;
    border: 1px solid #bdbdbd;
    border-radius: var(--ww-trade-field-radius);
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.35;
    box-shadow: none;
    outline: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, #000 50%), linear-gradient(135deg, #000 50%, transparent 50%);
    background-position: calc(100% - 24px) 50%, calc(100% - 16px) 50%;
    background-size: 8px 8px, 8px 8px;
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .ww-trade-application textarea {
    min-height: 86px;
    padding-top: 22px;
    padding-bottom: 10px;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .ww-trade-application input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]):focus,
  #shopify-section-{{ section.id }} .ww-trade-application select:focus,
  #shopify-section-{{ section.id }} .ww-trade-application textarea:focus {
    border-color: #000;
    border-width: 2px;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__field:focus-within > label,
  #shopify-section-{{ section.id }} .ww-trade-application__field:has(input:-webkit-autofill) > label,
  #shopify-section-{{ section.id }} .ww-trade-application__field.ww-field-focused > label,
  #shopify-section-{{ section.id }} .ww-trade-application__field.ww-field-filled > label {
    top: -6px;
    left: 14px;
    padding: 0 4px;
    background: #efefef;
    font-size: 10px;
    transform: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk form,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk .pxFormGenerator,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk iframe {
    width: 100%;
  }

  {%- comment -%}
    Hulk renders its own form chrome (card border/shadow/background, title, description) -
    this page already has its own heading and intro text above, and its own pill/floating-
    label field styling below, so Hulk's own chrome is neutralised rather than duplicated.
    Selectors are broad/defensive (class-contains matches) because Hulk's exact DOM and
    class names aren't visible from theme code - confirm against the live render and adjust.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ww-trade-application__hulk form,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk .form-wrapper,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk .form-container,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk .hulk-form,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="form-wrapper"],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="form-container"] {
    max-width: 100% !important;
    margin-inline: auto !important;
    padding: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="title"],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="description"] {
    display: none !important;
  }

  {%- comment -%}
    Hulk renders a static <label> above each field rather than placing it inside the pill
    (confirmed against the live page - a DOM-walking relocation attempt didn't change that).
    Hiding the label outright and relying on the native placeholder instead matches the
    target single-line pill look without depending on Hulk's internal structure at all.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ww-trade-application__hulk label {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="file"]),
  #shopify-section-{{ section.id }} .ww-trade-application__hulk select,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk textarea {
    width: 100% !important;
    min-height: 48px !important;
    padding: 0 20px !important;
    border: 1px solid #bdbdbd !important;
    border-radius: var(--ww-trade-field-radius) !important;
    background: #fff !important;
    color: #000 !important;
    font-family: var(--ww-trade-text-font) !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    line-height: 1.35 !important;
    box-shadow: none !important;
    outline: 0 !important;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk input::placeholder,
  #shopify-section-{{ section.id }} .ww-trade-application__hulk textarea::placeholder {
    color: #000 !important;
    opacity: 1 !important;
    font-family: var(--ww-trade-text-font) !important;
    font-size: 13px !important;
    font-weight: 400 !important;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk textarea {
    min-height: 86px !important;
    padding-top: 20px !important;
    padding-bottom: 20px !important;
    resize: vertical;
  }

  {%- comment -%}
    Hulk's field rows render as a responsive grid that goes two-up at this panel's width
    (760px) even though the target design is single column. Selectors are a defensive guess
    at common row/grid wrapper naming (confirm against the live render and adjust the class
    patterns if a row still sits side-by-side).
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="row" i],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="grid" i],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="column" i],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="fields-wrapper" i] {
    display: block !important;
    grid-template-columns: none !important;
    width: 100% !important;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="field" i],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk [class*="field" i] > * {
    width: 100% !important;
    max-width: 100% !important;
    flex: 1 1 100% !important;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__hulk button[type="submit"],
  #shopify-section-{{ section.id }} .ww-trade-application__hulk input[type="submit"] {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: auto !important;
    min-width: 220px;
    min-height: 52px !important;
    margin-top: 44px !important;
    padding: 15px 32px !important;
    border: 1px solid #000 !important;
    border-radius: 999px !important;
    background: #000 !important;
    color: #fff !important;
    font-family: var(--ww-trade-text-font) !important;
    font-size: 12px !important;
    font-weight: var(--ww-trade-bold-weight) !important;
    line-height: 1 !important;
    letter-spacing: .03em !important;
    text-transform: uppercase !important;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__terms {
    max-width: 760px;
    margin-top: 22px;
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__terms p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-application__terms a,
  #shopify-section-{{ section.id }} .ww-trade-application__terms strong {
    color: inherit;
    font-weight: var(--ww-trade-bold-weight);
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-application {
      padding: 48px 0 68px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application,
    #shopify-section-{{ section.id }} .ww-trade-application p,
    #shopify-section-{{ section.id }} .ww-trade-application span,
    #shopify-section-{{ section.id }} .ww-trade-application a,
    #shopify-section-{{ section.id }} .ww-trade-application button,
    #shopify-section-{{ section.id }} .ww-trade-application input,
    #shopify-section-{{ section.id }} .ww-trade-application select,
    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      font-family: var(--ww-trade-text-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-application h1,
    #shopify-section-{{ section.id }} .ww-trade-application h2,
    #shopify-section-{{ section.id }} .ww-trade-application h3 {
      font-family: var(--ww-trade-heading-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-application h1 {
      font-size: 34px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__intro,
    #shopify-section-{{ section.id }} .ww-trade-application__signin {
      font-size: 14px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application h2 {
      font-size: 26px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__field > label {
      left: 14px;
      font-size: 13px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application input:not([type="hidden"]):not([type="checkbox"]):not([type="file"]),
    #shopify-section-{{ section.id }} .ww-trade-application select,
    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      min-height: 46px;
      padding: 16px 14px 6px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application textarea {
      min-height: 78px;
      padding-top: 21px;
      padding-bottom: 10px;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__hulk input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]):not([type="reset"]):not([type="file"]),
    #shopify-section-{{ section.id }} .ww-trade-application__hulk select,
    #shopify-section-{{ section.id }} .ww-trade-application__hulk textarea {
      min-height: 46px !important;
      padding: 0 14px !important;
      font-size: 12px !important;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__hulk input::placeholder,
    #shopify-section-{{ section.id }} .ww-trade-application__hulk textarea::placeholder {
      font-size: 12px !important;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__hulk textarea {
      min-height: 78px !important;
      padding-top: 18px !important;
      padding-bottom: 18px !important;
    }

    #shopify-section-{{ section.id }} .ww-trade-application__hulk button[type="submit"],
    #shopify-section-{{ section.id }} .ww-trade-application__hulk input[type="submit"] {
      width: 100% !important;
    }
  }
</style>

{%- comment -%}
  Deliberately not walking Hulk's DOM to relocate labels onto the inputs (that was tried
  and didn't match Hulk's real markup - labels still rendered as static text above the
  field instead of floating inside it). Styling below hides native labels outright and
  restyles the native placeholder text instead, which works regardless of Hulk's actual
  DOM structure since it only relies on the HTML placeholder attribute, not guessed class
  names - far more robust than DOM-walking against an unknown third-party widget.
{%- endcomment -%}
<script>
  (function() {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-ww-trade-application-hulk]');
    if (!root) {
      return;
    }

    function renderHulkForm() {
      var formMount = root.querySelector('.pxFormGenerator[id]');
      if (!formMount) {
        return;
      }

      if (typeof window.shouldLoadPopup === 'function') {
        window.shouldLoadPopup(formMount.id);
      } else if (typeof window.RenderFormById === 'function') {
        window.RenderFormById(formMount.id);
      }
    }

    renderHulkForm();

    var attempts = 0;
    var renderTimer = setInterval(function() {
      attempts += 1;
      renderHulkForm();

      if (root.querySelector('form, iframe') || attempts >= 20) {
        clearInterval(renderTimer);
      }
    }, 250);
  })();
</script>

{% schema %}
{
  "name": "Trade application form",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "William Wood Trade"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trade application"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro text",
      "default": "<p>Complete the form below and our trade team will review your application before coming back to you.</p>"
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details heading",
      "default": "Your details"
    },
    {
      "type": "text",
      "id": "sign_in_text",
      "label": "Sign in text",
      "default": "Purchased with us before?"
    },
    {
      "type": "text",
      "id": "sign_in_link_text",
      "label": "Sign in link text",
      "default": "Sign In"
    },
    {
      "type": "richtext",
      "id": "terms_text",
      "label": "Terms text",
      "default": "<p>By creating our account you agree to our <strong>Terms &amp; Conditions</strong> and <strong>Privacy Policy</strong></p>"
    }
  ],
  "presets": [
    {
      "name": "Trade application form"
    }
  ]
}
{% endschema %}
