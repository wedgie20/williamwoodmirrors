<section class="hero-section">
  <div class="hero-section__image-wrapper">
    {%- if section.settings.background_image_desktop != blank -%}
      <img 
        class="hero-section__image hero-section__image--desktop" 
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.background_image_desktop | image_url: width: 2400 }}" 
        alt="{{ section.settings.title | escape }}"
        loading="eager"
        width="{{ section.settings.background_image_desktop.width }}"
        height="{{ section.settings.background_image_desktop.height }}"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-section__image hero-section__image--desktop' }}
    {%- endif -%}

    {%- if section.settings.background_image_mobile != blank -%}
      <img 
        class="hero-section__image hero-section__image--mobile" 
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.background_image_mobile | image_url: width: 1000 }}" 
        alt="{{ section.settings.title | escape }}"
        loading="eager"
        width="{{ section.settings.background_image_mobile.width }}"
        height="{{ section.settings.background_image_mobile.height }}"
      >
    {%- elsif section.settings.background_image_desktop != blank -%}
      <img 
        class="hero-section__image hero-section__image--mobile" 
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.background_image_desktop | image_url: width: 1000 }}" 
        alt="{{ section.settings.title | escape }}"
        loading="eager"
      >
    {%- endif -%}

    <div class="hero-section__overlay"></div>

    <div class="hero-section__content container">
      <div class="hero-section__text-wrapper">
        
<div class="titleplussubtitle">
  {%- if section.settings.subtitle != blank -%}
          <p class="hero-section__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <p class="mini-sub-hero" style="margin-bottom: 0px;">New Year Neew Style</p>
         <p class="mini-sub-hero"  style="">Better Value When You Bundle</p>
        {%- if section.settings.title != blank -%}
          <h1 class="hero-section__title">{{ section.settings.title }}</h1>
            <p class="mini-sub-hero"  style="margin-bottom: 0px;">2 Full-Priced Products </p>Or
             <h1 class="hero-section__title">40% OFF</h1>
              <p class="mini-sub-hero"  style="">3 Or More Full-Priced Products </p>
           {% comment %} <p class="mini-sub-hero-thin">EVERYTHING</p> {% endcomment %}
        {%- endif -%}
        <p class="mini-sub-hero-v2"><b>Limited-Time-Only</b></p>
</div>

        {%- assign has_bullet_points = false -%}
        {%- if section.settings.bullet_point_1 != blank or section.settings.bullet_point_2 != blank or section.settings.bullet_point_3 != blank or section.settings.bullet_point_4 != blank or section.settings.bullet_point_5 != blank -%}
          {%- assign has_bullet_points = true -%}
        {%- endif -%}

        {%- if has_bullet_points -%}
          <ul class="hero-section__bullet-points">
            {%- if section.settings.bullet_point_1 != blank -%}
              <li class="hero-section__bullet-item">
                <svg class="hero-section__bullet-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  <polyline points="18 2 7 13 2 8"></polyline>
</svg>
                <span>{{ section.settings.bullet_point_1 }}</span>
              </li>
            {%- endif -%}

            {%- if section.settings.bullet_point_2 != blank -%}
              <li class="hero-section__bullet-item">
                <svg class="hero-section__bullet-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  <polyline points="18 2 7 13 2 8"></polyline>
</svg>
                <span>{{ section.settings.bullet_point_2 }}</span>
              </li>
            {%- endif -%}

            {%- if section.settings.bullet_point_3 != blank -%}
              <li class="hero-section__bullet-item">
                <svg class="hero-section__bullet-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  <polyline points="18 2 7 13 2 8"></polyline>
</svg>
                <span>{{ section.settings.bullet_point_3 }}</span>
              </li>
            {%- endif -%}

            {%- if section.settings.bullet_point_4 != blank -%}
              <li class="hero-section__bullet-item">
               <svg class="hero-section__bullet-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  <polyline points="18 2 7 13 2 8"></polyline>
</svg>
                <span>{{ section.settings.bullet_point_4 }}</span>
              </li>
            {%- endif -%}

            {%- if section.settings.bullet_point_5 != blank -%}
              <li class="hero-section__bullet-item">
                <svg class="hero-section__bullet-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
  <polyline points="18 2 7 13 2 8"></polyline>
</svg>
                <span>{{ section.settings.bullet_point_5 }}</span>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="hero-section__button">
            {{ section.settings.button_text }}
          </a>

          <a href="{{ section.settings.button_link }}" class="justfroormobile shop-now-summer" style="display: block;
    overflow: hidden;
    min-height: 70px;">
    <button class="button button--primary slideshow_txt clearance-text" style="display: inline-flex; align-items: center; justify-content: center; transform: translateY(10px);
        width: 206px;
    height: 49px !important;
    gap: 10px;
    opacity: 1;
    border-radius: 1000px;
    padding-top: 16px;
    padding-right: 24px;
    padding-bottom: 16px;
    padding-left: 24px;">
      <span class="button_1_text" style="white-space: nowrap; width: 100%;font-family: Zurich, sans-serif;
    font-size: 10px;
    font-weight: 700;
    line-height: 100%;
    letter-spacing: 0;">{{ section.settings.button_text }}</span>
    </button>
  </a>

        {%- endif -%}

        {%- if section.settings.review_first_line != blank or section.settings.review_second_line != blank -%}
          <div class="hero-section__review">
            <div class="review_inner_part">
            {%- if section.settings.review_first_line != blank -%}
              <span>{{ section.settings.review_first_line }}</span>
            {%- endif -%}
            </div>
            
            <div class="review_second_line">
                  {%- if section.settings.review_icon != blank -%}
              <img 
                class="hero-section__review-icon" 
                src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.review_icon | image_url: width: 200 }}" 
                alt="Review icon"
              >
            {%- endif -%}
            {%- if section.settings.review_second_line != blank -%}
              <span>{{ section.settings.review_second_line }}</span>
            {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "class": "shopify-section--hero",
  "settings": [
    {
      "type": "header",
      "content": "Background Images"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "Desktop Background Image",
      "info": "Recommended: 2400 x 800px .jpg"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile Background Image",
      "info": "Recommended: 750 x 1000px .jpg. Falls back to desktop if empty."
    },
    {
      "type": "header",
      "content": "Review Section"
    },
    {
      "type": "text",
      "id": "review_first_line",
      "label": "Review First Line",
      "default": "Join 700,000+ Satisfied Customers"
    },
    {
      "type": "image_picker",
      "id": "review_icon",
      "label": "Review Icon/Stars"
    },
    {
      "type": "range",
      "id": "review_icon_width",
      "label": "Review Icon Width",
      "min": 50,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "text",
      "id": "review_second_line",
      "label": "Review Second Line",
      "default": "4.7 / 5 Excellent | 10,000+ Reviews"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "We Help You Feel More Proud Of Your Home, Without Worrying About Quality."
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title Size (Desktop)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title Size (Mobile)",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Extra Bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Title Letter Spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join 700,000+ Satisfied Customers already feeling instantly more proud of their homes, backed by our 90-Day Money Back Guarantee & 5 Year Warranty."
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "label": "Subtitle Size (Desktop)",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Subtitle Size (Mobile)",
      "min": 12,
