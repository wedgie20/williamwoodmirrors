

<style>
@font-face {
    font-family: 'GothamBook';
    src: url('https://cdn.shopify.com/s/files/1/0780/3843/files/Gotham-Book.eot?v=1664357984');
    src: url('https://cdn.shopify.com/s/files/1/0780/3843/files/Gotham-Book.eot?v=1664357984?#iefix') format('embedded-opentype'),
    url('https://cdn.shopify.com/s/files/1/0780/3843/files/Gotham-Book.woff2?v=1664357984') format('woff2'),
    url('https://cdn.shopify.com/s/files/1/0780/3843/files/Gotham-Book.woff?v=1664357984') format('woff'),
    url('https://cdn.shopify.com/s/files/1/0780/3843/files/Gotham-Book.ttf?v=1664357984') format('truetype');
    font-weight: 500;
    font-style: normal;
}
  #shopify-section-{{ section.id }} {
    position: relative;
    overflow: hidden;
  }

  .hero-section {
    position: relative;
    width: 100%;
    min-height: 400px;
  }

  .hero-section__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
        min-height: 90vh;
    object-position: right;
  }

  .hero-section__image--mobile {
    display: none;
  }

  .hero-section__content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.vertical_alignment_desktop }};
    align-items: {{ section.settings.horizontal_alignment_desktop }};
    padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_right_desktop }}px {{ section.settings.padding_bottom_desktop }}px {{ section.settings.padding_left_desktop }}px;
    text-align: {{ section.settings.text_alignment_desktop }};
    color: {{ section.settings.text_color }};
    z-index: 2;
  }

  .hero-section__text-wrapper {
    max-width: {{ section.settings.content_max_width }}px;
    width: 100%;
  }

  .review_second_line {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 0px;
    font-size: 12px;
    justify-content: flex-start;
    font-family: 'GothamBook';
}

  .hero-section__review {
    display: flex;
    align-items: center;
    gap: 0px;
    margin-bottom: 16px;
    font-size: 14px;
        flex-direction: column;
    {% if section.settings.text_alignment_desktop == 'center' %}
      justify-content: center;
    {% elsif section.settings.text_alignment_desktop == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
        order: 6;
    margin-top: 20px;
  }

  .hero-section__review-icon {
    width: {{ section.settings.review_icon_width }}px;
    height: auto;
  }

  .hero-section__title {
    font-size: {{ section.settings.title_size_desktop }}px;
    font-weight: {{ section.settings.title_weight }};
    font-family: 'GothamBlack';
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
  }

  .hero-section__subtitle {
    font-size: {{ section.settings.subtitle_size_desktop }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    line-height: 1.4;
    margin: 0 0 0 0;
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
  }

  .hero-section__bullet-points {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hero-section__bullet-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: {{ section.settings.bullet_size_desktop }}px;
    {% if section.settings.text_alignment_desktop == 'center' %}
      justify-content: center;
    {% elsif section.settings.text_alignment_desktop == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .hero-section__bullet-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .hero-section__text-wrapper div#trustpilot-widget-trustbox-0-wrapper {
    display: none !important;
}

  .hero-section__button {
    display: inline-block;
    padding: {{ section.settings.button_padding_top }}px {{ section.settings.button_padding_horizontal }}px {{ section.settings.button_padding_bottom }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_size_desktop }}px;
    font-weight: {{ section.settings.button_weight }};
    transition: opacity 0.3s ease;
    border: none;
    cursor: pointer;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
        min-width: 250px;
    text-align: center;
  }

  .hero-section__button:hover {
    opacity: 0.85;
  }

  .titleplussubtitle {
    {% comment %} display: flex; {% endcomment %}
    place-items: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    place-content: center;
}

h1.hero-section__title {
    margin: unset;
}

p.hero-section__subtitle{
    font-family: altesse-std-24pt;
    font-size: 64px;
    font-weight: 400;
    line-height: 1.2;
}

 .hero-section__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }
  .mini-sub-hero-thin {
    font-weight: 100;
    letter-spacing: 2px;
    margin-top: 0 !important;
     font-family: 'GothamBook';
  }

  .mini-sub-hero {
        font-weight: lighter;
        font-family: 'GothamBook';
    }

    .mini-sub-hero-v2 {
      font-family: 'GothamBook';
    }

    @media screen and (min-width: 741px) {
    p.hero-section__subtitle{
        margin-top: -8px;
    }
      .mini-sub-hero {
        font-size: 20px;
         margin-top: 0 !important;
      }

      .mini-sub-hero-thin {
        font-size: 15px;
      }
      .mini-sub-hero-v2 {
      font-size: 12px;
    }
    }

  @media screen and (max-width: 740px) {
    .hero-section__image--desktop {
      display: none;
    }

    .mini-sub-hero-thin {
        font-size: 13px;
      }

    .mini-sub-hero {
        font-size: 14px;
         margin-top: 0 !important;
      }

    .hero-section__image--mobile {
      display: block;
    }

    .hero-section__content {
      justify-content: {{ section.settings.vertical_alignment_mobile }};
      align-items: {{ section.settings.horizontal_alignment_mobile }};
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_right_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_left_mobile }}px;
      text-align: {{ section.settings.text_alignment_mobile }};
    }

    .hero-section__review {
      {% if section.settings.text_alignment_mobile == 'center' %}
        justify-content: center;
      {% elsif section.settings.text_alignment_mobile == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .hero-section__title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }

    .hero-section__subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
      font-weight: 600;
    }

    .hero-section__bullet-item {
      font-size: {{ section.settings.bullet_size_mobile }}px;
      {% if section.settings.text_alignment_mobile == 'center' %}
        justify-content: center;
      {% elsif section.settings.text_alignment_mobile == 'right' %}
        justify-content: flex-end;
      {% else %}
        justify-content: flex-start;
      {% endif %}
    }

    .hero-section__button {
      font-size: {{ section.settings.button_size_mobile }}px;
      min-width: 250px;
        max-width: 300px;
        margin: 0 auto;
    }
    p.hero-section__subtitle {
    font-size: 52px;
    }
  }

  .justfroormobile{
  display: none !important;
  }

  @media screen and (max-width: 740px) {
    .hero-section__image--desktop {
      display: none;
    }
    .mini-sub-hero-v2 {
      font-size: 10px;
    }
     .justfroormobile{
  display: block !important;
  }

      .justfroormobile .button--primary{
  display: block;
   background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
  }

  .hero-section__button{
  display: none !important;
  }

    .hero-section__bullet-points {
      font-weight: 100 !important;
    }

    .review_second_line span {
    font-size: 10px;
    }

    .hero-section__review-icon {
      width: 65px !important;
    }

    .hero-section__image--mobile {
      display: block;
    }

