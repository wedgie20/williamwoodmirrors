<!-- TrustBox script -->
<script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
<!-- End TrustBox script -->

<style>
  .trustpilot-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<section class="trustpilot-section-{{ section.id }} container">
  <!-- TrustBox widget - Carousel -->
  <div
    class="trustpilot-widget"
    data-locale="en-GB"
    data-template-id="53aa8912dec7e10d38f59f36"
    data-businessunit-id="5c1ad659b7fbfa000156daec"
    data-style-height="140px"
    data-style-width="100%"
    data-theme="light"
    data-stars="4,5"
    data-review-languages="en"
  >
    <a href="https://uk.trustpilot.com/review/www.williamwoodmirrors.co.uk" target="_blank" rel="noopener"
      >Trustpilot</a
    >
  </div>
  <!-- End TrustBox widget -->
</section>

{% schema %}
{
  "name": "Trustpilot carousel",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding-top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding-bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Trustpilot carousel"
    }
  ]
}
{% endschema %}
