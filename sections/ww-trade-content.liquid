{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
-%}

<section class="ww-trade-content" data-ww-trade-content>
  {%- if section.settings.intro_heading != blank or section.settings.intro_body != blank -%}
    <section class="ww-trade-content__section ww-trade-content__intro">
      <div class="ww-trade-content__container ww-trade-content__container--narrow">
        {%- if section.settings.intro_eyebrow != blank -%}
          <p class="ww-trade-content__eyebrow">{{ section.settings.intro_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.intro_heading != blank -%}
          <h2>{{ section.settings.intro_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro_body != blank -%}
          <div class="ww-trade-content__rte">{{ section.settings.intro_body }}</div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.split1_heading != blank or section.settings.split1_image != blank -%}
    <section class="ww-trade-content__split">
      <div class="ww-trade-content__split-media">
        {%- if section.settings.split1_image != blank -%}
          <img
            src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.split1_image | image_url: width: 1600 }}"
            alt="{{ section.settings.split1_heading | escape }}"
            loading="lazy"
            width="{{ section.settings.split1_image.width }}"
            height="{{ section.settings.split1_image.height }}">
        {%- endif -%}
      </div>
      <div class="ww-trade-content__split-copy">
        {%- if section.settings.split1_eyebrow != blank -%}
          <p class="ww-trade-content__eyebrow">{{ section.settings.split1_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.split1_heading != blank -%}
          <h2>{{ section.settings.split1_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.split1_body != blank -%}
          <div class="ww-trade-content__rte">{{ section.settings.split1_body }}</div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.split2_heading != blank or section.settings.split2_image != blank -%}
    <section class="ww-trade-content__split ww-trade-content__split--reverse">
      <div class="ww-trade-content__split-media">
        {%- if section.settings.split2_image != blank -%}
          <img
            src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.split2_image | image_url: width: 1600 }}"
            alt="{{ section.settings.split2_heading | escape }}"
            loading="lazy"
            width="{{ section.settings.split2_image.width }}"
            height="{{ section.settings.split2_image.height }}">
        {%- endif -%}
      </div>
      <div class="ww-trade-content__split-copy">
        {%- if section.settings.split2_eyebrow != blank -%}
          <p class="ww-trade-content__eyebrow">{{ section.settings.split2_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.split2_heading != blank -%}
          <h2>{{ section.settings.split2_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.split2_body != blank -%}
          <div class="ww-trade-content__rte">{{ section.settings.split2_body }}</div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if step_blocks.size > 0 -%}
    <section class="ww-trade-content__section ww-trade-content__steps">
      <div class="ww-trade-content__container">
        <div class="ww-trade-content__section-heading">
          {%- if section.settings.steps_eyebrow != blank -%}
            <p class="ww-trade-content__eyebrow">{{ section.settings.steps_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.steps_heading != blank -%}
            <h2>{{ section.settings.steps_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.steps_body != blank -%}
            <div class="ww-trade-content__rte">{{ section.settings.steps_body }}</div>
          {%- endif -%}
        </div>

        <div class="ww-trade-content__step-grid">
          {%- for block in step_blocks -%}
            <article class="ww-trade-content__step" {{ block.shopify_attributes }}>
              <span>{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="ww-trade-content__rte ww-trade-content__rte--small">{{ block.settings.body }}</div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_form -%}
    <section id="trade-apply" class="ww-trade-content__section ww-trade-content__form-section">
      <div class="ww-trade-content__container ww-trade-content__form-grid">
        <div class="ww-trade-content__form-copy">
          {%- if section.settings.form_eyebrow != blank -%}
            <p class="ww-trade-content__eyebrow">{{ section.settings.form_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.form_heading != blank -%}
            <h2>{{ section.settings.form_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.form_body != blank -%}
            <div class="ww-trade-content__rte">{{ section.settings.form_body }}</div>
          {%- endif -%}
        </div>
        <div class="ww-trade-content__form-panel">
          {% render 'ww-trade-hulk-form' %}
        </div>
      </div>
    </section>
  {%- endif -%}

</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-content {
    --ww-trade-text-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-bold-weight: var(--text-font-bold-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .ww-trade-content * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__container {
    {% comment %} width: min(100%, 1320px); {% endcomment %}
    margin: 0 auto;
    padding: 0 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__container--narrow {
    max-width: 920px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__section {
    padding: 96px 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-content h2,
  #shopify-section-{{ section.id }} .ww-trade-content h3 {
    margin: 0;
    color: inherit;
    font-family: var(--ww-trade-heading-font);
    font-weight: var(--ww-trade-heading-weight);
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-content h2 {
    font-size: var(--heading-h2-font-size, 54px);
    line-height: 1.1333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-content h3 {
    font-size: var(--heading-h3-font-size, 24px);
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__eyebrow {
    margin: 0 0 18px;
    font-family: var(--ww-trade-text-font);
    font-size: calc(var(--ww-trade-body-size) - 3px);
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__rte {
    color: #111;
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__rte--small {
    font-size: calc(var(--ww-trade-body-size) - 1px);
    line-height: 1.7142857143;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__rte p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__rte p + p {
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__intro {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__intro .ww-trade-content__rte,
  #shopify-section-{{ section.id }} .ww-trade-content__section-heading .ww-trade-content__rte {
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 640px;
    border-top: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__split--reverse .ww-trade-content__split-media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__split-media {
    min-height: 520px;
    background: #f3f3f3;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__split-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__split-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 88px clamp(32px, 6vw, 110px);
  }

  #shopify-section-{{ section.id }} .ww-trade-content__split-copy .ww-trade-content__rte {
    max-width: 560px;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__section-heading {
    max-width: 720px;
    margin-bottom: 52px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__step-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__step {
    border: 1px solid #d9d9d9;
    padding: 32px;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__step span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-bottom: 28px;
    border: 1px solid #000;
    border-radius: 50%;
    font-family: var(--ww-trade-text-font);
    font-size: calc(var(--ww-trade-body-size) - 2px);
    font-weight: var(--ww-trade-bold-weight);
  }

  #shopify-section-{{ section.id }} .ww-trade-content__step .ww-trade-content__rte {
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__form-section {
    background: #f5f5f5;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__form-grid {
    display: grid;
    grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__form-copy {
    position: sticky;
    top: 120px;
  }

  #shopify-section-{{ section.id }} .ww-trade-content__form-copy .ww-trade-content__rte {
    margin-top: 22px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ww-trade-content__container {
      padding: 0 28px;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__section {
      padding: 72px 0;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__split,
    #shopify-section-{{ section.id }} .ww-trade-content__form-grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__split--reverse .ww-trade-content__split-media {
      order: 0;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__split-copy {
      padding: 56px 28px;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__step-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .ww-trade-content__form-copy {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-content,
    #shopify-section-{{ section.id }} .ww-trade-content p,
    #shopify-section-{{ section.id }} .ww-trade-content span,
    #shopify-section-{{ section.id }} .ww-trade-content a,
    #shopify-section-{{ section.id }} .ww-trade-content button {
      font-family: var(--ww-trade-text-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-content h1,
    #shopify-section-{{ section.id }} .ww-trade-content h2,
    #shopify-section-{{ section.id }} .ww-trade-content h3 {
      font-family: var(--ww-trade-heading-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-content__container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__section {
      padding: 56px 0;
    }

    #shopify-section-{{ section.id }} .ww-trade-content h2 {
      font-size: var(--heading-h2-font-size, 32px);
    }

    #shopify-section-{{ section.id }} .ww-trade-content__rte {
      font-size: calc(var(--ww-trade-body-size) - 1px);
      line-height: 1.7142857143;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__split-media {
      min-height: 360px;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__step-grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .ww-trade-content__step {
      padding: 26px 22px;
    }
  }
</style>

{% schema %}
{
  "name": "Trade content",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "intro_eyebrow",
      "label": "Eyebrow",
      "default": "Designed for professionals"
