    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Eyebrow",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading",
      "default": "Trade application form"
    },
    {
      "type": "richtext",
      "id": "form_body",
      "label": "Text",
      "default": "<p>Tell us a little about your business and the projects you work on. Our team will respond as soon as possible.</p>"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Apply"
        },
        {
          "type": "richtext",
          "id": "body",
