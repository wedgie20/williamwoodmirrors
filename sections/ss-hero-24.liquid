{% if layout_mode == 'slideshow' %}
<script>
  (function() {
    var container = document.querySelector('.section-{{ section.id }}');
    if (!container) return;

    var slides = container.querySelectorAll('.hero-slide-{{ section.id }}');
    var dots = container.querySelectorAll('.hero-slider-dot-{{ section.id }}');
    var contentPanels = container.querySelectorAll('.hero-slide-content-{{ section.id }}');
    var shopScenePanels = container.querySelectorAll('[data-shop-scene-slide-wrap^="{{ section.id }}-"]');
    var prevBtn = container.querySelector('.hero-slider-arrow-prev-{{ section.id }}');
    var nextBtn = container.querySelector('.hero-slider-arrow-next-{{ section.id }}');
    var current = 0;
    var total = slides.length;
    var autoplay = {{ slider_autoplay | default: true }};
    var speed = ({{ slider_speed | default: 5 }}) * 1000;
    var timer = null;

    if (total <= 1) return;

    function setActiveShopScene(slideIndex) {
      if (!shopScenePanels.length) return;
      var targetKey = '{{ section.id }}-' + (slideIndex + 1);
      shopScenePanels.forEach(function(el) {
        if (el.getAttribute('data-shop-scene-slide-wrap') === targetKey) {
          el.classList.add('is-active-slide');
        } else {
          el.classList.remove('is-active-slide');
        }
      });
    }

    function playActiveSlideVideos(slide) {
      if (!slide) return;
      var vids = slide.querySelectorAll('video');
      vids.forEach(function(v) {
        try {
          v.muted = true;
          var p = v.play();
          if (p && typeof p.catch === 'function') { p.catch(function(){}); }
        } catch (e) {}
      });
    }

    function pauseInactiveSlideVideos(slide) {
      if (!slide) return;
      var vids = slide.querySelectorAll('video');
      vids.forEach(function(v) { try { v.pause(); } catch (e) {} });
    }

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      slides[current].classList.remove('is-active');
      pauseInactiveSlideVideos(slides[current]);
      if (dots[current]) dots[current].classList.remove('is-active');
      if (contentPanels[current]) contentPanels[current].classList.remove('is-active');
      current = index;
      slides[current].classList.add('is-active');
      playActiveSlideVideos(slides[current]);
      if (dots[current]) dots[current].classList.add('is-active');
      if (contentPanels[current]) contentPanels[current].classList.add('is-active');
      setActiveShopScene(current);
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAutoplay() {
      if (!autoplay) return;
      stopAutoplay();
      timer = setInterval(next, speed);
    }

    function stopAutoplay() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    if (prevBtn) prevBtn.addEventListener('click', function() { prev(); startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', function() { next(); startAutoplay(); });

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        goTo(parseInt(this.getAttribute('data-dot-index'), 10));
        startAutoplay();
      });
    });

    container.addEventListener('mouseenter', function() { stopAutoplay(); });
    container.addEventListener('mouseleave', function() { startAutoplay(); });

    var touchStartX = 0;
    container.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    container.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) { next(); } else { prev(); }
        startAutoplay();
      }
    }, { passive: true });

    playActiveSlideVideos(slides[current]);
    startAutoplay();
  })();
</script>
{% endif %}

{%- if section.settings.shop_scene_enable -%}
<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var openers = document.querySelectorAll('[data-shop-scene-open^="' + sectionId + '-"]');
    var drawers = document.querySelectorAll('[data-shop-scene-drawer^="' + sectionId + '-"]');
    var closers = document.querySelectorAll('[data-shop-scene-close^="' + sectionId + '-"]');
    var backdrop = document.querySelector('[data-shop-scene-backdrop="' + sectionId + '"]');
    if (!openers.length || !drawers.length) return;

    function getDrawer(key) {
      return document.querySelector('[data-shop-scene-drawer="' + key + '"]');
    }

    function openersForKey(key) {
      return document.querySelectorAll('[data-shop-scene-open="' + key + '"]');
    }

    function closeAllDrawers() {
      drawers.forEach(function(d) { d.classList.remove('is-open'); });
      if (backdrop) backdrop.classList.remove('is-visible');
      document.body.style.overflow = '';
      openers.forEach(function(o) { o.setAttribute('aria-expanded', 'false'); });
    }

    function openDrawerByKey(key) {
      closeAllDrawers();
      var drawer = getDrawer(key);
      if (!drawer) return;
      drawer.classList.add('is-open');
      if (backdrop) backdrop.classList.add('is-visible');
      document.body.style.overflow = 'hidden';
      openersForKey(key).forEach(function(o) { o.setAttribute('aria-expanded', 'true'); });
    }

    openers.forEach(function(o) {
      var key = o.getAttribute('data-shop-scene-open');
      o.addEventListener('click', function() { openDrawerByKey(key); });
      if (o.getAttribute('role') === 'button') {
        o.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDrawerByKey(key); }
        });
      }
    });

    closers.forEach(function(c) {
      c.addEventListener('click', closeAllDrawers);
    });
    if (backdrop) backdrop.addEventListener('click', closeAllDrawers);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        var anyOpen = false;
        drawers.forEach(function(d) { if (d.classList.contains('is-open')) anyOpen = true; });
        if (anyOpen) closeAllDrawers();
      }
    });

    // AJAX add to cart for product forms inside any drawer for this section
    var forms = document.querySelectorAll('[data-shop-scene-drawer^="' + sectionId + '-"] [data-shop-scene-form]');
    forms.forEach(function(form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var submitBtn = form.querySelector('[data-shop-scene-add]');
        if (!submitBtn || submitBtn.classList.contains('is-loading')) return;
        var originalLabel = submitBtn.textContent;
        submitBtn.classList.add('is-loading');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Adding...';

        var routes = (window.themeVariables && window.themeVariables.routes) || {};
        var addUrl = routes.cartAddUrl ? routes.cartAddUrl + '.js' : (form.action || '/cart/add.js');
        var cartUrl = routes.cartUrl ? routes.cartUrl + '.js' : '/cart.js';
        var settings = (window.themeVariables && window.themeVariables.settings) || {};

        var formData = new FormData(form);
        formData.append('sections', ['mini-cart']);

        fetch(addUrl, {
          method: 'POST',
          body: formData,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
          .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
          .then(function(result) {
            if (!result.ok) {
              submitBtn.textContent = (result.data && result.data.description) || 'Unavailable';
              setTimeout(function() {
                submitBtn.textContent = originalLabel;
                submitBtn.classList.remove('is-loading');
                submitBtn.disabled = false;
              }, 1800);
              return;
            }

            // Notify theme that a variant was added (for cart-notification etc.)
            form.dispatchEvent(new CustomEvent('variant:added', {
              bubbles: true,
              detail: {
                variant: result.data.hasOwnProperty('items') ? result.data.items[0] : result.data
              }
            }));

            // Fetch fresh cart and dispatch refresh events the theme listens for
            return fetch(cartUrl).then(function(r) { return r.json(); }).then(function(cartContent) {
              document.documentElement.dispatchEvent(new CustomEvent('cart:updated', {
                bubbles: true,
                detail: { cart: cartContent }
              }));
              cartContent.sections = result.data.sections;
              document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
                bubbles: true,
                detail: {
                  cart: cartContent,
                  openMiniCart: settings.cartType === 'drawer'
                }
              }));
              submitBtn.textContent = 'Added \u2713';
              setTimeout(function() {
                submitBtn.textContent = originalLabel;
                submitBtn.classList.remove('is-loading');
                submitBtn.disabled = false;
              }, 1800);
            });
          })
          .catch(function() {
            submitBtn.textContent = 'Try again';
            setTimeout(function() {
              submitBtn.textContent = originalLabel;
              submitBtn.classList.remove('is-loading');
              submitBtn.disabled = false;
            }, 1800);
          });
      });
    });
  })();
</script>
{%- endif -%}

