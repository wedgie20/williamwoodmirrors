{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width
  assign lazy = section.settings.lazy
  assign section_radius = section.settings.section_radius

  assign layout_mode = section.settings.layout_mode
  assign slider_autoplay = section.settings.slider_autoplay
  assign slider_speed = section.settings.slider_speed

  assign layout_height = section.settings.layout_height
  assign layout_fixed_height = section.settings.layout_fixed_height
  assign layout_fixed_height_mobile = section.settings.layout_fixed_height_mobile

  assign bg_image = section.settings.bg_image
  assign bg_image_mobile = section.settings.bg_image_mobile
  assign bg_image_overlay_color = section.settings.bg_image_overlay_color
  assign bg_image_overlay = section.settings.bg_image_overlay

  assign content_max_width = section.settings.content_max_width
  assign content_align = section.settings.content_align
  assign content_align_mobile = section.settings.content_align_mobile
  assign content_vertical_align = section.settings.content_vertical_align
  assign content_vertical_align_mobile = section.settings.content_vertical_align_mobile

  assign loading_attribute = 'eager'
  if lazy
    assign loading_attribute = 'lazy'
  endif

  assign content_horizontal_align = ''
  if content_align == 'center'
    assign content_horizontal_align = 'center'
  elsif content_align == 'right'
    assign content_horizontal_align = 'end'
  else
    assign content_horizontal_align = 'start'
  endif

  assign content_horizontal_align_mobile = ''
  if content_align_mobile == 'center'
    assign content_horizontal_align_mobile = 'center'
  elsif content_align_mobile == 'right'
    assign content_horizontal_align_mobile = 'end'
  else
    assign content_horizontal_align_mobile = 'start'
  endif

  assign loading_attribute = 'eager'
  if lazy
    assign loading_attribute = 'lazy'
  endif
-%}

{%- style -%}

  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
    position: relative;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .hero-bg-image-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-bg-image-{{ section.id }} .hero-bg-image-mobile {
    display: block;
  }

  .hero-bg-image-{{ section.id }} .hero-bg-image-desktop {
    display: none;
  }

  .hero-bg-image-{{ section.id }}::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ bg_image_overlay_color | hex_to_rgba: bg_image_overlay | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }};
    z-index: 2;
    pointer-events: none;
  }

  .hero-bg-image-{{ section.id }} img,
  .hero-bg-image-{{ section.id }} svg,
  .hero-bg-image-{{ section.id }} video  {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-bg-image-{{ section.id }} video {
    display: block;
  }

  /* Force mobile/desktop visibility inside slides */
  .hero-slide-{{ section.id }} .hero-bg-image-mobile,
  .hero-slide-{{ section.id }} .hero-bg-video-mobile {
    display: block;
  }

  .hero-slide-{{ section.id }} .hero-bg-image-desktop,
  .hero-slide-{{ section.id }} .hero-bg-video-desktop {
    display: none;
  }

  /* Slideshow Mode */
  .hero-slide-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .hero-slide-{{ section.id }}.is-active {
    opacity: 1;
    z-index: 1;
  }

  .hero-slider-dots-{{ section.id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    gap: 8px;
  }

  .hero-slider-dot-{{ section.id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.7);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease;
  }

  .hero-slider-dot-{{ section.id }}.is-active {
    background: #fff;
    border-color: #fff;
  }

  .hero-slider-arrow-{{ section.id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .hero-slider-arrow-{{ section.id }}:hover {
    background: rgba(255,255,255,0.3);
  }

  .hero-slider-arrow-prev-{{ section.id }} {
    left: 16px;
  }

  .hero-slider-arrow-next-{{ section.id }} {
    right: 16px;
  }

  .hero-slider-arrow-{{ section.id }} svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 1023px) {
    .hero-slider-arrow-{{ section.id }} {
      display: none;
    }
  }

  /* Slide Content Panels */
  .hero-slide-content-wrapper-{{ section.id }} {
    display: grid;
    width: 100%;
  }

  .hero-slide-content-{{ section.id }} {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .hero-slide-content-{{ section.id }}.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-content-{{ section.id }} {
    position: relative;
    z-index: 1;
    max-width: 100%;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ content_vertical_align_mobile }};
  }

  .hero-review-{{ section.id }} {
    display: flex;
    justify-content: {{ content_horizontal_align_mobile }};
    gap: 16px;
  }

  .hero-review-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ content_horizontal_align_mobile }};
    row-gap: 4px;
  }


  .hero-stars-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 1px;
    max-width: fit-content;
  }

  .hero-stars-wrapper-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hero-buttons-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    justify-content: {{ content_horizontal_align_mobile }};
  }

  .hero-authors-{{ section.id }} {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
  }

  .hero-author-image-{{ section.id }} img,
  .hero-author-image-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-bg-desktop-{{ section.id }} {
    display: none !important;
  }

  @media(min-width: 1024px) {

    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding: 0 5rem;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .hero-bg-image-{{ section.id }} .hero-bg-image-mobile {
      display: none;
    }

    .hero-bg-image-{{ section.id }} .hero-bg-image-desktop {
      display: block;
    }

    .hero-slide-{{ section.id }} .hero-bg-image-mobile,
    .hero-slide-{{ section.id }} .hero-bg-video-mobile {
      display: none;
    }

    .hero-slide-{{ section.id }} .hero-bg-image-desktop,
    .hero-slide-{{ section.id }} .hero-bg-video-desktop {
      display: block;
    }

    .hero-content-{{ section.id }} {
      max-width: {{ content_max_width }}%;
      justify-content: {{ content_vertical_align }};
    }

    .hero-review-{{ section.id }} {
      justify-content: {{ content_horizontal_align }};
    }

    .hero-review-content-{{ section.id }} {
      align-items: {{ content_horizontal_align }};
    }

    .hero-buttons-{{ section.id }} {
      justify-content: {{ content_horizontal_align }};
    }

    .hero-bg-desktop-{{ section.id }} {
      display: block !important;
    }

    .hero-bg-mobile-{{ section.id }} {
      display: none !important;
    }
  }

  /* ================================================
     Shop Scene — Button
  ================================================ */
  .hero-shop-scene-btn-wrap-{{ section.id }} {
    position: absolute;
    top: 175px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: none;
    align-items: center;
    gap: 14px;
    padding: 8px 14px 8px 18px;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 999px;
  }

  .hero-shop-scene-btn-wrap-{{ section.id }}.is-active-slide {
    display: flex;
  }

  .hero-shop-scene-btn-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  .hero-shop-scene-btn-{{ section.id }}:hover {
    opacity: 0.85;
  }

  .hero-shop-scene-btn-{{ section.id }} .ss-btn-arrow {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .hero-shop-scene-btn-{{ section.id }}:hover .ss-btn-arrow {
    transform: translateX(3px);
  }

  .hero-shop-scene-btn-thumbs-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .hero-shop-scene-btn-thumb-{{ section.id }} {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    overflow: hidden;
    background: #f8f8f8;
    flex-shrink: 0;
  }

  .hero-shop-scene-btn-thumb-{{ section.id }} img,
  .hero-shop-scene-btn-thumb-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ================================================
     Shop Scene — Backdrop
  ================================================ */
  .hero-shop-scene-backdrop-{{ section.id }} {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0, 0, 0, 0.45);
  }

  .hero-shop-scene-backdrop-{{ section.id }}.is-visible {
    display: block;
  }

  /* ================================================
     Shop Scene — Drawer
  ================================================ */
  .hero-shop-scene-drawer-{{ section.id }} {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 420px;
    max-width: 100vw;
    z-index: 1000;
    background: #fff;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
    -webkit-overflow-scrolling: touch;
  }

  .hero-shop-scene-drawer-{{ section.id }}.is-open {
    transform: translateX(0);
  }

  .hero-shop-scene-drawer-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid #e5e5e5;
    position: sticky;
    top: 0;
    background: #fff;
    z-index: 1;
    flex-shrink: 0;
  }

  .hero-shop-scene-drawer-title-{{ section.id }} {
    font-size: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #111;
  }

  .hero-shop-scene-drawer-close-{{ section.id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
    border-radius: 4px;
    transition: background 0.2s ease;
  }

  .hero-shop-scene-drawer-close-{{ section.id }}:hover {
    background: #f3f3f3;
  }

  .hero-shop-scene-drawer-close-{{ section.id }} svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* ================================================
     Shop Scene — Product Grid
  ================================================ */
  .hero-shop-scene-drawer-products-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #e5e5e5;
    flex: 1;
  }

  .hero-shop-scene-product-{{ section.id }} {
    background: #fff;
    display: flex;
    flex-direction: column;
  }

  .hero-shop-scene-product-image-link-{{ section.id }} {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f8f8f8;
  }

  .hero-shop-scene-product-image-link-{{ section.id }} img,
  .hero-shop-scene-product-image-link-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hero-shop-scene-product-image-link-{{ section.id }}:hover img {
    transform: scale(1.04);
  }

  .hero-shop-scene-product-info-{{ section.id }} {
    padding: 12px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
  }

  .hero-shop-scene-product-title-{{ section.id }} {
    font-size: 13px;
    color: #111;
    text-decoration: none;
    line-height: 1.4;
    display: block;
  }

  .hero-shop-scene-product-title-{{ section.id }}:hover {
    text-decoration: underline;
  }

  .hero-shop-scene-product-price-{{ section.id }} {
    font-size: 13px;
    color: #333;
    margin: 0;
  }

  .hero-shop-scene-view-link-{{ section.id }} {
    font-size: 11px;
    color: #555;
    text-decoration: underline;
    letter-spacing: 0.05em;
    text-align: center;
    display: block;
    margin-top: 8px;
    padding-top: 2px;
  }

  .hero-shop-scene-view-link-{{ section.id }}:hover {
    color: #111;
  }

  /* ================================================
     Shop Scene — Cart Action Buttons
  ================================================ */
  .hero-shop-scene-product-actions-{{ section.id }} {
    margin-top: auto;
    padding-top: 10px;
  }

  .hero-shop-scene-product-form-{{ section.id }} {
    display: block;
  }

  .hero-shop-scene-add-btn-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 10px 12px;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 2px;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }

  .hero-shop-scene-add-btn-{{ section.id }}:hover {
    background: #333;
    color: #fff;
  }

  .hero-shop-scene-add-btn-{{ section.id }}[disabled],
  .hero-shop-scene-add-btn-{{ section.id }}.is-loading {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .hero-shop-scene-add-btn-{{ section.id }} svg {
    width: 12px;
    height: 12px;
  }

  /* ================================================
     Shop Scene — Mobile Overrides
  ================================================ */
  @media screen and (max-width: 1023px) {
    .hero-shop-scene-btn-wrap-{{ section.id }} {
      top: 175px;
      bottom: auto;
      gap: 8px;
      padding: 6px 10px 6px 12px;
      margin-top: 0;
      width: max-content;
      max-width: calc(100vw - 24px);
    }

    .hero-shop-scene-btn-{{ section.id }} {
      font-size: 11px;
      white-space: nowrap;
    }

    .hero-shop-scene-btn-thumb-{{ section.id }} {
      width: 30px;
      height: 30px;
    }

    .hero-shop-scene-drawer-{{ section.id }} {
      width: 92vw;
      max-width: 420px;
    }
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}px;
    }
  </style>
{% endunless %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

{% if layout_height == 'full_screen' %}
  <style>
    .section-{{ section.id }}-settings {
      height: 100%;
    }

    .hero-{{ section.id }} {
      height: 95vh;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }}-settings {
        height: 100%;
      }

      .hero-{{ section.id }} {
        height: 95vh;
      }
    }
  </style>
{% elsif layout_height == 'fixed_height' %}
  <style>
    .section-{{ section.id }}-settings {
      height: 100%;
    }

    .hero-{{ section.id }} {
      height: {{ layout_fixed_height_mobile }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }}-settings {
        height: 100%;
      }

      .hero-{{ section.id }} {
        height: {{ layout_fixed_height }}px;
      }
    }
  </style>
{% endif %}

{% if content_align_mobile == 'center' %}
  <style>
    .hero-content-{{ section.id }} {
      margin-left: auto;
      margin-right: auto;
    }
  </style>
{% elsif content_align_mobile == 'right' %}
  <style>
    .hero-content-{{ section.id }} {
      margin-left: auto;
    }
  </style>
{% endif %}

{% if content_align == 'center' %}
  <style>
    @media(min-width: 1024px) {
      .hero-content-{{ section.id }} {
        margin-left: auto;
        margin-right: auto;
      }
    }
  </style>
{% elsif content_align == 'right' %}
  <style>
    @media(min-width: 1024px) {
      .hero-content-{{ section.id }} {
        margin-left: auto;
        margin-right: 0px;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .hero-content-{{ section.id }} {
        margin-left: 0px;
        margin-right: 0px;
      }
    }
  </style>
{% endif %}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'review' %}
      <style>
        {{  block.settings.review_font | font_face: font_display: 'swap' }}

        .hero-review-{{ block.id }} {
          margin-top: {{ block.settings.review_mt_mobile }}px;
        }

        .hero-author-image-{{ block.id }} {
          border: {{ block.settings.image_border_thickness | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}px solid {{ block.settings.image_border_color | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }};
          border-radius: {{ block.settings.image_radius | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}px;
          overflow: hidden;
          width: {{ block.settings.image_size_mobile | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}px;
