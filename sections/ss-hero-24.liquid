                              {% if block.settings.stars_count == 4.5 %}
                                <defs>
                                  <linearGradient id="grad{{ section.id }}{{ block.id }}5">
                                    <stop offset="0%" stop-color="{{ block.settings.stars_bg_color }}" />
                                    <stop offset="50%" stop-color="{{ block.settings.stars_bg_color }}" />
                                    <stop offset="50%" stop-color="{{ block.settings.stars_bg_half_color }}" />
                                    <stop offset="100%" stop-color="{{ block.settings.stars_bg_half_color }}" />
                                  </linearGradient>
                                </defs>
                              {% endif %}
                              <defs><clipPath id="clip{{ section.id }}{{ block.id }}s5"><rect width="22" height="22" fill="{{ block.settings.stars_color }}" transform="translate(5 5)"/></clipPath></defs>
                              <rect width="32" height="32" fill="{% if block.settings.stars_count == 4.5 %}url(#grad{{ section.id }}{{ block.id }}5){% else %}{{ block.settings.stars_bg_color }}{% endif %}"/>
                              <g clip-path="url(#clip{{ section.id }}{{ block.id }}s5)">
                                <path d="M9.20283 27L16.001 21.807L22.7972 27L20.2018 18.596L27 13.403H18.5984L16.001 5L13.4037 13.403H5L11.7982 18.596L9.20283 27Z" fill="{{ block.settings.stars_color }}"/>
                              </g>
                            </svg>
                          {% endif %}
                        {% endif %}
                      </div>
                      {% if block.settings.stars_text %}
                        <p class="hero-stars-count-{{ section.id }} hero-stars-count-{{ block.id }}">
                          {{ block.settings.stars_text }}
                        </p>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% when 'heading' %}
            {% unless layout_mode == 'slideshow' %}
            {% assign hero_slide = block.settings.slide_number | default: 'all' %}
            {% if hero_slide == 'all' or hero_slide == '1' %}
            {% if block.settings.heading != blank %}
              <div class="hero-heading-{{ block.id }}">
                {{ block.settings.heading }}
              </div>
            {% endif %}
            {% endif %}
            {% endunless %}
          {% when 'text' %}
            {% unless layout_mode == 'slideshow' %}
            {% assign hero_slide = block.settings.slide_number | default: 'all' %}
            {% if hero_slide == 'all' or hero_slide == '1' %}
            {% if block.settings.text != blank %}
              <div class="hero-text-{{ block.id }}">
                {{ block.settings.text }}
              </div>
            {% endif %}
            {% endif %}
            {% endunless %}
          {% when 'star_rating_full' %}
            {% if block.settings.star_rating_image != blank %}
              <div class="hero-star-image-{{ block.id }}">
                <img 
                  src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.star_rating_image | image_url: width: 800 }}" 
                  alt="Star Rating"
                  loading="{{ loading_attribute }}"
                  width="{{ block.settings.star_rating_image.width }}"
                  height="{{ block.settings.star_rating_image.height }}"
                />
              </div>
            {% endif %}
          {% when 'button' %}
            {% unless layout_mode == 'slideshow' %}
            {% assign hero_slide = block.settings.slide_number | default: 'all' %}
            {% if hero_slide == 'all' or hero_slide == '1' %}
            {% assign next_index = forloop.index0 | plus: 1 %}
            {% assign next_block = section.blocks[next_index] %}

            {% unless button_open %}
              <div class="hero-buttons-{{ section.id }}">
            {% endunless %}

            {% if block.settings.button != blank %}
              <a href="{{ block.settings.url }}" class="hero-button-{{ block.id }}">
                <p class="hero-button-inner-{{ block.id }}">
                  {{ block.settings.button }}
                  {% if block.settings.button_style == 'non_outline_arrow'
                    or block.settings.button_style == 'outline_arrow'
                  %}
                    <svg width="192" height="192" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M187.827 98.7858C188.123 98.4749 188.123 98.4749 188.123 98.1761C188.419 97.8652 188.419 97.5663 188.704 97.5663C189 96.9566 189 96.6458 189 96.0361C189 95.4263 189 94.8166 188.704 94.5058C188.704 94.195 188.408 93.8961 188.123 93.5852C188.123 93.2744 187.827 93.2744 187.827 92.9755L103.287 4.21945C102.41 3.29889 101.533 3 100.668 3C99.791 3 98.6295 3.31083 98.0488 4.21945C97.1719 5.14 96.8872 6.06058 96.8872 6.96919C96.8872 7.88974 97.1833 9.10918 98.0488 9.7189L175.587 92.0539H6.79206C4.75371 92.0539 3 93.895 3 96.0351C3 98.1751 4.75365 100.016 6.79206 100.016H175.575L97.7543 182.042C96.2967 183.572 96.2967 186.322 97.7543 187.852C99.2119 189.383 101.831 189.383 103.288 187.852L187.827 98.7858Z" fill="black"></path>
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M188.607 97.5657C188.432 97.5657 188.365 97.6788 188.27 97.8382C188.211 97.9378 188.141 98.0554 188.027 98.1748C188.027 98.4734 188.027 98.4734 187.731 98.7839L103.281 187.759C101.825 189.287 99.2085 189.287 97.7524 187.759C96.2963 186.23 96.2963 183.483 97.7524 181.954L175.492 100.013L6.88489 100.013C4.8486 100.013 3.09677 98.1739 3.09677 96.036C3.09677 93.8982 4.84866 92.059 6.88489 92.059L175.504 92.059L98.0465 9.80878C97.182 9.19968 96.8862 7.9815 96.8862 7.0619C96.8862 6.15422 97.1706 5.2346 98.0465 4.315C98.6267 3.40732 99.787 3.0968 100.663 3.0968C101.527 3.0968 102.403 3.39539 103.279 4.315L187.731 92.9796C187.731 93.1274 187.804 93.2021 187.877 93.2774C187.952 93.3543 188.027 93.4319 188.027 93.5887C188.046 93.6098 188.066 93.6308 188.085 93.6518C188.338 93.9267 188.584 94.1935 188.606 94.4689C188.607 94.482 188.607 94.4951 188.607 94.5083C188.903 94.8188 188.903 95.4279 188.903 96.037C188.903 96.6461 188.903 96.9566 188.607 97.5657ZM191.489 93.2767C191.79 93.8661 191.89 94.4204 191.934 94.7363C192.001 95.2226 192 95.7194 192 95.9856L192 96.037C192 96.0544 192 96.0729 192 96.0926C192 96.3523 192.001 96.8096 191.924 97.2931C191.828 97.8884 191.64 98.41 191.393 98.9184L190.546 100.663H190.212C190.127 100.759 190.038 100.852 189.988 100.905L189.974 100.92L105.527 189.891C102.85 192.701 98.1865 192.704 95.51 189.895C94.1476 188.464 93.5636 186.587 93.5636 184.857C93.5636 183.128 94.1468 181.252 95.5071 179.822M191.489 93.2767C191.316 92.7908 191.078 92.4357 190.938 92.2406C190.903 92.1912 190.866 92.142 190.828 92.0939V91.7408L105.522 2.17912C104.076 0.661813 102.397 0 100.663 0C99.3914 0 97.0569 0.401401 95.6212 2.37737C94.3151 3.83819 93.7895 5.45521 93.7895 7.0619C93.7895 8.26663 94.1183 10.6061 95.9608 12.111L168.333 88.9622L6.88489 88.9622C2.9981 88.9622 0 92.3316 0 96.036C0 99.7405 2.99801 103.11 6.88489 103.11L168.285 103.11" fill="black"></path>
                      <path d="M169.5 104L16.5 102.5V90H171L97.5 10.5V7L107.5 4.5C131.167 29.6667 180.2 81.5 187 87.5C193.8 93.5 191.5 99 189.5 101L105.5 184L94 181.5L169.5 104Z" fill="black"></path>
                    </svg>
                  {% endif %}
                </p>
              </a>
            {% endif %}

            {% assign button_open = true %}

            {% if next_block.type != 'button' %}
              </div>
              {% assign button_open = false %}
            {% endif %}
            {% endif %}
            {% endunless %}

          {% when 'melrose_hero' %}
            {% unless layout_mode == 'slideshow' %}
              <div class="hero-melrose-{{ block.id }}" {{ block.shopify_attributes }}>
                {{ block.settings.content }}
              </div>
            {% endunless %}

        {% endcase %}
      {% endfor %}

      {%- comment -%} Per-slide content panels for slideshow mode (block-based) {%- endcomment -%}
      {% if layout_mode == 'slideshow' %}
        <div class="hero-slide-content-wrapper-{{ section.id }}">
          {% assign content_idx = 0 %}
          {% for i in (1..5) %}
            {% assign slide_video = blank %}
            {% assign slide_media_type = 'image' %}
            {% case i %}
              {% when 1 %}
                {% assign slide_img = bg_image %}
                {% assign slide_video = section.settings.bg_video_1 %}
                {% assign slide_media_type = section.settings.bg_media_type_1 | default: 'image' %}
                {% assign s_align = section.settings.slide_align_1 %}
              {% when 2 %}
                {% assign slide_img = section.settings.bg_image_2 %}
                {% assign slide_video = section.settings.bg_video_2 %}
                {% assign slide_media_type = section.settings.bg_media_type_2 | default: 'image' %}
                {% assign s_align = section.settings.slide_align_2 %}
              {% when 3 %}
                {% assign slide_img = section.settings.bg_image_3 %}
                {% assign slide_video = section.settings.bg_video_3 %}
                {% assign slide_media_type = section.settings.bg_media_type_3 | default: 'image' %}
                {% assign s_align = section.settings.slide_align_3 %}
              {% when 4 %}
                {% assign slide_img = section.settings.bg_image_4 %}
                {% assign slide_video = section.settings.bg_video_4 %}
                {% assign slide_media_type = section.settings.bg_media_type_4 | default: 'image' %}
                {% assign s_align = section.settings.slide_align_4 %}
              {% when 5 %}
                {% assign slide_img = section.settings.bg_image_5 %}
                {% assign slide_video = section.settings.bg_video_5 %}
                {% assign slide_media_type = section.settings.bg_media_type_5 | default: 'image' %}
                {% assign s_align = section.settings.slide_align_5 %}
            {% endcase %}

            {% assign slide_has_media = false %}
            {% if slide_media_type == 'video' and slide_video != blank %}
              {% assign slide_has_media = true %}
            {% elsif slide_img != blank %}
              {% assign slide_has_media = true %}
            {% endif %}

            {% assign slide_num_str = i | append: '' %}

            {% if slide_has_media %}
              {%- liquid
                assign slide_text_align = content_align
                assign slide_justify = content_horizontal_align
                if s_align != 'default' and s_align != blank
                  assign slide_text_align = s_align
                  if s_align == 'center'
                    assign slide_justify = 'center'
                  elsif s_align == 'right'
                    assign slide_justify = 'end'
                  else
                    assign slide_justify = 'start'
                  endif
                endif
              -%}
              <div class="hero-slide-content-{{ section.id }}{% if content_idx == 0 %} is-active{% endif %}" data-slide-content-index="{{ content_idx }}" style="text-align: {{ slide_text_align }};">
                {% for block in section.blocks %}
                  {% assign block_slide = block.settings.slide_number | default: 'all' %}
                  {% if block_slide == slide_num_str or block_slide == 'all' %}
                    {% case block.type %}
                      {% when 'heading' %}
                        {% if block.settings.heading != blank %}
                          <div class="hero-heading-{{ block.id }}" {{ block.shopify_attributes }}>
                            {{ block.settings.heading }}
                          </div>
                        {% endif %}
                      {% when 'text' %}
                        {% if block.settings.text != blank %}
                          <div class="hero-text-{{ block.id }}" {{ block.shopify_attributes }}>
                            {{ block.settings.text }}
                          </div>
                        {% endif %}
                      {% when 'melrose_hero' %}
                        <div class="hero-melrose-{{ block.id }}" {{ block.shopify_attributes }}>
                          {{ block.settings.content }}
                        </div>
                    {% endcase %}
                  {% endif %}
                {% endfor %}

                {% assign has_slide_buttons = false %}
                {% for block in section.blocks %}
                  {% assign block_slide = block.settings.slide_number | default: 'all' %}
                  {% if block.type == 'button' and block.settings.button != blank %}
                    {% if block_slide == slide_num_str or block_slide == 'all' %}
                      {% assign has_slide_buttons = true %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% if has_slide_buttons %}
                  <div class="hero-buttons-{{ section.id }}" style="justify-content: {{ slide_justify }};">
                    {% for block in section.blocks %}
                      {% assign block_slide = block.settings.slide_number | default: 'all' %}
                      {% if block.type == 'button' and block.settings.button != blank %}
                        {% if block_slide == slide_num_str or block_slide == 'all' %}
                          <a href="{{ block.settings.url }}" class="hero-button-{{ block.id }}">
                            <p class="hero-button-inner-{{ block.id }}">
                              {{ block.settings.button }}
                              {% if block.settings.button_style == 'non_outline_arrow' or block.settings.button_style == 'outline_arrow' %}
                                <svg width="192" height="192" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <path d="M187.827 98.7858C188.123 98.4749 188.123 98.4749 188.123 98.1761C188.419 97.8652 188.419 97.5663 188.704 97.5663C189 96.9566 189 96.6458 189 96.0361C189 95.4263 189 94.8166 188.704 94.5058C188.704 94.195 188.408 93.8961 188.123 93.5852C188.123 93.2744 187.827 93.2744 187.827 92.9755L103.287 4.21945C102.41 3.29889 101.533 3 100.668 3C99.791 3 98.6295 3.31083 98.0488 4.21945C97.1719 5.14 96.8872 6.06058 96.8872 6.96919C96.8872 7.88974 97.1833 9.10918 98.0488 9.7189L175.587 92.0539H6.79206C4.75371 92.0539 3 93.895 3 96.0351C3 98.1751 4.75365 100.016 6.79206 100.016H175.575L97.7543 182.042C96.2967 183.572 96.2967 186.322 97.7543 187.852C99.2119 189.383 101.831 189.383 103.288 187.852L187.827 98.7858Z" fill="black"></path>
                                  <path d="M169.5 104L16.5 102.5V90H171L97.5 10.5V7L107.5 4.5C131.167 29.6667 180.2 81.5 187 87.5C193.8 93.5 191.5 99 189.5 101L105.5 184L94 181.5L169.5 104Z" fill="black"></path>
                                </svg>
                              {% endif %}
                            </p>
                          </a>
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
              {% assign content_idx = content_idx | plus: 1 %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if layout_mode == 'slideshow' %}
    {%- assign nav_slide_count = 0 -%}
    {%- for n_i in (1..5) -%}
      {%- assign n_media_type = 'image' -%}
      {%- assign n_video = blank -%}
      {%- assign n_image = blank -%}
      {%- case n_i -%}
        {%- when 1 -%}
          {%- assign n_media_type = section.settings.bg_media_type_1 | default: 'image' -%}
          {%- assign n_video = section.settings.bg_video_1 -%}
          {%- assign n_image = bg_image -%}
        {%- when 2 -%}
          {%- assign n_media_type = section.settings.bg_media_type_2 | default: 'image' -%}
          {%- assign n_video = section.settings.bg_video_2 -%}
          {%- assign n_image = section.settings.bg_image_2 -%}
        {%- when 3 -%}
          {%- assign n_media_type = section.settings.bg_media_type_3 | default: 'image' -%}
          {%- assign n_video = section.settings.bg_video_3 -%}
          {%- assign n_image = section.settings.bg_image_3 -%}
        {%- when 4 -%}
          {%- assign n_media_type = section.settings.bg_media_type_4 | default: 'image' -%}
          {%- assign n_video = section.settings.bg_video_4 -%}
          {%- assign n_image = section.settings.bg_image_4 -%}
        {%- when 5 -%}
          {%- assign n_media_type = section.settings.bg_media_type_5 | default: 'image' -%}
          {%- assign n_video = section.settings.bg_video_5 -%}
          {%- assign n_image = section.settings.bg_image_5 -%}
      {%- endcase -%}
      {%- if n_media_type == 'video' and n_video != blank -%}
        {%- assign nav_slide_count = nav_slide_count | plus: 1 -%}
      {%- elsif n_image != blank -%}
        {%- assign nav_slide_count = nav_slide_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {% if nav_slide_count > 1 %}
      <button class="hero-slider-arrow-{{ section.id }} hero-slider-arrow-prev-{{ section.id }}" aria-label="Previous slide">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="hero-slider-arrow-{{ section.id }} hero-slider-arrow-next-{{ section.id }}" aria-label="Next slide">
        <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
      <div class="hero-slider-dots-{{ section.id }}">
        {%- for i in (1..nav_slide_count) -%}
          {%- assign dot_index = i | minus: 1 -%}
          <button class="hero-slider-dot-{{ section.id }} {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ dot_index }}" aria-label="Go to slide {{ i }}"></button>
        {%- endfor -%}
      </div>
    {% endif %}
  {% endif %}

  {%- if section.settings.shop_scene_enable -%}
    {%- assign shop_scene_label = section.settings.shop_scene_button_label | default: 'Shop scene' -%}
    {%- assign shop_scene_thumb_count = section.settings.shop_scene_thumb_count | default: 3 -%}
    {%- assign shop_scene_max_slides = 5 -%}
    {%- if layout_mode != 'slideshow' -%}{%- assign shop_scene_max_slides = 1 -%}{%- endif -%}

    {%- for ss_idx in (1..shop_scene_max_slides) -%}
      {%- assign ss_products = empty -%}
      {%- assign ss_count = 0 -%}
      {%- assign ss_source = 'products' -%}
      {%- case ss_idx -%}
        {%- when 1 -%}
          {%- assign ss_source = section.settings.shop_scene_source_1 | default: 'products' -%}
          {%- assign ss_picked = section.settings.shop_scene_products -%}
          {%- assign ss_handle = section.settings.shop_scene_collection -%}
        {%- when 2 -%}
          {%- assign ss_source = section.settings.shop_scene_source_2 | default: 'products' -%}
          {%- assign ss_picked = section.settings.shop_scene_products_2 -%}
          {%- assign ss_handle = section.settings.shop_scene_collection_2 -%}
        {%- when 3 -%}
          {%- assign ss_source = section.settings.shop_scene_source_3 | default: 'products' -%}
          {%- assign ss_picked = section.settings.shop_scene_products_3 -%}
          {%- assign ss_handle = section.settings.shop_scene_collection_3 -%}
        {%- when 4 -%}
          {%- assign ss_source = section.settings.shop_scene_source_4 | default: 'products' -%}
          {%- assign ss_picked = section.settings.shop_scene_products_4 -%}
          {%- assign ss_handle = section.settings.shop_scene_collection_4 -%}
        {%- when 5 -%}
          {%- assign ss_source = section.settings.shop_scene_source_5 | default: 'products' -%}
          {%- assign ss_picked = section.settings.shop_scene_products_5 -%}
          {%- assign ss_handle = section.settings.shop_scene_collection_5 -%}
      {%- endcase -%}
      {%- if ss_source == 'collection' and ss_handle != blank -%}
        {%- assign ss_collection = collections[ss_handle] -%}
        {%- assign ss_products = ss_collection.products -%}
        {%- assign ss_count = ss_collection.products_count -%}
      {%- elsif ss_source == 'products' and ss_picked != blank and ss_picked.size > 0 -%}
        {%- assign ss_products = ss_picked -%}
        {%- assign ss_count = ss_picked.size -%}
      {%- endif -%}
      {%- if ss_products != empty -%}
        <div class="hero-shop-scene-btn-wrap-{{ section.id }}{% if forloop.first %} is-active-slide{% endif %}"
             data-shop-scene-slide-wrap="{{ section.id }}-{{ ss_idx }}">
          <button
            class="hero-shop-scene-btn-{{ section.id }}"
            aria-label="{{ shop_scene_label }}"
            aria-expanded="false"
            data-shop-scene-open="{{ section.id }}-{{ ss_idx }}"
            type="button"
          >
            <span>{{ shop_scene_label }} ({{ ss_count }})</span>
            <svg class="ss-btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12H19M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          {%- if shop_scene_thumb_count > 0 -%}
            <div class="hero-shop-scene-btn-thumbs-{{ section.id }}" data-shop-scene-open="{{ section.id }}-{{ ss_idx }}" role="button" tabindex="0" aria-label="{{ shop_scene_label }}">
              {%- for product in ss_products limit: shop_scene_thumb_count -%}
                <span class="hero-shop-scene-btn-thumb-{{ section.id }}">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.featured_image.alt, widths: '60,120' | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>

{%- if section.settings.shop_scene_enable -%}
  {%- assign shop_scene_label = section.settings.shop_scene_button_label | default: 'Shop scene' -%}
  {%- assign shop_scene_limit = section.settings.shop_scene_product_limit | default: 12 -%}
  {%- assign shop_scene_max_slides = 5 -%}
  {%- if layout_mode != 'slideshow' -%}{%- assign shop_scene_max_slides = 1 -%}{%- endif -%}

  {%- assign ss_any = false -%}
  {%- for ss_idx in (1..shop_scene_max_slides) -%}
    {%- assign ss_source = 'products' -%}
    {%- case ss_idx -%}
      {%- when 1 -%}
        {%- assign ss_source = section.settings.shop_scene_source_1 | default: 'products' -%}
        {%- assign ss_picked = section.settings.shop_scene_products -%}
        {%- assign ss_handle = section.settings.shop_scene_collection -%}
      {%- when 2 -%}
        {%- assign ss_source = section.settings.shop_scene_source_2 | default: 'products' -%}
        {%- assign ss_picked = section.settings.shop_scene_products_2 -%}
        {%- assign ss_handle = section.settings.shop_scene_collection_2 -%}
      {%- when 3 -%}
        {%- assign ss_source = section.settings.shop_scene_source_3 | default: 'products' -%}
        {%- assign ss_picked = section.settings.shop_scene_products_3 -%}
        {%- assign ss_handle = section.settings.shop_scene_collection_3 -%}
      {%- when 4 -%}
        {%- assign ss_source = section.settings.shop_scene_source_4 | default: 'products' -%}
        {%- assign ss_picked = section.settings.shop_scene_products_4 -%}
        {%- assign ss_handle = section.settings.shop_scene_collection_4 -%}
      {%- when 5 -%}
        {%- assign ss_source = section.settings.shop_scene_source_5 | default: 'products' -%}
        {%- assign ss_picked = section.settings.shop_scene_products_5 -%}
        {%- assign ss_handle = section.settings.shop_scene_collection_5 -%}
    {%- endcase -%}
    {%- if ss_source == 'collection' and ss_handle != blank -%}{%- assign ss_any = true -%}
