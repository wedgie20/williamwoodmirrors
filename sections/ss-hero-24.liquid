              {%- assign s_video_mobile = section.settings.bg_video_mobile_3 -%}
              {%- assign s_image = section.settings.bg_image_3 -%}
              {%- assign s_image_mobile = section.settings.bg_image_mobile_3 -%}
            {%- when 4 -%}
              {%- assign s_media_type = section.settings.bg_media_type_4 | default: 'image' -%}
              {%- assign s_video = section.settings.bg_video_4 -%}
              {%- assign s_video_mobile = section.settings.bg_video_mobile_4 -%}
              {%- assign s_image = section.settings.bg_image_4 -%}
              {%- assign s_image_mobile = section.settings.bg_image_mobile_4 -%}
            {%- when 5 -%}
              {%- assign s_media_type = section.settings.bg_media_type_5 | default: 'image' -%}
              {%- assign s_video = section.settings.bg_video_5 -%}
              {%- assign s_video_mobile = section.settings.bg_video_mobile_5 -%}
              {%- assign s_image = section.settings.bg_image_5 -%}
