<div class="{% if section.settings.include_horizontal_margins %}container{% endif %} {% if section.settings.include_vertical_margins %}vertical-breather{% endif %}">
  {%- for block in section.blocks -%}
    {%- render block -%}
  {%- endfor -%}
</div>

{% if section.settings.include_trustpilot == true %}
  <!-- TrustBox widget - Slider -->
<div class="trustpilot-widget widget-bottom" data-locale="en-GB" data-template-id="54ad5defc6454f065c28af8b" data-businessunit-id="5c1ad659b7fbfa000156daec" data-style-height="240px" data-style-width="100%" data-theme="light" data-stars="1,2,3,4,5" data-review-languages="en">
  <a href="https://uk.trustpilot.com/review/www.williamwoodmirrors.co.uk" target="_blank" rel="noopener">Trustpilot</a>
</div>
<!-- End TrustBox widget -->
{% endif %}

{% schema %}
{
  "name": "Apps",
  "class": "shopify-section--apps",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_trustpilot",
      "label": "Include trustpilot into app block",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "include_horizontal_margins",
      "label": "Include horizontal margins",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "include_vertical_margins",
      "label": "Include vertical margins",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
