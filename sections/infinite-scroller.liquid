{% schema %}
{
  "name": "Social Proof Scroller",
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "logos_shown",
      "label": "numLogos",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 0.5
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "spaceLogos",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "speed_ofAnimation",
      "default": 10,
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "bgColour",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "image_size",
      "label": "imgSize",
      "default": "200x200"
    }
  ],
  "presets": [
    {
      "name": "Social Proof Scroller",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="infinite-logo-scroller" style="background-color: {{ section.settings.background_color }};">
  <div class="logo-track">
    {% assign images_count = 0 %}
    {% capture slides %}
    {% for block in section.blocks %}
      {% assign logo = block.settings.logo %}
      {% if logo %}
        {% assign images_count = images_count | plus: 1  %}
        <div class="logo-slide">
          <img src="{{ settings.speedsize_url_pfx_https -}}{{ logo | img_url: section.settings.image_size }}" alt="{{ logo.alt }}">
        </div>
      {% endif %}
    {% endfor %}
    {%  endcapture %}
    {{  slides }}
    {{  slides }}   
    {%  if images_count < section.settings.logos_shown %} 
    {{  slides }}   
    {% endif %} 
  </div>
</div>

<style>
  .infinite-logo-scroller {
    overflow: hidden;
    width: 100%;
    position: relative;
  }
  
  .logo-track {
    display: flex;
    animation: scroll {{ section.settings.animation_speed }}s linear infinite;
    width: 200%;
  }
  
  .logo-slide {
    flex: 0 0 calc(50% / {{ section.settings.logos_shown }} - {{ section.settings.logo_spacing }}px);
    margin-right: {{ section.settings.logo_spacing }}px;
  }
  
  .logo-slide img {
    width: 100%;
    height: auto;
  }
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      {%  assign animation_stop_at = 1.0 | times: images_count | divided_by: section.settings.logos_shown %}
      transform: translateX(calc( -50% * {{ animation_stop_at }}));
    }
  }
</style>