{% comment %} not sure this variable is used {% endcomment %}
{% assign first_column_results_size = predictive_search.resources.queries.size
  | plus: predictive_search.resources.collections.size
  | plus: predictive_search.resources.pages.size
  | plus: predictive_search.resources.articles.size
%}
<div id="predictive-search-results" role="listbox">
  <div class="predictive-search__suggestions">
     <div class="trending-title" style="text-align: center;">
       <p style="font-family: altesse-std-24pt; text-transform: lowercase; font-size: 25px; font-weight: 300;">Trending Searches</p>
    </div>
    <ul
      class="search-suggestion-list"
      role="group"
      aria-labelledby="predictive-search-queries"
    >
      {% comment %} {%- if predictive_search.resources.queries.size > 0 -%}
        {%- for query in predictive_search.resources.queries -%}
          <li
            data-suggested-query="{{ query.text  }}"
            class="suggested-search-term"
            role="option"
          >
            {{ query.styled_text }}
          </li>
        {%- endfor -%} {% endcomment %}
      {% comment %} {%- else -%} {% endcomment %}
        {%- if settings.search_term_1_label != blank and settings.search_term_1_url != blank -%}
          <li class="suggested-search-term" role="option">
            <a href="{{ settings.search_term_1_url }}" style="text-decoration: none; color: inherit; display: block;">
              {{ settings.search_term_1_label }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.search_term_2_label != blank and settings.search_term_2_url != blank -%}
          <li class="suggested-search-term" role="option">
            <a href="{{ settings.search_term_2_url }}" style="text-decoration: none; color: inherit; display: block;">
              {{ settings.search_term_2_label }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.search_term_3_label != blank and settings.search_term_3_url != blank -%}
          <li class="suggested-search-term" role="option">
            <a href="{{ settings.search_term_3_url }}" style="text-decoration: none; color: inherit; display: block;">
              {{ settings.search_term_3_label }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.search_term_4_label != blank and settings.search_term_4_url != blank -%}
          <li class="suggested-search-term" role="option">
            <a href="{{ settings.search_term_4_url }}" style="text-decoration: none; color: inherit; display: block;">
              {{ settings.search_term_4_label }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.search_term_5_label != blank and settings.search_term_5_url != blank -%}
          <li class="suggested-search-term" role="option">
            <a href="{{ settings.search_term_5_url }}" style="text-decoration: none; color: inherit; display: block;">
              {{ settings.search_term_5_label }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.search_term_6_label != blank and settings.search_term_6_url != blank -%}
          <li class="suggested-search-term" role="option">
            <a href="{{ settings.search_term_6_url }}" style="text-decoration: none; color: inherit; display: block;">
              {{ settings.search_term_6_label }}
            </a>
          </li>
        {%- endif -%}
      {% comment %} {%- endif -%} {% endcomment %}
    </ul>
  </div>

  <div class="predictive-search__pages-wrapper">
    <div class="sticky-wrapper">
      <div class="title-wrapper">
        <h2>{{- 'templates.search.help_links' | t -}}</h2>
        <span class="mobile-product-count" id="mobile-results-count">
          {{ 'templates.search.results_products_with_count' | t: count: collections.all.products_count }}
        </span>
      </div>
      <ul
        class="suggested-links"
        role="group"
        aria-labelledby="predictive-search-pages-results"
      >
        {% comment %}
          esthetic-ignore
        {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
          {%- for page in predictive_search.resources.pages -%}
            <li>
              <a href="{{ page.url  }}" tabindex="-1">
                {{ page.title | escape }}
              </a>
            </li>
          {%- endfor -%}
          {%- for article in predictive_search.resources.articles -%}
            <li>
              <a href="{{ article.url  }}" tabindex="-1">
                {{ article.title | escape }}
              </a>
            </li>
          {%- endfor -%}
          {%- for collection in predictive_search.resources.collections -%}
            <li>
              <a href="{{ collection.url  }}" tabindex="-1">
                {{ collection.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {% for link in settings.help_links.links -%}
            <li>
              {{ link.title | link_to: link.url }}
            </li>
          {%- endfor %}
        {%- endif -%}

        {% endcomment %}
        {% for link in settings.help_links.links -%}
            <li>
              {{ link.title | link_to: link.url }} 
            </li>
        {%- endfor %}
      </ul>
    </div>
  </div>

  {%- if predictive_search.performed -%}
    <div id="search-results-container" class="predictive-search__result-group "></div>
  {%- else -%}
    <div class="predictive-search__result-group ">
      <span class="desktop-product-count">
        {{ 'templates.search.results_products_with_count' | t: count: collections.all.products_count }}
      </span>
      <ul class="predictive-search__results-list">
        {% for product in settings.defualt_collection.products %}
          <li>
            {% comment %} {% render 'product-item' with product: product %} {% endcomment %}
             {% render 'product-item-updated' with product: product, forloop_index: forloop.index %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {%- endif -%}

  <div class="link-to-search-wrapper">
    <a
      href="{% if predictive_search.terms == blank %}/collections/all{% else %}{{- routes.search_url | append: '?q=' | append: predictive_search.terms  -}}{% endif %}"
      id="searchUrl"
      class="button"
      tabindex="-1"
      role="option"
      aria-selected="false"
    >
      <span>
        {% if predictive_search.terms == blank %}
          View all
        {% else %}
          {{- 'templates.search.search_for' | t: terms: predictive_search.terms -}}
        {% endif %}
      </span>
      {%- render 'icon' with 'nav-arrow-right', stroke_width: 2 -%}
    </a>
  </div>
</div>

<span style="visibility: hidden" data-predictive-search-live-region-count-value>
  {% liquid
    assign total_results = predictive_search.resources.products.size | plus: first_column_results_size
    if total_results == 0
      echo 'templates.search.no_results' | t: terms: predictive_search.terms
    else
      echo 'templates.search.results_with_count' | t: count: total_results | append: ': '
      if predictive_search.resources.queries.size > 0
        assign count = predictive_search.resources.queries.size | plus: predictive_search.resources.collections.size
        echo 'templates.search.results_suggestions_with_count' | t: count: count | append: ', '
      endif
      if predictive_search.resources.pages.size > 0
        assign count = predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size
        echo 'templates.search.results_pages_with_count' | t: count: count | append: ', '
      endif
      if predictive_search.resources.products.size > 0
        echo 'templates.search.results_products_with_count' | t: count: predictive_search.resources.products.size
      endif
    endif
  %}
</span>

{% if template == 'collection' or template.name == 'collection' %}

{% else %}
  <script>
 function setupAnimateImagesObserver() {
  // Only run on screens smaller than 550px
  if (!window.matchMedia('(max-width: 549px)').matches) return;

  const elements = document.querySelectorAll('.this_is_animate');
  if (!('IntersectionObserver' in window)) return; // Fallback for old browsers
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target;
        
        // Check if container has mobile images
        const mobileImages = el.querySelectorAll('.mobile_images');
        if (mobileImages.length > 0) {
          // Temporarily disable scroll-snap to prevent conflicts with animation
          const originalScrollSnapType = el.style.scrollSnapType;
          el.style.scrollSnapType = 'none';
          
          // Remove and re-add animation class for restart
          el.classList.remove('animate_images');
          // Force reflow to restart the animation
          void el.offsetWidth;
          el.classList.add('animate_images');
          
          // Re-enable scroll-snap after animation completes (1s animation + small buffer)
          setTimeout(() => {
            el.style.scrollSnapType = 'x mandatory';
          }, 3000);
        }
      }
    });
  }, { threshold: 0.1 });

  elements.forEach(el => observer.observe(el));
}

// Infinite scroll setup function for search results
function setupInfiniteScrollForSearch() {
  if (window.innerWidth >= 550) return;

  const containers = document.querySelectorAll('.updated-product-item.product-item .product-item__aspect-ratio');

  containers.forEach((container) => {
    if (container.dataset.infiniteSetup) return;
    container.dataset.infiniteSetup = 'true';

    const images = container.querySelectorAll('.mobile_images');
    if (images.length <= 1) return;

    container.querySelectorAll('.mobile_images.clone-image').forEach(clone => clone.remove());

    const firstImage = images[0].cloneNode(true);
    const lastImage = images[images.length - 1].cloneNode(true);
    firstImage.classList.add('clone-image');
    lastImage.classList.add('clone-image');
    container.appendChild(firstImage);
    container.insertBefore(lastImage, images[0]);

    function setToFirstRealImage() {
      const updatedImages = container.querySelectorAll('.mobile_images');
      if (updatedImages.length > 2) {
        const imageWidth = updatedImages[1].offsetWidth;
        container.scrollLeft = imageWidth;
      }
    }
    setTimeout(setToFirstRealImage, 100);
    setTimeout(setToFirstRealImage, 500);

    let isJumping = false;
    let scrollTimeout;

    container.addEventListener('scroll', function() {
      if (isJumping) return;

      clearTimeout(scrollTimeout);

      scrollTimeout = setTimeout(() => {
        const updatedImages = container.querySelectorAll('.mobile_images');
        const scrollLeft = container.scrollLeft;
        const maxScroll = container.scrollWidth - container.clientWidth;
        const imageWidth = updatedImages[1].offsetWidth;
        const tolerance = imageWidth * 0.1;

        if (scrollLeft <= tolerance) {
          isJumping = true;
          container.style.scrollSnapType = 'none';
          container.style.scrollBehavior = 'auto';
          const targetPosition = maxScroll - imageWidth;
          container.scrollLeft = targetPosition;
          requestAnimationFrame(() => {
            container.style.scrollSnapType = 'x mandatory';
            container.style.scrollBehavior = 'smooth';
            isJumping = false;
          });
        } else if (scrollLeft >= maxScroll - tolerance) {
          isJumping = true;
          container.style.scrollSnapType = 'none';
          container.style.scrollBehavior = 'auto';
          container.scrollLeft = imageWidth;
          requestAnimationFrame(() => {
            container.style.scrollSnapType = 'x mandatory';
            container.style.scrollBehavior = 'smooth';
            isJumping = false;
          });
        }
      }, 10);
    });
  });
}

document.addEventListener('DOMContentLoaded', function() {
  setupAnimateImagesObserver();
  setupInfiniteScrollForSearch();
  
  // Call again after infinite scroll setup (with delay to ensure DOM is ready)
  setTimeout(setupAnimateImagesObserver, 1500);
  setTimeout(setupAnimateImagesObserver, 3000);
  setTimeout(setupInfiniteScrollForSearch, 1000);
  setTimeout(setupInfiniteScrollForSearch, 2000);
});

// Also call when search results are updated (for dynamic content)
if (typeof window.setupInfiniteScrollForSearch === 'undefined') {
  window.setupInfiniteScrollForSearch = setupInfiniteScrollForSearch;
}
</script>

<style>
  @media screen and (min-width: 550px) {
  .updated-product-item.product-item .mobile_images{
  display: none !important;
}
  }
  @media screen and (max-width: 549px) {
    .updated-product-item.product-item .product-item__secondary-image, .updated-product-item.product-item .product-item__primary-image {
      display: none !important;
    }
    @keyframes peekAnimation {
    0% { transform: translateZ(0); }
  50% { transform: translate3d(-25%, 0, 0); }
  100% { transform: translateZ(0); }
}

.updated-product-item.product-item .product-item__aspect-ratio.animate_images .mobile_images.clc-Items_Items-animate:not(.clone-image) {
  animation: peekAnimation 1s ease-in-out;
  animation-delay: 2s;
}

/* Ensure cloned images don't interfere with animation */
.updated-product-item.product-item .product-item__aspect-ratio.animate_images .mobile_images.clone-image {
  animation: none;
}

/* Prevent scroll-snap during animation to avoid conflicts */
.updated-product-item.product-item .product-item__aspect-ratio.animate_images {
  {% comment %} scroll-snap-type: none !important; {% endcomment %}
}
    .updated-product-item.product-item .product-item__aspect-ratio{
      display: flex;
    -ms-overflow-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    }
    .updated-product-item.product-item .mobile_images{
    flex-shrink: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    width: 100%;
    position: unset;
    }
  }
</style>
{% endif %}