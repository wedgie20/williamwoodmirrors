<script>
if (!window.__wwMiniCartCheckoutInit) {
  window.__wwMiniCartCheckoutInit = true;

  document.addEventListener('click', function (event) {
    const button = event.target.closest('.checkout-action-button');

    if (!button) return; // clicked element isn't the button

    event.preventDefault();

    // Prevent double execution
    if (button.classList.contains('button--clicked')) return;

    button.classList.add('button--clicked');

    // Redirect to checkout after short delay
    setTimeout(() => {
      window.location.href = '/checkout';
    }, 300);
  });
}


</script>

<script>
if (!window.__wwFreeGiftDrawerInit) {
  window.__wwFreeGiftDrawerInit = true;

  const wwGetFreeGiftShell = () => document.querySelector('[data-ww-free-gift-shell]');

  const wwOpenFreeGiftDrawer = () => {
    const shell = wwGetFreeGiftShell();
    if (!shell) return;

    const drawer = shell.querySelector('[data-ww-free-gift-drawer]');
    const triggers = document.querySelectorAll('[data-ww-free-gift-open]');

    shell.hidden = false;
    requestAnimationFrame(() => shell.classList.add('is-open'));

    if (drawer) drawer.setAttribute('aria-hidden', 'false');
    triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'true'));
  };

  const wwCloseFreeGiftDrawer = () => {
    const shell = wwGetFreeGiftShell();
    if (!shell) return;

    const drawer = shell.querySelector('[data-ww-free-gift-drawer]');
    const triggers = document.querySelectorAll('[data-ww-free-gift-open]');

    shell.classList.remove('is-open');
    if (drawer) drawer.setAttribute('aria-hidden', 'true');
    triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));

    window.setTimeout(() => {
      if (!shell.classList.contains('is-open')) shell.hidden = true;
    }, 260);
  };

  document.addEventListener('click', (event) => {
    const opener = event.target.closest('[data-ww-free-gift-open]');
    if (opener) {
      event.preventDefault();
      wwOpenFreeGiftDrawer();
      return;
    }

    if (event.target.closest('[data-ww-free-gift-close]')) {
      event.preventDefault();
      wwCloseFreeGiftDrawer();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') wwCloseFreeGiftDrawer();
  });

  document.addEventListener('submit', (event) => {
    const form = event.target.closest('[data-ww-free-gift-form]');
    if (!form) return;

    event.preventDefault();

    const submitButton = form.querySelector('[data-ww-free-gift-submit]');
    if (!submitButton || submitButton.disabled) return;

    const originalLabel = submitButton.textContent;
    const routes = (window.themeVariables && window.themeVariables.routes) || {};
    const settings = (window.themeVariables && window.themeVariables.settings) || {};
    const addUrl = routes.cartAddUrl ? `${routes.cartAddUrl}.js` : '/cart/add.js';
    const cartUrl = routes.cartUrl ? `${routes.cartUrl}.js` : '/cart.js';
    const formData = new FormData(form);

    formData.append('sections', 'mini-cart');
    formData.append('sections_url', window.location.pathname);

    submitButton.disabled = true;
    submitButton.textContent = 'ADDING...';

    fetch(addUrl, {
      method: 'POST',
      body: formData,
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then((response) => response.json().then((data) => ({ ok: response.ok, data })))
      .then((result) => {
        if (!result.ok) {
          submitButton.textContent = (result.data && result.data.description) || 'TRY AGAIN';
          window.setTimeout(() => {
            submitButton.textContent = originalLabel;
            submitButton.disabled = false;
          }, 1800);
          return null;
        }

        form.dispatchEvent(new CustomEvent('variant:added', {
          bubbles: true,
          detail: {
            variant: Object.prototype.hasOwnProperty.call(result.data, 'items') ? result.data.items[0] : result.data
          }
        }));

        submitButton.textContent = 'ADDED';
        wwCloseFreeGiftDrawer();

        return fetch(cartUrl)
          .then((response) => response.json())
          .then((cartContent) => {
            document.documentElement.dispatchEvent(new CustomEvent('cart:updated', {
              bubbles: true,
              detail: { cart: cartContent }
            }));

            cartContent.sections = result.data.sections;
            document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
              bubbles: true,
              detail: {
                cart: cartContent,
                openMiniCart: settings.cartType === 'drawer'
              }
            }));
          });
      })
      .catch(() => {
        submitButton.textContent = 'TRY AGAIN';
        window.setTimeout(() => {
          submitButton.textContent = originalLabel;
          submitButton.disabled = false;
        }, 1800);
      });
  });
}
</script>



