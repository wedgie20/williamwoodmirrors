<style>
  #shopify-section-{{ section.id }} {
    --section-overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --section-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    background-color: {{ section.settings.background }};
  }

  #shopify-section-{{ section.id }} .collection-banner__title {
    {% if section.settings.custom_heading_font != "Select Font" %}
      font-family: {{ section.settings.custom_heading_font }};
    {% endif %}
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.text_color }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

 #shopify-section-{{ section.id }} .collection-banner__subheading p {
    {% if section.settings.custom_subheading_font != "Select Font" %}
      font-family: {{ section.settings.custom_subheading_font }};
    {% endif %}
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    color: {{ section.settings.text_color }};
    letter-spacing: {{ section.settings.subheading_letter_spacing }}px;
        line-height: 14.7692px;
  }

  #shopify-section-{{ section.id }} .collection-banner__description {
    {% if section.settings.custom_description_font != "Select Font" %}
      font-family: {{ section.settings.custom_description_font }};
    {% endif %}
    font-size: {{ section.settings.description_size }}px;
    font-weight: {{ section.settings.description_weight }};
    color: {{ section.settings.text_color }};
    letter-spacing: {{ section.settings.description_letter_spacing }}px;
  }

  #shopify-section-{{ section.id }} .collection-banner__button {
    {% if section.settings.custom_button_font != "Select Font" %}
      font-family: {{ section.settings.custom_button_font }};
    {% endif %}
    font-size: {{ section.settings.button_size }}px;
    font-weight: {{ section.settings.button_weight }};
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
  }

  .collection-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .collection-banner__image-wrapper {
    position: relative;
    width: 100%;
  }

  .collection-banner__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    min-height: 330px;
  }

  .collection-banner__image--mobile {
    display: none;
  }

  .collection-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(var(--section-overlay-color), var(--section-overlay-opacity));
  }

  .collection-banner__content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.vertical_position }};
    align-items: {{ section.settings.horizontal_position }};
    padding: 40px;
    text-align: {{ section.settings.text_alignment }};
  }

  .collection-banner__text-wrapper {
    max-width: 800px;
  }

  .collection-banner__title {
    margin: 0 0 8px 0;
    text-transform: uppercase;
  }

  .collection-banner__subheading p {
    margin: 0 0 12px 0;
    text-transform: uppercase;
  }

  .collection-banner__description {
    margin: 0 0 20px 0;
    line-height: 1.6;
  }

  .collection-banner__button {
    display: inline-block;
    padding: 12px 30px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .collection-banner__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 740px) {
    .collection-banner__image--desktop {
      display: none;
    }

    .collection-banner__image--mobile {
      display: block;
    }

    .collection-banner__content {
      padding: 30px 20px;
    }

    .collection-banner__title {
      font-size: {{ section.settings.heading_size_mobile }}px !important;
    }

    .collection-banner__subheading p {
      font-size: {{ section.settings.subheading_size_mobile }}px !important;
    }

    .collection-banner__description p {
      font-size: {{ section.settings.description_size_mobile }}px !important;
    }
    .collection-banner__text-wrapper {
    margin-left: 24px;
}
  }
  @media screen and (min-width: 741px) {
.collection-banner__text-wrapper {
    margin-left: calc(var(--grid-column-width) + var(--grid-gap));
}
}
</style>

<section class="collection-banner">
  <div class="collection-banner__image-wrapper">
    {%- if section.settings.image != blank -%}
      <img 
        class="collection-banner__image collection-banner__image--desktop" 
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.image | image_url: width: 2000 }}" 
        alt="{{ section.settings.title | escape }}"
        loading="eager"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'collection-banner__image collection-banner__image--desktop' }}
    {%- endif -%}

    {%- if section.settings.mobile_image != blank -%}
      <img 
        class="collection-banner__image collection-banner__image--mobile" 
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.mobile_image | image_url: width: 1000 }}" 
        alt="{{ section.settings.title | escape }}"
        loading="eager"
        width="{{ section.settings.mobile_image.width }}"
        height="{{ section.settings.mobile_image.height }}"
      >
    {%- elsif section.settings.image != blank -%}
      <img 
        class="collection-banner__image collection-banner__image--mobile" 
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.image | image_url: width: 1000 }}" 
        alt="{{ section.settings.title | escape }}"
        loading="eager"
      >
    {%- endif -%}

    <div class="collection-banner__overlay"></div>

    <div class="collection-banner__content">
      <div class="collection-banner__text-wrapper">
        {%- if section.settings.title != blank -%}
          <h1 class="collection-banner__title">{{ section.settings.title }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="collection-banner__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="collection-banner__description">{{ section.settings.description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</div>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="collection-banner__button">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Collection Banner",
  "class": "shopify-section--collection-banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
