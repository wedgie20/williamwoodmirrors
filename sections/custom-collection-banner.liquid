      "options": [
        { "value": "Select Font", "label": "Default" },
        { "value": "Zurich, sans-serif", "label": "Zurich" },
        { "value": "GothamBlack", "label": "Gotham Black" },
        { "value": "altesse-std-24pt", "label": "Altesse" },
        { "value": "Ambroise", "label": "Ambroise" }
      ],
      "default": "GothamBlack"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size (Desktop)",
      "min": 16,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "900", "label": "Extra Bold" }
      ],
      "default": "700"
    },
    {
      "type": "range",
