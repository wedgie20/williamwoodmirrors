{%- liquid
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
-%}

<section id="trade-benefits" class="ww-trade-why" data-ww-trade-why>
  <div class="ww-trade-why__container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="ww-trade-why__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if benefit_blocks.size > 0 -%}
      <div class="ww-trade-why__grid">
        {%- for block in benefit_blocks -%}
          <article class="ww-trade-why__item" {{ block.shopify_attributes }}>
            <div class="ww-trade-why__image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}">
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'ww-trade-why__placeholder' }}
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="ww-trade-why__item-body">{{ block.settings.body }}</div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-why {
    --ww-trade-text-font: var(--text-font-family, "Gotham Book", Arial, sans-serif);
    --ww-trade-heading-font: var(--heading-font-family, "GothamBlack", "Gotham Book", Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-text-weight: var(--text-font-weight, 400);
    --ww-trade-body-size: var(--base-font-size, 14px);
    padding: 64px 0 96px;
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .ww-trade-why * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__container {
    {% comment %} width: min(100%, 1320px); {% endcomment %}
    margin: 0 auto;
    padding: 0 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-why h2 {
    margin: 0 0 34px;
    color: #000;
    font-family: var(--ww-trade-heading-font);
    font-size: var(--heading-h2-font-size, 54px);
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.1333333333;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__body {
    max-width: 720px;
    margin: -16px 0 34px;
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__body p,
  #shopify-section-{{ section.id }} .ww-trade-why__item-body p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__item {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__image {
    aspect-ratio: 1 / 1;
    margin-bottom: 20px;
    overflow: hidden;
    background: #f3f3f3;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__image img,
  #shopify-section-{{ section.id }} .ww-trade-why__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__placeholder {
    fill: #d8d8d8;
  }

  #shopify-section-{{ section.id }} .ww-trade-why h3 {
    max-width: 94%;
    margin: 0;
    color: #000;
    font-family: var(--ww-trade-heading-font);
    font-size: var(--heading-h3-font-size, 24px);
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.3;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-why__item-body {
    margin-top: 12px;
    font-size: calc(var(--ww-trade-body-size) - 1px);
    line-height: 1.7142857143;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ww-trade-why {
      padding: 56px 0 72px;
    }

    #shopify-section-{{ section.id }} .ww-trade-why__container {
      padding: 0 28px;
    }

    #shopify-section-{{ section.id }} .ww-trade-why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-why {
      padding: 46px 0 56px;
    }

    #shopify-section-{{ section.id }} .ww-trade-why__container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .ww-trade-why h2 {
      font-size: var(--heading-h2-font-size, 32px);
    }

    #shopify-section-{{ section.id }} .ww-trade-why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

