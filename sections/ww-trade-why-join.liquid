      "default": "Why join?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tailored service with direct access to sales support & advice"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why join",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
