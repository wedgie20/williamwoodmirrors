{% schema %}
{
  "name": "Social Proof Scroller",
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (px)",
      "default": 140,
      "min": 80,
      "max": 300,
      "step": 10
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Logo spacing (px)",
      "default": 20,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation speed (desktop)",
      "default": 20,
      "min": 5,
      "max": 60,
      "step": 1
    },
    {
      "type": "range",
      "id": "animation_speed_mobile",
      "label": "Animation speed (mobile)",
      "default": 30,
      "min": 5,
      "max": 60,
      "step": 1
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Social Proof Scroller",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div
  class="infinite-logo-scroller"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="logo-track">
    {% capture slides %}
      {% for block in section.blocks %}
        {% if block.settings.logo %}
          <div class="logo-slide">
            <img
              src="{{ block.settings.logo | img_url: '300x' }}"
              alt="{{ block.settings.logo.alt | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}
      {% endfor %}
    {% endcapture %}

    {{ slides }}
    {{ slides }}
  </div>
</div>

<style>
.infinite-logo-scroller {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.logo-track {
  display: flex;
  width: 200%;
  gap: {{ section.settings.logo_spacing }}px;
  animation: scroll {{ section.settings.animation_speed }}s linear infinite;
  will-change: transform;
  transform: translate3d(0, 0, 0);
}

.logo-slide {
  flex: 0 0 auto;
  width: {{ section.settings.logo_width }}px;
}

.logo-slide img {
  width: 100%;
  height: auto;
  display: block;
  backface-visibility: hidden;
}

@keyframes scroll {
  from {
    transform: translate3d(0, 0, 0);
  }
  to {
    transform: translate3d(-50%, 0, 0);
  }
}

@media (max-width: 768px) {
  .logo-track {
    animation-duration: {{ section.settings.animation_speed_mobile }}s;
  }
}

/* Optional: accessibility */
@media (prefers-reduced-motion: reduce) {
  .logo-track {
    animation: none;
  }
}
</style>
