{% schema %}
{
  "name": "Social Proof Scroller2",
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "number_of_logos",
      "label": "Number of Logos",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 0.5
    },
    {
      "type": "range",
      "id": "logo_spacing_px",
      "label": "Logo Spacing (px)",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed (Desktop)",
      "default": 10,
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "type": "range",
      "id": "scroll_speed_mobile",
      "label": "Scroll Speed (Mobile)",
      "default": 15,
      "min": 1,
      "max": 50,
      "step": 1
    },
    {
      "type": "color",
      "id": "background_color_hex",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "logo_image_size",
      "label": "Logo Image Size",
      "default": "200x200"
    }
  ],
  "presets": [
    {
      "name": "Social Proof Scroller2",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="infinite-logo-scroller" style="background-color: {{ section.settings.background_color_hex }};">
  <div class="logo-track">
    {% assign logo_count = 0 %}
    {% capture logo_slides %}
    {% for block in section.blocks %}
      {% assign logo_image = block.settings.logo_image  %}
      {% if logo_image %}
        {% assign logo_count = logo_count | plus: 1 %}
        <div class="logo-slide">
          <img src="{{ settings.speedsize_url_pfx_https -}}{{ logo_image | img_url: section.settings.logo_image_size }}" alt="{{ logo_image.alt }}">
        </div>
      {% endif %}
    {% endfor %}
    {%  endcapture %}
    {{ logo_slides }}
    {{ logo_slides }}
    {% if logo_count < section.settings.number_of_logos %}
      {{ logo_slides }}
    {% endif %}
  </div>
</div>

<style>
  .infinite-logo-scroller {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .logo-track {
    display: flex;
    animation: scroll {{ section.settings.scroll_speed }}s linear infinite;
    width: fit-content;
    will-change: transform;
  }

  .logo-slide {
    flex: 0 0 auto;
    {% comment %} width: calc(100vw / {{ section.settings.number_of_logos }} - {{ section.settings.logo_spacing_px }}px); {% endcomment %}
    margin-right: {{ section.settings.logo_spacing_px }}px;
  }

  .logo-slide img {
    width: 100%;
    height: auto;
    backface-visibility: hidden;
  }

  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (max-width: 768px) {
    .logo-track {
      animation: scroll {{ section.settings.scroll_speed_mobile }}s linear infinite;
    }
  }
</style>