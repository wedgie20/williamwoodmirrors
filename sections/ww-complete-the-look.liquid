{%- assign ctl_products = product.metafields.custom.related_products.value -%}

<div class="ctl-section" id="ctl-{{ section.id }}">
  <div class="ctl-inner">
    <div class="ctl-box">

      <div class="ctl-header">
        <h2 class="ctl-heading">{{ section.settings.title }}</h2>
        <div class="ctl-arrows" id="ctl-arrows-{{ section.id }}" hidden>
          <button class="ctl-arrow ctl-arrow--prev" id="ctl-prev-{{ section.id }}" aria-label="Previous" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="ctl-arrow ctl-arrow--next" id="ctl-next-{{ section.id }}" aria-label="Next">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="ctl-track" id="ctl-track-{{ section.id }}">
        {%- if ctl_products != blank -%}
          {%- for rp in ctl_products -%}
            <div class="ctl-card">
              <a href="{{ rp.url }}" class="ctl-card__img-wrap" tabindex="-1">
                {%- if rp.featured_image -%}
                  {{ rp.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'ctl-card__img', alt: rp.featured_image.alt, widths: '150,200,300' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'ctl-card__img ctl-card__img--placeholder' }}
                {%- endif -%}
              </a>
              <div class="ctl-card__body">
                <a href="{{ rp.url }}" class="ctl-card__title">{{ rp.title }}</a>
                <span class="ctl-card__price">{{ rp.price | money }}</span>
                <div class="ctl-card__footer">
                  {%- if rp.available and rp.has_only_default_variant -%}
                    <button
                      class="ctl-card__atc"
                      data-variant-id="{{ rp.selected_or_first_available_variant.id }}"
                      aria-label="Add to cart">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                      </svg>
                    </button>
                  {%- else -%}
                    <a href="{{ rp.url }}" class="ctl-card__atc" aria-label="View product">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                      </svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="ctl-empty">No related products have been added yet.</div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  .ctl-section {
    padding: 40px 0;
  }
  .ctl-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Bordered box wrapping header + grid */
  .ctl-box {
    border: 1px solid #d8d8d8;
    overflow: hidden;
  }

  /* Header */
  .ctl-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid #d8d8d8;
  }
  .ctl-heading {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
    margin: 0;
  }
  .ctl-arrows {
    display: flex;
    gap: 4px;
  }
  .ctl-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #111;
    padding: 0;
    transition: opacity 0.2s;
  }
  .ctl-arrow[disabled] { opacity: 0.3; cursor: default; }
  .ctl-arrow:hover:not([disabled]) { opacity: 0.6; }

  /* Product grid */
  .ctl-track {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #d8d8d8;
  }

  .ctl-empty {
    grid-column: 1 / -1;
    padding: 32px;
    text-align: center;
    font-size: 13px;
    color: #999;
    background: #fff;
  }

  /* Card */
  .ctl-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px 24px;
    background: #fff;
  }
  .ctl-card__img-wrap {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    overflow: hidden;
    display: block;
    background: #f5f5f5;
  }
  .ctl-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ctl-card__img-wrap:hover .ctl-card__img { transform: scale(1.05); }
  .ctl-card__img--placeholder { width: 100%; height: 100%; }

  .ctl-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 100px;
  }
  .ctl-card__title {
    font-size: 13px;
    font-weight: 400;
    color: #111;
    text-decoration: none;
    line-height: 1.4;
    display: block;
    margin-bottom: 4px;
  }
  .ctl-card__title:hover { text-decoration: underline; }
  .ctl-card__price {
    font-size: 13px;
    color: #111;
    display: block;
    font-weight: 400;
  }
  .ctl-card__footer {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    justify-content: flex-end;
  }
  .ctl-card__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }
  .ctl-card__atc:hover { background: #333; }
  .ctl-card__atc.is-loading { opacity: 0.6; cursor: not-allowed; }
  .ctl-card__atc.is-added { background: #2e9e7b; }

  @media screen and (max-width: 740px) {
    .ctl-section { padding: 24px 0; }
    .ctl-inner { padding: 0 16px; }
    .ctl-track { grid-template-columns: 1fr; }
    .ctl-card__img-wrap { width: 85px; height: 85px; }
  }
</style>

<script>
(function () {
  var PER_PAGE = 4;
  var track    = document.getElementById('ctl-track-{{ section.id }}');
  if (!track) return;

  var cards      = Array.from(track.querySelectorAll('.ctl-card'));
  if (!cards.length) return;

  var totalPages = Math.ceil(cards.length / PER_PAGE);
  var current    = 0;

  var arrowsEl = document.getElementById('ctl-arrows-{{ section.id }}');
  var prevBtn  = document.getElementById('ctl-prev-{{ section.id }}');
  var nextBtn  = document.getElementById('ctl-next-{{ section.id }}');

  function showPage(page) {
    cards.forEach(function (card, idx) {
      card.style.display = (idx >= page * PER_PAGE && idx < (page + 1) * PER_PAGE) ? '' : 'none';
    });
    current = page;
    if (prevBtn) prevBtn.disabled = (page === 0);
    if (nextBtn) nextBtn.disabled = (page >= totalPages - 1);
  }

  if (arrowsEl && totalPages > 1) arrowsEl.hidden = false;
  showPage(0);

  if (prevBtn) prevBtn.addEventListener('click', function () { if (current > 0) showPage(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { if (current < totalPages - 1) showPage(current + 1); });

  track.addEventListener('click', function (e) {
    var btn = e.target.closest('.ctl-card__atc[data-variant-id]');
    if (!btn || btn.classList.contains('is-loading')) return;

    btn.classList.add('is-loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: btn.dataset.variantId, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.classList.remove('is-loading');
      btn.classList.add('is-added');
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart, openMiniCart: true } }));
        });
      setTimeout(function () { btn.classList.remove('is-added'); }, 2000);
    })
    .catch(function () { btn.classList.remove('is-loading'); });
  });
})();
</script>

{% schema %}
{
  "name": "Complete the Look",
  "tag": "div",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "COMPLETE THE LOOK"
    }
  ],
  "presets": [
    {
      "name": "Complete the Look"
    }
  ]
}
{% endschema %}
