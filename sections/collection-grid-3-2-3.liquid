{%- liquid
  assign section_id = 'cg323-' | append: section.id
  assign gap = section.settings.gap | default: 16
  assign mobile_gap = section.settings.mobile_gap | default: 10
-%}

<section
  id="{{ section_id }}"
  class="cg323"
  style="
    --cg323-gap: {{ gap }}px;
    --cg323-mobile-gap: {{ mobile_gap }}px;
    --cg323-pad-top: {{ section.settings.padding_top }}px;
    --cg323-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cg323-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --cg323-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cg323-bg: {{ section.settings.background }};
    --cg323-text: {{ section.settings.text_color }};
    --cg323-overlay: {{ section.settings.overlay_color }};
    --cg323-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cg323-radius: {{ section.settings.corner_radius }}px;
    --cg323-title-size: {{ section.settings.title_size }}px;
    --cg323-title-size-mobile: {{ section.settings.title_size_mobile }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="cg323__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="cg323__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cg323__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="cg323__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign d_span = block.settings.desktop_span | plus: 0
        assign m_span = block.settings.mobile_span | plus: 0
        assign min_h = block.settings.min_height | default: 320
        assign min_h_m = block.settings.min_height_mobile | default: 220
        assign overlay = block.settings.show_overlay
        assign mobile_image = block.settings.image_mobile | default: block.settings.image
        assign shop_scene_enabled = true
        if block.settings.shop_scene_enable == false
          assign shop_scene_enabled = false
        endif
        assign shop_scene_source = block.settings.shop_scene_source | default: 'card_link'
        assign shop_scene_products = empty
        assign shop_scene_count = 0
        assign shop_scene_limit = block.settings.shop_scene_product_limit | default: 12
        assign shop_scene_thumb_count = block.settings.shop_scene_thumb_count | default: 3
        assign shop_scene_collection_handle = ''
        assign shop_scene_collection = blank

        if shop_scene_source == 'card_link' and block.settings.link != blank
          assign card_link_url = block.settings.link | append: ''
          if card_link_url contains '/collections/'
            assign shop_scene_collection_handle = card_link_url | split: '/collections/' | last | split: '?' | first | split: '#' | first
          endif
          if shop_scene_collection_handle != blank
            assign shop_scene_collection = collections[shop_scene_collection_handle]
          endif
        elsif shop_scene_source == 'collection' and block.settings.shop_scene_collection != blank
          assign shop_scene_collection = block.settings.shop_scene_collection
        endif

        if shop_scene_source == 'products' and block.settings.shop_scene_products != blank and block.settings.shop_scene_products.size > 0
          assign shop_scene_products = block.settings.shop_scene_products
          assign shop_scene_count = block.settings.shop_scene_products.size
        elsif shop_scene_collection != blank
          assign shop_scene_products = shop_scene_collection.products
          assign shop_scene_count = shop_scene_collection.products_count
        endif

        assign has_shop_scene = false
        if shop_scene_enabled and shop_scene_products != empty
          assign has_shop_scene = true
        endif
      -%}
      {%- capture card_inner -%}
        <div class="cg323__card-media">
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image_mobile | image_url: width: 800 }}">
              {%- endif -%}
              <img
                src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | image_url: width: 1400 }}"
                alt="{{ block.settings.title | default: block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            </picture>
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'cg323__placeholder' }}
          {%- endif -%}
          {%- if overlay -%}<span class="cg323__overlay"></span>{%- endif -%}
        </div>
        {%- if block.settings.title != blank or has_shop_scene -%}
          <div class="cg323__card-header{% if has_shop_scene %} cg323__card-header--has-scene{% endif %}">
            {%- if block.settings.title != blank -%}
              <span class="cg323__card-title" style="color: {{ block.settings.title_color | default: section.settings.text_color }};">
                {{- block.settings.title -}}
              </span>
            {%- endif -%}
            {%- if has_shop_scene -%}
              <button
                class="cg323__shop-scene"
                type="button"
                data-cg323-scene-toggle="{{ section.id }}-{{ block.id }}"
                aria-expanded="false"
                aria-controls="cg323-scene-{{ section.id }}-{{ block.id }}"
              >
                <span>{{ block.settings.shop_scene_label | default: 'Shop scene' }} ({{ shop_scene_count }})</span>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="18" height="18">
                  <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {%- if shop_scene_thumb_count > 0 -%}
                  <span class="cg323__shop-scene-thumbs" aria-hidden="true">
                    {%- for product in shop_scene_products limit: shop_scene_thumb_count -%}
                      {%- if product.featured_image -%}
                        {{ product.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: product.featured_image.alt, widths: '48, 72, 96' | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated }}
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                {%- endif -%}
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if block.settings.show_arrow -%}
          {%- unless has_shop_scene -%}
            <span class="cg323__card-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
                <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          {%- endunless -%}
        {%- endif -%}
      {%- endcapture -%}

      <div
        class="cg323__card cg323__card--span-{{ d_span }} cg323__card--mobile-span-{{ m_span }}{% if has_shop_scene %} cg323__card--has-scene{% endif %}{% if block.settings.link == blank %} cg323__card--no-link{% endif %}"
        style="--d-span: {{ d_span }}; --m-span: {{ m_span }}; --min-h: {{ min_h }}px; --min-h-m: {{ min_h_m }}px;"
        {{ block.shopify_attributes }}
      >
        {{ card_inner }}
        {%- if block.settings.link != blank -%}
          <a class="cg323__card-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}"></a>
        {%- endif -%}
      </div>

      {%- if shop_scene_enabled and shop_scene_products != empty -%}
        <div
          id="cg323-scene-{{ section.id }}-{{ block.id }}"
          class="cg323__scene-drawer"
          data-cg323-scene-drawer="{{ section.id }}-{{ block.id }}"
          aria-hidden="true"
        >
          <button class="cg323__scene-backdrop" type="button" data-cg323-scene-close="{{ section.id }}-{{ block.id }}" aria-label="Close shop scene"></button>
          <div class="cg323__scene-panel" role="dialog" aria-modal="true" aria-label="{{ block.settings.shop_scene_title | default: block.settings.title | escape }}">
            <div class="cg323__scene-header">
              <span>{{ block.settings.shop_scene_title | default: block.settings.title }} ({{ shop_scene_count }})</span>
              <button class="cg323__scene-close" type="button" data-cg323-scene-close="{{ section.id }}-{{ block.id }}" aria-label="Close">
                <svg viewBox="0 0 24 24" fill="none" width="22" height="22" aria-hidden="true">
                  <path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <div class="cg323__scene-products">
              {%- for product in shop_scene_products limit: shop_scene_limit -%}
                <div class="cg323__scene-product">
                  <a href="{{ product.url }}" class="cg323__scene-product-image" tabindex="-1">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.featured_image.alt, widths: '250, 360, 500' | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </a>
                  <div class="cg323__scene-product-info">
                    <a href="{{ product.url }}" class="cg323__scene-product-title">{{ product.title }}</a>
                    <p class="cg323__scene-product-price">{{ product.price | money }}</p>
                    {%- if product.available == false -%}
                      <button class="cg323__scene-product-action" type="button" disabled>Sold out</button>
                    {%- elsif product.variants.size > 1 or product.has_only_default_variant == false -%}
                      <a class="cg323__scene-product-action" href="{{ product.url }}">View details</a>
                    {%- else -%}
                      {%- assign first_variant = product.selected_or_first_available_variant -%}
                      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ first_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button class="cg323__scene-product-action" type="submit">Add to bag</button>
                      </form>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .cg323 {
    background: var(--cg323-bg, transparent);
    color: var(--cg323-text, #111);
    padding: var(--cg323-pad-top, 60px) 24px var(--cg323-pad-bottom, 60px);
    box-sizing: border-box;
    width: 100%;
  }
  .cg323__header {
    text-align: center;
    margin-bottom: 32px;
  }
  .cg323__heading {
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 8px;
    color: var(--cg323-text, #111);
  }
  .cg323__subheading {
    font-size: 16px;
    opacity: 0.85;
  }
  .cg323__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: auto;
    gap: var(--cg323-gap, 16px);
    max-width: 1600px;
    margin: 0 auto;
  }
  .cg323__card {
    grid-column: span var(--d-span, 2);
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--cg323-radius, 0px);
    text-decoration: none;
    color: inherit;
    min-height: var(--min-h, 320px);
    isolation: isolate;
    transition: transform 0.4s ease;
  }
  .cg323__card:hover { transform: translateY(-2px); }
  .cg323__card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .cg323__card-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cg323__card-media img,
  .cg323__card-media .cg323__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .cg323__card:hover .cg323__card-media img { transform: scale(1.04); }
  .cg323__overlay {
    position: absolute;
    inset: 0;
    background: var(--cg323-overlay, #000);
    opacity: var(--cg323-overlay-opacity, 0.15);
    pointer-events: none;
  }
  .cg323__card-header {
    position: relative;
    padding: 18px 22px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    box-sizing: border-box;
    pointer-events: none;
  }
  .cg323__card-header--has-scene {
    flex-wrap: wrap;
  }
  .cg323__card-title {
    display: inline-block;
    min-width: 0;
    font-family: var(--heading-font-family, inherit);
    font-size: var(--cg323-title-size, 28px);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.1;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .cg323__card-arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    pointer-events: none;
  }
  .cg323__card:hover .cg323__card-arrow { background: #fff; }
  .cg323-scene-open {
    overflow: hidden;
  }
  .cg323__shop-scene {
    position: relative;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    flex: 0 1 auto;
    gap: 12px;
    max-width: 100%;
    padding: 8px 12px 8px 18px;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.48);
    color: #fff;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: auto;
  }
  .cg323__shop-scene > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cg323__shop-scene svg {
    flex: 0 0 auto;
  }
  .cg323__shop-scene-thumbs {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .cg323__shop-scene-thumbs img {
    width: 34px;
    height: 34px;
    border-radius: 4px;
    object-fit: cover;
    background: #fff;
  }
  .cg323__card--span-1 .cg323__card-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }
  .cg323__card--span-1 .cg323__shop-scene {
    gap: 8px;
    padding: 7px 9px 7px 12px;
    font-size: 10px;
    letter-spacing: 0.08em;
  }
  .cg323__card--span-1 .cg323__shop-scene > span:first-child {
    max-width: 76px;
    white-space: normal;
  }
  .cg323__card--span-1 .cg323__shop-scene-thumbs img {
    width: 26px;
    height: 26px;
  }
  .cg323__card--span-2 .cg323__shop-scene {
    gap: 9px;
    padding: 7px 10px 7px 13px;
    font-size: 11px;
    letter-spacing: 0.09em;
  }
  .cg323__card--span-2 .cg323__shop-scene-thumbs img {
    width: 30px;
    height: 30px;
  }
  .cg323__scene-drawer {
    position: fixed;
    inset: 0;
    z-index: 999999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .cg323__scene-drawer.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  .cg323__scene-backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.45);
    cursor: pointer;
  }
  .cg323__scene-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(430px, 92vw);
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    color: #111;
    transform: translateX(100%);
    transition: transform 0.28s ease;
  }
  .cg323__scene-drawer.is-open .cg323__scene-panel {
    transform: translateX(0);
  }
  .cg323__scene-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid #e6e1dc;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cg323__scene-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: #f1f1f1;
    color: #111;
    cursor: pointer;
  }
  .cg323__scene-products {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 18px 20px 24px;
    overflow-y: auto;
  }
  .cg323__scene-product {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 14px;
    align-items: start;
  }
  .cg323__scene-product-image {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f1ed;
  }
  .cg323__scene-product-image img,
  .cg323__scene-product-image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cg323__scene-product-title {
    display: block;
    color: inherit;
    font-size: 13px;
    line-height: 1.35;
    text-decoration: none;
  }
  .cg323__scene-product-price {
    margin: 6px 0 12px;
    font-size: 13px;
    font-weight: 700;
  }
  .cg323__scene-product-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: #111;
    color: #fff;
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cg323__scene-product-action:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  @media (max-width: 767px) {
    .cg323 {
      padding: var(--cg323-pad-top-mobile, 40px) 12px var(--cg323-pad-bottom-mobile, 40px);
    }
    .cg323__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--cg323-mobile-gap, 10px);
    }
    .cg323__card {
      grid-column: span var(--m-span, 1);
      min-height: var(--min-h-m, 220px);
    }
    .cg323__card-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      padding: 12px 14px;
    }
    .cg323__card--mobile-span-2 .cg323__card-header--has-scene {
      align-items: center;
      flex-direction: row;
    }
    .cg323__card-title {
      font-size: var(--cg323-title-size-mobile, 18px);
    }
    .cg323__card-arrow {
      width: 28px;
      height: 28px;
      right: 10px;
      bottom: 10px;
    }
    .cg323__shop-scene {
      gap: 8px;
      padding: 7px 9px 7px 12px;
      font-size: 10px;
      letter-spacing: 0.08em;
    }
    .cg323__shop-scene-thumbs img {
      width: 26px;
      height: 26px;
    }
    .cg323__scene-product {
      grid-template-columns: 92px 1fr;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById({{ section_id | json }});
    if (!section) return;

    const setDrawer = (key, open) => {
      const drawer = document.querySelector(`[data-cg323-scene-drawer="${key}"]`);
      const toggle = section.querySelector(`[data-cg323-scene-toggle="${key}"]`);
      if (!drawer) return;
      drawer.classList.toggle('is-open', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.documentElement.classList.toggle('cg323-scene-open', open);
    };

    section.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-cg323-scene-toggle]');
      if (!toggle) return;
      event.preventDefault();
      event.stopPropagation();
      setDrawer(toggle.dataset.cg323SceneToggle, true);
    });

    document.addEventListener('click', (event) => {
      const close = event.target.closest('[data-cg323-scene-close]');
      if (!close) return;
      setDrawer(close.dataset.cg323SceneClose, false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      document.querySelectorAll('.cg323__scene-drawer.is-open').forEach((drawer) => {
        setDrawer(drawer.dataset.cg323SceneDrawer, false);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection Grid 3-2-3",
  "tag": "section",
  "class": "section-collection-grid-3-2-3",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 10
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Card title size – desktop (px)",
      "min": 14,
      "max": 56,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Card title size – mobile (px)",
      "min": 12,
      "max": 36,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top – desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
