{%- liquid
  assign section_id = 'cg323-' | append: section.id
  assign gap = section.settings.gap | default: 16
  assign mobile_gap = section.settings.mobile_gap | default: 10
-%}

<section
  id="{{ section_id }}"
  class="cg323"
  style="
    --cg323-gap: {{ gap }}px;
    --cg323-mobile-gap: {{ mobile_gap }}px;
    --cg323-pad-top: {{ section.settings.padding_top }}px;
    --cg323-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cg323-pad-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --cg323-pad-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --cg323-bg: {{ section.settings.background }};
    --cg323-text: {{ section.settings.text_color }};
    --cg323-overlay: {{ section.settings.overlay_color }};
    --cg323-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cg323-radius: {{ section.settings.corner_radius }}px;
    --cg323-title-size: {{ section.settings.title_size }}px;
    --cg323-title-size-mobile: {{ section.settings.title_size_mobile }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="cg323__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="cg323__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="cg323__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="cg323__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign d_span = block.settings.desktop_span | plus: 0
        assign m_span = block.settings.mobile_span | plus: 0
        assign min_h = block.settings.min_height | default: 320
        assign min_h_m = block.settings.min_height_mobile | default: 220
        assign overlay = block.settings.show_overlay
        assign mobile_image = block.settings.image_mobile | default: block.settings.image
      -%}
      {%- capture card_inner -%}
        <div class="cg323__card-media">
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.image_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image_mobile | image_url: width: 800 }}">
              {%- endif -%}
              <img
                src="{{ settings.speedsize_url_pfx_https -}}{{ block.settings.image | image_url: width: 1400 }}"
                alt="{{ block.settings.title | default: block.settings.image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            </picture>
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'cg323__placeholder' }}
          {%- endif -%}
          {%- if overlay -%}<span class="cg323__overlay"></span>{%- endif -%}
        </div>
        {%- if block.settings.title != blank -%}
          <span class="cg323__card-title" style="color: {{ block.settings.title_color | default: section.settings.text_color }};">
            {{- block.settings.title -}}
          </span>
        {%- endif -%}
        {%- if block.settings.show_arrow -%}
          <span class="cg323__card-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18">
              <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {%- endif -%}
      {%- endcapture -%}

      {%- if block.settings.link != blank -%}
        <a
          href="{{ block.settings.link }}"
          class="cg323__card"
          style="--d-span: {{ d_span }}; --m-span: {{ m_span }}; --min-h: {{ min_h }}px; --min-h-m: {{ min_h_m }}px;"
          {{ block.shopify_attributes }}
          aria-label="{{ block.settings.title | escape }}"
        >
          {{ card_inner }}
        </a>
      {%- else -%}
        <div
          class="cg323__card cg323__card--no-link"
          style="--d-span: {{ d_span }}; --m-span: {{ m_span }}; --min-h: {{ min_h }}px; --min-h-m: {{ min_h_m }}px;"
          {{ block.shopify_attributes }}
        >
          {{ card_inner }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .cg323 {
    background: var(--cg323-bg, transparent);
    color: var(--cg323-text, #111);
    padding: var(--cg323-pad-top, 60px) 24px var(--cg323-pad-bottom, 60px);
    box-sizing: border-box;
    width: 100%;
  }
  .cg323__header {
    text-align: center;
    margin-bottom: 32px;
  }
  .cg323__heading {
    font-size: clamp(28px, 4vw, 44px);
    margin: 0 0 8px;
    color: var(--cg323-text, #111);
  }
  .cg323__subheading {
    font-size: 16px;
    opacity: 0.85;
  }
  .cg323__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: auto;
    gap: var(--cg323-gap, 16px);
    max-width: 1600px;
    margin: 0 auto;
  }
  .cg323__card {
    grid-column: span var(--d-span, 2);
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--cg323-radius, 0px);
    text-decoration: none;
    color: inherit;
    min-height: var(--min-h, 320px);
    isolation: isolate;
    transition: transform 0.4s ease;
  }
  .cg323__card:hover { transform: translateY(-2px); }
  .cg323__card-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cg323__card-media img,
  .cg323__card-media .cg323__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .cg323__card:hover .cg323__card-media img { transform: scale(1.04); }
  .cg323__overlay {
    position: absolute;
    inset: 0;
    background: var(--cg323-overlay, #000);
    opacity: var(--cg323-overlay-opacity, 0.15);
    pointer-events: none;
  }
  .cg323__card-title {
    position: relative;
    z-index: 2;
    display: inline-block;
    padding: 18px 22px;
    font-family: var(--heading-font-family, inherit);
    font-size: var(--cg323-title-size, 28px);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.1;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }
  .cg323__card-arrow {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .cg323__card:hover .cg323__card-arrow { background: #fff; }

  @media (max-width: 767px) {
    .cg323 {
      padding: var(--cg323-pad-top-mobile, 40px) 12px var(--cg323-pad-bottom-mobile, 40px);
    }
    .cg323__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--cg323-mobile-gap, 10px);
    }
    .cg323__card {
      grid-column: span var(--m-span, 1);
      min-height: var(--min-h-m, 220px);
    }
    .cg323__card-title {
      font-size: var(--cg323-title-size-mobile, 18px);
      padding: 12px 14px;
    }
    .cg323__card-arrow {
      width: 28px;
      height: 28px;
      right: 10px;
      bottom: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Grid 3-2-3",
  "tag": "section",
  "class": "section-collection-grid-3-2-3",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 10
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Card title size – desktop (px)",
      "min": 14,
      "max": 56,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Card title size – mobile (px)",
      "min": 12,
      "max": 36,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top – desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom – desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top – mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom – mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Card image overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile, optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collection"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#ffffff"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "desktop_span",
          "label": "Desktop columns (out of 6)",
          "options": [
            { "value": "1", "label": "1 / 6" },
            { "value": "2", "label": "2 / 6 (third)" },
            { "value": "3", "label": "3 / 6 (half)" },
            { "value": "4", "label": "4 / 6" },
            { "value": "6", "label": "6 / 6 (full)" }
          ],
          "default": "2"
        },
        {
          "type": "select",
          "id": "mobile_span",
          "label": "Mobile columns (out of 2)",
          "options": [
            { "value": "1", "label": "1 / 2 (half)" },
            { "value": "2", "label": "2 / 2 (full)" }
          ],
          "default": "1"
        },
        {
          "type": "range",
          "id": "min_height",
          "label": "Min height – desktop",
          "min": 180,
          "max": 700,
          "step": 10,
          "default": 320,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "min_height_mobile",
          "label": "Min height – mobile",
          "min": 140,
          "max": 500,
          "step": 10,
          "default": 220,
          "unit": "px"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show image overlay",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow icon",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection Grid 3-2-3",
      "blocks": [
        { "type": "card", "settings": { "title": "DINING CHAIRS", "desktop_span": "2", "mobile_span": "2", "min_height": 360, "min_height_mobile": 280 } },
        { "type": "card", "settings": { "title": "ACCENT CHAIRS & ARMCHAIRS", "desktop_span": "2", "mobile_span": "1" } },
        { "type": "card", "settings": { "title": "LIGHTING", "desktop_span": "2", "mobile_span": "1" } },
        { "type": "card", "settings": { "title": "DINING TABLES", "desktop_span": "2", "mobile_span": "2" } },
        { "type": "card", "settings": { "title": "SOFAS", "desktop_span": "4", "mobile_span": "1" } },
        { "type": "card", "settings": { "title": "MIRRORS", "desktop_span": "2", "mobile_span": "1" } },
        { "type": "card", "settings": { "title": "COFFEE TABLES", "desktop_span": "2", "mobile_span": "2" } },
        { "type": "card", "settings": { "title": "SIDE TABLES", "desktop_span": "2", "mobile_span": "1" } }
      ]
    }
  ]
}
{% endschema %}
