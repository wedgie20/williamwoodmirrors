{% comment %}
  Hero Image Slider Section
  - Background images cycle automatically
  - Content overlay stays static
  - Each block = 1 slide (desktop + mobile image only)
  - All text/content defined at section level
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --hero-overlay-color: {{ section.settings.overlay_color.red }}, {{ section.settings.overlay_color.green }}, {{ section.settings.overlay_color.blue }};
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-text-color: {{ section.settings.text_color }};
    --hero-btn-bg: {{ section.settings.button_background }};
    --hero-btn-text: {{ section.settings.button_text_color }};
    --hero-autoplay-speed: {{ section.settings.cycle_speed }}s;
  }

  .hero-slider {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-slider__slides {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    will-change: opacity;
  }

  .hero-slider__slide.is-active {
    opacity: 1;
    z-index: 2;
  }

  .hero-slider__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Desktop / Mobile image toggling */
  .hero-slider__img--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .hero-slider__img--desktop {
      display: none;
    }
    .hero-slider__img--mobile {
      display: block;
    }
  }

  /* Overlay */
  .hero-slider__overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--hero-overlay-color), var(--hero-overlay-opacity));
    z-index: 3;
    pointer-events: none;
  }

  /* Content stays static on top */
  .hero-slider__content {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--hero-text-color);
    padding: 20px;
    pointer-events: none;
  }

  .hero-slider__content > * {
    pointer-events: auto;
  }

  /* Review / Social Proof */
  .hero-slider__review-stats {
    font-family: 'altesse-std-24pt', serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .hero-slider__review-stars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .hero-slider__review-stars img {
    height: 14px;
    width: auto;
  }

  .hero-slider__review-stars span {
    font-family: 'Zurich', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  /* Main heading */
  .hero-slider__heading {
    font-family: 'Zurich', sans-serif;
    font-size: 42px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.1;
    margin: 0 0 4px;
  }

  /* Script / cursive subheading */
  .hero-slider__subheading {
    font-family: 'altesse-std-24pt', serif;
    font-size: 48px;
    font-weight: 400;
    font-style: italic;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  /* Subtitle text */
  .hero-slider__subtitle {
    font-family: 'Zurich', sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 1px;
    margin-bottom: 24px;
  }

  /* Buttons */
  .hero-slider__buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-slider__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 200px;
    height: 52px;
    padding: 0 32px;
    border-radius: 1000px;
    font-family: 'Zurich', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.15s ease;
    cursor: pointer;
    border: none;
    background: var(--hero-btn-bg);
    color: var(--hero-btn-text);
  }

  .hero-slider__btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  /* Navigation dots */
  .hero-slider__dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    gap: 10px;
  }

  .hero-slider__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.7);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .hero-slider__dot.is-active {
    background: #fff;
    border-color: #fff;
  }

  /* Progress bar for autoplay */
  .hero-slider__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 3px;
    background: rgba(255,255,255,0.6);
    z-index: 6;
    width: 0%;
  }

  .hero-slider__progress.is-running {
    animation: hero-progress var(--hero-autoplay-speed) linear forwards;
  }

  @keyframes hero-progress {
    from { width: 0%; }
    to { width: 100%; }
  }

  /* Arrows */
  .hero-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
    backdrop-filter: blur(4px);
  }

  .hero-slider__arrow:hover {
    background: rgba(255,255,255,0.3);
  }

  .hero-slider__arrow--prev {
    left: 16px;
  }

  .hero-slider__arrow--next {
    right: 16px;
  }

  .hero-slider__arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Trustpilot review section below buttons */
  .hero-slider__trustpilot {
    margin-top: 16px;
    text-align: center;
  }

  .hero-slider__trustpilot p {
    margin: 0 0 4px;
    font-family: 'Zurich', sans-serif;
    font-size: 12px;
    font-weight: 400;
  }

  .hero-slider__trustpilot-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .hero-slider__trustpilot-row img {
    height: 14px;
    width: auto;
  }

  .hero-slider__trustpilot-row span {
    font-family: 'Zurich', sans-serif;
    font-size: 12px;
  }

  /* ===================== MOBILE STYLES ===================== */
  @media screen and (max-width: 749px) {
    .hero-slider {
      height: 100svh;
    }

    .hero-slider__review-stats {
      font-size: 14px;
    }

    .hero-slider__heading {
      font-size: 28px;
      letter-spacing: 1px;
    }

    .hero-slider__subheading {
      font-size: 34px;
    }

    .hero-slider__subtitle {
      font-size: 13px;
    }

    .hero-slider__buttons {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .hero-slider__btn {
      min-width: 180px;
      height: 46px;
      font-size: 10px;
      padding: 0 24px;
    }

    .hero-slider__arrow {
      display: none;
    }

    .hero-slider__dots {
      bottom: 16px;
    }

    .hero-slider__trustpilot p {
      font-size: 9px;
    }

    .hero-slider__trustpilot-row span {
      font-size: 9px;
    }

    .hero-slider__trustpilot-row img {
      height: 11px;
    }
  }

  /* Hide dots & arrows if only 1 slide */
  {% if section.blocks.size <= 1 %}
    .hero-slider__dots,
    .hero-slider__arrow,
    .hero-slider__progress {
      display: none;
    }
  {% endif %}
</style>

<section class="section section--flush">
  <div class="hero-slider" id="hero-slider-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.cycle_speed }}">

    {%- comment -%} ===== Background Image Slides ===== {%- endcomment -%}
    <div class="hero-slider__slides">
      {%- for block in section.blocks -%}
        {%- assign is_first = false -%}
        {%- if forloop.first -%}{%- assign is_first = true -%}{%- endif -%}

        <div class="hero-slider__slide {% if is_first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 3000 | image_tag: loading: 'eager', class: 'hero-slider__img--desktop', sizes: '100vw', widths: '600,800,1000,1200,1400,1600,1800,2000,2400,2800,3000', draggable: false }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__img--desktop' }}
          {%- endif -%}

          {%- if block.settings.mobile_image != blank -%}
            {{ block.settings.mobile_image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'hero-slider__img--mobile', sizes: '100vw', widths: '400,600,800,1000,1200,1400', draggable: false }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', class: 'hero-slider__img--mobile', sizes: '100vw', widths: '400,600,800,1000,1200,1400', draggable: false }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slider__img--mobile' }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} ===== Overlay ===== {%- endcomment -%}
    <div class="hero-slider__overlay"></div>

    {%- comment -%} ===== Static Content ===== {%- endcomment -%}
    <div class="hero-slider__content">
      <div class="hero-slider__content-inner">

        {%- comment -%} Review Stats Line {%- endcomment -%}
        {%- if section.settings.review_stat_text != blank -%}
          <div class="hero-slider__review-stats">
            {{ section.settings.review_stat_text | escape }}
          </div>
        {%- endif -%}

        {%- comment -%} Trustpilot Stars + Text (below stats) {%- endcomment -%}
        {%- if section.settings.review_image != blank or section.settings.review_detail_text != blank -%}
          <div class="hero-slider__review-stars">
            {%- if section.settings.review_image != blank -%}
              <img src="{{ section.settings.review_image | image_url: width: 200 }}" alt="Review stars" loading="eager">
            {%- endif -%}
            {%- if section.settings.review_detail_text != blank -%}
              <span>{{ section.settings.review_detail_text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Main Heading {%- endcomment -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-slider__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        {%- comment -%} Script / Cursive Subheading {%- endcomment -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hero-slider__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- comment -%} Subtitle {%- endcomment -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="hero-slider__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        {%- comment -%} CTA Buttons {%- endcomment -%}
        {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
          <div class="hero-slider__buttons">
            {%- if section.settings.button_1_text != blank -%}
              <a href="{{ section.settings.button_1_link }}" class="hero-slider__btn">
                {{ section.settings.button_1_text | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_text != blank -%}
              <a href="{{ section.settings.button_2_link }}" class="hero-slider__btn">
                {{ section.settings.button_2_text | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Trustpilot below buttons (desktop) {%- endcomment -%}
        {%- if section.settings.trustpilot_headline != blank -%}
          <div class="hero-slider__trustpilot">
            <p>{{ section.settings.trustpilot_headline | escape }}</p>
            {%- if section.settings.trustpilot_image != blank or section.settings.trustpilot_text != blank -%}
              <div class="hero-slider__trustpilot-row">
                {%- if section.settings.trustpilot_image != blank -%}
                  <img src="{{ section.settings.trustpilot_image | image_url: width: 200 }}" alt="Trustpilot" loading="eager">
                {%- endif -%}
                {%- if section.settings.trustpilot_text != blank -%}
                  <span>{{ section.settings.trustpilot_text | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>

    {%- comment -%} ===== Navigation Arrows ===== {%- endcomment -%}
    {%- if section.blocks.size > 1 -%}
      <button class="hero-slider__arrow hero-slider__arrow--prev" aria-label="Previous slide">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="hero-slider__arrow hero-slider__arrow--next" aria-label="Next slide">
        <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
    {%- endif -%}

    {%- comment -%} ===== Dot Navigation ===== {%- endcomment -%}
    {%- if section.blocks.size > 1 -%}
      <div class="hero-slider__dots">
        {%- for block in section.blocks -%}
          <button class="hero-slider__dot {% if forloop.first %}is-active{% endif %}" data-dot-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ===== Progress Bar ===== {%- endcomment -%}
    {%- if section.blocks.size > 1 and section.settings.autoplay -%}
      <div class="hero-slider__progress"></div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} ===== Slider JS ===== {%- endcomment -%}
<script>
  (function() {
    var container = document.getElementById('hero-slider-{{ section.id }}');
    if (!container) return;

    var slides = container.querySelectorAll('.hero-slider__slide');
    var dots = container.querySelectorAll('.hero-slider__dot');
    var prevBtn = container.querySelector('.hero-slider__arrow--prev');
    var nextBtn = container.querySelector('.hero-slider__arrow--next');
    var progressBar = container.querySelector('.hero-slider__progress');
    var current = 0;
    var total = slides.length;
    var autoplay = container.getAttribute('data-autoplay') === 'true';
    var speed = (parseFloat(container.getAttribute('data-speed')) || 5) * 1000;
    var timer = null;
    var paused = false;

    if (total <= 1) return;

    function goTo(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;

      slides[current].classList.remove('is-active');
      dots[current].classList.remove('is-active');

      current = index;

      slides[current].classList.add('is-active');
      dots[current].classList.add('is-active');

      resetProgress();
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function resetProgress() {
      if (!progressBar || !autoplay) return;
      progressBar.classList.remove('is-running');
      void progressBar.offsetWidth; /* reflow */
      progressBar.classList.add('is-running');
    }

    function startAutoplay() {
      if (!autoplay) return;
      stopAutoplay();
      resetProgress();
      timer = setInterval(next, speed);
    }

    function stopAutoplay() {
      if (timer) { clearInterval(timer); timer = null; }
      if (progressBar) progressBar.classList.remove('is-running');
    }

    /* Arrows */
    if (prevBtn) prevBtn.addEventListener('click', function() { prev(); startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', function() { next(); startAutoplay(); });

    /* Dots */
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        goTo(parseInt(this.getAttribute('data-dot-index'), 10));
        startAutoplay();
      });
    });

    /* Pause on hover */
    container.addEventListener('mouseenter', function() {
      paused = true;
      stopAutoplay();
    });

    container.addEventListener('mouseleave', function() {
      paused = false;
      startAutoplay();
    });

    /* Touch / Swipe support */
    var touchStartX = 0;
    var touchEndX = 0;

    container.addEventListener('touchstart', function(e) {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    container.addEventListener('touchend', function(e) {
      touchEndX = e.changedTouches[0].screenX;
      var diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) { next(); } else { prev(); }
        startAutoplay();
      }
    }, { passive: true });

    /* Init */
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Hero Image Slider",
  "class": "shopify-section--hero-slider",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Review / Social Proof"
    },
    {
      "type": "text",
      "id": "review_stat_text",
      "label": "Review stats line",
      "default": "700,000+ Satisfied Customers  |  30,000+ 5 Star Reviews"
    },
    {
      "type": "image_picker",
      "id": "review_image",
      "label": "Stars image"
    },
    {
      "type": "text",
      "id": "review_detail_text",
      "label": "Review detail text"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MAKE YOUR HOME"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (cursive)",
      "default": "unforgettable"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Shop Our Latest Arrivals"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 text",
      "default": "LATEST ARRIVALS"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button 2 text",
      "default": "SPRING SALE"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Trustpilot (below buttons)"
    },
    {
      "type": "text",
      "id": "trustpilot_headline",
      "label": "Trustpilot headline",
      "default": "Join Over 700,000+ Satisfied Customers"
    },
    {
      "type": "image_picker",
      "id": "trustpilot_image",
      "label": "Trustpilot stars image"
    },
    {
      "type": "text",
      "id": "trustpilot_text",
      "label": "Trustpilot text",
      "default": "4.7 / 5 Excellent | 10,000+ Reviews"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "label": "Slide duration",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "2160 x 1080px .jpg recommended"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "1000 x 1400px .jpg recommended. Falls back to desktop image if empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Image Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
