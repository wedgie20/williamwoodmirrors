{{ 'section-pill-navigation.css' | asset_url | stylesheet_tag }}

<div class="pill-nav-section" style="--pill-nav-bg: {{ section.settings.section_bg }}; --pill-nav-padding-top: {{ section.settings.padding_top }}px; --pill-nav-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="pill-nav-wrapper page-width">
    <div class="pill-nav-scroll" id="PillNav-{{ section.id }}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'pill' %}
            {% liquid
              assign pill_url = block.settings.link
              assign is_active = false
              if pill_url != blank and pill_url == request.path
                assign is_active = true
              endif
            %}
            <a
              href="{{ pill_url | default: '#' }}"
              class="pill-nav-item{% if block.settings.force_active or is_active %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pill navigation",
  "tag": "section",
  "class": "section-pill-navigation",
  "settings": [
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Text",
          "default": "New pill"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "force_active",
          "label": "Show as active",
          "default": false,
          "info": "Manually highlight this pill (e.g. for the current collection) regardless of the current page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pill navigation",
      "blocks": [
        { "type": "pill", "settings": { "label": "Bestsellers" } },
        { "type": "pill", "settings": { "label": "New In" } },
        { "type": "pill", "settings": { "label": "Sets & Gifts" } },
        { "type": "pill", "settings": { "label": "Cuban" } },
        { "type": "pill", "settings": { "label": "Religious" } },
        { "type": "pill", "settings": { "label": "Iced" } },
        { "type": "pill", "settings": { "label": "Gemstones" } },
        { "type": "pill", "settings": { "label": "Clover" } },
        { "type": "pill", "settings": { "label": "Outlet" } },
        { "type": "pill", "settings": { "label": "All Jewellery" } }
      ]
    }
  ]
}
{% endschema %}
