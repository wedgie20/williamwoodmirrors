{%- liquid
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial'
-%}

<section class="ww-trade-testimonials" data-ww-trade-testimonials>
  <div class="ww-trade-testimonials__container">
    <div class="ww-trade-testimonials__header">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="ww-trade-testimonials__arrows" aria-label="Testimonials controls">
        <button class="ww-trade-testimonials__arrow" type="button" data-ww-testimonial-prev aria-label="Previous testimonial">
          <span aria-hidden="true">&lsaquo;</span>
        </button>
        <button class="ww-trade-testimonials__arrow" type="button" data-ww-testimonial-next aria-label="Next testimonial">
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </div>
    </div>

    {%- if testimonial_blocks.size > 0 -%}
      <div class="ww-trade-testimonials__track" data-ww-testimonial-track>
        {%- for block in testimonial_blocks -%}
          <article class="ww-trade-testimonials__card" {{ block.shopify_attributes }}>
            {%- if block.settings.quote != blank -%}
              <div class="ww-trade-testimonials__quote">{{ block.settings.quote }}</div>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <p class="ww-trade-testimonials__author">{{ block.settings.author }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    function initTradeTestimonials(root) {
      if (root.dataset.wwTestimonialsReady === 'true') {
        return;
      }

      var track = root.querySelector('[data-ww-testimonial-track]');
      var prev = root.querySelector('[data-ww-testimonial-prev]');
      var next = root.querySelector('[data-ww-testimonial-next]');

      if (!track || !prev || !next) {
        return;
      }

      function scrollTestimonials(direction) {
        track.scrollBy({ left: direction * track.clientWidth, behavior: 'smooth' });
      }

      prev.addEventListener('click', function() {
        scrollTestimonials(-1);
      });

      next.addEventListener('click', function() {
        scrollTestimonials(1);
      });

      root.dataset.wwTestimonialsReady = 'true';
    }

    function initAllTradeTestimonials() {
      document.querySelectorAll('[data-ww-trade-testimonials]').forEach(initTradeTestimonials);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAllTradeTestimonials);
    } else {
      initAllTradeTestimonials();
    }

    document.addEventListener('shopify:section:load', initAllTradeTestimonials);
  })();
</script>

<style>
  #shopify-section-{{ section.id }} .ww-trade-testimonials {
    --ww-trade-text-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    padding: 34px 0 96px;
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__container {
    {% comment %} width: min(100%, 1320px); {% endcomment %}
    margin: 0 auto;
    padding: 0 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials h2 {
    margin: 0;
    color: #000;
    font-family: var(--ww-trade-heading-font);
    font-size: var(--heading-h2-font-size, 54px);
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.1333333333;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__arrows {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #000;
    cursor: pointer;
    font-family: var(--ww-trade-text-font);
    font-size: calc(var(--ww-trade-body-size) + 13px);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__card {
    flex: 0 0 calc((100% - 14px) / 2);
    min-height: 320px;
    padding: clamp(36px, 5vw, 80px);
    background: #f1f0ee;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__quote {
    max-width: 880px;
    font-size: 18px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__quote p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-testimonials__author {
    margin: 24px 0 0;
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ww-trade-testimonials {
      padding: 28px 0 72px;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__container {
      padding: 0 28px;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__card {
      flex-basis: calc((100% - 14px) / 2);
      min-height: 280px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-testimonials {
      padding: 24px 0 56px;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials h2 {
      font-size: var(--heading-h2-font-size, 32px);
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__header {
      align-items: flex-end;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__card {
      flex-basis: 100%;
      min-height: 260px;
      padding: 32px 24px;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__quote {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .ww-trade-testimonials__author {
      font-size: calc(var(--ww-trade-body-size) - 1px);
      line-height: 1.7142857143;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimonials"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>William Wood remains one of my favourite brands to source from for my clients. The range is the perfect addition to homes that value considered design and quality.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Trade customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
