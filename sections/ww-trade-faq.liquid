{%- liquid
  assign faq_blocks = section.blocks | where: 'type', 'faq'
-%}

<section class="ww-trade-faq" data-ww-trade-faq>
  <div class="ww-trade-faq__container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="ww-trade-faq__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if faq_blocks.size > 0 -%}
      <div class="ww-trade-faq__list">
        {%- for block in faq_blocks -%}
          <details class="ww-trade-faq__item" {% if section.settings.open_first_item and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question }}</span>
              <span class="ww-trade-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="ww-trade-faq__answer">
              {{ block.settings.answer }}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
      <a class="ww-trade-faq__button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-faq {
    --ww-trade-text-font: var(--text-font-family, "Gotham Book", Arial, sans-serif);
    --ww-trade-heading-font: var(--heading-font-family, "GothamBlack", "Gotham Book", Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-bold-weight: var(--text-font-bold-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    padding: 86px 0 110px;
    background: #fff;
    color: #000;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__container {
    width: min(100%, 1450px);
    margin: 0 auto;
    padding: 0 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq h2 {
    margin: 0 0 18px;
    color: #000;
    font-family: var(--ww-trade-heading-font);
    font-size: var(--heading-h2-font-size, 54px);
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.1333333333;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__body {
    max-width: 850px;
    margin-bottom: 28px;
    color: #000;
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__body p,
  #shopify-section-{{ section.id }} .ww-trade-faq__answer p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__body p + p,
  #shopify-section-{{ section.id }} .ww-trade-faq__answer p + p {
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__list {
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item {
    border: 1px solid transparent;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item + .ww-trade-faq__item {
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 52px;
    padding: 10px 14px 10px 0;
    color: #000;
    cursor: pointer;
    list-style: none;
    font-family: var(--ww-trade-heading-font);
    font-size: var(--heading-h3-font-size, 24px);
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item summary:focus-visible {
    outline: 1px solid #000;
    outline-offset: 8px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item[open] summary {
    padding-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item:hover,
  #shopify-section-{{ section.id }} .ww-trade-faq__item:focus-within {
    border-color: #000;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__icon {
    position: relative;
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__icon::before,
  #shopify-section-{{ section.id }} .ww-trade-faq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1px;
    background: #000;
    transform: translate(-50%, -50%);
    transition: transform .2s ease;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item[open] .ww-trade-faq__icon::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__item[open] .ww-trade-faq__icon::after {
    transform: translate(-50%, -50%) rotate(135deg);
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__answer {
    max-width: 1320px;
    padding: 0 64px 26px 0;
    color: #000;
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    margin-top: 28px;
    padding: 14px 30px;
    border: 1px solid #000;
    border-radius: 999px;
    color: #000;
    background: #fff;
    font-family: var(--ww-trade-text-font);
    font-size: calc(var(--ww-trade-body-size) - 1px);
    font-weight: var(--ww-trade-bold-weight);
    text-decoration: none;
    transition: background .2s ease, color .2s ease;
  }

  #shopify-section-{{ section.id }} .ww-trade-faq__button:hover {
    background: #000;
    color: #fff;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ww-trade-faq {
      padding: 72px 0;
    }

    #shopify-section-{{ section.id }} .ww-trade-faq__container {
      padding: 0 28px;
    }

    #shopify-section-{{ section.id }} .ww-trade-faq__answer {
      padding-right: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-faq {
      padding: 56px 0;
    }

    #shopify-section-{{ section.id }} .ww-trade-faq__container {
      padding: 0 20px;
    }

    #shopify-section-{{ section.id }} .ww-trade-faq h2 {
      font-size: var(--heading-h2-font-size, 32px);
    }

    #shopify-section-{{ section.id }} .ww-trade-faq__item summary {
      font-size: var(--heading-h3-font-size, 22px);
    }

    #shopify-section-{{ section.id }} .ww-trade-faq__answer {
      padding-right: 0;
      font-size: calc(var(--ww-trade-body-size) - 1px);
      line-height: 1.7142857143;
    }
  }
</style>

{% schema %}
{
  "name": "Trade FAQs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "open_first_item",
      "label": "Open first FAQ by default",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View all FAQs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Who can apply for a trade account?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our trade programme is here to support interior designers, architects, stylists, hoteliers, property developers and other trade professionals across residential and commercial projects.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trade FAQs",
      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
