{{ 'video-hero.css' | asset_url | stylesheet_tag }}

<div class="video-hero-section" id="video-hero-{{ section.id }}">
  <div class="video-hero-container">
    {% if section.settings.desktop_video != blank or section.settings.mobile_video != blank %}
      <div class="video-wrapper">
        <!-- Desktop Video -->
        {% if section.settings.desktop_video != blank %}
          <video 
            class="hero-video hero-video--desktop"
            {% if section.settings.autoplay %}autoplay{% endif %}
            {% if section.settings.loop %}loop{% endif %}
            muted
            playsinline
            preload="auto"
            poster="{% if section.settings.desktop_poster %}{{ settings.speedsize_url_pfx_https -}}{{ section.settings.desktop_poster | image_url }}{% endif %}"
            data-video-id="desktop-{{ section.id }}"
          >
            <source src="{{ section.settings.desktop_video.sources[1].url | replace: '//cdn.shopify.com/', settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: 'https:https:', 'https:' | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx   }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% endif %}

        <!-- Mobile Video -->
        {% if section.settings.mobile_video != blank %}
          <video 
            class="hero-video hero-video--mobile"
            {% if section.settings.autoplay %}autoplay{% endif %}
            {% if section.settings.loop %}loop{% endif %}
            muted
            playsinline
            preload="auto"
            poster="{% if section.settings.mobile_poster %}{{ settings.speedsize_url_pfx_https -}}{{ section.settings.mobile_poster | image_url }}{% endif %}"
            data-video-id="mobile-{{ section.id }}"
          >
            <source src="{{ section.settings.mobile_video.sources[1].url | replace: '//cdn.shopify.com/', settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: 'https:https:', 'https:' | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx   }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% elsif section.settings.desktop_video != blank %}
          <!-- Fallback: Use desktop video on mobile if no mobile video is set -->
          <video 
            class="hero-video hero-video--mobile"
            {% if section.settings.autoplay %}autoplay{% endif %}
            {% if section.settings.loop %}loop{% endif %}
            muted
            playsinline
            preload="auto"
            poster="{% if section.settings.desktop_poster %}{{ settings.speedsize_url_pfx_https -}}{{ section.settings.desktop_poster | image_url }}{% endif %}"
            data-video-id="mobile-fallback-{{ section.id }}"
          >
            <source src="{{ section.settings.desktop_video.sources[1].url | replace: '//cdn.shopify.com/', settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: 'https:https:', 'https:' | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx   }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% endif %}

        <!-- Video Controls -->
  {% comment %}
        {% unless section.settings.hide_controls %}
          <div class="video-controls">
            <button class="video-play-pause" aria-label="Play/Pause video">
              <svg class="play-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M8 5v14l11-7z" fill="currentColor"/>
              </svg>
              <svg class="pause-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" style="display: none;">
                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" fill="currentColor"/>
              </svg>
            </button>
            <div class="volume-control">
              <button class="volume-toggle" aria-label="Toggle mute">
              <svg class="volume-on-icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1 3.29-2.5 4.03V8.97c1.5.74 2.5 2.26 2.5 4.03zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77 0-4.28-2.99-7.86-7-8.77z" fill="currentColor"/>
              </svg>
              <svg class="volume-off-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" style="display: none;">
                <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" fill="currentColor"/>
              </svg>
              </button>
              <input type="range" class="volume-slider" min="0" max="1" step="0.1" value="0.5">
            </div>
          </div>
        {% endunless %}
      {% endcomment %}
      </div>
    {% endif %}

    <!-- Content Overlay -->
    {% if section.blocks.size > 0 and section.settings.show_content %}
      <div class="video-hero-content">
        <div class="video-hero-content-inner">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'heading' %}
                {% if section.settings.show_heading %}
                  <{{ block.settings.heading_size }} class="video-hero-heading" {{ block.shopify_attributes }}>
                    {{ block.settings.heading | escape }}
                  </{{ block.settings.heading_size }}>
                {% endif %}
              
              {% when 'text' %}
                {% if section.settings.show_text %}
                  <div class="video-hero-text" {{ block.shopify_attributes }}>
                    {{ block.settings.text | escape }}
                  </div>
                {% endif %}


          

                    
            <div class="MobileDown">
                    <div class="heading heading--small"></div>
