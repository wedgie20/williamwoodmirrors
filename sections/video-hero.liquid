<style>
/* Hero Video CSS */


.video-hero-section {
    position: relative;
    width: 100%;
    height: {{ section.settings.section_height }}vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-hero-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-video--mobile {
    display: none;
  }

  .video-controls {
    position: absolute;
    bottom: 20px;
    right: 20px;
    z-index: 2;
    display: none;
  }

  .video-play-pause {
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: white;
    padding: 8px;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .video-play-pause:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  .video-hero-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    
  }

  .video-hero-content-inner {
    text-align: center;
    color: {{ section.settings.text_color }};
    max-width: 800px;
    padding: 0 20px;
  }

  .video-hero-heading {
    margin-bottom: 20px;
    font-weight: bold;
  }

  .video-hero-text {
    margin-bottom: 30px;
    font-size: 1.2rem;
    line-height: 1.6;
  }

  .btn {
    display: inline-block;
    padding: 12px 30px;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    transition: all 0.3s ease;
  }

  .btn--primary {
    background-color: {{ section.settings.button_color }};
    color: white;
  }

  .btn--secondary {
    background-color: transparent;
    color: {{ section.settings.button_color }};
    border: 2px solid {{ section.settings.button_color }};
  }

  .btn:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .hero-video--desktop {
      display: none;
    }
    
    .hero-video--mobile {
      display: block;
    }
    
    .video-hero-section {
      height: {{ section.settings.mobile_section_height }}vh;
    }
    
    .video-hero-heading {
      font-size: 1.8rem;
    }
    
    .video-hero-text {
      font-size: 1rem;
    }
  }

  .volume-control {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: 15px;
}

.volume-toggle {
  background: rgba(0, 0, 0, 0.5);
  border: none;
  color: white;
  padding: 8px;
  border-radius: 50%;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.volume-toggle:hover {
  background: rgba(0, 0, 0, 0.7);
}

.volume-slider {
  width: 80px;
  height: 4px;
  background: rgba(0, 0, 0, 0.7);
  outline: none;
  border-radius: 2px;
  cursor: pointer;
  -webkit-appearance: none;
  appearance: none;
}

.volume-slider::-webkit-slider-track {
  background: rgba(0, 0, 0, 0.7);
  height: 4px;
  border-radius: 2px;
}

.volume-slider::-moz-range-track {
  background: rgba(0, 0, 0, 0.7);
  height: 4px;
  border-radius: 2px;
  border: none;
}

.volume-slider::-webkit-slider-thumb {
  appearance: none;
  width: 16px;
  height: 16px;
  background: white;
  border-radius: 50%;
  cursor: pointer;
}

.volume-slider::-moz-range-thumb {
  width: 16px;
  height: 16px;
  background: white;
  border-radius: 50%;
  cursor: pointer;
  border: none;
}
  
</style>


<script>
document.addEventListener('DOMContentLoaded', function() {
  const section = document.getElementById('video-hero-{{ section.id }}');
  const videos = section.querySelectorAll('.hero-video');
  const playPauseBtn = section.querySelector('.video-play-pause');
  const playIcon = section.querySelector('.play-icon');
  const pauseIcon = section.querySelector('.pause-icon');
  const volumeToggle = section.querySelector('.volume-toggle');
  const volumeOnIcon = section.querySelector('.volume-on-icon');
  const volumeOffIcon = section.querySelector('.volume-off-icon');
  const volumeSlider = section.querySelector('.volume-slider');
  
  let currentVideo = null;
  let hasUserInteracted = false;
  
  // Determine which video to use based on screen size
  function getCurrentVideo() {
    const desktopVideo = section.querySelector('.hero-video--desktop');
    const mobileVideo = section.querySelector('.hero-video--mobile');
    
    if (window.innerWidth <= 768) {
      return mobileVideo || desktopVideo;
    } else {
      return desktopVideo || mobileVideo;
    }
  }
  
  // Update current video reference
  function updateCurrentVideo() {
    const previousVideo = currentVideo;
    currentVideo = getCurrentVideo();
    
    if (currentVideo && volumeSlider) {
      currentVideo.volume = volumeSlider.value;
      
      // Apply user interaction state to new video
      if (hasUserInteracted && !{{ section.settings.start_muted | json }}) {
        currentVideo.muted = false;
      }
      
      updateVolumeButton();
    }
  }
  
  // Update play/pause button state
  function updatePlayPauseButton() {
    if (!currentVideo || !playPauseBtn) return;
    
    if (currentVideo.paused) {
      playIcon.style.display = 'block';
      pauseIcon.style.display = 'none';
    } else {
      playIcon.style.display = 'none';
      pauseIcon.style.display = 'block';
    }
  }
  
  // Update volume button state
  function updateVolumeButton() {
    if (!currentVideo || !volumeToggle) return;
    
    if (currentVideo.muted || currentVideo.volume === 0) {
      volumeOnIcon.style.display = 'none';
      volumeOffIcon.style.display = 'block';
    } else {
      volumeOnIcon.style.display = 'block';
      volumeOffIcon.style.display = 'none';
    }
  }
  
  // Enable audio on first user interaction
  function enableAudioOnFirstInteraction() {
    if (!{{ section.settings.start_muted | json }}) {
      hasUserInteracted = true;
      if (currentVideo) {
        currentVideo.muted = false;
        updateVolumeButton();
      }
    }
  }
  
  // Initialize
  updateCurrentVideo();
  updatePlayPauseButton();
  
  // Play/Pause button functionality
  if (playPauseBtn) {
    playPauseBtn.addEventListener('click', function() {
      enableAudioOnFirstInteraction();
      
      if (currentVideo && currentVideo.paused) {
        currentVideo.play();
      } else if (currentVideo) {
        currentVideo.pause();
      }
      updatePlayPauseButton();
    });
  }
  
  // Volume toggle functionality
  if (volumeToggle) {
    volumeToggle.addEventListener('click', function() {
      hasUserInteracted = true;
      if (currentVideo) {
        currentVideo.muted = !currentVideo.muted;
        updateVolumeButton();
      }
    });
  }
  
  // Volume slider functionality
  if (volumeSlider) {
    volumeSlider.addEventListener('input', function() {
      hasUserInteracted = true;
      if (currentVideo) {
        currentVideo.volume = this.value;
        currentVideo.muted = false;
        updateVolumeButton();
      }
    });
  }

  // Click anywhere on video to play/pause
  videos.forEach(video => {
    video.addEventListener('click', function() {
      enableAudioOnFirstInteraction();
      
      if (this.paused) {
        this.play();
      } else {
        this.pause();
      }
      updatePlayPauseButton();
    });
    
    // Add cursor pointer to indicate clickable
    video.style.cursor = 'pointer';
  });
  
  // Intersection Observer for auto-pause on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (currentVideo) {
        if (entry.isIntersecting) {
          // Video is visible - play if it was playing before
          if (currentVideo.hasAttribute('data-was-playing')) {
            currentVideo.play();
            currentVideo.removeAttribute('data-was-playing');
          }
        } else {
          // Video is not visible - pause and remember state
          if (!currentVideo.paused) {
            currentVideo.setAttribute('data-was-playing', 'true');
            currentVideo.pause();
          }
        }
        updatePlayPauseButton();
      }
    });
  }, {
    threshold: 0.5 // Trigger when 50% of the video is visible
  });

  // Start observing the video section
  observer.observe(section);
  
  // Update video on resize
  window.addEventListener('resize', function() {
    updateCurrentVideo();
    updatePlayPauseButton();
  });
  
  // Update button states when video plays/pauses
  videos.forEach(video => {
    video.addEventListener('play', updatePlayPauseButton);
    video.addEventListener('pause', updatePlayPauseButton);
    video.addEventListener('volumechange', updateVolumeButton);
  });
});
</script>

{% schema %}
{
  "name": "Video Hero",
  "tag": "section",
  "class": "video-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop Video",
      "info": "Upload a video file for desktop display"
    },
    {
      "type": "image_picker",
      "id": "desktop_poster",
      "label": "Desktop Video Poster Image"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video (Optional)",
      "info": "Upload a video file for mobile display. If empty, desktop video will be used."
    },
    {
      "type": "image_picker",
      "id": "mobile_poster",
      "label": "Mobile Video Poster Image"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true,
      "info": "Videos must be muted to autoplay in most browsers"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_controls",
      "label": "Hide video controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Content Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show content overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Show text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Desktop section height",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Mobile section height",
      "default": 60
    },
    {
      "type": "header",
      "content": "Content Overlay"
