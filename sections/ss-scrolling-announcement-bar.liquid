<style>
  {{ section.settings.ss_font_family | font_face: font_display: 'swap' }}

  .ss-announcement-bar {
    overflow: hidden;
  }
  .ss-announcement-bar:hover {
    opacity:0.{{section.settings.hover_opacity}};
  }
  .announcement-bar__link {
    display: block;
    width: 100%;
    padding: {{ section.settings.padding_vertical }}rem {{section.settings.padding_horizontal}}rem;
    text-decoration: none;
    color: var(--text-color);
    line-height:0;
  }
  .announcement-bar__link:hover {
    color: var(--text-color);
  }

  .ss-announcement-bar__message {
    text-align: center;
    padding: 0;
    margin: 0;
    line-height: 1;
    font-size: {{section.settings.text_size}}px;
    font-family: {{section.settings.ss_font_family.family}};
    font-weight: {{section.settings.ss_font_family.weight}};
  }

  {%- if section.settings.enable_scroll -%}
  /* Vertical rotating ticker: one message at a time, sliding upward */
  #marq {
    position: relative;
    width: 100%;
    height: calc({{section.settings.text_size}}px * 1.4);
    overflow: hidden;
  }
  .ss-announcement-bar__message {
    position: relative;
    width: 100%;
    height: 100%;
    list-style: none;
  }
  .ss-announcement-bar__message li {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    line-height: calc({{section.settings.text_size}}px * 1.4);
    font-size: {{section.settings.text_size}}px;
    font-family: {{section.settings.ss_font_family.family}};
    font-weight: {{section.settings.ss_font_family.weight}};
    text-align: center;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.6s ease, opacity 0.6s ease;
  }
  .ss-announcement-bar__message li.active {
    transform: translateY(0%);
    opacity: 1;
  }
  .ss-announcement-bar__message li.leaving {
    transform: translateY(-100%);
    opacity: 0;
  }
  {%- else -%}
  /* Static mode: all messages shown together on one line, no animation */
  #marq {
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .ss-announcement-bar__message {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .ss-announcement-bar__message li {
    line-height: 1;
    font-size: {{section.settings.text_size}}px;
    font-family: {{section.settings.ss_font_family.family}};
    font-weight: {{section.settings.ss_font_family.weight}};
    position: relative;
    padding-right: 24px;
  }
  .ss-announcement-bar__message li:last-child {
    padding-right: 0;
  }
  .ss-announcement-bar__message li:not(:last-child)::after {
    content: '';
    width: 3.5px;
    height: 3.5px;
    background-color: var(--text-color);
    opacity: 0.3;
    border-radius: 50%;
    position: absolute;
    top: 45%;
    right: 8px;
  }
  {%- endif -%}
</style>

<template id="marquee-announcement-bar-{{ section.id }}">
  <div
    class="ss-announcement-bar ss-announcement-bar-{{ section.id }}"
    aria-label="Announcement"
    style="background-color: {{ section.settings.bg }}; --text-color: {{ section.settings.text_color }};"
  >
    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        style="cursor: pointer;"
      >
    {% endif %}
    <div class="announcement-bar__link">
      <div id="marq">
        <ul class="ss-announcement-bar__message">
          {%- for block in section.blocks -%}
            <li{% if forloop.first %} class="active"{% endif %}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
    {%- if section.settings.link != blank -%}</a>{% endif %}
  </div>
</template>

<div id="marquee-local-target-{{ section.id }}"></div>

<script>
  window.addEventListener('DOMContentLoaded', (event) => {
    let cssTarget = '{{ section.settings.insert_css_class_target }}';
    let productForm = cssTarget
      ? document.querySelector(cssTarget)
      : document.querySelector('#marquee-local-target-{{ section.id }}');

    if (!productForm) return;

    const templateContent = document.querySelector(
      '#marquee-announcement-bar-{{ section.id }}'
    ).content;

    const insertedBar = templateContent.firstElementChild;

    productForm.insertAdjacentElement(
      'beforebegin',
      insertedBar
    );

    {%- if section.settings.enable_scroll -%}
    const liItems = insertedBar.querySelectorAll('.ss-announcement-bar__message li');

    if (liItems.length > 1) {
      let currentIndex = 0;
      const holdSeconds = {{ section.settings.animation_duration }};

      function rotateMessages() {
        const current = liItems[currentIndex];
        const nextIndex = (currentIndex + 1) % liItems.length;
        const next = liItems[nextIndex];

        current.classList.remove('active');
        current.classList.add('leaving');
        next.classList.add('active');

        setTimeout(() => {
          current.classList.remove('leaving');
        }, 600);

        currentIndex = nextIndex;
      }

      let intervalId = setInterval(rotateMessages, holdSeconds * 1000);

      {%- if section.settings.pause_hover -%}
      insertedBar.addEventListener('mouseenter', () => clearInterval(intervalId));
      insertedBar.addEventListener('mouseleave', () => {
        intervalId = setInterval(rotateMessages, holdSeconds * 1000);
      });
      {%- endif -%}
    }
    {%- endif -%}
  });
</script>

{% schema %}
{
  "name": "SS - Scrolling Ann Bar",
  "settings": [
    {
      "type": "header",
      "content": "Save section to see live"
    },
    {
      "type": "text",
      "id": "insert_css_class_target",
      "label": "Target CSS Class",
      "default": ".header, .pageheader, .section-header, #announcement, .toolbar, .header__wrapper",
      "placeholder": ".header, .pageheader",
      "info": "Empty text field this to display where you drag it. If you want to display the announcement bar in a specific place, you can add the CSS class of the target element here. Default is above header as announcement bar."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
        "type": "range",
        "id": "text_size",
        "label": "Font size",
        "default": 12,
        "min": 8,
        "max": 50,
        "step": 1,
        "unit": "px"
    },
    {
      "type": "font_picker",
      "id": "ss_font_family",
      "label": "Font family",
      "default": "montserrat_n4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Url"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_scroll",
      "label": "Enable Rotating Messages",
      "default": true,
      "info": "On: messages rotate one at a time, sliding upward. Off: all messages shown together on one static line."
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Seconds per message",
      "info": "How long each message stays visible before the next slides up.",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on Hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "hover_opacity",
      "label": "Background color hover opacity",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 90
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "unit": "rem",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "default": 2
    },
     {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding vertical",
      "unit": "rem",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 1.5
    }
  ],
  "presets": [
    {
      "category": "Custom",
      "name": "SS - Scrolling Announcement Bar",
      "blocks": [
        {
          "type": "text",
          "settings":{
            "text":"Free Shipping"
          }
        },
        {
          "type": "text",
           "settings":{
            "text":"Free Returns"
          }
        }
      ]
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        }
      ]
    }
  ]
}
{% endschema %}
