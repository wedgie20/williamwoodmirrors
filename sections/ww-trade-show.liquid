{%- comment -%}
  William Wood trade page body.
  Keeps the theme header/footer outside this section and avoids the Soho sections
  called out in the brief: Featured Projects and Book a trade appointment.
{%- endcomment -%}

{%- liquid
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign testimonial_blocks = section.blocks | where: 'type', 'testimonial'
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
-%}

<section class="ww-trade-page" data-ww-trade-page>
  <section class="ww-trade-page__hero">
    <picture class="ww-trade-page__hero-picture">
      {%- if section.settings.hero_mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.hero_mobile_image | image_url: width: 900 }}">
      {%- endif -%}
      {%- if section.settings.hero_image != blank -%}
        <img
          class="ww-trade-page__hero-image"
          src="{{ section.settings.hero_image | image_url: width: 2400 }}"
          alt="{{ section.settings.hero_title | escape }}"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'ww-trade-page__hero-placeholder' }}
      {%- endif -%}
    </picture>

    <div class="ww-trade-page__hero-overlay"></div>

    <div class="ww-trade-page__hero-content">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="ww-trade-page__eyebrow ww-trade-page__eyebrow--light">{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.hero_title != blank -%}
        <h1>{{ section.settings.hero_title }}</h1>
      {%- endif -%}
      {%- if section.settings.hero_subtitle != blank -%}
        <div class="ww-trade-page__hero-copy">{{ section.settings.hero_subtitle }}</div>
      {%- endif -%}
      <div class="ww-trade-page__actions">
        {%- if section.settings.hero_cta_text != blank -%}
          <a class="ww-trade-page__button ww-trade-page__button--light" href="{{ section.settings.hero_cta_link | default: '#trade-apply' }}">
            {{ section.settings.hero_cta_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.hero_secondary_text != blank -%}
          <a class="ww-trade-page__button ww-trade-page__button--ghost-light" href="{{ section.settings.hero_secondary_link | default: '#trade-benefits' }}">
            {{ section.settings.hero_secondary_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if benefit_blocks.size > 0 -%}
    <section id="trade-benefits" class="ww-trade-page__section ww-trade-page__benefits">
      <div class="ww-trade-page__container">
        <div class="ww-trade-page__section-heading">
          {%- if section.settings.benefits_eyebrow != blank -%}
            <p class="ww-trade-page__eyebrow">{{ section.settings.benefits_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.benefits_heading != blank -%}
            <h2>{{ section.settings.benefits_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.benefits_body != blank -%}
            <div class="ww-trade-page__rte">{{ section.settings.benefits_body }}</div>
          {%- endif -%}
        </div>

        <div class="ww-trade-page__benefit-grid">
          {%- for block in benefit_blocks -%}
            <article class="ww-trade-page__benefit" {{ block.shopify_attributes }}>
              <div class="ww-trade-page__benefit-image">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}">
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'ww-trade-page__benefit-placeholder' }}
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="ww-trade-page__rte ww-trade-page__rte--small">{{ block.settings.body }}</div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if testimonial_blocks.size > 0 -%}
    <section class="ww-trade-page__section ww-trade-page__testimonials" data-ww-trade-testimonials>
      <div class="ww-trade-page__container">
        <div class="ww-trade-page__testimonial-header">
          {%- if section.settings.testimonials_heading != blank -%}
            <h2>{{ section.settings.testimonials_heading }}</h2>
          {%- endif -%}
          <div class="ww-trade-page__testimonial-arrows" aria-label="Testimonials controls">
            <button class="ww-trade-page__testimonial-arrow" type="button" data-ww-testimonial-prev aria-label="Previous testimonial">
              <span aria-hidden="true">&lsaquo;</span>
            </button>
            <button class="ww-trade-page__testimonial-arrow" type="button" data-ww-testimonial-next aria-label="Next testimonial">
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          </div>
        </div>

        <div class="ww-trade-page__testimonial-track" data-ww-testimonial-track>
          {%- for block in testimonial_blocks -%}
            <article class="ww-trade-page__testimonial" {{ block.shopify_attributes }}>
              {%- if block.settings.quote != blank -%}
                <div class="ww-trade-page__testimonial-quote">{{ block.settings.quote }}</div>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <p class="ww-trade-page__testimonial-author">{{ block.settings.author }}</p>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.intro_heading != blank or section.settings.intro_body != blank -%}
    <section class="ww-trade-page__section ww-trade-page__intro">
      <div class="ww-trade-page__container ww-trade-page__container--narrow">
        {%- if section.settings.intro_eyebrow != blank -%}
          <p class="ww-trade-page__eyebrow">{{ section.settings.intro_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.intro_heading != blank -%}
          <h2>{{ section.settings.intro_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro_body != blank -%}
          <div class="ww-trade-page__rte">{{ section.settings.intro_body }}</div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.split1_heading != blank or section.settings.split1_image != blank -%}
    <section class="ww-trade-page__split">
      <div class="ww-trade-page__split-media">
        {%- if section.settings.split1_image != blank -%}
          <img
            src="{{ section.settings.split1_image | image_url: width: 1600 }}"
            alt="{{ section.settings.split1_heading | escape }}"
            loading="lazy"
            width="{{ section.settings.split1_image.width }}"
            height="{{ section.settings.split1_image.height }}">
        {%- endif -%}
      </div>
      <div class="ww-trade-page__split-copy">
        {%- if section.settings.split1_eyebrow != blank -%}
          <p class="ww-trade-page__eyebrow">{{ section.settings.split1_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.split1_heading != blank -%}
          <h2>{{ section.settings.split1_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.split1_body != blank -%}
          <div class="ww-trade-page__rte">{{ section.settings.split1_body }}</div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.split2_heading != blank or section.settings.split2_image != blank -%}
    <section class="ww-trade-page__split ww-trade-page__split--reverse">
      <div class="ww-trade-page__split-media">
        {%- if section.settings.split2_image != blank -%}
          <img
            src="{{ section.settings.split2_image | image_url: width: 1600 }}"
            alt="{{ section.settings.split2_heading | escape }}"
            loading="lazy"
            width="{{ section.settings.split2_image.width }}"
            height="{{ section.settings.split2_image.height }}">
        {%- endif -%}
      </div>
      <div class="ww-trade-page__split-copy">
        {%- if section.settings.split2_eyebrow != blank -%}
          <p class="ww-trade-page__eyebrow">{{ section.settings.split2_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.split2_heading != blank -%}
          <h2>{{ section.settings.split2_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.split2_body != blank -%}
          <div class="ww-trade-page__rte">{{ section.settings.split2_body }}</div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if step_blocks.size > 0 -%}
    <section class="ww-trade-page__section ww-trade-page__steps">
      <div class="ww-trade-page__container">
        <div class="ww-trade-page__section-heading">
          {%- if section.settings.steps_eyebrow != blank -%}
            <p class="ww-trade-page__eyebrow">{{ section.settings.steps_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.steps_heading != blank -%}
            <h2>{{ section.settings.steps_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.steps_body != blank -%}
            <div class="ww-trade-page__rte">{{ section.settings.steps_body }}</div>
          {%- endif -%}
        </div>

        <div class="ww-trade-page__step-grid">
          {%- for block in step_blocks -%}
            <article class="ww-trade-page__step" {{ block.shopify_attributes }}>
              <span>{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <h3>{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <div class="ww-trade-page__rte ww-trade-page__rte--small">{{ block.settings.body }}</div>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_form -%}
    <section id="trade-apply" class="ww-trade-page__section ww-trade-page__form-section">
      <div class="ww-trade-page__container ww-trade-page__form-grid">
        <div class="ww-trade-page__form-copy">
          {%- if section.settings.form_eyebrow != blank -%}
            <p class="ww-trade-page__eyebrow">{{ section.settings.form_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.form_heading != blank -%}
            <h2>{{ section.settings.form_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.form_body != blank -%}
            <div class="ww-trade-page__rte">{{ section.settings.form_body }}</div>
          {%- endif -%}
        </div>
        <div class="ww-trade-page__form-panel">
          {% render 'ww-trade-hulk-form' %}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if faq_blocks.size > 0 -%}
    <section class="ww-trade-page__section ww-trade-page__faq">
      <div class="ww-trade-page__container ww-trade-page__container--narrow">
        {%- if section.settings.faq_heading != blank -%}
          <h2>{{ section.settings.faq_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.faq_body != blank -%}
          <div class="ww-trade-page__rte">{{ section.settings.faq_body }}</div>
        {%- endif -%}
        <div class="ww-trade-page__faq-list">
          {%- for block in faq_blocks -%}
            <details class="ww-trade-page__faq-item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question }}</span>
                <span aria-hidden="true">+</span>
              </summary>
              <div class="ww-trade-page__faq-answer ww-trade-page__rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</section>

<script>
  (function() {
    function initTradeTestimonials(root) {
      if (root.dataset.wwTestimonialsReady === 'true') {
        return;
      }

      var track = root.querySelector('[data-ww-testimonial-track]');
      var prev = root.querySelector('[data-ww-testimonial-prev]');
      var next = root.querySelector('[data-ww-testimonial-next]');

      if (!track || !prev || !next) {
        return;
      }

      function scrollTestimonials(direction) {
        var distance = track.clientWidth;
        track.scrollBy({ left: direction * distance, behavior: 'smooth' });
      }

      prev.addEventListener('click', function() {
        scrollTestimonials(-1);
      });

      next.addEventListener('click', function() {
        scrollTestimonials(1);
      });

      root.dataset.wwTestimonialsReady = 'true';
    }

    function initAllTradeTestimonials() {
      document.querySelectorAll('[data-ww-trade-testimonials]').forEach(initTradeTestimonials);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAllTradeTestimonials);
    } else {
      initAllTradeTestimonials();
    }

    document.addEventListener('shopify:section:load', initAllTradeTestimonials);
  })();
</script>

<style>
  #shopify-section-{{ section.id }} .ww-trade-page {
    background: #fff;
    color: #000;
    font-family: "Gotham Book", Arial, sans-serif;
    overflow-x: clip;
  }

  #shopify-section-{{ section.id }} .ww-trade-page * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__container {
    width: min(100%, 1320px);
    margin: 0 auto;
    padding: 0 48px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__container--narrow {
    max-width: 920px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__section {
    padding: 96px 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero {
    position: relative;
    min-height: 700px;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
    background: #111;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-picture,
  #shopify-section-{{ section.id }} .ww-trade-page__hero-image,
  #shopify-section-{{ section.id }} .ww-trade-page__hero-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-image {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-placeholder {
    background: #222;
    fill: #444;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, .62) 0%, rgba(0, 0, 0, .28) 48%, rgba(0, 0, 0, .06) 100%);
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 1320px);
    margin: 0 auto;
    padding: 0 48px 92px;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero h1,
  #shopify-section-{{ section.id }} .ww-trade-page h2,
  #shopify-section-{{ section.id }} .ww-trade-page h3 {
    margin: 0;
    color: inherit;
    font-family: "GothamBlack", "Gotham Book", Arial, sans-serif;
    font-weight: 700;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero h1 {
    max-width: 780px;
    font-size: clamp(48px, 7vw, 108px);
    line-height: .95;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-page h2 {
    font-size: clamp(30px, 4vw, 54px);
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .ww-trade-page h3 {
    font-size: 18px;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    line-height: 1.4;
    font-family: "GothamBlack", "Gotham Book", Arial, sans-serif;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__eyebrow--light {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-copy {
    max-width: 560px;
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-copy p,
  #shopify-section-{{ section.id }} .ww-trade-page__rte p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__hero-copy p + p,
  #shopify-section-{{ section.id }} .ww-trade-page__rte p + p {
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__rte {
    color: #111;
    font-size: 16px;
    line-height: 1.75;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__rte--small {
    font-size: 14px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 168px;
    min-height: 48px;
    padding: 14px 28px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: "GothamBlack", "Gotham Book", Arial, sans-serif;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__button--light {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__button--light:hover {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__button--ghost-light {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__button--ghost-light:hover,
  #shopify-section-{{ section.id }} .ww-trade-page__button--dark {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__intro {
    text-align: center;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__intro .ww-trade-page__rte,
  #shopify-section-{{ section.id }} .ww-trade-page__section-heading .ww-trade-page__rte {
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 640px;
    border-top: 1px solid #e5e5e5;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__split--reverse .ww-trade-page__split-media {
    order: 2;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__split-media {
    min-height: 520px;
    background: #f3f3f3;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__split-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__split-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 88px clamp(32px, 6vw, 110px);
  }

  #shopify-section-{{ section.id }} .ww-trade-page__split-copy .ww-trade-page__rte {
    max-width: 560px;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__form-section {
    background: #f5f5f5;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefits {
    background: #fff;
    padding-top: 64px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__section-heading {
    max-width: 720px;
    margin-bottom: 52px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefits .ww-trade-page__section-heading {
    max-width: none;
    margin-bottom: 34px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefits .ww-trade-page__section-heading h2 {
    font-family: "Ambroise", Georgia, serif;
    font-size: clamp(42px, 5vw, 62px);
    font-weight: 400;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit-image {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    margin-bottom: 20px;
    overflow: hidden;
    background: #f3f3f3;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit-image img,
  #shopify-section-{{ section.id }} .ww-trade-page__benefit-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit-placeholder {
    fill: #d8d8d8;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit h3 {
    max-width: 94%;
    font-family: "Gotham Book", Arial, sans-serif;
    font-size: clamp(20px, 1.7vw, 28px);
    font-weight: 400;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__benefit .ww-trade-page__rte,
  #shopify-section-{{ section.id }} .ww-trade-page__step .ww-trade-page__rte {
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__testimonials {
    background: #fff;
    padding-top: 34px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__testimonial-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__testimonial-header h2 {
    font-family: "Ambroise", Georgia, serif;
    font-size: clamp(42px, 5vw, 62px);
    font-weight: 400;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__testimonial-arrows {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .ww-trade-page__testimonial-arrow {
    display: inline-flex;
