{%- comment -%}
  William Wood trade hero.
  This section is intentionally hero-only so the editor can hide/reorder
  the hero separately from Why join, Testimonials and the rest of the page.
{%- endcomment -%}

<section class="ww-trade-hero" data-ww-trade-hero>
  <picture class="ww-trade-hero__picture">
    {%- if section.settings.hero_mobile_image != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.hero_mobile_image | image_url: width: 900 }}">
    {%- endif -%}
    {%- if section.settings.hero_image != blank -%}
      <img
        class="ww-trade-hero__image"
        src="{{ settings.speedsize_url_pfx_https -}}{{ section.settings.hero_image | image_url: width: 2400 }}"
        alt="{{ section.settings.hero_title | escape }}"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ww-trade-hero__placeholder' }}
    {%- endif -%}
  </picture>

  <div class="ww-trade-hero__overlay"></div>

  <div class="ww-trade-hero__content">
    {%- if section.settings.hero_eyebrow != blank -%}
      <p class="ww-trade-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.hero_title != blank -%}
      <h1>{{ section.settings.hero_title }}</h1>
    {%- endif -%}
    {%- if section.settings.hero_subtitle != blank -%}
      <div class="ww-trade-hero__copy">{{ section.settings.hero_subtitle }}</div>
    {%- endif -%}
    <div class="ww-trade-hero__actions">
      {%- if section.settings.hero_cta_text != blank -%}
        <a class="ww-trade-hero__button ww-trade-hero__button--light" href="{{ section.settings.hero_cta_link | default: '/pages/trade-application' }}">
          {{ section.settings.hero_cta_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.hero_secondary_text != blank -%}
        <a class="ww-trade-hero__button ww-trade-hero__button--ghost" href="{{ section.settings.hero_secondary_link | default: '#trade-benefits' }}">
          {{ section.settings.hero_secondary_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ww-trade-hero {
    --ww-trade-text-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-font: "Gotham Book", var(--text-font-family, Arial, sans-serif);
    --ww-trade-heading-weight: var(--heading-font-weight, 700);
    --ww-trade-bold-weight: var(--text-font-bold-weight, 700);
    --ww-trade-body-size: var(--base-font-size, 14px);
    --ww-trade-h1-size: var(--heading-large-font-size, var(--heading-h1-font-size, 72px));
    position: relative;
    min-height: 700px;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
    background: #111;
    color: #fff;
    font-family: var(--ww-trade-text-font);
    font-size: var(--ww-trade-body-size);
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero *,
  #shopify-section-{{ section.id }} .ww-trade-hero *::before,
  #shopify-section-{{ section.id }} .ww-trade-hero *::after {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__picture,
  #shopify-section-{{ section.id }} .ww-trade-hero__image,
  #shopify-section-{{ section.id }} .ww-trade-hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__image {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__placeholder {
    background: #222;
    fill: #444;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(0, 0, 0, .62) 0%, rgba(0, 0, 0, .28) 48%, rgba(0, 0, 0, .06) 100%);
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--container-gutter) 92px;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__eyebrow {
    margin: 0 0 18px;
    font-family: var(--ww-trade-text-font);
    font-size: calc(var(--ww-trade-body-size) - 3px);
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero h1 {
    max-width: 780px;
    margin: 0;
    color: inherit;
    font-family: var(--ww-trade-heading-font);
    font-size: 44px;
    font-weight: var(--ww-trade-heading-weight);
    line-height: 1.1111111111;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__copy {
    max-width: 560px;
    margin-top: 24px;
    font-size: 14px;
    line-height: 1.7333333333;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__copy p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 168px;
    min-height: 48px;
    padding: 14px 28px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--ww-trade-text-font);
    font-size: calc(var(--ww-trade-body-size) - 3px);
    font-weight: var(--ww-trade-bold-weight);
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__button--light {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  #shopify-section-{{ section.id }} .ww-trade-hero__button--ghost {
    color: #fff;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .ww-trade-hero {
      min-height: 620px;
    }

    #shopify-section-{{ section.id }} .ww-trade-hero__content {
      padding: 0 var(--container-gutter) 68px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ww-trade-hero,
    #shopify-section-{{ section.id }} .ww-trade-hero p,
    #shopify-section-{{ section.id }} .ww-trade-hero span,
    #shopify-section-{{ section.id }} .ww-trade-hero a,
    #shopify-section-{{ section.id }} .ww-trade-hero button {
      font-family: var(--ww-trade-text-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-hero h1,
    #shopify-section-{{ section.id }} .ww-trade-hero h2,
    #shopify-section-{{ section.id }} .ww-trade-hero h3 {
      font-family: var(--ww-trade-heading-font);
    }

    #shopify-section-{{ section.id }} .ww-trade-hero {
      min-height: 560px;
    }

    #shopify-section-{{ section.id }} .ww-trade-hero__overlay {
      background: linear-gradient(180deg, rgba(0, 0, 0, .12) 0%, rgba(0, 0, 0, .64) 100%);
    }

    #shopify-section-{{ section.id }} .ww-trade-hero__content {
      padding: 0 var(--container-gutter) 46px;
    }

    #shopify-section-{{ section.id }} .ww-trade-hero h1 {
      font-size: var(--heading-h1-font-size, 40px);
    }

    #shopify-section-{{ section.id }} .ww-trade-hero__copy {
      font-size: calc(var(--ww-trade-body-size) - 1px);
      line-height: 1.7142857143;
    }

    #shopify-section-{{ section.id }} .ww-trade-hero__button {
      min-width: 0;
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "WW trade hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "William Wood Trade"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Heading",
      "default": "William Wood Trade"
    },
    {
      "type": "richtext",
      "id": "hero_subtitle",
      "label": "Text",
      "default": "<p>Exclusive access, dedicated support and considered pieces for residential and commercial projects.</p>"
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "Primary button text",
      "default": "Join now"
    },
    {
      "type": "url",
      "id": "hero_cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "hero_secondary_text",
      "label": "Secondary button text",
      "default": "View benefits"
    },
    {
      "type": "url",
      "id": "hero_secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "WW trade hero"
    }
  ]
}
{% endschema %}
