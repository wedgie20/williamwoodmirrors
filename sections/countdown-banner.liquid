<style>
  {{ section.settings.ss_font_family | font_face: font_display: 'swap' }}

  .ss-countdown-bar {
    overflow: hidden;
  }
  .ss-countdown-bar:hover {
    opacity: 0.{{ section.settings.hover_opacity }};
  }
  .countdown-bar__link {
    display: block;
    width: 100%;
    padding: {{ section.settings.padding_vertical }}rem {{ section.settings.padding_horizontal }}rem;
    text-decoration: none;
    color: var(--text-color);
  }
  .countdown-bar__link:hover {
    color: var(--text-color);
  }
  .countdown-bar__inner {
    {% comment %} display: flex; {% endcomment %}
     text-align: center;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .countdown-bar__description {
    margin: 0;
    line-height: 1;
    font-size: {{ section.settings.text_size }}px;
    font-family: {{ section.settings.ss_font_family.family }};
    font-weight: {{ section.settings.ss_font_family.weight }};
  }
  .countdown-bar__timer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }
  .countdown-bar__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .countdown-bar__value {
    font-size: {{ section.settings.text_size }}px;
    font-family: {{ section.settings.ss_font_family.family }};
    font-weight: {{ section.settings.ss_font_family.weight }};
    min-width: 1.6em;
    text-align: center;
  }
  .countdown-bar__separator {
    font-size: {{ section.settings.text_size }}px;
    font-family: {{ section.settings.ss_font_family.family }};
    font-weight: {{ section.settings.ss_font_family.weight }};
  }
</style>

{%- comment -%}
  Build zero-padded ISO-ish date strings from the individual settings fields,
  e.g. start_month "9" becomes "09" via the '0' | append | slice trick.
{%- endcomment -%}
{%- assign start_month_padded = '0' | append: section.settings.start_month | slice: -2, 2 -%}
{%- assign start_day_padded = '0' | append: section.settings.start_day | slice: -2, 2 -%}
{%- assign start_hour_padded = '0' | append: section.settings.start_hour | slice: -2, 2 -%}
{%- assign start_minute_padded = '0' | append: section.settings.start_minute | slice: -2, 2 -%}

{%- assign end_month_padded = '0' | append: section.settings.end_month | slice: -2, 2 -%}
{%- assign end_day_padded = '0' | append: section.settings.end_day | slice: -2, 2 -%}
{%- assign end_hour_padded = '0' | append: section.settings.end_hour | slice: -2, 2 -%}
{%- assign end_minute_padded = '0' | append: section.settings.end_minute | slice: -2, 2 -%}

{%- assign start_datetime = section.settings.start_year | append: '-' | append: start_month_padded | append: '-' | append: start_day_padded | append: 'T' | append: start_hour_padded | append: ':' | append: start_minute_padded | append: ':00' -%}
{%- assign end_datetime = section.settings.end_year | append: '-' | append: end_month_padded | append: '-' | append: end_day_padded | append: 'T' | append: end_hour_padded | append: ':' | append: end_minute_padded | append: ':00' -%}

<template id="countdown-bar-{{ section.id }}">
  <div
    class="ss-countdown-bar ss-countdown-bar-{{ section.id }}"
    aria-label="Countdown offer"
    style="background-color: {{ section.settings.bg }}; --text-color: {{ section.settings.text_color }};"
    data-start="{{ start_datetime }}"
    data-end="{{ end_datetime }}"
    data-hide-on-expire="{{ section.settings.hide_on_expire }}"
  >
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" style="cursor: pointer;">
    {% endif %}
    <div class="countdown-bar__link">
      <div class="countdown-bar__inner">
        {%- if section.settings.description != blank -%}
          <p class="countdown-bar__description">{{ section.settings.description }}</p>
        {%- endif -%}
        <div class="countdown-bar__timer" data-countdown-timer>
          <div class="countdown-bar__unit">
            <span class="countdown-bar__value" data-countdown-hours>00</span>
          </div>
          <span class="countdown-bar__separator">:</span>
          <div class="countdown-bar__unit">
            <span class="countdown-bar__value" data-countdown-minutes>00</span>
          </div>
          <span class="countdown-bar__separator">:</span>
          <div class="countdown-bar__unit">
            <span class="countdown-bar__value" data-countdown-seconds>00</span>
          </div>
        </div>
      </div>
    </div>
    {%- if section.settings.link != blank -%}</a>{% endif %}
  </div>
</template>

<div id="countdown-local-target-{{ section.id }}"></div>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    let cssTarget = '{{ section.settings.insert_css_class_target }}';
    let productForm = cssTarget
      ? document.querySelector(cssTarget)
      : document.querySelector('#countdown-local-target-{{ section.id }}');

    if (!productForm) return;

    const templateContent = document.querySelector('#countdown-bar-{{ section.id }}').content;
    const insertedBar = templateContent.firstElementChild;

    productForm.insertAdjacentElement('beforebegin', insertedBar);

    const startDate = new Date(insertedBar.dataset.start);
    const endDate = new Date(insertedBar.dataset.end);
    const hideOnExpire = insertedBar.dataset.hideOnExpire === 'true';

    const hoursEl = insertedBar.querySelector('[data-countdown-hours]');
    const minutesEl = insertedBar.querySelector('[data-countdown-minutes]');
    const secondsEl = insertedBar.querySelector('[data-countdown-seconds]');

    function pad(num) {
      return String(num).padStart(2, '0');
    }

    function updateCountdown() {
      const now = new Date();

      // Not started yet — stay hidden until the start date/time is reached
      if (now < startDate) {
        insertedBar.style.display = 'none';
        return;
      }

      const diff = endDate - now;

      if (diff <= 0) {
        // Countdown has ended
        if (hideOnExpire) {
          insertedBar.style.display = 'none';
          clearInterval(intervalId);
          return;
        }
        hoursEl.textContent = '00';
        minutesEl.textContent = '00';
        secondsEl.textContent = '00';
        clearInterval(intervalId);
        return;
      }

      insertedBar.style.display = '';

      const totalSeconds = Math.floor(diff / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      hoursEl.textContent = pad(hours);
      minutesEl.textContent = pad(minutes);
      secondsEl.textContent = pad(seconds);
    }

    updateCountdown();
    const intervalId = setInterval(updateCountdown, 1000);
  });
</script>

{% schema %}
{
  "name": "SS - Countdown Bar",
  "settings": [
    {
      "type": "header",
      "content": "Save section to see live"
    },
    {
      "type": "text",
      "id": "insert_css_class_target",
      "label": "Target CSS Class",
      "default": ".header, .pageheader, .section-header, #announcement, .toolbar, .header__wrapper",
      "placeholder": ".header, .pageheader",
      "info": "Leave as default to display above the header. Add a CSS class of a specific element to insert the bar right before it instead."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Sale ends in"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Url"
    },
    {
      "type": "header",
      "content": "Countdown Start"
    },
    {
      "type": "text",
      "id": "start_year",
      "label": "Start Year",
      "default": "2026"
    },
    {
      "type": "text",
      "id": "start_month",
      "label": "Start Month",
      "info": "1-12",
      "default": "1"
    },
    {
      "type": "text",
      "id": "start_day",
      "label": "Start Day",
      "info": "1-31",
      "default": "1"
    },
    {
      "type": "text",
      "id": "start_hour",
      "label": "Start Hour",
      "info": "0-23, 24hr format",
      "default": "0"
    },
    {
      "type": "text",
      "id": "start_minute",
      "label": "Start Minute",
      "info": "0-59",
      "default": "0"
    },
    {
      "type": "header",
      "content": "Countdown End"
    },
    {
      "type": "text",
      "id": "end_year",
      "label": "End Year",
      "default": "2026"
    },
    {
      "type": "text",
      "id": "end_month",
      "label": "End Month",
      "info": "1-12",
      "default": "12"
    },
    {
      "type": "text",
      "id": "end_day",
      "label": "End Day",
      "info": "1-31",
      "default": "31"
    },
    {
      "type": "text",
      "id": "end_hour",
      "label": "End Hour",
      "info": "0-23, 24hr format",
      "default": "23"
    },
    {
      "type": "text",
      "id": "end_minute",
      "label": "End Minute",
      "info": "0-59",
      "default": "59"
    },
    {
      "type": "checkbox",
      "id": "hide_on_expire",
      "label": "Hide bar when countdown ends",
      "default": true,
      "info": "If off, the bar stays visible showing 00:00:00 after the end date/time passes."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Font size",
      "default": 12,
      "min": 8,
      "max": 50,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "font_picker",
      "id": "ss_font_family",
      "label": "Font family",
      "default": "montserrat_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "hover_opacity",
      "label": "Background color hover opacity",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 90
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "unit": "rem",
      "min": 0,
      "max": 5,
      "step": 0.2,
      "default": 2
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding vertical",
      "unit": "rem",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 1.5
    }
  ],
  "presets": [
    {
      "category": "Custom",
      "name": "SS - Countdown Bar"
    }
  ]
}
{% endschema %}
