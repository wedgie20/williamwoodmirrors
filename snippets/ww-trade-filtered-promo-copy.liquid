    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p><strong>Bundle & Save</strong></p>', '<p data-ww-trade-collection-promo-copy><strong>Bundle & Save</strong></p>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p><b>Bundle &amp; Save</b></p>', '<p data-ww-trade-collection-promo-copy><b>Bundle &amp; Save</b></p>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p><b>Bundle & Save</b></p>', '<p data-ww-trade-collection-promo-copy><b>Bundle & Save</b></p>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p>Bundle &amp; Save</p>', '<p data-ww-trade-collection-promo-copy>Bundle &amp; Save</p>' -%}
