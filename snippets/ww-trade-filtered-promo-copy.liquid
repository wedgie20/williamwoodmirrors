    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<strong>Bundle & Save</strong>', '<strong><span data-ww-trade-collection-promo-copy>Bundle & Save</span></strong>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<b>Bundle &amp; Save</b>', '<b><span data-ww-trade-collection-promo-copy>Bundle &amp; Save</span></b>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<b>Bundle & Save</b>', '<b><span data-ww-trade-collection-promo-copy>Bundle & Save</span></b>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '15% off 1 product or 20% off 2 products or 30% off when you buy 3+ products.', '<span data-ww-trade-collection-promo-copy>15% off 1 product or 20% off 2 products or 30% off when you buy 3+ products.</span>' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: 'No code required. Limited time only.', '<span data-ww-trade-collection-promo-copy>No code required. Limited time only.</span>' -%}
    {{- ww_trade_filtered_output -}}
  {%- endif -%}
{%- else -%}
  {{- ww_trade_filtered_content -}}
{%- endif -%}
