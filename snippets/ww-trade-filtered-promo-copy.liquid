    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p>15% off 1 product or 20% off 2 products or 30% off when you buy 3+ products.</p>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p>15% off 1 product or 20% off 2 products or 30% off when you buy 3+ products</p>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p>No code required. Limited time only.</p>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p>No code required. Limited time only</p>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<strong>Bundle &amp; Save</strong>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<strong>Bundle & Save</strong>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<b>Bundle &amp; Save</b>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<b>Bundle & Save</b>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: 'Bundle &amp; Save', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: 'Bundle & Save', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '15% off 1 product or 20% off 2 products or 30% off when you buy 3+ products.', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '15% off 1 product or 20% off 2 products or 30% off when you buy 3+ products', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: 'No code required. Limited time only.', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: 'No code required. Limited time only', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p><strong></strong></p>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p><b></b></p>', '' -%}
    {%- assign ww_trade_filtered_output = ww_trade_filtered_output | replace: '<p></p>', '' -%}
    {{- ww_trade_filtered_output -}}
  {%- else -%}
