      flex: 0 0 calc((100% - 12px) / 2);
      min-width: calc((100% - 12px) / 2);
      width: calc((100% - 12px) / 2);
      gap: 0;
      padding: 0 !important;
      scroll-snap-align: start;
    }

    .ww-pdp__ctl .ctl-box--inline .ctl-card__body {
      min-height: 0;
      padding-top: 12px;
    }

    .ww-pdp__ctl .ctl-box--inline .ctl-card__title {
      min-height: 34px;
      font-size: 13px;
      line-height: 1.25;
    }

    .ww-pdp__ctl .ctl-box--inline .ctl-card__price {
      margin-top: 6px;
      font-size: 13px;
      line-height: 1.2;
      font-weight: 400;
    }

    .ww-pdp__ctl .ctl-box--inline .ctl-card__rating {
      margin-top: 12px;
    }

    .ww-pdp__details {
      padding: 24px 28px 24px 28px;
    }

    .ww-pdp__detail-image {
      order: 2;
      min-height: 0;
      aspect-ratio: 1 / 1.15;
      margin: 8px 0 0;
    }

    .ww-pdp__detail-copy {
      order: 1;
      padding-top: 0;
      font-size: 16px;
      padding-left: 0px !important;
    }

    .ww-pdp__detail-copy h2 {
      margin-bottom: 32px;
      font-size: 24px;
      font-weight: 500;
      font-family: 'Gotham Book';
    }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-ww-pdp]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    var gallery = root.querySelector('[data-ww-pdp-gallery]');
    var mainImage = root.querySelector('[data-ww-pdp-main-image]');
    var thumbs = gallery ? Array.prototype.slice.call(gallery.querySelectorAll('[data-ww-pdp-thumb]')) : [];
    var currentIndex = thumbs.findIndex(function (thumb) { return thumb.classList.contains('is-active'); });
    if (currentIndex < 0) currentIndex = 0;

    function showImage(index) {
      if (!mainImage || !thumbs.length) return;
      currentIndex = (index + thumbs.length) % thumbs.length;
      var thumb = thumbs[currentIndex];
      mainImage.src = thumb.dataset.src;
      mainImage.removeAttribute('srcset');
      mainImage.alt = thumb.dataset.alt || '';
      thumbs.forEach(function (item) { item.classList.remove('is-active'); });
      thumb.classList.add('is-active');
    }

    thumbs.forEach(function (thumb, index) {
      thumb.addEventListener('click', function () { showImage(index); });
    });

    var prev = root.querySelector('[data-ww-pdp-prev]');
    var next = root.querySelector('[data-ww-pdp-next]');
    var zoom = root.querySelector('[data-ww-pdp-zoom]');
    var lightbox = root.querySelector('[data-ww-pdp-lightbox]');
    var lightboxImage = lightbox ? lightbox.querySelector('[data-ww-pdp-lightbox-image]') : null;
    var lightboxCloseButtons = lightbox ? lightbox.querySelectorAll('[data-ww-pdp-lightbox-close]') : [];
    var lightboxPrev = lightbox ? lightbox.querySelector('[data-ww-pdp-lightbox-prev]') : null;
    var lightboxNext = lightbox ? lightbox.querySelector('[data-ww-pdp-lightbox-next]') : null;
    var previousBodyOverflow = '';
    var lightboxTouchStartX = 0;

    function updateLightboxImage() {
      if (!lightboxImage || !mainImage || !mainImage.src) return;
      var activeThumb = thumbs[currentIndex];
      lightboxImage.src = activeThumb && activeThumb.dataset.src ? activeThumb.dataset.src : (mainImage.currentSrc || mainImage.src);
      lightboxImage.alt = activeThumb && activeThumb.dataset.alt ? activeThumb.dataset.alt : (mainImage.alt || '');
    }

    function moveLightbox(step) {
      if (!thumbs.length) return;
      showImage(currentIndex + step);
      updateLightboxImage();
    }

    function openLightbox() {
      if (!lightbox || !lightboxImage || !mainImage || !mainImage.src) return;
      updateLightboxImage();
      var hasMultipleImages = thumbs.length > 1;
      if (lightboxPrev) lightboxPrev.hidden = !hasMultipleImages;
      if (lightboxNext) lightboxNext.hidden = !hasMultipleImages;
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      lightbox.hidden = false;
      var closeButton = lightbox.querySelector('.ww-pdp-lightbox__close');
      if (closeButton) closeButton.focus();
    }

    function closeLightbox() {
      if (!lightbox || lightbox.hidden) return;
      lightbox.hidden = true;
      lightboxImage.removeAttribute('src');
      document.body.style.overflow = previousBodyOverflow;
      if (zoom) zoom.focus();
    }

    if (prev) prev.addEventListener('click', function () { showImage(currentIndex - 1); });
    if (next) next.addEventListener('click', function () { showImage(currentIndex + 1); });
    if (zoom) zoom.addEventListener('click', openLightbox);
    if (lightboxPrev) {
      lightboxPrev.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        moveLightbox(-1);
      });
    }
    if (lightboxNext) {
      lightboxNext.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        moveLightbox(1);
      });
    }
    lightboxCloseButtons.forEach(function (button) {
      button.addEventListener('click', closeLightbox);
    });
    document.addEventListener('keydown', function (event) {
      if (!lightbox || lightbox.hidden) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') moveLightbox(-1);
      if (event.key === 'ArrowRight') moveLightbox(1);
    });
    if (lightbox) {
      lightbox.addEventListener('touchstart', function (event) {
        lightboxTouchStartX = event.changedTouches[0].clientX;
      }, { passive: true });
      lightbox.addEventListener('touchend', function (event) {
        var distance = event.changedTouches[0].clientX - lightboxTouchStartX;
        if (Math.abs(distance) < 45) return;
        moveLightbox(distance > 0 ? -1 : 1);
      }, { passive: true });
    }

    root.querySelectorAll('[data-ww-quantity]').forEach(function (quantity) {
      var input = quantity.querySelector('input');
      var minus = quantity.querySelector('[data-ww-quantity-minus]');
      var plus = quantity.querySelector('[data-ww-quantity-plus]');
      if (!input) return;
      if (minus) {
        minus.addEventListener('click', function () {
          input.value = Math.max(1, parseInt(input.value || '1', 10) - 1);
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
      if (plus) {
        plus.addEventListener('click', function () {
          input.value = Math.max(1, parseInt(input.value || '1', 10) + 1);
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
    });

    root.querySelectorAll('[data-ww-copy-code]').forEach(function (button) {
      button.addEventListener('click', function () {
        var code = button.dataset.wwCopyCode;
        if (!code) return;
        var done = function () {
          var label = button.querySelector('span');
          if (!label) return;
          var original = label.textContent;
          label.textContent = 'Copied';
          setTimeout(function () { label.textContent = original; }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(done).catch(done);
        } else {
          done();
        }
      });
    });

    root.querySelectorAll('[data-ww-read-more]').forEach(function (button) {
      button.addEventListener('click', function () {
        var excerpt = button.closest('.ww-pdp__excerpt');
        if (!excerpt) return;
        var text = excerpt.querySelector('[data-ww-excerpt-text]');
        if (!text) return;

        var isExpanded = button.getAttribute('aria-expanded') === 'true';
        text.classList.toggle('is-expanded', !isExpanded);
        button.textContent = isExpanded ? 'Read more' : 'Read less';
        button.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      });
    });

    function formatInstallmentMoney(cents) {
      var rounded = Math.round(cents);
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(rounded, {{ shop.money_format | json }});
      }

      var amount = rounded / 100;
      return new Intl.NumberFormat('en-GB', {
        style: 'currency',
        currency: (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'GBP',
        minimumFractionDigits: amount % 1 === 0 ? 0 : 2,
        maximumFractionDigits: 2
      }).format(amount);
    }

    var variantSelect = root.querySelector('.ww-pdp__variant select[name="id"]');
    var priceGroup = root.querySelector('[data-ww-pdp-price-group]');
    var stockPill = root.querySelector('.ww-pdp__pill--stock');
    var addButton = root.querySelector('.ww-pdp__add');
    var stickyBar = document.querySelector('#shopify-section-{{ section.id }} [data-ww-pdp-sticky-atc]');
    var stickyPrice = stickyBar ? stickyBar.querySelector('[data-ww-sticky-price]') : null;
    var stickyMobileLabel = stickyBar ? stickyBar.querySelector('.ww-pdp-sticky-atc__mobile-label') : null;
    var stickyAddButton = stickyBar ? stickyBar.querySelector('[data-ww-sticky-add]') : null;
    var stickyQuantity = stickyBar ? stickyBar.querySelector('[data-ww-sticky-quantity]') : null;
    var stickyQuantityInput = stickyQuantity ? stickyQuantity.querySelector('input') : null;
    var mainQuantityInput = root.querySelector('.ww-pdp__quantity input[name="quantity"]');

    function stickyPriceHtml(priceText, compareText) {
      return (compareText ? '<span class="ww-pdp-sticky-atc__price-compare">' + compareText + '</span>' : '') + '<span class="ww-pdp-sticky-atc__price-current">' + priceText + '</span>';
    }

    function updateStickyPrice(priceText, compareText) {
      if (!stickyPrice || !priceText) return;
      stickyPrice.classList.toggle('is-discounted', !!compareText);
      stickyPrice.innerHTML = stickyPriceHtml(priceText, compareText);
    }

    function updateStickyButtonLabel(priceText, compareText, available) {
      if (!stickyAddButton) return;
      stickyAddButton.disabled = !available;
      var desktopLabel = stickyAddButton.querySelector('.ww-pdp-sticky-atc__desktop-label');
      if (desktopLabel) desktopLabel.textContent = available ? 'Add to bag' : 'Sold out';
      if (stickyMobileLabel) {
        stickyMobileLabel.classList.toggle('is-discounted', !!compareText);
        stickyMobileLabel.innerHTML = available ? stickyPriceHtml(priceText, compareText) + '<span>- Add to bag</span>' : 'Sold out';
      }
    }

    function syncQuantityInputs(source, value) {
      var nextValue = Math.max(1, parseInt(value || '1', 10) || 1);
      if (source !== mainQuantityInput && mainQuantityInput) {
        mainQuantityInput.value = nextValue;
        mainQuantityInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
      if (source !== stickyQuantityInput && stickyQuantityInput) {
        stickyQuantityInput.value = nextValue;
      }
    }

    if (mainQuantityInput && stickyQuantityInput) {
      mainQuantityInput.addEventListener('change', function () {
        syncQuantityInputs(mainQuantityInput, mainQuantityInput.value);
      });

      stickyQuantityInput.addEventListener('change', function () {
        syncQuantityInputs(stickyQuantityInput, stickyQuantityInput.value);
      });
    }

    if (stickyQuantity) {
      var stickyMinus = stickyQuantity.querySelector('[data-ww-sticky-quantity-minus]');
      var stickyPlus = stickyQuantity.querySelector('[data-ww-sticky-quantity-plus]');

      if (stickyMinus) {
        stickyMinus.addEventListener('click', function () {
          syncQuantityInputs(stickyQuantityInput, Math.max(1, parseInt((stickyQuantityInput && stickyQuantityInput.value) || '1', 10) - 1));
        });
      }

      if (stickyPlus) {
        stickyPlus.addEventListener('click', function () {
          syncQuantityInputs(stickyQuantityInput, Math.max(1, parseInt((stickyQuantityInput && stickyQuantityInput.value) || '1', 10) + 1));
        });
      }
    }

    if (stickyAddButton && addButton) {
      stickyAddButton.addEventListener('click', function () {
        if (stickyAddButton.disabled) return;
        syncQuantityInputs(stickyQuantityInput, stickyQuantityInput ? stickyQuantityInput.value : (mainQuantityInput ? mainQuantityInput.value : 1));
        addButton.click();
      });
    }

    function updateStickyVisibility() {
      if (!stickyBar || !addButton) return;
      var addRect = addButton.getBoundingClientRect();
      var footer = document.querySelector('.shopify-section--footer, footer');
      var footerRect = footer ? footer.getBoundingClientRect() : null;
      var footerVisible = footerRect ? footerRect.top < window.innerHeight : false;
      var addButtonVisible = addRect.top < window.innerHeight && addRect.bottom > 0;
      var shouldShow = !addButtonVisible && !footerVisible;
      stickyBar.hidden = false;
      stickyBar.classList.toggle('is-hidden', !shouldShow);
    }

    if (stickyBar && addButton) {
      stickyBar.classList.add('is-hidden');
      stickyBar.hidden = false;
      updateStickyButtonLabel(
        {{ current_variant.price | money | json }},
        {%- if has_variant_discount -%}{{ current_variant.compare_at_price | money | json }}{%- else -%}''{%- endif -%},
        {{ current_variant.available | json }}
      );
      updateStickyVisibility();
      window.addEventListener('scroll', updateStickyVisibility, { passive: true });
      window.addEventListener('resize', updateStickyVisibility);
      window.addEventListener('load', updateStickyVisibility);
    }

    function updateSelectedVariantDisplay(option) {
      if (!option) return;
      var price = parseInt(option.dataset.price || '0', 10);
      var compareAt = parseInt(option.dataset.compareAt || '0', 10);
      var available = option.dataset.available === 'true';
      var priceText = price ? formatInstallmentMoney(price) : '';
      var compareText = compareAt > price ? formatInstallmentMoney(compareAt) : '';

      if (priceGroup && price) {
        if (compareAt > price) {
          priceGroup.classList.add('is-discounted');
          priceGroup.innerHTML = '<span class="ww-pdp__price ww-pdp__price--compare" data-ww-pdp-compare-price>' + formatInstallmentMoney(compareAt) + '</span><span class="ww-pdp__price ww-pdp__price--sale" data-ww-pdp-current-price>' + priceText + '</span>';
        } else {
          priceGroup.classList.remove('is-discounted');
          priceGroup.innerHTML = '<span class="ww-pdp__price" data-ww-pdp-current-price>' + priceText + '</span>';
        }
      }

      updateStickyPrice(priceText, compareText);

      if (stockPill) {
        stockPill.classList.toggle('ww-pdp__pill--sold-out', !available);
        stockPill.innerHTML = '<span></span>' + (available ? 'In stock' : 'Sold out');
      }

      if (addButton) {
        addButton.disabled = !available;
        addButton.textContent = available ? 'Add to bag' : 'Sold out';
      }

      updateStickyButtonLabel(priceText || '', compareText, available);
      updateStickyVisibility();

      root.querySelectorAll('[data-ww-installments]').forEach(function (box) {
        box.dataset.priceCents = price || box.dataset.priceCents;
        var select = box.querySelector('[data-ww-installment-select]');
        if (select) select.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }

    if (variantSelect) {
      variantSelect.addEventListener('change', function () {
        updateSelectedVariantDisplay(variantSelect.options[variantSelect.selectedIndex]);
      });
    }

    root.querySelectorAll('[data-ww-installments]').forEach(function (box) {
      var select = box.querySelector('[data-ww-installment-select]');
      var paypalCount = box.querySelector('[data-ww-paypal-count]');
      var paypalAmount = box.querySelector('[data-ww-paypal-amount]');
      var klarnaAmount = box.querySelector('[data-ww-klarna-amount]');
      if (!select) return;

      function updateInstallments() {
        var priceCents = parseInt(box.dataset.priceCents || '0', 10);
        if (!priceCents) return;
        var count = parseInt(select.value || '3', 10);
        var amount = formatInstallmentMoney(priceCents / count);
        if (paypalCount) paypalCount.textContent = count;
        if (paypalAmount) paypalAmount.textContent = amount;
        if (klarnaAmount) klarnaAmount.textContent = amount;
      }

      select.addEventListener('change', updateInstallments);
      updateInstallments();
    });

    function hideLoosePaymentLines() {
      root.querySelectorAll('product-payment-terms, .shopify-payment-terms, .shopify-installments, [data-shopify-payment-terms], [data-pp-message], .paypal-messages, .ww-pdp__summary > p, .ww-pdp__summary > div:not([class^="ww-pdp__"])').forEach(function (node) {
        if (node.closest('.ww-pdp__payments')) return;
        var text = (node.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
        if (node.matches('product-payment-terms, .shopify-payment-terms, .shopify-installments, [data-shopify-payment-terms], [data-pp-message], .paypal-messages') || (text.indexOf('pay in') !== -1 && text.indexOf('paypal') !== -1 && text.indexOf('interest-free') !== -1)) {
          node.style.setProperty('display', 'none', 'important');
        }
      });
    }

    function hidePostcodeWidget() {
      var summary = root.querySelector('.ww-pdp__summary');
      if (!summary) return;

      summary.querySelectorAll('input').forEach(function (input) {
        var marker = ((input.getAttribute('placeholder') || '') + ' ' + (input.getAttribute('aria-label') || '') + ' ' + (input.name || '') + ' ' + (input.id || '')).toLowerCase();
        if (marker.indexOf('postcode') === -1 && marker.indexOf('post code') === -1 && marker.indexOf('zip') === -1) return;

        var target = input.closest('form') || input.parentElement;
        var walker = target;
        for (var i = 0; i < 6 && walker && walker !== summary; i += 1) {
          if ((walker.textContent || '').toLowerCase().indexOf('postcode') !== -1) {
            target = walker;
          }
          walker = walker.parentElement;
        }

        if (target && target !== summary) {
          target.classList.add('ww-pdp__postcode-widget');
          target.style.setProperty('display', 'none', 'important');
        }
      });
    }

    hideLoosePaymentLines();
    hidePostcodeWidget();
    new MutationObserver(function () {
      hideLoosePaymentLines();
      hidePostcodeWidget();
    }).observe(root, { childList: true, subtree: true });

    function normalizeJudgeMeReviews() {
      var widget = document.querySelector('#judgeme_product_reviews, .jdgm-widget.jdgm-review-widget');
      if (!widget) return;

      var title = widget.querySelector('.jdgm-rev-widg__title');
      if (title && title.textContent.trim() !== 'Community Feedback') {
        title.textContent = 'Community Feedback';
      }
    }

    normalizeJudgeMeReviews();
    if (document.body) {
      new MutationObserver(normalizeJudgeMeReviews).observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
