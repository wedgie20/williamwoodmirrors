{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign title_parts = product.title | split: ' - '

  if title_parts.size > 1
    assign product_label = title_parts.first | strip
    assign product_heading = product.title | remove_first: product_label | remove_first: ' - ' | strip
  else
    assign product_label = product.title | split: ' ' | first | strip
    assign product_heading = product.title
  endif

  assign review_count = product.metafields.reviews.rating_count.value | default: 0
  assign full_description = product.description | strip_html | strip
  assign short_description = product.metafields.custom.short_description.value | default: product.metafields.custom.short_description | default: product.description | strip_html | truncate: 150
  assign has_host_promo = false

  for product_collection in product.collections
    if product_collection.handle == 'host-the-moment'
      assign has_host_promo = true
    endif
  endfor

  assign is_full_price = true
  if current_variant.compare_at_price != blank and current_variant.compare_at_price > current_variant.price
    assign is_full_price = false
  endif
  assign has_variant_discount = false
  if current_variant.compare_at_price != blank and current_variant.compare_at_price > current_variant.price
    assign has_variant_discount = true
  endif

  assign promo_code = ''
  assign promo_text = ''
  assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id

  if has_host_promo
    assign promo_code = 'HOST20'
    assign promo_text = '20% off this item'
  elsif is_full_price
    assign promo_code = 'TAKE15'
    assign promo_text = '15% off on this item'
  endif

  assign payment_amount = current_variant.price | divided_by: 3

  assign detail_height = product.metafields.custom.height.value | default: product.metafields.custom.height
  assign detail_width = product.metafields.custom.width.value | default: product.metafields.custom.width
  assign detail_depth = product.metafields.custom.depth.value | default: product.metafields.custom.depth
  assign detail_colour = product.metafields.custom.colour.value | default: product.metafields.custom.colour | default: product.metafields.custom.color.value | default: product.metafields.custom.color
  assign detail_material = product.metafields.custom.material.value | default: product.metafields.custom.material
  assign detail_weight = product.metafields.custom.weight.value | default: product.metafields.custom.weight
  assign detail_capacity = product.metafields.custom.weight_capacity.value | default: product.metafields.custom.weight_capacity
  assign detail_outdoor = product.metafields.custom.outdoor_suitable.value | default: product.metafields.custom.outdoor_suitable
  assign detail_assembly = product.metafields.custom.assembly.value | default: product.metafields.custom.assembly
  assign detail_care = product.metafields.custom.product_care_information.value | default: product.metafields.custom.product_care_information | default: product.metafields.custom.care.value | default: product.metafields.custom.care
  assign detail_assembly_time = product.metafields.custom.assembly_time.value | default: product.metafields.custom.assembly_time
-%}

{%- liquid
  assign description_detail_lines = product.description | replace: '</li>', '||' | replace: '</p>', '||' | replace: '</h2>', '||' | replace: '</h3>', '||' | replace: '<br />', '||' | replace: '<br>', '||' | replace: '&nbsp;', ' ' | strip_html | split: '||'
  assign description_overall_size = ''
  assign description_colour = ''
  assign description_material = ''
  assign description_weight = ''
  assign description_capacity = ''
  assign description_outdoor = ''
  assign description_assembly = ''
  assign description_assembly_time = ''
  assign description_care = ''
  assign capture_description_care = false
-%}

{%- for description_detail_line_raw in description_detail_lines -%}
  {%- liquid
    assign description_detail_line = description_detail_line_raw | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
    assign normalized_detail_line = description_detail_line | replace: '–', '-' | replace: '—', '-'

    if capture_description_care and description_care == blank and normalized_detail_line != blank
      assign description_care = description_detail_line
      assign capture_description_care = false
    endif

    if normalized_detail_line contains 'Product Care Information'
      assign description_care_remainder = normalized_detail_line | split: 'Product Care Information' | last | remove_first: '-' | remove_first: ':' | strip
      if description_care_remainder != blank
        assign description_care = description_care_remainder
        assign capture_description_care = false
      else
        assign capture_description_care = true
      endif
    elsif normalized_detail_line contains 'Overall Size'
      assign description_overall_size = normalized_detail_line | split: 'Overall Size' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Colour'
      assign description_colour = normalized_detail_line | split: 'Colour' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Color'
      assign description_colour = normalized_detail_line | split: 'Color' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Material'
      assign description_material = normalized_detail_line | split: 'Material' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Weight Capacity'
      assign description_capacity = normalized_detail_line | split: 'Weight Capacity' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Weight'
      assign description_weight = normalized_detail_line | split: 'Weight' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Outdoor suitable'
      assign description_outdoor = normalized_detail_line | split: 'Outdoor suitable' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Outdoor Suitable'
      assign description_outdoor = normalized_detail_line | split: 'Outdoor Suitable' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Assembly Time'
      assign description_assembly_time = normalized_detail_line | split: 'Assembly Time' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Assembly time'
      assign description_assembly_time = normalized_detail_line | split: 'Assembly time' | last | remove_first: '-' | remove_first: ':' | strip
    elsif normalized_detail_line contains 'Assembly'
      assign description_assembly = normalized_detail_line | split: 'Assembly' | last | remove_first: '-' | remove_first: ':' | strip
    endif
  -%}
{%- endfor -%}

{%- liquid
  assign detail_colour = detail_colour | default: description_colour | replace: '","', ', ' | remove: '["' | remove: '"]' | remove: '"' | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
  assign detail_material = detail_material | default: description_material | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
  assign detail_weight = detail_weight | default: description_weight | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
  assign detail_capacity = detail_capacity | default: description_capacity | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
  assign detail_outdoor = detail_outdoor | default: description_outdoor | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
  assign detail_assembly = detail_assembly | default: description_assembly | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
  assign detail_care = detail_care | default: description_care | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
-%}

{%- liquid
  assign detail_assembly_time = detail_assembly_time | default: description_assembly_time | replace: '&nbsp;', ' ' | strip
  assign detail_assembly_note = ''

  if detail_assembly_time == blank
    if product.type == 'Furniture Set'
      assign detail_assembly_time = '0 Minutes'
      assign detail_assembly_note = 'All pieces of this furniture set arrive fully assembled for your convenience.'
    elsif product.type == 'Table' or product.type == 'Chair'
      if product.tags contains 'prebuilt'
        assign detail_assembly_time = '0 Minutes'
        assign detail_assembly_note = 'This piece of furniture arrives fully assembled for your convenience.'
      else
        assign detail_assembly_time = '3-5 Minutes'
        assign detail_assembly_note = 'This piece of furniture arrives ready for quick and easy assembly.'
      endif
    endif
  endif

  if detail_assembly_time != blank and detail_assembly_note == blank
    assign detail_assembly_note = 'This piece of furniture arrives ready for quick and easy assembly.'
  endif
-%}

{%- capture overall_size -%}
  {%- if detail_height != blank -%}{{ detail_height }} Height{%- endif -%}
  {%- if detail_width != blank -%}{% if detail_height != blank %} x {% endif %}{{ detail_width }} Width{%- endif -%}
  {%- if detail_depth != blank -%}{% if detail_height != blank or detail_width != blank %} x {% endif %}{{ detail_depth }} Depth{%- endif -%}
{%- endcapture -%}
{%- assign overall_size_clean = overall_size | strip -%}
{%- assign overall_size_clean = overall_size_clean | default: description_overall_size -%}

{%- assign second_media = blank -%}
{%- for media in product.media -%}
  {%- if forloop.index == 2 -%}
    {%- assign second_media = media -%}
  {%- endif -%}
{%- endfor -%}
{%- assign detail_media = second_media | default: featured_media -%}

<section class="ww-pdp" data-ww-pdp>
  <div class="ww-pdp__top">
    <div class="ww-pdp__media" data-ww-pdp-gallery>
      <div class="ww-pdp__media-frame">
        {%- if featured_media != blank -%}
          <img class="ww-pdp__main-image" data-ww-pdp-main-image loading="eager" sizes="(min-width: 1000px) 57vw, 100vw" {% render 'image-attributes', image: featured_media.preview_image, sizes: '800,1000,1200,1400,1600,1800,2200' %}>
        {%- endif -%}

        <div class="ww-pdp__thumbs" aria-label="Product media thumbnails">
          {%- for media in product.media limit: 7 -%}
            {%- if media.preview_image != blank -%}
              <button type="button" class="ww-pdp__thumb {% if media.id == featured_media.id %}is-active{% endif %}" data-ww-pdp-thumb data-src="{{ settings.speedsize_url_pfx_https -}}{{ media.preview_image | img_url: '1800x' }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show image {{ forloop.index }}">
                <img loading="lazy" sizes="78px" {% render 'image-attributes', image: media.preview_image, sizes: '90,140,180' %}>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="ww-pdp__media-controls">
          <button type="button" class="ww-pdp__media-btn" data-ww-pdp-zoom aria-label="Zoom product image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 18a7.5 7.5 0 1 1 5.3-12.8 7.5 7.5 0 0 1-5.3 12.8Zm0-1.5a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm4.7-.2 4.2 4.2-1.1 1.1-4.2-4.2 1.1-1.1ZM9.8 7h1.5v2.8H14v1.5h-2.7V14H9.8v-2.7H7V9.8h2.8V7Z"/></svg>
          </button>
          <button type="button" class="ww-pdp__media-btn" data-ww-pdp-prev aria-label="Previous product image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.7 5.3 1.1 1.1L10.2 12l5.6 5.6-1.1 1.1L8 12l6.7-6.7Z"/></svg>
          </button>
          <button type="button" class="ww-pdp__media-btn" data-ww-pdp-next aria-label="Next product image">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.3 18.7-1.1-1.1 5.6-5.6-5.6-5.6 1.1-1.1L16 12l-6.7 6.7Z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="ww-pdp__summary">
      <nav class="ww-pdp__breadcrumb" aria-label="{{ 'general.breadcrumb.title' | t }}">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        <span>{{ product.title }}</span>
      </nav>

      {% comment %} <div class="ww-pdp__designed">Designed in-house by <strong>WILLIAM WOOD</strong></div> {% endcomment %}

      <div class="ww-pdp_designed_div">
      <p class="ww-pdp__label">{{ product_label }}</p>
      
{% if product.tags contains 'in-house' %}<div class="ww-pdp__designed">Designed in-house by <strong>WILLIAM WOOD</strong></div>{% endif %}
      </div>
      {%- assign product_type_lc = product.type | downcase -%}
      <h1 class="ww-pdp__title">{{ product_heading }}{%- if product_type_lc contains 'table' and detail_height != blank or product_type_lc contains 'table' and detail_width != blank or product_type_lc contains 'table' and detail_depth != blank %} <span class="ww-pdp__title-dims">{%- if detail_height != blank %}{{ detail_height }}{%- endif -%}{%- if detail_width != blank %} x {{ detail_width }}{%- endif -%}{%- if detail_depth != blank %} x {{ detail_depth }}{%- endif -%}</span>{%- endif -%}</h1>

      <div class="ww-pdp__price-row">
        <span class="ww-pdp__price-group {% if has_variant_discount %}is-discounted{% endif %}" data-ww-pdp-price-group>
          {%- if has_variant_discount -%}
            <span class="ww-pdp__price ww-pdp__price--compare" data-ww-pdp-compare-price>{{ current_variant.compare_at_price | money }}</span>
            <span class="ww-pdp__price ww-pdp__price--sale" data-ww-pdp-current-price>{{ current_variant.price | money }}</span>
          {%- else -%}
            <span class="ww-pdp__price" data-ww-pdp-current-price>{{ current_variant.price | money }}</span>
          {%- endif -%}
        </span>
        <span class="ww-pdp__pill ww-pdp__pill--stock{% unless current_variant.available %} ww-pdp__pill--sold-out{% endunless %}"><span></span>{% if current_variant.available %}In stock{% else %}Sold out{% endif %}</span>
        <span class="ww-pdp__pill">Free UK Delivery</span>
        <span class="ww-pdp__pill">Crafted in limited quantities</span>
      </div>

      <a class="ww-pdp__reviews" href="#judgeme_product_reviews">
        <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span>{{ review_count }} reviews</span>
      </a>

      {%- if product.description != blank -%}
        {%- assign desc_clean = product.description | strip_html | strip | split: 'Key Details' | first | strip | remove_first: 'Product Description' | strip -%}
        <div class="ww-pdp__excerpt">
          <h3 class="ww-pdp__excerpt-heading">Product Description</h3>
          <div class="ww-pdp__excerpt-text" data-ww-excerpt-text>
            {{ desc_clean }}
          </div>
          <button type="button" data-ww-read-more aria-expanded="false">Read more</button>
        </div>
      {%- endif -%}

      {%- if promo_code != blank -%}
        <div class="ww-pdp__promo">
          <strong>{{ promo_text }}</strong>
          <span>Apply code at checkout.</span>
          <button type="button" class="ww-pdp__code" data-ww-copy-code="{{ promo_code }}">
            <span>{{ promo_code | replace: 'TAKE15', 'TAKE 15' }}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7V5.5A2.5 2.5 0 0 1 10.5 3h7A2.5 2.5 0 0 1 20 5.5v7a2.5 2.5 0 0 1-2.5 2.5H16v1.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 4 16.5v-7A2.5 2.5 0 0 1 6.5 7H8Zm1.5 0h4A2.5 2.5 0 0 1 16 9.5v4h1.5a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1V7Zm-3 1.5a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-7a1 1 0 0 0-1-1h-7Z"/></svg>
          </button>
        </div>
      {%- endif -%}

      {%- form 'product', product, id: product_form_id, is: 'product-form', class: 'ww-pdp__form' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" disabled name="id" value="{{ current_variant.id }}">
        {%- else -%}
          <div class="ww-pdp__variant">
            <label for="{{ product_form_id }}-id">Choose option</label>
            <select id="{{ product_form_id }}-id" name="id">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare-at="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
        <div class="ww-pdp__buy-row">
          <div class="ww-pdp__quantity" data-ww-quantity>
            <button type="button" data-ww-quantity-minus aria-label="Decrease quantity">-</button>
            <input type="number" name="quantity" min="1" value="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" data-ww-quantity-plus aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="ww-pdp__add" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}Add to bag{%- else -%}Sold out{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <div class="ww-pdp__payments" data-ww-installments data-price-cents="{{ current_variant.price }}">
        <p>Pay in <span data-ww-paypal-count>3</span> interest-free payments of <span data-ww-paypal-amount>{{ payment_amount | money }}</span> with <strong class="ww-pdp__paypal">PayPal</strong> <a href="/pages/payment">Learn More</a></p>
        <p>
          Pay in
          <select class="ww-pdp__installment-select" data-ww-installment-select aria-label="Choose installment count">
            <option value="3" selected>3</option>
            <option value="4">4</option>
            <option value="6">6</option>
            <option value="9">9</option>
            <option value="12">12</option>
          </select>
          interest-free payments of <span data-ww-klarna-amount>{{ payment_amount | money }}</span> with <strong>Klarna.</strong> <a href="/pages/payment">Learn More</a>
        </p>
      </div>

      <div class="ww-pdp__ctl">
        {%- render 'ww-ctl-inline', full_titles: true -%}
      </div>
    </div>
  </div>

  <div class="ww-pdp-lightbox" data-ww-pdp-lightbox hidden>
    <button type="button" class="ww-pdp-lightbox__backdrop" data-ww-pdp-lightbox-close aria-label="Close image popup"></button>
    <div class="ww-pdp-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Product image preview">
      <button type="button" class="ww-pdp-lightbox__close" data-ww-pdp-lightbox-close aria-label="Close image popup">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.4 5.3 5.6 5.6 5.6-5.6 1.1 1.1-5.6 5.6 5.6 5.6-1.1 1.1-5.6-5.6-5.6 5.6-1.1-1.1 5.6-5.6-5.6-5.6 1.1-1.1Z"/></svg>
      </button>
      <button type="button" class="ww-pdp-lightbox__arrow ww-pdp-lightbox__arrow--prev" data-ww-pdp-lightbox-prev aria-label="Previous product image">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.7 5.3 1.1 1.1L10.2 12l5.6 5.6-1.1 1.1L8 12l6.7-6.7Z"/></svg>
      </button>
      <img class="ww-pdp-lightbox__image" data-ww-pdp-lightbox-image alt="">
      <button type="button" class="ww-pdp-lightbox__arrow ww-pdp-lightbox__arrow--next" data-ww-pdp-lightbox-next aria-label="Next product image">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.3 18.7-1.1-1.1 5.6-5.6-5.6-5.6 1.1-1.1L16 12l-6.7 6.7Z"/></svg>
      </button>
    </div>
  </div>

  <div class="ww-pdp__details" id="product-{{ product.id }}-details">
    <div class="ww-pdp__detail-image">
      {%- if detail_media.preview_image != blank -%}
        <img loading="lazy" sizes="(min-width: 1000px) 58vw, 100vw" {% render 'image-attributes', image: detail_media.preview_image, sizes: '800,1000,1200,1400,1600,1800,2200' %}>
      {%- endif -%}
    </div>

    <div class="ww-pdp__detail-copy">
      <h2>Key Details</h2>
      {%- if overall_size_clean != blank -%}
        <div class="ww-pdp__detail-item"><strong>Overall Size</strong><p>{{ overall_size_clean }}</p></div>
      {%- endif -%}
      {%- if detail_colour != blank -%}
        <div class="ww-pdp__detail-item"><strong>Colour</strong><p>{{ detail_colour }}</p></div>
      {%- endif -%}
      {%- if detail_material != blank -%}
        <div class="ww-pdp__detail-item"><strong>Material</strong><p>{{ detail_material }}</p></div>
      {%- endif -%}
      {%- if detail_weight != blank -%}
        <div class="ww-pdp__detail-item"><strong>Weight - {{ detail_weight }}</strong>{% if detail_material != blank %}<p>{{ detail_material }}</p>{% endif %}</div>
      {%- endif -%}
      {%- if detail_capacity != blank -%}
        <div class="ww-pdp__detail-item"><strong>Weight Capacity- {{ detail_capacity }}</strong>{% if detail_material != blank %}<p>{{ detail_material }}</p>{% endif %}</div>
      {%- endif -%}
      {%- if detail_outdoor != blank -%}
        <div class="ww-pdp__detail-item"><strong>Outdoor suitable</strong><p>{{ detail_outdoor }}</p></div>
      {%- endif -%}
      {%- if detail_assembly != blank -%}
        <div class="ww-pdp__detail-item"><strong>Assembly</strong><p>{{ detail_assembly }}</p></div>
      {%- endif -%}
      {%- if detail_care != blank -%}
        <div class="ww-pdp__detail-item"><strong>Product Care Information</strong><p>{{ detail_care }}</p></div>
      {%- endif -%}
      {%- if detail_assembly_time != blank -%}
        <div class="ww-pdp__detail-item"><strong>Assembly Time</strong><p>{{ detail_assembly_time }}</p>{% if detail_assembly_note != blank %}<em>{{ detail_assembly_note }}</em>{% endif %}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<div class="ww-pdp-sticky-atc" data-ww-pdp-sticky-atc hidden>
  <div class="ww-pdp-sticky-atc__inner">
    <p class="ww-pdp-sticky-atc__title">{{ product_heading }}</p>
    <span class="ww-pdp-sticky-atc__price {% if has_variant_discount %}is-discounted{% endif %}" data-ww-sticky-price>
      {%- if has_variant_discount -%}
        <span class="ww-pdp-sticky-atc__price-compare" data-ww-sticky-compare-price>{{ current_variant.compare_at_price | money }}</span>
        <span class="ww-pdp-sticky-atc__price-current" data-ww-sticky-current-price>{{ current_variant.price | money }}</span>
      {%- else -%}
        <span class="ww-pdp-sticky-atc__price-current" data-ww-sticky-current-price>{{ current_variant.price | money }}</span>
      {%- endif -%}
    </span>
    <div class="ww-pdp-sticky-atc__quantity" data-ww-sticky-quantity>
      <button type="button" data-ww-sticky-quantity-minus aria-label="Decrease quantity">-</button>
      <input type="number" min="1" value="1" inputmode="numeric" aria-label="Quantity">
      <button type="button" data-ww-sticky-quantity-plus aria-label="Increase quantity">+</button>
    </div>
    <button type="button" class="ww-pdp-sticky-atc__button" data-ww-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
      <span class="ww-pdp-sticky-atc__desktop-label">{%- if current_variant.available -%}Add to bag{%- else -%}Sold out{%- endif -%}</span>
      <span class="ww-pdp-sticky-atc__mobile-label {% if has_variant_discount %}is-discounted{% endif %}">
        {%- if current_variant.available -%}
          {%- if has_variant_discount -%}
            <span class="ww-pdp-sticky-atc__price-compare" data-ww-sticky-mobile-compare-price>{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="ww-pdp-sticky-atc__price-current" data-ww-sticky-mobile-current-price>{{ current_variant.price | money }}</span>
          <span>- Add to bag</span>
        {%- else -%}
          Sold out
        {%- endif -%}
      </span>
    </button>
  </div>
</div>

<style>
