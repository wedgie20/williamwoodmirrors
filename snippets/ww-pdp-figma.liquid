<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-ww-pdp]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    var gallery = root.querySelector('[data-ww-pdp-gallery]');
    var mainImage = root.querySelector('[data-ww-pdp-main-image]');
    var thumbs = gallery ? Array.prototype.slice.call(gallery.querySelectorAll('[data-ww-pdp-thumb]')) : [];
    var currentIndex = thumbs.findIndex(function (thumb) { return thumb.classList.contains('is-active'); });
    if (currentIndex < 0) currentIndex = 0;

    function showImage(index) {
      if (!mainImage || !thumbs.length) return;
      currentIndex = (index + thumbs.length) % thumbs.length;
      var thumb = thumbs[currentIndex];
      mainImage.src = thumb.dataset.src;
      mainImage.removeAttribute('srcset');
      mainImage.alt = thumb.dataset.alt || '';
      thumbs.forEach(function (item) { item.classList.remove('is-active'); });
      thumb.classList.add('is-active');
    }

    thumbs.forEach(function (thumb, index) {
      thumb.addEventListener('click', function () { showImage(index); });
    });

    var prev = root.querySelector('[data-ww-pdp-prev]');
    var next = root.querySelector('[data-ww-pdp-next]');
    var zoom = root.querySelector('[data-ww-pdp-zoom]');
    if (prev) prev.addEventListener('click', function () { showImage(currentIndex - 1); });
    if (next) next.addEventListener('click', function () { showImage(currentIndex + 1); });
    if (zoom) {
      zoom.addEventListener('click', function () {
        if (mainImage && mainImage.src) window.open(mainImage.src, '_blank', 'noopener');
      });
    }

    root.querySelectorAll('[data-ww-quantity]').forEach(function (quantity) {
      var input = quantity.querySelector('input');
      var minus = quantity.querySelector('[data-ww-quantity-minus]');
      var plus = quantity.querySelector('[data-ww-quantity-plus]');
      if (!input) return;
      if (minus) {
        minus.addEventListener('click', function () {
          input.value = Math.max(1, parseInt(input.value || '1', 10) - 1);
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
      if (plus) {
        plus.addEventListener('click', function () {
          input.value = Math.max(1, parseInt(input.value || '1', 10) + 1);
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
      }
    });

    root.querySelectorAll('[data-ww-copy-code]').forEach(function (button) {
      button.addEventListener('click', function () {
        var code = button.dataset.wwCopyCode;
        if (!code) return;
        var done = function () {
          var label = button.querySelector('span');
          if (!label) return;
          var original = label.textContent;
          label.textContent = 'Copied';
          setTimeout(function () { label.textContent = original; }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(code).then(done).catch(done);
        } else {
          done();
        }
      });
    });

    function formatInstallmentMoney(cents) {
      var rounded = Math.round(cents);
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(rounded, {{ shop.money_format | json }});
      }

      var amount = rounded / 100;
      return new Intl.NumberFormat('en-GB', {
        style: 'currency',
        currency: (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'GBP',
        minimumFractionDigits: amount % 1 === 0 ? 0 : 2,
        maximumFractionDigits: 2
      }).format(amount);
    }

    root.querySelectorAll('[data-ww-installments]').forEach(function (box) {
      var priceCents = parseInt(box.dataset.priceCents || '0', 10);
      var select = box.querySelector('[data-ww-installment-select]');
      var paypalCount = box.querySelector('[data-ww-paypal-count]');
      var paypalAmount = box.querySelector('[data-ww-paypal-amount]');
      var klarnaAmount = box.querySelector('[data-ww-klarna-amount]');
      if (!priceCents || !select) return;

      function updateInstallments() {
        var count = parseInt(select.value || '3', 10);
        var amount = formatInstallmentMoney(priceCents / count);
        if (paypalCount) paypalCount.textContent = count;
        if (paypalAmount) paypalAmount.textContent = amount;
        if (klarnaAmount) klarnaAmount.textContent = amount;
      }

      select.addEventListener('change', updateInstallments);
      updateInstallments();
    });

    function hideLoosePaymentLines() {
      root.querySelectorAll('product-payment-terms, .shopify-payment-terms, .shopify-installments, [data-shopify-payment-terms], [data-pp-message], .paypal-messages, .ww-pdp__summary > p, .ww-pdp__summary > div:not([class^="ww-pdp__"])').forEach(function (node) {
        if (node.closest('.ww-pdp__payments')) return;
        var text = (node.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
        if (node.matches('product-payment-terms, .shopify-payment-terms, .shopify-installments, [data-shopify-payment-terms], [data-pp-message], .paypal-messages') || (text.indexOf('pay in') !== -1 && text.indexOf('paypal') !== -1 && text.indexOf('interest-free') !== -1)) {
          node.style.setProperty('display', 'none', 'important');
        }
      });
    }

    function alignPostcodeWidget() {
      var summary = root.querySelector('.ww-pdp__summary');
      if (!summary) return;

      summary.querySelectorAll('input').forEach(function (input) {
        var marker = ((input.getAttribute('placeholder') || '') + ' ' + (input.getAttribute('aria-label') || '') + ' ' + (input.name || '') + ' ' + (input.id || '')).toLowerCase();
        if (marker.indexOf('postcode') === -1 && marker.indexOf('post code') === -1 && marker.indexOf('zip') === -1) return;

        var target = input.closest('form') || input.parentElement;
        var walker = target;
        for (var i = 0; i < 6 && walker && walker !== summary; i += 1) {
          if ((walker.textContent || '').toLowerCase().indexOf('postcode') !== -1) {
            target = walker;
          }
          walker = walker.parentElement;
        }

        if (target && target !== summary) {
          target.classList.add('ww-pdp__postcode-widget');
        }
      });
    }

    hideLoosePaymentLines();
    alignPostcodeWidget();
    new MutationObserver(function () {
      hideLoosePaymentLines();
      alignPostcodeWidget();
    }).observe(root, { childList: true, subtree: true });

    function normalizeJudgeMeReviews() {
      var widget = document.querySelector('#judgeme_product_reviews, .jdgm-widget.jdgm-review-widget');
      if (!widget) return;

      var title = widget.querySelector('.jdgm-rev-widg__title');
      if (title && title.textContent.trim() !== 'Community Feedback') {
        title.textContent = 'Community Feedback';
      }
    }

    normalizeJudgeMeReviews();
    if (document.body) {
      new MutationObserver(normalizeJudgeMeReviews).observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
