{%- assign ctl_products = product.metafields.custom.related_products.value -%}
{%- if ctl_products != blank -%}

{%- assign ctl_uid = product.id -%}

<div class="ctl-box ctl-box--inline" id="ctl-{{ ctl_uid }}">

  <div class="ctl-header">
    <h2 class="ctl-heading">COMPLETE THE LOOK</h2>
    <div class="ctl-arrows" id="ctl-arrows-{{ ctl_uid }}" hidden>
      <button type="button" class="ctl-arrow ctl-arrow--prev" id="ctl-prev-{{ ctl_uid }}" aria-label="Previous" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="ctl-arrow ctl-arrow--next" id="ctl-next-{{ ctl_uid }}" aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="ctl-track" id="ctl-track-{{ ctl_uid }}">
    {%- for rp in ctl_products -%}
      <div class="ctl-card">
        <a href="{{ rp.url }}" class="ctl-card__img-wrap">
          {%- if rp.featured_image -%}
            {{ rp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ctl-card__img', alt: rp.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ctl-card__img ctl-card__img--placeholder' }}
          {%- endif -%}
        </a>
        <div class="ctl-card__body">
          <a href="{{ rp.url }}" class="ctl-card__title">{{ rp.title }}</a>
          <span class="ctl-card__price">{{ rp.price | money }}</span>
          <div class="ctl-card__footer">
            {%- if rp.available and rp.has_only_default_variant -%}
              <button type="button" class="ctl-card__atc" data-variant-id="{{ rp.selected_or_first_available_variant.id }}" aria-label="Add to cart">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- else -%}
              <a href="{{ rp.url }}" class="ctl-card__atc" aria-label="View product">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<style>
  .ctl-box--inline {
    border: 1px solid #dddddd;
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
    margin-top: 20px;
  }

  .ctl-box--inline .ctl-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px 0;
  }

  .ctl-box--inline .ctl-heading {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
  }

  .ctl-box--inline .ctl-arrows {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ctl-box--inline .ctl-arrow {
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0.7;
    transition: opacity .2s ease;
  }

  .ctl-box--inline .ctl-arrow:hover:not([disabled]) {
    opacity: 1;
  }

  .ctl-box--inline .ctl-arrow[disabled] {
    opacity: .25;
    cursor: default;
  }

  .ctl-box--inline .ctl-track {
    display: flex;
    align-items: flex-start;
    gap: 46px;
    padding: 28px 24px 28px;
    overflow: hidden;
  }

  .ctl-box--inline .ctl-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 260px;
    flex: 0 0 auto;
  }

  .ctl-box--inline .ctl-card__img-wrap {
    width: 98px;
    height: 98px;
    overflow: hidden;
    display: block;
    background: #f5f5f5;
    flex-shrink: 0;
  }

  .ctl-box--inline .ctl-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .45s ease;
  }

  .ctl-box--inline .ctl-card__img-wrap:hover .ctl-card__img {
    transform: scale(1.04);
  }

  .ctl-box--inline .ctl-card__body {
    display: flex;
    flex-direction: column;
    min-height: 98px;
    min-width: 0;
  }

  .ctl-box--inline .ctl-card__title {
    font-size: 15px;
    line-height: 1.45;
    color: #111 !important;
    text-decoration: none !important;
    margin-bottom: 5px;
  }

  .ctl-box--inline .ctl-card__title:hover {
    text-decoration: underline !important;
  }

  .ctl-box--inline .ctl-card__price {
    font-size: 13px;
    color: #111;
  }

  .ctl-box--inline .ctl-card__footer {
    margin-top: auto;
    padding-top: 14px;
  }

  .ctl-box--inline .ctl-card__atc {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s ease;
  }

  .ctl-box--inline .ctl-card__atc:hover {
    background: #333;
  }

  .ctl-box--inline .ctl-card__atc.is-loading {
    opacity: .5;
    cursor: wait;
  }

  .ctl-box--inline .ctl-card__atc.is-added {
    background: #2e9e7b;
  }

  @media screen and (max-width: 740px) {
    .ctl-box--inline .ctl-track {
      overflow-x: auto;
      gap: 22px;
      padding: 22px 16px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .ctl-box--inline .ctl-track::-webkit-scrollbar {
      display: none;
    }

    .ctl-box--inline .ctl-card {
      min-width: 220px;
      scroll-snap-align: start;
    }

    .ctl-box--inline .ctl-card__img-wrap {
      width: 82px;
      height: 82px;
    }

    .ctl-box--inline .ctl-card__body {
      min-height: 82px;
    }

    .ctl-box--inline .ctl-card__title {
      font-size: 14px;
    }
  }
</style>

<script>
(function () {

  function initSlider(box) {
    if (!box || box.dataset.sliderInit === '1') return;
    box.dataset.sliderInit = '1';

    var track = box.querySelector('.ctl-track');
    var prevBtn = box.querySelector('.ctl-arrow--prev');
    var nextBtn = box.querySelector('.ctl-arrow--next');
    var arrows = box.querySelector('.ctl-arrows');

    if (!track) return;

    var cards = Array.from(track.querySelectorAll('.ctl-card'));
    var currentPage = 0;
    var perPage = window.innerWidth <= 740 ? 1 : 4;
    var totalPages = Math.ceil(cards.length / perPage);

    if (totalPages <= 1) {
      if (arrows) arrows.hidden = true;
      return;
    }

    if (arrows) arrows.hidden = false;

    function updateSlider() {
      perPage = window.innerWidth <= 740 ? 1 : 4;
      totalPages = Math.ceil(cards.length / perPage);

      var card = cards[0];
      if (!card) return;

      var gap = window.innerWidth <= 740 ? 22 : 46;
      var moveX = (card.offsetWidth + gap) * perPage * currentPage;

      track.style.transform = 'translateX(-' + moveX + 'px)';
      track.style.transition = 'transform 0.35s ease';

      if (prevBtn) prevBtn.disabled = currentPage === 0;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        if (currentPage < totalPages - 1) {
          currentPage++;
          updateSlider();
        }
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        if (currentPage > 0) {
          currentPage--;
          updateSlider();
        }
      });
    }

    window.addEventListener('resize', function () {
      currentPage = 0;
      updateSlider();
    });

    updateSlider();
  }

  function initAllSliders() {
    document.querySelectorAll('.ctl-box--inline').forEach(initSlider);
  }

  document.addEventListener('DOMContentLoaded', initAllSliders);
  document.addEventListener('shopify:section:load', initAllSliders);
  document.addEventListener('shopify:section:select', initAllSliders);

  document.addEventListener('click', function (e) {
    var atc = e.target.closest('.ctl-box--inline .ctl-card__atc[data-variant-id]');

    if (atc && !atc.classList.contains('is-loading')) {
      e.preventDefault();

      atc.classList.add('is-loading');

      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          id: atc.dataset.variantId,
          quantity: 1
        })
      })
      .then(function (r) {
        return r.json();
      })
      .then(function () {

        atc.classList.remove('is-loading');
        atc.classList.add('is-added');

        fetch('/cart.js')
          .then(function (r) {
            return r.json();
          })
          .then(function (cart) {

            document.documentElement.dispatchEvent(
              new CustomEvent('cart:refresh', {
                bubbles: true,
                detail: {
                  cart: cart,
                  openMiniCart: true
                }
              })
            );

          });

        setTimeout(function () {
          atc.classList.remove('is-added');
        }, 2000);

      })
      .catch(function () {
        atc.classList.remove('is-loading');
      });
    }
  });

})();
</script>

{%- endif -%}
