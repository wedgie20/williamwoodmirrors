{%- assign ctl_products = product.metafields.custom.related_products.value -%}
{%- if ctl_products != blank -%}

{%- assign ctl_uid = product.id -%}

<div class="ctl-box ctl-box--inline" id="ctl-{{ ctl_uid }}">

  <div class="ctl-header">
    <h2 class="ctl-heading">COMPLETE THE LOOK</h2>
    <div class="ctl-arrows" id="ctl-arrows-{{ ctl_uid }}" hidden>
      <button type="button" class="ctl-arrow ctl-arrow--prev" id="ctl-prev-{{ ctl_uid }}" aria-label="Previous" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="ctl-arrow ctl-arrow--next" id="ctl-next-{{ ctl_uid }}" aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="ctl-track" id="ctl-track-{{ ctl_uid }}">
    {%- for rp in ctl_products -%}
      <div class="ctl-card">
        <a href="{{ rp.url }}" class="ctl-card__img-wrap">
          {%- if rp.featured_image -%}
            {{ rp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ctl-card__img', alt: rp.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ctl-card__img ctl-card__img--placeholder' }}
          {%- endif -%}
        </a>
        <div class="ctl-card__body">
          <a href="{{ rp.url }}" class="ctl-card__title">{{ rp.title|truncate: 20 }}</a>
          <span class="ctl-card__price">{{ rp.price | money }}</span>
          <div class="ctl-card__footer">
            {%- if rp.available and rp.has_only_default_variant -%}
              <button type="button" class="ctl-card__atc" data-variant-id="{{ rp.selected_or_first_available_variant.id }}" aria-label="Add to cart">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- else -%}
              <a href="{{ rp.url }}" class="ctl-card__atc" aria-label="View product">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<style>
  .ctl-box--inline {
    border: 1px solid #dddddd;
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
    margin-top: 20px;
  }

  .ctl-box--inline .ctl-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 24px 0;
  }

  .ctl-box--inline .ctl-heading {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
  }

  .ctl-box--inline .ctl-arrows {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ctl-box--inline .ctl-arrow {
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0.7;
    transition: opacity .2s ease;
  }

  .ctl-box--inline .ctl-arrow:hover:not([disabled]) {
    opacity: 1;
  }

  .ctl-box--inline .ctl-arrow[disabled] {
    opacity: .25;
    cursor: default;
  }

  .ctl-box--inline .ctl-track {
    display: flex;
    align-items: flex-start;
    gap: 46px;
    padding: 28px 24px 28px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ctl-box--inline .ctl-track::-webkit-scrollbar {
    display: none;
  }

  .ctl-box--inline .ctl-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 260px;
    flex: 0 0 auto;
  }

  .ctl-box--inline .ctl-card__img-wrap {
    width: 98px;
    height: 98px;
    overflow: hidden;
    display: block;
    background: #f5f5f5;
    flex-shrink: 0;
  }

  .ctl-box--inline .ctl-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .45s ease;
  }

  .ctl-box--inline .ctl-card__img-wrap:hover .ctl-card__img {
    transform: scale(1.04);
  }

  .ctl-box--inline .ctl-card__body {
    display: flex;
    flex-direction: column;
    min-height: 98px;
    min-width: 0;
  }

  .ctl-box--inline .ctl-card__title {
    font-size: 15px;
    line-height: 1.45;
    color: #111 !important;
    text-decoration: none !important;
    margin-bottom: 5px;
  }

  .ctl-box--inline .ctl-card__title:hover {
    text-decoration: underline !important;
  }

  .ctl-box--inline .ctl-card__price {
    font-size: 13px;
    color: #111;
  }

  .ctl-box--inline .ctl-card__footer {
    margin-top: auto;
    padding-top: 14px;
  }

  .ctl-box--inline .ctl-card__atc {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s ease;
  }

  .ctl-box--inline .ctl-card__atc:hover {
    background: #333;
  }

  .ctl-box--inline .ctl-card__atc.is-loading {
    opacity: .5;
    cursor: wait;
  }

  .ctl-box--inline .ctl-card__atc.is-added {
    background: #2e9e7b;
  }

  @media screen and (max-width: 740px) {
    .ctl-box--inline .ctl-track {
      overflow-x: auto;
      gap: 22px;
      padding: 22px 16px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .ctl-box--inline .ctl-track::-webkit-scrollbar {
      display: none;
    }

    .ctl-box--inline .ctl-card {
      min-width: 220px;
      scroll-snap-align: start;
    }

    .ctl-box--inline .ctl-card__img-wrap {
      width: 82px;
      height: 82px;
    }

    .ctl-box--inline .ctl-card__body {
      min-height: 82px;
    }

    .ctl-box--inline .ctl-card__title {
      font-size: 14px;
    }
  }
</style>

<script>
(function () {
  if (window.ctlInlineInit) return;
  window.ctlInlineInit = true;

  function getCardStep(track) {
    var card = track.querySelector('.ctl-card');
    if (!card) return 0;
    var styles = window.getComputedStyle(track);
    var gap = parseInt(styles.columnGap || styles.gap || 0, 10) || 0;
    return card.offsetWidth + gap;
  }

  function updateButtons(box) {
    if (!box) return;
    var track = box.querySelector('.ctl-track');
    var prevBtn = box.querySelector('.ctl-arrow--prev');
    var nextBtn = box.querySelector('.ctl-arrow--next');
    var arrowsEl = box.querySelector('.ctl-arrows');
    if (!track) return;

    var maxScroll = track.scrollWidth - track.clientWidth;

    if (arrowsEl) arrowsEl.hidden = maxScroll <= 5;

    if (prevBtn) prevBtn.disabled = track.scrollLeft <= 5;
    if (nextBtn) nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
  }

  function initTrack(track) {
    if (!track || track.dataset.ctlInit === '1') return;
    track.dataset.ctlInit = '1';
    var box = track.closest('.ctl-box');
    track.addEventListener('scroll', function () { updateButtons(box); });
    updateButtons(box);
  }

  function initAll() {
    document.querySelectorAll('.ctl-box--inline .ctl-track').forEach(initTrack);
  }

  document.addEventListener('click', function (e) {
    var arrow = e.target.closest('.ctl-box--inline .ctl-arrow');
    if (arrow && !arrow.disabled) {
      var box = arrow.closest('.ctl-box');
      if (!box) return;
      var track = box.querySelector('.ctl-track');
      if (!track) return;
      initTrack(track);
      var step = getCardStep(track) * 2;
      if (step <= 0) step = track.clientWidth;
      var dir = arrow.classList.contains('ctl-arrow--next') ? 1 : -1;
      track.scrollTo({
        left: track.scrollLeft + step * dir,
        behavior: 'smooth'
      });
      setTimeout(function () { updateButtons(box); }, 500);
      return;
    }

    var atc = e.target.closest('.ctl-box--inline .ctl-card__atc[data-variant-id]');
    if (atc && !atc.classList.contains('is-loading')) {
      e.preventDefault();
      atc.classList.add('is-loading');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ id: atc.dataset.variantId, quantity: 1 })
      })
      .then(function (r) { return r.json(); })
      .then(function () {
        atc.classList.remove('is-loading');
        atc.classList.add('is-added');
        fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart, openMiniCart: true } }));
        });
        setTimeout(function () { atc.classList.remove('is-added'); }, 2000);
      })
      .catch(function () { atc.classList.remove('is-loading'); });
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('shopify:section:load', initAll);
  document.addEventListener('shopify:section:select', initAll);
})();
</script>

{%- endif -%}
