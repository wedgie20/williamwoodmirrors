{%- assign ctl_products = product.metafields.custom.related_products.value -%}
{%- if ctl_products != blank -%}

{%- assign ctl_uid = product.id -%}

<div class="ctl-box ctl-box--inline" id="ctl-{{ ctl_uid }}">

  <div class="ctl-header">
    <h2 class="ctl-heading">COMPLETE THE LOOK</h2>
    <div class="ctl-arrows" id="ctl-arrows-{{ ctl_uid }}" hidden>
      <button class="ctl-arrow ctl-arrow--prev" id="ctl-prev-{{ ctl_uid }}" aria-label="Previous" disabled>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="ctl-arrow ctl-arrow--next" id="ctl-next-{{ ctl_uid }}" aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="ctl-track" id="ctl-track-{{ ctl_uid }}">
    {%- for rp in ctl_products -%}
      <div class="ctl-card">
        <a href="{{ rp.url }}" class="ctl-card__img-wrap">
          {%- if rp.featured_image -%}
            {{ rp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'ctl-card__img', alt: rp.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ctl-card__img ctl-card__img--placeholder' }}
          {%- endif -%}
        </a>
        <div class="ctl-card__body">
          <a href="{{ rp.url }}" class="ctl-card__title">{{ rp.title }}</a>
          <span class="ctl-card__price">{{ rp.price | money }}</span>
          <div class="ctl-card__footer">
            {%- if rp.available and rp.has_only_default_variant -%}
              <button class="ctl-card__atc" data-variant-id="{{ rp.selected_or_first_available_variant.id }}" aria-label="Add to cart">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- else -%}
              <a href="{{ rp.url }}" class="ctl-card__atc" aria-label="View product">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<style>
  .ctl-box--inline {
    margin-top: 20px;
  }
</style>

<script>
(function () {
  var PER_PAGE = 4;
  var track = document.getElementById('ctl-track-{{ ctl_uid }}');
  if (!track) return;

  var cards = Array.from(track.querySelectorAll('.ctl-card'));
  if (!cards.length) return;

  var totalPages = Math.ceil(cards.length / PER_PAGE);
  var current = 0;
  var arrowsEl = document.getElementById('ctl-arrows-{{ ctl_uid }}');
  var prevBtn  = document.getElementById('ctl-prev-{{ ctl_uid }}');
  var nextBtn  = document.getElementById('ctl-next-{{ ctl_uid }}');

  function showPage(page) {
    cards.forEach(function (card, index) {
      card.style.display = (index >= page * PER_PAGE && index < (page + 1) * PER_PAGE) ? 'flex' : 'none';
    });
    current = page;
    if (prevBtn) prevBtn.disabled = current === 0;
    if (nextBtn) nextBtn.disabled = current >= totalPages - 1;
  }

  if (arrowsEl && totalPages > 1) arrowsEl.hidden = false;
  showPage(0);

  if (prevBtn) prevBtn.addEventListener('click', function () { if (current > 0) showPage(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { if (current < totalPages - 1) showPage(current + 1); });

  track.addEventListener('click', function (e) {
    var btn = e.target.closest('.ctl-card__atc[data-variant-id]');
    if (!btn || btn.classList.contains('is-loading')) return;
    btn.classList.add('is-loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: btn.dataset.variantId, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.classList.remove('is-loading');
      btn.classList.add('is-added');
      fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
        document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart, openMiniCart: true } }));
      });
      setTimeout(function () { btn.classList.remove('is-added'); }, 2000);
    })
    .catch(function () { btn.classList.remove('is-loading'); });
  });
})();
</script>

{%- endif -%}
