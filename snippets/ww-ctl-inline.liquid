{%- assign ctl_i_products = product.metafields.custom.related_products.value -%}
{%- if ctl_i_products != blank -%}

<div class="ctl-i-wrap" id="ctl-i-{{ section.id }}">

  <div class="ctl-i-header">
    <h2 class="ctl-i-heading">COMPLETE THE LOOK</h2>
    <div class="ctl-i-arrows" id="ctl-i-arrows-{{ section.id }}" hidden>
      <button class="ctl-i-arrow ctl-i-arrow--prev" id="ctl-i-prev-{{ section.id }}" aria-label="Previous" disabled>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="ctl-i-arrow ctl-i-arrow--next" id="ctl-i-next-{{ section.id }}" aria-label="Next">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <div class="ctl-i-track" id="ctl-i-track-{{ section.id }}">
    {%- for rp in ctl_i_products -%}
      <div class="ctl-i-card">
        <a href="{{ rp.url }}" class="ctl-i-card__img-wrap" tabindex="-1">
          {%- if rp.featured_image -%}
            {{ rp.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'ctl-i-card__img', alt: rp.featured_image.alt, widths: '100,150,200' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ctl-i-card__img ctl-i-card__img--placeholder' }}
          {%- endif -%}
        </a>
        <div class="ctl-i-card__body">
          <a href="{{ rp.url }}" class="ctl-i-card__title">{{ rp.title }}</a>
          <span class="ctl-i-card__price">{{ rp.price | money }}</span>
          <div class="ctl-i-card__footer">
            {%- if rp.available and rp.has_only_default_variant -%}
              <button class="ctl-i-card__atc" data-variant-id="{{ rp.selected_or_first_available_variant.id }}" aria-label="Add to cart">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                </svg>
              </button>
            {%- else -%}
              <a href="{{ rp.url }}" class="ctl-i-card__atc" aria-label="View product">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

</div>

<style>
  .ctl-i-wrap {
    border: 1px solid #d8d8d8;
    overflow: hidden;
    margin-top: 24px;
  }
  .ctl-i-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid #d8d8d8;
  }
  .ctl-i-heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
    margin: 0;
  }
  .ctl-i-arrows { display: flex; gap: 4px; }
  .ctl-i-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #111;
    padding: 0;
    transition: opacity 0.2s;
  }
  .ctl-i-arrow[disabled] { opacity: 0.3; cursor: default; }
  .ctl-i-arrow:hover:not([disabled]) { opacity: 0.6; }

  .ctl-i-track {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: #d8d8d8;
  }

  .ctl-i-card {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px 20px;
    background: #fff;
  }
  .ctl-i-card__img-wrap {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    overflow: hidden;
    display: block;
    background: #f5f5f5;
  }
  .ctl-i-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ctl-i-card__img-wrap:hover .ctl-i-card__img { transform: scale(1.05); }
  .ctl-i-card__img--placeholder { width: 100%; height: 100%; }

  .ctl-i-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 76px;
  }
  .ctl-i-card__title {
    font-size: 12px;
    font-weight: 400;
    color: #111;
    text-decoration: none;
    line-height: 1.4;
    display: block;
    margin-bottom: 3px;
  }
  .ctl-i-card__title:hover { text-decoration: underline; }
  .ctl-i-card__price {
    font-size: 12px;
    color: #111;
    display: block;
  }
  .ctl-i-card__footer {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    justify-content: flex-end;
  }
  .ctl-i-card__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease;
    flex-shrink: 0;
  }
  .ctl-i-card__atc:hover { background: #444; }
  .ctl-i-card__atc.is-loading { opacity: 0.6; cursor: not-allowed; }
  .ctl-i-card__atc.is-added { background: #2e9e7b; }

  @media screen and (max-width: 740px) {
    .ctl-i-track { grid-template-columns: 1fr; }
    .ctl-i-card__img-wrap { width: 68px; height: 68px; }
  }
</style>

<script>
(function () {
  var PER_PAGE = 4;
  var track    = document.getElementById('ctl-i-track-{{ section.id }}');
  if (!track) return;

  var cards      = Array.from(track.querySelectorAll('.ctl-i-card'));
  if (!cards.length) return;

  var totalPages = Math.ceil(cards.length / PER_PAGE);
  var current    = 0;

  var arrowsEl = document.getElementById('ctl-i-arrows-{{ section.id }}');
  var prevBtn  = document.getElementById('ctl-i-prev-{{ section.id }}');
  var nextBtn  = document.getElementById('ctl-i-next-{{ section.id }}');

  function showPage(page) {
    cards.forEach(function (card, idx) {
      card.style.display = (idx >= page * PER_PAGE && idx < (page + 1) * PER_PAGE) ? '' : 'none';
    });
    current = page;
    if (prevBtn) prevBtn.disabled = (page === 0);
    if (nextBtn) nextBtn.disabled = (page >= totalPages - 1);
  }

  if (arrowsEl && totalPages > 1) arrowsEl.hidden = false;
  showPage(0);

  if (prevBtn) prevBtn.addEventListener('click', function () { if (current > 0) showPage(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { if (current < totalPages - 1) showPage(current + 1); });

  track.addEventListener('click', function (e) {
    var btn = e.target.closest('.ctl-i-card__atc[data-variant-id]');
    if (!btn || btn.classList.contains('is-loading')) return;

    btn.classList.add('is-loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: btn.dataset.variantId, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.classList.remove('is-loading');
      btn.classList.add('is-added');
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart, openMiniCart: true } }));
        });
      setTimeout(function () { btn.classList.remove('is-added'); }, 2000);
    })
    .catch(function () { btn.classList.remove('is-loading'); });
  });
})();
</script>

{%- endif -%}
