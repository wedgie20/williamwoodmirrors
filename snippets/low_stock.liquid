{% if product.available %}
{% if product.compare_at_price_max <= product.price_max %}
    <span style="margin-top: 5px; margin-bottom: 5px; margin-left: 5px;">
      <b>Exclusive Black Friday Weekend price</b> - offer ends midnight Sunday
    </span>
{% endif %}
{% if product.tags contains '__label:RESTOCKED' %}
<div style="margin-left: 5px;">
<b>{{ block.settings.restocked_text | default: "Recently restocked, don't miss out." }}</b>
</div>
{% endif %}
{%- assign threshold = block.settings.low_stock_threshold | default: 16 -%}
{% if product.variants[0].inventory_quantity < threshold %}
<span style="margin-left: 4px;"><span class="urgency-indicator"></span> {{ block.settings.low_stock_text | default: "Low stock, only" }} <b>{{ product.variants[0].inventory_quantity }} {{ block.settings.low_stock_suffix | default: "left" }}</b></span>
{% else %}
<div style="margin-left: 5px;">
  <b>{{ block.settings.limited_availability_bold | default: "Availability is limited" }} </b>{{ block.settings.limited_availability_normal | default: " - secure yours before it's gone" }}
</div>
{% endif %}
{% endif %}



{% if product.tags contains '__label:LAST CHANCE' %}
<div style="margin-top: 10px; margin-bottom: 10px; margin-left: 5px;">{{ block.settings.last_chance_text | default: "Last chance to purchase, this product won't be restocked." }}</div>
{% endif %}

{% if product.tags contains '__label:LIMITED OFFER' %}
<div style="margin-top: 10px; margin-bottom: 10px; margin-left: 5px;"><span style="font-weight: bold;">{{ block.settings.limited_offer_prefix | default: "Exclusive offer" }}</span>{{ block.settings.limited_offer_suffix | default: ", returning to full price soon." }}</div>
{% endif %}

<div style="margin-top: 0px; margin-bottom: 15px; display: flex; flex-direction: column;">
{% if product.variants[0].inventory_quantity > 0 %}
{% for tag in product.tags %}
{% if tag == 'pre-order' %}
<div class="instock-pulse">
<span class="icon--pulsing"></span>
<span>{{ block.settings.preorder_delivery_text | default: "Free UK Delivery: Available for pre order" }}</span>
</div>
{% endif %}
{% endfor %}
{% unless product.tags contains 'pre-order' %}
{% unless product.tags contains 'PF' %}
<div class="instock-pulse">
<span class="icon--pulsing"></span>
<span>{{ block.settings.instock_delivery_bold_text | default: "<b>Free</b> & <b>Fast</b> UK Delivery: <b>In stock</b> & ready to ship" }}</span>
</div>
{% else %}

<div class="instock-pulse">
<span class="icon--pulsing"></span>
<span>{{ block.settings.instock_delivery_regular_text | default: "<b>Free</b> & <b>Fast</b> UK Delivery: In stock & ready to ship" }}</span> 
</div>
{% endunless %}
{% endunless %}
{% endif %}
</div>

<style>
{% if product.available %}
.instock-pulse {
display: flex;
flex-wrap: nowrap;
align-items: center;
justify-content: center;
margin: 3px 0 0;
}
.icon--pulsing {
position: relative;
width: 20px;
height: 20px;
margin-right: 5px;
}
.icon--pulsing:after,
.icon--pulsing:before {
background: {{ block.settings.pulse_color | default: '#54c63a' }};
width: 10px;
height: 10px;
border-radius: 10px;
position: absolute;
left: 0;
top: 0;
content: "";
margin: 5px;
}
{% if block.settings.enable_animations != false %}
@keyframes inventory-pulse {
0% {
opacity: 0.5;
}
to {
transform: scale(2.5);
opacity: 0;
}
}
{% endif %}
{% endif %}
{% if block.settings.enable_animations != false %}
{% if product.variants[0].inventory_quantity >= 11 %}
.icon--pulsing:before {
animation: inventory-pulse 2.5s linear infinite;
}
{% elsif product.variants[0].inventory_quantity < 11 and product.variants[0].inventory_quantity > 1 %}
.icon--pulsing:before {
animation: inventory-pulse 1.5s linear infinite;
}
{% else %}
.icon--pulsing:before {
animation: inventory-pulse 1s linear infinite;
}
{% endif %}
{% endif %}

.urgency-indicator {
position: relative;
display: inline-block;
width: 10px;
height: 10px;
margin-right: 6px;
vertical-align: middle;
background-color: {{ block.settings.urgency_indicator_color | default: '#FFBF00' }};
border-radius: 20px;
margin-top: -1px;
}
{% if block.settings.enable_animations != false %}
.urgency-indicator::before {
animation: inventory-pulse 2s linear infinite;
width: 8px;
height: 8px;
}
{% endif %}
.urgency-indicator::before,
.urgency-indicator::after {
background: {{ block.settings.urgency_indicator_color | default: '#FFBF00' }};
border-radius: 9px;
position: absolute;
left: 1px;
top: 1px;
content: '';
}
</style>