{% if block.settings.image != blank %}
          <div 
            class="product-form__review-banner" 
            style="
              display: flex;
              justify-content: {{ block.settings.alignment }};
              margin-top: {{ block.settings.margin_top }}px;
              margin-bottom: {{ block.settings.margin_bottom }}px;
            "
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
            {%- endif -%}
            
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.alt_text | default: 'Review Banner' | escape }}"
              loading="lazy"
              style="
                width: 100%;
                max-width: {{ block.settings.max_width }}px;
                height: {% if block.settings.height == 0 %}auto{% else %}{{ block.settings.height }}px{% endif %};
                object-fit: contain;
              "
            >
            
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}