{% assign start = block.settings.start_time | date: "%s" %}
{% assign end = block.settings.end_time | date: "%s" %}
{% assign now = 'now' | date: "%s" %}

{% if now >= start and now < end %}
  <div class="countdown-banner">
    <p class="countdown-label">{{ block.settings.label }}</p>
    <div id="countdown-timer-{{ block.id }}" class="countdown-timer" data-end="{{ block.settings.end_time }}">
      <span class="hours">00</span> :
      <span class="minutes">00</span> :
      <span class="seconds">00</span>
    </div>
  </div>
{% endif %}

<style>
    .countdown-banner {
      background-color: #000000;
    border-radius: 10px;
  color: #ffffff;
  padding: 10px 10px;
  text-align: center;
  font-family: Arial, sans-serif;
  margin-bottom: 0px;
  margin-top: 5px;
      background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0)), url(https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/https://www.williamwoodmirrors.co.uk/cdn/shop/files/BF_Collection_Page_Mob_-_Texture.jpg?v=1762245088);
    background-size: cover;
    background-position: center;
}

.countdown-label {
font-size: 13px;
    text-transform: capitalize;
        font-family: var(--text-font-family);
    letter-spacing: 0.5px;
    margin-bottom: unset;
    font-weight: 700;
    color: white;
}

.countdown-timer {
 font-size: calc(var(--base-font-size) - 2px);
        font-family: var(--text-font-family);
    font-weight: var(--text-font-bold-weight);
    letter-spacing: 1px;
}

@media (max-width: 768px) {
.countdown-label {
    font-size: 12px;
}
.countdown-timer {
    font-size: 11px;
}

}
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.countdown-timer').forEach(function (timer) {
    const endTimeStr = timer.getAttribute('data-end');
    const endTime = new Date(endTimeStr.replace(' ', 'T'));

    function updateCountdown() {
      const now = new Date();
      const diff = endTime - now;

      if (diff <= 0) {
        timer.innerHTML = '00 : 00 : 00';
        return;
      }

      const hours = String(Math.floor(diff / (1000 * 60 * 60))).padStart(2, '0');
      const minutes = String(Math.floor((diff / (1000 * 60)) % 60)).padStart(2, '0');
      const seconds = String(Math.floor((diff / 1000) % 60)).padStart(2, '0');

      timer.querySelector('.hours').textContent = hours;
      timer.querySelector('.minutes').textContent = minutes;
      timer.querySelector('.seconds').textContent = seconds;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  });
});
</script>
