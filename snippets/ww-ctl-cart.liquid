{%- assign ctl_cart_seen_ids = '' -%}
{%- assign ctl_cart_products = '' | split: '' -%}
{%- assign cart_item_product_ids = cart.items | map: 'product_id' -%}

{%- for item in cart.items -%}
  {%- assign related = item.product.metafields.custom.related_products.value -%}
  {%- if related != blank -%}
    {%- for rp in related -%}
      {%- assign rp_id_str = rp.id | append: '' -%}
      {%- unless cart_item_product_ids contains rp.id -%}
        {%- unless ctl_cart_seen_ids contains rp_id_str -%}
          {%- assign ctl_cart_products = ctl_cart_products | push: rp -%}
          {%- assign ctl_cart_seen_ids = ctl_cart_seen_ids | append: rp_id_str | append: ',' -%}
        {%- endunless -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

{%- if ctl_cart_products.size > 0 -%}

<div class="ctl-cart-box">
  <div class="ctl-cart-header">
    <span class="ctl-cart-heading">COMPLETE THE LOOK</span>
    <div class="ctl-cart-arrows" id="ctl-cart-arrows" hidden>
      <button class="ctl-cart-arrow ctl-cart-arrow--prev" id="ctl-cart-prev" aria-label="Previous" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="ctl-cart-arrow ctl-cart-arrow--next" id="ctl-cart-next" aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="ctl-cart-list" id="ctl-cart-list">
    {%- for rp in ctl_cart_products -%}
      <div class="ctl-cart-card">
        <a href="{{ rp.url }}" class="ctl-cart-card__img-wrap">
          {%- if rp.featured_image -%}
            {{ rp.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'ctl-cart-card__img', alt: rp.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ctl-cart-card__img ctl-cart-card__img--placeholder' }}
          {%- endif -%}
        </a>
        <div class="ctl-cart-card__body">
          <a href="{{ rp.url }}" class="ctl-cart-card__title">{{ rp.title }}</a>
          <span class="ctl-cart-card__price">{{ rp.price | money }}</span>
          <div class="ctl-cart-card__footer">
            {%- if rp.available and rp.has_only_default_variant -%}
              <button
                class="ctl-cart-card__atc"
                data-variant-id="{{ rp.selected_or_first_available_variant.id }}"
                aria-label="Add to cart">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- else -%}
              <a href="{{ rp.url }}" class="ctl-cart-card__atc" aria-label="View product">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 12.0783 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .ctl-cart-box {
    border-top: 1px solid #e8e8e8;
    padding: 16px 20px 20px;
    background: #fff;
  }

  .ctl-cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .ctl-cart-heading {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111;
  }

  .ctl-cart-arrows {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .ctl-cart-arrow {
    width: 26px;
    height: 26px;
    border: none;
    background: transparent;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0.7;
    transition: opacity .2s ease;
  }

  .ctl-cart-arrow:hover:not([disabled]) { opacity: 1; }

  .ctl-cart-arrow[disabled] {
    opacity: .25;
    cursor: default;
  }

  .ctl-cart-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ctl-cart-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ctl-cart-card__img-wrap {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    overflow: hidden;
    display: block;
    background: #f5f5f5;
  }

  .ctl-cart-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .4s ease;
  }

  .ctl-cart-card__img-wrap:hover .ctl-cart-card__img { transform: scale(1.04); }

  .ctl-cart-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 72px;
  }

  .ctl-cart-card__title {
    font-size: 13px;
    line-height: 1.4;
    color: #111 !important;
    text-decoration: none !important;
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ctl-cart-card__title:hover { text-decoration: underline !important; }

  .ctl-cart-card__price {
    font-size: 12px;
    color: #111;
  }

  .ctl-cart-card__footer {
    margin-top: auto;
    padding-top: 8px;
  }

  .ctl-cart-card__atc {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    transition: background .2s ease;
  }

  .ctl-cart-card__atc:hover { background: #333; }

  .ctl-cart-card__atc.is-loading {
    opacity: .5;
    cursor: wait;
  }

  .ctl-cart-card__atc.is-added { background: #2e9e7b; }
</style>

<script>
(function () {
  var PER_PAGE = 3;
  var list = document.getElementById('ctl-cart-list');
  if (!list) return;

  var cards = Array.from(list.querySelectorAll('.ctl-cart-card'));
  if (!cards.length) return;

  var totalPages = Math.ceil(cards.length / PER_PAGE);
  var current = 0;
  var arrowsEl = document.getElementById('ctl-cart-arrows');
  var prevBtn = document.getElementById('ctl-cart-prev');
  var nextBtn = document.getElementById('ctl-cart-next');

  function showPage(page) {
    cards.forEach(function (card, i) {
      card.style.display = (i >= page * PER_PAGE && i < (page + 1) * PER_PAGE) ? 'flex' : 'none';
    });
    current = page;
    if (prevBtn) prevBtn.disabled = current === 0;
    if (nextBtn) nextBtn.disabled = current >= totalPages - 1;
  }

  if (arrowsEl && totalPages > 1) arrowsEl.hidden = false;
  showPage(0);

  if (prevBtn) prevBtn.addEventListener('click', function () { if (current > 0) showPage(current - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { if (current < totalPages - 1) showPage(current + 1); });

  list.addEventListener('click', function (e) {
    var btn = e.target.closest('.ctl-cart-card__atc[data-variant-id]');
    if (!btn || btn.classList.contains('is-loading')) return;

    btn.classList.add('is-loading');

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: btn.dataset.variantId, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function () {
      btn.classList.remove('is-loading');
      btn.classList.add('is-added');

      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.documentElement.dispatchEvent(
            new CustomEvent('cart:refresh', {
              bubbles: true,
              detail: { cart: cart, openMiniCart: true }
            })
          );
        });

      setTimeout(function () { btn.classList.remove('is-added'); }, 2000);
    })
    .catch(function () { btn.classList.remove('is-loading'); });
  });
})();
</script>

{%- endif -%}
