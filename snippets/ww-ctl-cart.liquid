{%- if cart.item_count > 0 -%}

{%- assign ctl_cart_ids = '' -%}
{%- for item in cart.items -%}
  {%- assign ctl_cart_ids = ctl_cart_ids | append: ',' | append: item.product_id -%}
{%- endfor -%}

{%- assign ctl_seen = '' -%}
{%- assign ctl_count = 0 -%}

{%- capture ctl_cards -%}

  {%- for item in cart.items -%}

    {%- assign related_products = item.product.metafields.custom.related_products.value -%}

    {%- if related_products != blank -%}

      {%- for product in related_products limit: 8 -%}

        {%- assign product_check = ',' | append: product.id | append: ',' -%}
        {%- assign cart_check = ',' | append: ctl_cart_ids | append: ',' -%}
        {%- assign seen_check = ',' | append: ctl_seen | append: ',' -%}

        {%- unless cart_check contains product_check or seen_check contains product_check -%}

          {%- assign ctl_seen = ctl_seen | append: ',' | append: product.id -%}
          {%- assign ctl_count = ctl_count | plus: 1 -%}

          <div class="ctl-look-card">

            <a href="{{ product.url }}" class="ctl-look-card__image">

              {%- if product.featured_image -%}

                {{
                  product.featured_image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    class: 'ctl-look-card__img',
                    alt: product.title | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx
                }}

              {%- endif -%}

            </a>

            <div class="ctl-look-card__content">

              <a href="{{ product.url }}" class="ctl-look-card__title">
                {{ product.title|truncate: 20 }}
              </a>

              <div class="ctl-look-card__rating">
                {%- render 'product-rating', product: product -%}
              </div>

              <div class="ctl-look-card__bottom">

                <span class="ctl-look-card__price">
                  {{ product.price | money }}
                </span>

                {%- if product.available and product.has_only_default_variant -%}

                  <button
                    type="button"
                    class="ctl-look-card__btn"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    aria-label="Add to cart"
                  >

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 13.5786 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  </button>

                {%- else -%}

                  <a
                    href="{{ product.url }}"
                    class="ctl-look-card__btn"
                    aria-label="View product"
                  >

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 13.5786 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  </a>

                {%- endif -%}

              </div>

            </div>

          </div>

        {%- endunless -%}

      {%- endfor -%}

    {%- endif -%}

  {%- endfor -%}

{%- endcapture -%}

{%- if ctl_count > 0 -%}

<div class="ctl-look-box">

  <div class="ctl-look-box__top">

    <div class="ctl-look-box__heading-wrap">

      <h3 class="ctl-look-box__heading">
        COMPLETE THE LOOK
      </h3>

      <span class="ctl-look-count">
        ({{ ctl_count }})
      </span>

    </div>

    <div class="ctl-look-navs">

      <button type="button" class="ctl-look-nav ctl-look-nav--prev is-disabled" aria-label="Previous">
        &#10094;
      </button>

      <button type="button" class="ctl-look-nav ctl-look-nav--next" aria-label="Next">
        &#10095;
      </button>

    </div>

  </div>

  <div class="ctl-look-slider">

    {{ ctl_cards }}

  </div>

</div>

{%- endif -%}
{%- endif -%}

<style>

.ctl-look-box{
  background:#fff;
  border:1px solid #e7e7e7;
  border-radius:8px;
  padding:20px;
  margin-top:40px;
  overflow:hidden;
}

.ctl-look-box__top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
}

.ctl-look-box__heading-wrap{
  display:flex;
  align-items:center;
  gap:8px;
}

.ctl-look-box__heading{
  margin:0;
  font-size:11px;
  line-height:1;
  letter-spacing:.18em;
  font-weight:700;
  text-transform:uppercase;
  color:#111;
}

.ctl-look-count{
  font-size:12px;
  color:#777;
}

.ctl-look-navs{
  display:flex;
  align-items:center;
  gap:8px;
}

.ctl-look-nav{
  width:34px;
  height:34px;
  border:none;
  border-radius:50%;
  background:#111;
  color:#fff;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:16px;
  transition:all .25s ease;
}

.ctl-look-nav:hover{
  background:#2c2c2c;
}

.ctl-look-nav.is-disabled{
  opacity:.35;
  cursor:not-allowed;
  pointer-events:none;
}

.ctl-look-slider{
  display:flex;
  gap:18px;
  overflow-x:auto;
  scroll-behavior:smooth;
  scrollbar-width:none;
  -ms-overflow-style:none;
}

.ctl-look-slider::-webkit-scrollbar{
  display:none;
}

.ctl-look-card{
  flex:0 0 calc(50% - 9px);
  min-width:calc(50% - 9px);
  display:flex;
  flex-direction:column;
  padding: 0 25px 5px 10px;
}

.ctl-look-card__image{
  width:100%;
  aspect-ratio:1/1;
  background:#f5f5f5;
  overflow:hidden;
  display:block;
  margin-bottom:12px;
  text-decoration:none;
}

.ctl-look-card__img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .4s ease;
}

.ctl-look-card__image:hover .ctl-look-card__img{
  transform:scale(1.04);
}

.ctl-look-card__content{
  display:flex;
  flex-direction:column;
  flex:1;
}

.ctl-look-card__title{
  font-size:14px;
  line-height:1.45;
  color:#111;
  text-decoration:none;
}

.ctl-look-card__title:hover{
  text-decoration:underline;
}

.ctl-look-card__rating{
  margin:4px 0 4px;
  min-height:14px;
  line-height:1;
}

.ctl-look-card__rating .rating,
.ctl-look-card__rating .jdgm-widget{
  margin:0;
  line-height:1;
}

.ctl-look-card__rating .jdgm-prev-badge__text{
  font-size:11px;
}

.ctl-look-card__bottom{
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:10px;
}

.ctl-look-card__price{
  font-size:14px;
  color:#111;
  font-weight:500;
}

.ctl-look-card__btn{
  width:36px;
  height:36px;
  min-width:36px;
  border-radius:50%;
  border:none;
  background:#111;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .25s ease;
  text-decoration:none;
  padding:0;
}

.ctl-look-card__btn:hover{
  background:#2c2c2c;
}

.ctl-look-card__btn.loading{
  opacity:.5;
  pointer-events:none;
}

.ctl-look-card__btn.added{
  background:#1f9d72;
}
@media screen and (max-width:749px){
  .ctl-look-card__bottom{
    margin-top: 0px !important;
  }
}
@media screen and (max-width:749px){

  .ctl-look-box{
    padding:16px;
  }

  .ctl-look-slider{
    gap:14px;
  }

  .ctl-look-card{
    flex:0 0 calc(50% - 7px);
    min-width:calc(50% - 7px);
  }

  .ctl-look-card__title{
    font-size:13px;
  }

  .ctl-look-card__price{
    font-size:13px;
  }

  .ctl-look-card__btn{
    width:34px;
    height:34px;
    min-width:34px;
  }

}

</style>

<script>

(function(){

  if(window.ctlCompleteLookInit) return;
  window.ctlCompleteLookInit = true;

  let observer = null;

  function getCardWidth(slider){
    const card = slider.querySelector('.ctl-look-card');
    if(!card) return 0;
    const styles = window.getComputedStyle(slider);
    const gap = parseInt(styles.columnGap || styles.gap || 18, 10) || 18;
    return card.offsetWidth + gap;
  }

  function updateButtons(box){
    if(!box) return;
    const slider = box.querySelector('.ctl-look-slider');
    const prevBtn = box.querySelector('.ctl-look-nav--prev');
    const nextBtn = box.querySelector('.ctl-look-nav--next');
    if(!slider || !prevBtn || !nextBtn) return;

    const maxScroll = slider.scrollWidth - slider.clientWidth;

    if(maxScroll <= 0){
      prevBtn.classList.add('is-disabled');
      nextBtn.classList.add('is-disabled');
      return;
    }

    if(slider.scrollLeft <= 5){
      prevBtn.classList.add('is-disabled');
    } else {
      prevBtn.classList.remove('is-disabled');
    }

    if(slider.scrollLeft >= maxScroll - 5){
      nextBtn.classList.add('is-disabled');
    } else {
      nextBtn.classList.remove('is-disabled');
    }
  }

  function enhanceBox(box){
    if(!box || box.dataset.ctlEnhanced === '1') return;
    box.dataset.ctlEnhanced = '1';
    const slider = box.querySelector('.ctl-look-slider');
    if(slider){
      slider.addEventListener('scroll', function(){ updateButtons(box); });
    }
    updateButtons(box);
  }

  function enhanceAll(){
    document.querySelectorAll('.ctl-look-box').forEach(enhanceBox);
  }

  function scheduleEnhance(delay){
    window.setTimeout(function(){
      enhanceAll();
      document.querySelectorAll('.ctl-look-box').forEach(updateButtons);
    }, delay || 0);
  }

  function observeCartDrawer(){
    if(observer || !window.MutationObserver) return;

    observer = new MutationObserver(function(mutations){
      for(const mutation of mutations){
        for(const node of mutation.addedNodes){
          if(node.nodeType !== 1) continue;

          if(
            (node.matches && node.matches('.ctl-look-box, .ctl-look-slider')) ||
            (node.querySelector && node.querySelector('.ctl-look-box'))
          ){
            scheduleEnhance(50);
            scheduleEnhance(300);
            return;
          }
        }
      }
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });
  }

  document.addEventListener('click', function(e){
    const btn = e.target.closest('.ctl-look-nav--next, .ctl-look-nav--prev');
    if (!btn) return;

    e.preventDefault();

    if (btn.classList.contains('is-disabled')) return;

    const box = btn.closest('.ctl-look-box');
    if (!box) return;

    const slider = box.querySelector('.ctl-look-slider');
    if (!slider) return;

    if (slider.dataset.animating === 'true') return;

    enhanceBox(box);

    const direction = btn.classList.contains('ctl-look-nav--next') ? 1 : -1;
    let moveAmount = getCardWidth(slider) * 2;

    if (moveAmount <= 0) {
      moveAmount = slider.clientWidth;
    }

    slider.dataset.animating = 'true';

    slider.scrollTo({
      left: slider.scrollLeft + moveAmount * direction,
      behavior: 'smooth'
    });

    setTimeout(function () {
      slider.dataset.animating = 'false';
      updateButtons(box);
    }, 500);
  });

  document.addEventListener('click', function(e){
    const atc = e.target.closest('.ctl-look-card__btn[data-variant-id]');
    if(!atc || atc.classList.contains('loading')) return;
    e.preventDefault();
    atc.classList.add('loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: atc.dataset.variantId, quantity: 1 })
    })
    .then(function(r){ return r.json(); })
    .then(function(){
      atc.classList.remove('loading');
      atc.classList.add('added');
      fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
        document.documentElement.dispatchEvent(
          new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart, openMiniCart: true } })
        );
      });
      setTimeout(function(){ atc.classList.remove('added'); }, 2000);
    })
    .catch(function(){ atc.classList.remove('loading'); });
  });

  document.documentElement.addEventListener('cart:refresh', function(){
    scheduleEnhance(50);
    scheduleEnhance(300);
    scheduleEnhance(800);
  });

  window.addEventListener('resize', function(){
    document.querySelectorAll('.ctl-look-box').forEach(function(b){ updateButtons(b); });
  });

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', enhanceAll);
  } else {
    enhanceAll();
  }

  window.WWCompleteLookCart = {
    init: enhanceAll,
    update: function(){
      document.querySelectorAll('.ctl-look-box').forEach(updateButtons);
    }
  };

  observeCartDrawer();
  scheduleEnhance(300);

})();

</script>
