{%- if cart.item_count > 0 -%}

{%- assign ctl_cart_ids = '' -%}
{%- for item in cart.items -%}
  {%- assign ctl_cart_ids = ctl_cart_ids | append: ',' | append: item.product_id -%}
{%- endfor -%}

{%- assign ctl_seen = '' -%}
{%- assign ctl_count = 0 -%}

{%- capture ctl_cards -%}

  {%- for item in cart.items -%}

    {%- assign related_products = item.product.metafields.custom.related_products.value -%}

    {%- if related_products != blank -%}

      {%- for product in related_products limit: 8 -%}

        {%- assign product_check = ',' | append: product.id | append: ',' -%}
        {%- assign cart_check = ',' | append: ctl_cart_ids | append: ',' -%}
        {%- assign seen_check = ',' | append: ctl_seen | append: ',' -%}

        {%- unless cart_check contains product_check or seen_check contains product_check -%}

          {%- assign ctl_seen = ctl_seen | append: ',' | append: product.id -%}
          {%- assign ctl_count = ctl_count | plus: 1 -%}

          <div class="ctl-look-card">

            <a href="{{ product.url }}" class="ctl-look-card__image">

              {%- if product.featured_image -%}

                {{
                  product.featured_image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    class: 'ctl-look-card__img',
                    alt: product.title
                }}

              {%- endif -%}

            </a>

            <div class="ctl-look-card__content">

              <a href="{{ product.url }}" class="ctl-look-card__title">
                {{ product.title }}
              </a>

              <div class="ctl-look-card__bottom">

                <span class="ctl-look-card__price">
                  {{ product.price | money }}
                </span>

                {%- if product.available and product.has_only_default_variant -%}

                  <button
                    class="ctl-look-card__btn"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    aria-label="Add to cart"
                  >

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 13.5786 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  </button>

                {%- else -%}

                  <a
                    href="{{ product.url }}"
                    class="ctl-look-card__btn"
                    aria-label="View product"
                  >

                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M3 6H21" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M16 10C16 11.0609 15.5786 12.0783 14.8284 12.8284C14.0783 13.5786 13.0609 14 12 14C10.9391 14 9.92172 13.5786 9.17157 12.8284C8.42143 13.5786 8 11.0609 8 10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                  </a>

                {%- endif -%}

              </div>

            </div>

          </div>

        {%- endunless -%}

      {%- endfor -%}

    {%- endif -%}

  {%- endfor -%}

{%- endcapture -%}

{%- if ctl_count > 0 -%}

<div class="ctl-look-box">

  <div class="ctl-look-box__top">

    <div class="ctl-look-box__heading-wrap">

      <h3 class="ctl-look-box__heading">
        COMPLETE THE LOOK
      </h3>

      <span class="ctl-look-count">
        ({{ ctl_count }})
      </span>

    </div>

    <div class="ctl-look-navs">

      <button class="ctl-look-nav ctl-look-nav--prev is-disabled" aria-label="Previous">
        &#10094;
      </button>

      <button class="ctl-look-nav ctl-look-nav--next" aria-label="Next">
        &#10095;
      </button>

    </div>

  </div>

  <div class="ctl-look-slider">

    {{ ctl_cards }}

  </div>

</div>

{%- endif -%}
{%- endif -%}

<style>

.ctl-look-box{
  background:#fff;
  border:1px solid #e7e7e7;
  border-radius:8px;
  padding:20px;
  margin-top:40px;
  overflow:hidden;
}

.ctl-look-box__top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18px;
}

.ctl-look-box__heading-wrap{
  display:flex;
  align-items:center;
  gap:8px;
}

.ctl-look-box__heading{
  margin:0;
  font-size:11px;
  line-height:1;
  letter-spacing:.18em;
  font-weight:700;
  text-transform:uppercase;
  color:#111;
}

.ctl-look-count{
  font-size:12px;
  color:#777;
}

.ctl-look-navs{
  display:flex;
  align-items:center;
  gap:8px;
}

.ctl-look-nav{
  width:34px;
  height:34px;
  border:none;
  border-radius:50%;
  background:#111;
  color:#fff;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:16px;
  transition:all .25s ease;
}

.ctl-look-nav:hover{
  background:#2c2c2c;
}

.ctl-look-nav.is-disabled{
  opacity:.35;
  cursor:not-allowed;
  pointer-events:none;
}

.ctl-look-slider{
  display:flex;
  gap:18px;
  overflow-x:auto;
  scroll-behavior:smooth;
  scrollbar-width:none;
  -ms-overflow-style:none;
}

.ctl-look-slider::-webkit-scrollbar{
  display:none;
}

.ctl-look-card{
  flex:0 0 calc(50% - 9px);
  min-width:calc(50% - 9px);
  display:flex;
  flex-direction:column;
}

.ctl-look-card__image{
  width:100%;
  aspect-ratio:1/1;
  background:#f5f5f5;
  overflow:hidden;
  display:block;
  margin-bottom:12px;
  text-decoration:none;
}

.ctl-look-card__img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .4s ease;
}

.ctl-look-card__image:hover .ctl-look-card__img{
  transform:scale(1.04);
}

.ctl-look-card__content{
  display:flex;
  flex-direction:column;
  flex:1;
}

.ctl-look-card__title{
  font-size:14px;
  line-height:1.45;
  color:#111;
  text-decoration:none;
}

.ctl-look-card__title:hover{
  text-decoration:underline;
}

.ctl-look-card__bottom{
  margin-top:14px;
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:10px;
}

.ctl-look-card__price{
  font-size:14px;
  color:#111;
  font-weight:500;
}

.ctl-look-card__btn{
  width:36px;
  height:36px;
  min-width:36px;
  border-radius:50%;
  border:none;
  background:#111;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:all .25s ease;
  text-decoration:none;
  padding:0;
}

.ctl-look-card__btn:hover{
  background:#2c2c2c;
}

.ctl-look-card__btn.loading{
  opacity:.5;
  pointer-events:none;
}

.ctl-look-card__btn.added{
  background:#1f9d72;
}

@media screen and (max-width:749px){

  .ctl-look-box{
    padding:16px;
  }

  .ctl-look-slider{
    gap:14px;
  }

  .ctl-look-card{
    flex:0 0 calc(50% - 7px);
    min-width:calc(50% - 7px);
  }

  .ctl-look-card__title{
    font-size:13px;
  }

  .ctl-look-card__price{
    font-size:13px;
  }

  .ctl-look-card__btn{
    width:34px;
    height:34px;
    min-width:34px;
  }

}

</style>

<script>

(function(){

  if(window.ctlCompleteLookInit) return;
  window.ctlCompleteLookInit = true;

  function initCompleteLook(){

    const slider = document.querySelector('.ctl-look-slider');
    const nextBtn = document.querySelector('.ctl-look-nav--next');
    const prevBtn = document.querySelector('.ctl-look-nav--prev');

    if(!slider || !nextBtn || !prevBtn) return;

    const updateButtons = function(){

      const maxScrollLeft = slider.scrollWidth - slider.clientWidth;

      if(slider.scrollLeft <= 5){
        prevBtn.classList.add('is-disabled');
      } else {
        prevBtn.classList.remove('is-disabled');
      }

      if(slider.scrollLeft >= maxScrollLeft - 5){
        nextBtn.classList.add('is-disabled');
      } else {
        nextBtn.classList.remove('is-disabled');
      }

    };

    nextBtn.addEventListener('click', function(){

      const card = slider.querySelector('.ctl-look-card');

      if(!card) return;

      const gap = 18;
      const scrollAmount = card.offsetWidth + gap;

      slider.scrollBy({
        left: scrollAmount * 2,
        behavior:'smooth'
      });

    });

    prevBtn.addEventListener('click', function(){

      const card = slider.querySelector('.ctl-look-card');

      if(!card) return;

      const gap = 18;
      const scrollAmount = card.offsetWidth + gap;

      slider.scrollBy({
        left: -(scrollAmount * 2),
        behavior:'smooth'
      });

    });

    slider.addEventListener('scroll', updateButtons);

    window.addEventListener('resize', updateButtons);

    updateButtons();

  }

  document.addEventListener('DOMContentLoaded', initCompleteLook);

  document.addEventListener('click', function(e){

    var btn = e.target.closest('.ctl-look-card__btn[data-variant-id]');

    if(!btn || btn.classList.contains('loading')) return;

    e.preventDefault();

    btn.classList.add('loading');

    fetch('/cart/add.js',{

      method:'POST',

      headers:{
        'Content-Type':'application/json',
        'X-Requested-With':'XMLHttpRequest'
      },

      body:JSON.stringify({
        id:btn.dataset.variantId,
        quantity:1
      })

    })

    .then(function(response){
      return response.json();
    })

    .then(function(){

      btn.classList.remove('loading');
      btn.classList.add('added');

      fetch('/cart.js')

      .then(function(r){
        return r.json();
      })

      .then(function(cart){

        document.documentElement.dispatchEvent(

          new CustomEvent('cart:refresh',{

            bubbles:true,

            detail:{
              cart:cart,
              openMiniCart:true
            }

          })

        );

      });

      setTimeout(function(){
        btn.classList.remove('added');
      },2000);

    })

    .catch(function(){

      btn.classList.remove('loading');

    });

  });

})();

</script>