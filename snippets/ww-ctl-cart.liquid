{%- if cart.item_count > 0 -%}

{%- assign ctl_cart_ids = '' -%}
{%- for item in cart.items -%}
  {%- assign ctl_cart_ids = ctl_cart_ids | append: ',' | append: item.product_id -%}
{%- endfor -%}

{%- assign ctl_seen = '' -%}
{%- assign ctl_count = 0 -%}

{%- capture ctl_cards -%}

  {%- for item in cart.items -%}
    {%- assign related_products = item.product.metafields.custom.related_products.value -%}

    {%- if related_products != blank -%}
      {%- for product in related_products limit: 6 -%}

        {%- assign product_check = ',' | append: product.id | append: ',' -%}
        {%- assign cart_check = ',' | append: ctl_cart_ids | append: ',' -%}
        {%- assign seen_check = ',' | append: ctl_seen | append: ',' -%}

        {%- unless cart_check contains product_check or seen_check contains product_check -%}

          {%- assign ctl_seen = ctl_seen | append: ',' | append: product.id -%}
          {%- assign ctl_count = ctl_count | plus: 1 -%}

          <div class="ctl-card">

            <a href="{{ product.url }}" class="ctl-card__imgwrap">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'ctl-card__img', alt: product.title }}
              {%- endif -%}
            </a>

            <div class="ctl-card__info">

              <a href="{{ product.url }}" class="ctl-card__title">
                {{ product.title }}
              </a>

              <div class="ctl-card__bottom">
                <span class="ctl-card__price">{{ product.price | money }}</span>

                {%- if product.available and product.has_only_default_variant -%}
                  <button class="ctl-add" data-variant-id="{{ product.selected_or_first_available_variant.id }}">+</button>
                {%- else -%}
                  <a class="ctl-add" href="{{ product.url }}">→</a>
                {%- endif -%}

              </div>

            </div>

          </div>

        {%- endunless -%}

      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

{%- endcapture -%}

{%- if ctl_count > 0 -%}

<div class="ctl-wrapper">

  <div class="ctl-header">
    <h3>COMPLETE THE LOOK</h3>

    <div class="ctl-arrows">
      <button class="ctl-prev" type="button">‹</button>
      <button class="ctl-next" type="button">›</button>
    </div>
  </div>

  <div class="ctl-slider">
    {{ ctl_cards }}
  </div>

</div>

{%- endif -%}
{%- endif -%}

<style>

.ctl-wrapper{
  border:1px solid #e8e8e8;
  border-radius:10px;
  padding:18px;
  background:#fff;
  margin-top:40px;
}

.ctl-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.ctl-header h3{
  font-size:11px;
  letter-spacing:.2em;
  margin:0;
}

.ctl-arrows button{
  width:34px;
  height:34px;
  border-radius:50%;
  border:1px solid #ddd;
  background:#111;
  color:#fff;
  cursor:pointer;
  margin-left:6px;
}

.ctl-slider{
  display:flex;
  overflow:hidden;
  scroll-behavior:smooth;
  gap:16px;
}

/* 2 PER ROW DESKTOP */
.ctl-card{
  flex:0 0 calc(50% - 8px);
  display:flex;
  flex-direction:column;
}

.ctl-card__imgwrap{
  aspect-ratio:1/1;
  overflow:hidden;
  display:block;
  border-radius:8px;
  background:#f6f6f6;
}

.ctl-card__img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.35s ease;
}

.ctl-card__imgwrap:hover .ctl-card__img{
  transform:scale(1.05);
}

.ctl-card__info{
  margin-top:10px;
}

.ctl-card__title{
  font-size:14px;
  color:#111;
  text-decoration:none;
  display:block;
  line-height:1.4;
}

.ctl-card__bottom{
  display:flex;
  justify-content:space-between;
  margin-top:8px;
  align-items:center;
}

.ctl-card__price{
  font-size:14px;
  font-weight:500;
}

.ctl-add{
  width:32px;
  height:32px;
  border-radius:50%;
  border:none;
  background:#111;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  text-decoration:none;
}

/* MOBILE */
@media(max-width:768px){
  .ctl-card{flex:0 0 80%;}
}

</style>

<script>
(function(){

  document.querySelectorAll('.ctl-wrapper').forEach(function(wrapper){

    const slider = wrapper.querySelector('.ctl-slider');
    const prev = wrapper.querySelector('.ctl-prev');
    const next = wrapper.querySelector('.ctl-next');

    if(!slider || !prev || !next) return;

    function scrollAmount(){
      return slider.querySelector('.ctl-card').offsetWidth + 16;
    }

    prev.addEventListener('click', function(){
      slider.scrollBy({ left: -scrollAmount() * 2, behavior: 'smooth' });
    });

    next.addEventListener('click', function(){
      slider.scrollBy({ left: scrollAmount() * 2, behavior: 'smooth' });
    });

  });

  document.addEventListener('click', function(e){

    const btn = e.target.closest('.ctl-add[data-variant-id]');
    if(!btn) return;

    btn.classList.add('loading');

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({id: btn.dataset.variantId, quantity: 1})
    })
    .then(r => r.json())
    .then(() => {
      btn.classList.add('added');
      btn.classList.remove('loading');
      setTimeout(()=>btn.classList.remove('added'), 1500);
    })
    .catch(()=>btn.classList.remove('loading'));

  });

})();
</script>
