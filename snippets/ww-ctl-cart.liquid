{%- if cart.item_count > 0 -%}

{%- assign ctl_cart_ids = '' -%}
{%- for item in cart.items -%}
  {%- assign ctl_cart_ids = ctl_cart_ids | append: ',' | append: item.product_id -%}
{%- endfor -%}

{%- assign ctl_seen = '' -%}
{%- assign ctl_count = 0 -%}

{%- capture ctl_cards -%}

  {%- for item in cart.items -%}

    {%- assign related_products = item.product.metafields.custom.related_products.value -%}

    {%- if related_products != blank -%}

      {%- for product in related_products limit: 4 -%}

        {%- assign product_check = ',' | append: product.id | append: ',' -%}
        {%- assign cart_check = ',' | append: ctl_cart_ids | append: ',' -%}
        {%- assign seen_check = ',' | append: ctl_seen | append: ',' -%}

        {%- unless cart_check contains product_check or seen_check contains product_check -%}

          {%- assign ctl_seen = ctl_seen | append: ',' | append: product.id -%}
          {%- assign ctl_count = ctl_count | plus: 1 -%}

          <div class="ctl-look-card">

            <a href="{{ product.url }}" class="ctl-look-card__image">

              {%- if product.featured_image -%}

                {{
                  product.featured_image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    class: 'ctl-look-card__img',
                    alt: product.title
                }}

              {%- endif -%}

            </a>

            <div class="ctl-look-card__content">

              <a href="{{ product.url }}" class="ctl-look-card__title">
                {{ product.title }}
              </a>

              <div class="ctl-look-card__bottom">

                <span class="ctl-look-card__price">
                  {{ product.price | money }}
                </span>

                {%- if product.available and product.has_only_default_variant -%}

                  <button
                    class="ctl-look-card__btn"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    aria-label="Add to cart"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M3 6H21" stroke="currentColor" stroke-width="1.7"/>
                    </svg>
                  </button>

                {%- else -%}

                  <a href="{{ product.url }}" class="ctl-look-card__btn" aria-label="View product">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                      <path d="M6 2L3 6V20C3 20.5304 3.21071 21.0391 3.58579 21.4142C3.96086 21.7893 4.46957 22 5 22H19C19.5304 22 20.0391 21.7893 20.4142 21.4142C20.7893 21.0391 21 20.5304 21 20V6L18 2H6Z" stroke="currentColor" stroke-width="1.7"/>
                      <path d="M3 6H21" stroke="currentColor" stroke-width="1.7"/>
                    </svg>
                  </a>

                {%- endif -%}

              </div>

            </div>

          </div>

        {%- endunless -%}

      {%- endfor -%}

    {%- endif -%}

  {%- endfor -%}

{%- endcapture -%}

{%- if ctl_count > 0 -%}

<div class="ctl-look-box">

  <div class="ctl-look-box__top">
    <h3 class="ctl-look-box__heading">COMPLETE THE LOOK</h3>

    <div class="ctl-nav">
      <button class="ctl-prev" aria-label="Previous">&#10094;</button>
      <button class="ctl-next" aria-label="Next">&#10095;</button>
    </div>

  </div>

  <div class="ctl-look-slider" id="ctlSlider">
    {{ ctl_cards }}
  </div>

</div>

{%- endif -%}
{%- endif -%}

<style>
.ctl-look-box{
  background:#fff;
  border:1px solid #e7e7e7;
  border-radius:8px;
  padding:20px;
  margin-top:40px;
}

.ctl-look-box__top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.ctl-look-box__heading{
  margin:0;
  font-size:11px;
  letter-spacing:.18em;
  text-transform:uppercase;
}

.ctl-nav button{
  background:#111;
  color:#fff;
  border:none;
  width:32px;
  height:32px;
  border-radius:50%;
  cursor:pointer;
  margin-left:5px;
}

.ctl-look-slider{
  display:flex;
  overflow-x:auto;
  scroll-behavior:smooth;
  gap:16px;
  scrollbar-width:none;
}

.ctl-look-slider::-webkit-scrollbar{display:none;}

.ctl-look-card{
  flex:0 0 calc(50% - 10px);
  display:flex;
  flex-direction:column;
}

.ctl-look-card__image{
  aspect-ratio:1/1;
  overflow:hidden;
  display:block;
  margin-bottom:10px;
}

.ctl-look-card__img{
  width:100%;height:100%;object-fit:cover;
}

.ctl-look-card__title{font-size:14px;color:#111;text-decoration:none;}

.ctl-look-card__bottom{
  display:flex;
  justify-content:space-between;
  margin-top:10px;
}

.ctl-look-card__btn{
  width:34px;height:34px;border-radius:50%;background:#111;color:#fff;border:none;
}

@media(max-width:749px){
  .ctl-look-card{
    flex:0 0 80%;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){

  const slider=document.getElementById('ctlSlider');
  const prev=document.querySelector('.ctl-prev');
  const next=document.querySelector('.ctl-next');

  const scrollAmount=slider.offsetWidth/2;

  prev.addEventListener('click',()=>{
    slider.scrollBy({left:-scrollAmount,behavior:'smooth'});
  });

  next.addEventListener('click',()=>{
    slider.scrollBy({left:scrollAmount,behavior:'smooth'});
  });

  document.addEventListener('click',function(e){

    const btn=e.target.closest('.ctl-look-card__btn[data-variant-id]');
    if(!btn) return;

    btn.classList.add('loading');

    fetch('/cart/add.js',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({id:btn.dataset.variantId,quantity:1})
    })
    .then(()=>btn.classList.add('added'))
    .finally(()=>btn.classList.remove('loading'));

  });

});
</script>
