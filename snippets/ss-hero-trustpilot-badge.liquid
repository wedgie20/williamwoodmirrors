{% assign trustpilot_slide_number = slide_number | default: block.settings.slide_number | default: 'all' %}
{% assign trustpilot_section_id = section_id | default: '' %}
{% assign show_rating_text = true %}
{% assign show_stars = true %}
{% assign show_reviews_text = true %}
{% assign show_brand_text = true %}
{% if block.settings.show_rating_text == false %}
  {% assign show_rating_text = false %}
{% endif %}
{% if block.settings.show_stars == false %}
  {% assign show_stars = false %}
{% endif %}
{% if block.settings.show_reviews_text == false %}
  {% assign show_reviews_text = false %}
{% endif %}
{% if block.settings.show_brand_text == false %}
  {% assign show_brand_text = false %}
{% endif %}

<div
  class="hero-trustpilot-{{ block.id }}"
  data-hero-trustpilot
  data-trustpilot-section="{{ trustpilot_section_id }}"
  data-trustpilot-slide="{{ trustpilot_slide_number }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.intro_text != blank %}
    <p class="hero-trustpilot-{{ block.id }}__intro">{{ block.settings.intro_text }}</p>
  {% endif %}

  <div class="hero-trustpilot-{{ block.id }}__row">
    {% if show_rating_text and block.settings.rating_text != blank %}
      <span class="hero-trustpilot-{{ block.id }}__rating">{{ block.settings.rating_text }}</span>
    {% endif %}

    {% if show_stars %}
      <span class="hero-trustpilot-{{ block.id }}__stars" aria-hidden="true">
        {% for index in (1..5) %}
          <span class="hero-trustpilot-{{ block.id }}__star{% if index == 5 and block.settings.show_half_star %} hero-trustpilot-{{ block.id }}__star--half{% endif %}">&#9733;</span>
        {% endfor %}
      </span>
    {% endif %}

    {% if show_reviews_text and block.settings.reviews_text != blank %}
      <span class="hero-trustpilot-{{ block.id }}__reviews">{{ block.settings.reviews_text }}</span>
    {% endif %}

    {% if show_brand_text and block.settings.brand_text != blank %}
      <span class="hero-trustpilot-{{ block.id }}__brand">
        <span class="hero-trustpilot-{{ block.id }}__brand-star" aria-hidden="true">&#9733;</span>
        {{ block.settings.brand_text }}
      </span>
    {% endif %}
  </div>
</div>
