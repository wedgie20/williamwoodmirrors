{%- assign cart_discount_context = context | default: 'cart' -%}
{%- assign applied_discount_titles = '' -%}
{%- capture applied_discount_pills -%}
  {%- for discount_application in cart.cart_level_discount_applications -%}
    {%- if discount_application.type == 'discount_code' -%}
      {%- assign discount_title = discount_application.title | strip -%}
      {%- assign discount_key = '|' | append: discount_title | append: '|' -%}

      {%- unless applied_discount_titles contains discount_key -%}
        {%- assign applied_discount_titles = applied_discount_titles | append: discount_key -%}
        <span class="ww-cart-discount__pill">
          {%- render 'icon' with 'discount-badge' -%}
          <span>{{ discount_title }}</span>
          <button
            type="button"
            class="ww-cart-discount__pill-remove"
            aria-label="Remove discount code {{ discount_title | escape }}"
            data-cart-discount-remove
            data-discount-code="{{ discount_title | escape }}"
          >
            &times;
          </button>
        </span>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}

  {%- for line_item in cart.items -%}
    {%- for discount_allocation in line_item.line_level_discount_allocations -%}
      {%- assign discount_application = discount_allocation.discount_application -%}
      {%- if discount_application.type == 'discount_code' -%}
        {%- assign discount_title = discount_application.title | strip -%}
        {%- assign discount_key = '|' | append: discount_title | append: '|' -%}

        {%- unless applied_discount_titles contains discount_key -%}
          {%- assign applied_discount_titles = applied_discount_titles | append: discount_key -%}
          <span class="ww-cart-discount__pill">
            {%- render 'icon' with 'discount-badge' -%}
            <span>{{ discount_title }}</span>
            <button
              type="button"
              class="ww-cart-discount__pill-remove"
              aria-label="Remove discount code {{ discount_title | escape }}"
              data-cart-discount-remove
              data-discount-code="{{ discount_title | escape }}"
            >
              &times;
            </button>
          </span>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="ww-cart-discount ww-cart-discount--{{ cart_discount_context }}" data-cart-discount-code>
  <label class="ww-cart-discount__label" for="ww-cart-discount-code-{{ cart_discount_context }}">Discount code</label>

  <div class="ww-cart-discount__row">
    <input
      id="ww-cart-discount-code-{{ cart_discount_context }}"
      class="ww-cart-discount__input"
      type="text"
      inputmode="text"
      autocomplete="off"
      autocapitalize="characters"
      placeholder="Enter code here"
      aria-label="Discount code"
      data-cart-discount-input
    >

    <button type="button" class="ww-cart-discount__button" data-cart-discount-apply disabled>
      Apply
    </button>
  </div>

  {%- if applied_discount_pills != blank -%}
    <div class="ww-cart-discount__pills" aria-label="Applied discount codes">
      {{- applied_discount_pills -}}
    </div>
  {%- endif -%}

  <p class="ww-cart-discount__message" data-cart-discount-message hidden></p>
</div>

<style>
  .ww-cart-discount {
    padding: 16px 20px;
    border-top: 1px solid rgb(var(--root-border-color));
    border-bottom: 0;
    background: #fff;
  }

  .ww-cart-discount--cart {
    padding: 0 0 16px;
    border-top: 0;
    border-bottom: 0;
  }

  .ww-cart-discount__label {
    display: block;
    margin-bottom: 8px;
    color: #000;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ww-cart-discount__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 92px;
    gap: 12px;
    align-items: stretch;
  }

  .ww-cart-discount__input {
    width: 100%;
    min-height: 46px;
    padding: 0 14px;
    border: 1px solid #d7d7d7;
    border-radius: 4px;
    color: #000;
    font-size: 14px;
    background: #fff;
  }

  .ww-cart-discount__input:focus {
    border-color: #000;
    outline: 0;
  }

  .ww-cart-discount__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 12px;
    border: 1px solid #000;
    border-radius: 4px;
    background: #000;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  .ww-cart-discount__button[disabled] {
    border-color: #e8e8e8;
    background: #f5f5f5;
    color: #777;
    cursor: not-allowed;
    opacity: 0.65;
  }

  .ww-cart-discount__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .ww-cart-discount__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    min-height: 30px;
    padding: 5px 9px;
    border-radius: 6px;
    background: #f1f1f1;
    color: #000;
    font-size: 13px;
    line-height: 1;
  }

  .ww-cart-discount__pill svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  .ww-cart-discount__pill-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #777;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
  }

  .ww-cart-discount__pill-remove:hover {
    color: #000;
  }

  .ww-cart-discount__message {
    margin: 6px 0 0;
    color: #000;
    font-size: 12px;
    line-height: 1.4;
  }

  .ww-cart-discount__message.is-error {
    color: #9b1c1c;
  }

  @media (max-width: 740px) {
    .ww-cart-discount {
      padding: 14px 20px;
    }

    .ww-cart-discount--cart {
      padding: 0 0 14px;
    }

    .ww-cart-discount__row {
      grid-template-columns: minmax(0, 1fr) 82px;
      gap: 10px;
    }

    .ww-cart-discount__input,
    .ww-cart-discount__button {
      min-height: 44px;
    }
  }
</style>

<script>
  (function() {
    if (window.WWCartDiscountCodeReady) {
      return;
    }

    window.WWCartDiscountCodeReady = true;

    function getRoutes() {
      return window.themeVariables && window.themeVariables.routes ? window.themeVariables.routes : {};
    }

    function getSettings() {
      return window.themeVariables && window.themeVariables.settings ? window.themeVariables.settings : {};
    }

    function showMessage(form, message, isError) {
      var messageEl = form.querySelector('[data-cart-discount-message]');
      if (!messageEl) {
        return;
      }

      messageEl.textContent = message;
      messageEl.hidden = false;
      messageEl.classList.toggle('is-error', Boolean(isError));
    }

    function updateButtonState(form) {
      var input = form.querySelector('[data-cart-discount-input]');
      var button = form.querySelector('[data-cart-discount-apply]');

      if (!input || !button || button.dataset.loading === 'true') {
        return;
      }

      button.disabled = input.value.trim() === '';
    }

    async function getCart() {
      var routes = getRoutes();
      var cartUrl = routes.cartUrl || '/cart';
      var response = await fetch(cartUrl + '.js', {
        credentials: 'same-origin',
        cache: 'reload'
      });

      if (!response.ok) {
        throw new Error('Unable to refresh cart');
      }

      return response.json();
    }

    async function updateCartDiscount(discount) {
      var routes = getRoutes();
      var cartUrl = routes.cartUrl || '/cart';
      var updateUrl = cartUrl.replace(/\/$/, '') + '/update.js';
      var response = await fetch(updateUrl, {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ discount: discount })
      });

      if (!response.ok) {
        throw new Error('Unable to update discount');
      }

      return response.json();
    }

    function refreshDrawer(cart) {
      var settings = getSettings();

      document.documentElement.dispatchEvent(new CustomEvent('cart:updated', {
        bubbles: true,
        detail: { cart: cart }
      }));

      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', {
        bubbles: true,
        detail: {
          cart: cart,
          openMiniCart: settings.cartType === 'drawer'
        }
      }));
    }

    function isCartPage() {
      var routes = getRoutes();
      var cartPath = routes.cartUrl || '/cart';
      return window.location.pathname === cartPath || window.location.pathname.replace(/\/$/, '') === cartPath.replace(/\/$/, '');
    }

    async function applyDiscount(form) {
      var input = form.querySelector('[data-cart-discount-input]');
      var button = form.querySelector('[data-cart-discount-apply]');
      var code = input ? input.value.trim() : '';

      if (!code) {
        showMessage(form, 'Enter a discount code to apply.', true);
        return;
      }

      if (button) {
        button.dataset.loading = 'true';
        button.disabled = true;
        button.textContent = 'Applying';
      }

      showMessage(form, 'Applying code...', false);

      try {
        var cart = await updateCartDiscount(code);

        if (isCartPage()) {
          window.location.reload();
          return;
        }

        refreshDrawer(cart);
      } catch (error) {
        showMessage(form, 'We could not apply that code. Please try again.', true);
      } finally {
        if (button) {
          button.dataset.loading = 'false';
          button.textContent = 'Apply';
          updateButtonState(form);
        }
      }
    }

    async function removeDiscount(button) {
      var form = button.closest('[data-cart-discount-code]');

      if (!form) {
        return;
      }

      button.disabled = true;
      showMessage(form, 'Removing code...', false);

      try {
        var cart = await updateCartDiscount('');

        if (isCartPage()) {
          window.location.reload();
          return;
        }

        refreshDrawer(cart);
      } catch (error) {
        button.disabled = false;
        showMessage(form, 'We could not remove that code. Please try again.', true);
      }
    }

    document.addEventListener('input', function(event) {
      var input = event.target.closest('[data-cart-discount-input]');
      if (!input) {
        return;
      }

      var form = input.closest('[data-cart-discount-code]');
      if (form) {
        updateButtonState(form);
      }
    });

    document.addEventListener('click', function(event) {
      var removeButton = event.target.closest('[data-cart-discount-remove]');
      if (removeButton) {
        removeDiscount(removeButton);
        return;
      }

      var button = event.target.closest('[data-cart-discount-apply]');
      if (!button) {
        return;
      }

      var form = button.closest('[data-cart-discount-code]');
      if (form) {
        applyDiscount(form);
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key !== 'Enter') {
        return;
      }

      var input = event.target.closest('[data-cart-discount-input]');
      if (!input) {
        return;
      }

      event.preventDefault();

      var form = input.closest('[data-cart-discount-code]');
      if (form) {
        applyDiscount(form);
      }
    });
  })();
</script>
