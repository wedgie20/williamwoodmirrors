<style>
  button.swym-button {
    margin: 0 auto;
    border: none;
    font: inherit;
    line-height: normal;
    height: 40px;
    display: block;
    color: #545454;
    padding: 0 0 0 20px;
    text-transform: uppercase;
    font-size: 12px;
    text-align: center;
    overflow: hidden;
    position: relative;
    cursor: pointer;
  }
  .swym-button .not-selected {
    width: 15px;
    height: 15px;
    display: inline-block;
    transform: translate(-2px, 3px);
  }
  .swym-button .selected {
    width: 19px;
    height: 19px;
    display: none;
    transform: translate(-2px, 5px);
  }
  .swym-button.swym-added .selected {
    display: inline-block;
  }
  .swym-button.swym-added .not-selected {
    display: none;
  }
 /* .swym-button-bar {
    display: none !important;
  }*/
  @media (min-width: 768px) {
    button.swym-button {
      font-size: 14px;
    }
    .swym-button .not-selected {
      transform: translate(-2px, 2px);
    }
    .swym-button .selected {
      transform: translate(-2px, 4px);
    }
  }
  @media (max-width: 900px) {
    .swym-ui-component .swym-add-wishlist-modal .swym-modal-content .swym-action-btns .swym-new-wishlist-btn,
    .swym-ui-component .swym-add-wishlist-modal .swym-modal-content .swym-action-btns .swym-add-to-list-btn {
      width: 153px;
    }
  }
</style>

