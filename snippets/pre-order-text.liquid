{% if product.tags contains 'pre-order' %}
<div class="description-container-preorder" style="display: none;">
    
      {% if current_path contains '/en-fr/' or current_path contains '/en-de/' or current_path contains '/en-nl/' %}
        {% assign short_description = product.description 
              | strip_html 
              | replace: 'between', 'from' 
              | split: 'and' 
              | first 
              | strip 
        %}
      {% else %}
          {% assign short_description = product.description
            | strip_html
            | split: ':' 
            | first 
            | strip 
          %}
      {% endif %}

      {% if block.settings.short_description != blank %}
        <p><b>{{ block.settings.short_description }}</b></p>
      {% else %}
        <p><b>{{ short_description }}</b></p>
      {% endif %}
  
</div>
  {% endif %}