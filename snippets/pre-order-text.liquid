{% if product.tags contains 'pre-order' %}
<div class="description-container-preorder">
    
      {% if current_path contains '/en-fr/' or current_path contains '/en-de/' or current_path contains '/en-nl/' %}
        {% assign short_description = product.description 
              | strip_html 
              | replace: 'between', 'from' 
              | split: 'and' 
              | first 
              | strip 
        %}
      {% else %}
          {% assign short_description = product.description
            | strip_html
            | split: ':' 
            | first 
            | strip 
          %}
      {% endif %}

      {% if block.settings.short_description != blank %}
        <p><b>{{ block.settings.short_description | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx }}</b></p>
      {% else %}
        <p><b>{{ short_description }}</b></p>
      {% endif %}
  
</div>
  {% endif %}