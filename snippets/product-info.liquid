<style>

  .shopify_payment-terms {
  display: none !important;
}
.swipe-container-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transform: translateY(10px);
}


.swipe-container {
    overflow-x: auto;
    white-space: nowrap;
    display: flex;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    width: 100%;
}

.swipe-container::-webkit-scrollbar {
    display: none;
}

.swipe-content {
    display: flex;
    gap: 10px;
}

.swipe-content img {
    height: 26px;
    width: auto;
    flex-shrink: 0;
}

.dots-container {
    display: flex;
    gap: 5px;
    margin-top: 20px;
    justify-content: center; 
    width: 100%;
}

.dot {
    width: 4px;
    height: 4px;
    background-color: lightgray;
    border-radius: 50%;
    transition: background-color 0.3s;
}

.dot.active {
    background-color: black;
}


@media screen and (min-width: 741px) {
    .swipe-container {
        max-width: 50vw;
        overflow: hidden;
    }

    .dot {
        display: none;
    }

    .nav-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        color: black;
        border: none;
        cursor: pointer;
        font-size: 18px;
        transition: background 0.3s;
    }

    .nav-arrow:hover {
    }

    .left-arrow {
        left: -35px;
    }

    .right-arrow {
        right: -35px;
    }
}

@media screen and (max-width: 740px) {
    .nav-arrow {
        display: none !important;
    }
     .product-meta .product-title-price {
    margin-top: 15px;
}
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const swipeContainer = document.getElementById("swipeContainer");
    const dotsContainer = document.getElementById("dotsContainer");
    const images = document.querySelectorAll(".swipe-content img");
    const leftArrow = document.querySelector(".left-arrow");
    const rightArrow = document.querySelector(".right-arrow");

    images.forEach((_, index) => {
        const dot = document.createElement("div");
        dot.classList.add("dot");
        if (index === 0) dot.classList.add("active");
        dotsContainer.appendChild(dot);
    });

    const dots = document.querySelectorAll(".dot");

    function updateDots() {
        let scrollLeft = swipeContainer.scrollLeft;
        let containerWidth = swipeContainer.offsetWidth;
        let totalWidth = swipeContainer.scrollWidth;
        let imageWidth = images[0].offsetWidth + 10;
        
        let index = Math.round(scrollLeft / imageWidth);
        const maxIndex = dots.length - 1;

        if (scrollLeft + containerWidth >= totalWidth) {
            index = maxIndex;
        } else {
            index = Math.min(index, maxIndex);
        }

        dots.forEach(dot => dot.classList.remove("active"));
        dots[index].classList.add("active");

        if (window.innerWidth >= 741) {
            leftArrow.style.display = scrollLeft > 0 ? "flex" : "none";
            rightArrow.style.display = (scrollLeft + containerWidth) < totalWidth ? "flex" : "none";
        }
    }

    swipeContainer.addEventListener("scroll", updateDots);

    function scrollLeft() {
        swipeContainer.scrollBy({ left: -105, behavior: 'smooth' });
    }

    function scrollRight() {
        swipeContainer.scrollBy({ left: 105, behavior: 'smooth' });
    }

    leftArrow.addEventListener("click", scrollLeft);
    rightArrow.addEventListener("click", scrollRight);

    updateDots();
});
</script>

