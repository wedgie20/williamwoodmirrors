{% comment %} {% unless request.path contains '/en-fr/' or request.path contains '/en-de/' or request.path contains '/en-nl/' %} {% endcomment %}
 {%- if cart.currency.iso_code == 'GBP' -%}
<body>
    <div id="price-divider-container">
        <label for="installments">Or in </label>
        <select id="installments">
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="6">6</option>
            <option value="9">9</option>
            <option value="12">12</option>
        </select>
        instalments of <span id="installment"></span>
        <div id="disclaimer"></div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (window.location.pathname.startsWith('/fr-fr')) {
                document.getElementById('price-divider-container').style.display = 'none';
            }
        });

        const price = {{ product.price }};
        const installmentsDropdown = document.getElementById('installments');
        const installmentDisplay = document.getElementById('installment');
        const disclaimerDisplay = document.getElementById('disclaimer');

        function updateInstallment() {
            const selectedValue = installmentsDropdown.value;
            const installment = (price / selectedValue) / 100;
            let logoUrl = '';
            let logoClass = 'logo';
            let disclaimerText = '';

            switch (selectedValue) {
                case '3':
                    logoUrl = 'https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/Marketing_Badge_With_Clear_Space_1.png?v=1725885242';
                    logoClass += ' klarna-logo';
                    disclaimerText = 'Interest free monthly instalments';
                    break;
                case '4':
                    logoUrl = 'https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/CP_logo_badge_6328x2204_blackmint_png.png?v=1725884864';
                    disclaimerText = 'Interest free fortnightly instalments';
                    break;
                case '6':
                    logoUrl = 'https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/dividebuy-logo-full-colour-rgb-scaled.jpg?v=1725884791';
                    logoClass += ' DB-logo';
                    disclaimerText = 'Only available on orders £300 or more';
                    break;
                case '9':
                    logoUrl = 'https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/dividebuy-logo-full-colour-rgb-scaled.jpg?v=1725884791';
                    logoClass += ' DB-logo';
                    disclaimerText = 'Only available on orders £450 or more';
                    break;
                case '12':
                    logoUrl = 'https://sfycdn.speedsize.com/19bba31a-6c36-4510-aa4c-90e87768362d/cdn.shopify.com/s/files/1/0780/3843/files/dividebuy-logo-full-colour-rgb-scaled.jpg?v=1725884791';
                    logoClass += ' DB-logo';
                    disclaimerText = 'Only available on orders £600 or more';
                    break;
            }

            installmentDisplay.innerHTML = `<strong>£${installment.toFixed(2)} GBP</strong> with <img src="${logoUrl}" alt="${selectedValue} installments logo" class="${logoClass}" style="height: 20px;" loading="lazy">`;
            disclaimerDisplay.innerHTML = `<span class="disclaimer">${disclaimerText}</span>`;
        }

        installmentsDropdown.addEventListener('change', updateInstallment);

        updateInstallment();
    </script>
</body>
