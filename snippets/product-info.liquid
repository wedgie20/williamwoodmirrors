    .ww-code {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      background: #780606cc;
      color: #ffffff;
      padding: 4px 10px;
      border-radius: 18px;
      border: 0.5px dashed #c4b9aa;
      white-space: nowrap;
      flex-shrink: 0;
      user-select: all;
      cursor: pointer;
    }

    .ww-code.is-copied {
      background: #1f7a38;
      border-color: #1f7a38;
    }
  </style>

   <script>
    if (!window.WWDiscountCodeCopyBound) {
      window.WWDiscountCodeCopyBound = true;

      document.addEventListener('click', function(event) {
        var button = event.target.closest('[data-copy-code]');

        if (!button) {
          return;
        }

        var code = button.getAttribute('data-copy-code');
        var feedback = button.getAttribute('data-copy-feedback') || 'COPIED';
        var originalText = button.getAttribute('data-original-text') || button.textContent.trim();
        var originalHtml = button.copyOriginalHtml || button.innerHTML;

        button.setAttribute('data-original-text', originalText);
        button.copyOriginalHtml = originalHtml;

        var showCopiedState = function() {
          button.textContent = feedback;
          button.classList.add('is-copied');

          window.clearTimeout(button.copyResetTimer);
          button.copyResetTimer = window.setTimeout(function() {
            button.innerHTML = originalHtml;
            button.classList.remove('is-copied');
          }, 1500);
        };

        var fallbackCopy = function() {
          var textarea = document.createElement('textarea');

          textarea.value = code;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.top = '-9999px';
          textarea.style.left = '-9999px';

          document.body.appendChild(textarea);
          textarea.select();

          try {
            if (document.execCommand('copy')) {
              showCopiedState();
            }
          } catch (error) {
            console.warn('Discount code copy failed', error);
          }

          document.body.removeChild(textarea);
        };

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).then(showCopiedState).catch(fallbackCopy);
        } else {
          fallbackCopy();
        }
      });
    }
  </script>

