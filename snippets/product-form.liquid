<script>
  document.addEventListener('DOMContentLoaded', function () {
  const addToCartBtn = document.getElementById('AddToCart');

  if (!addToCartBtn) return;

  addToCartBtn.addEventListener('click', function () {
    // Add clicked style
    addToCartBtn.classList.add('button--clicked');

    // Optional: Add loading delay to simulate drawer open delay
    setTimeout(() => {
      // Remove clicked style after e.g. 800ms
      addToCartBtn.classList.remove('button--clicked');
    }, 800);
  });

document.querySelectorAll('.click-to-copy').forEach(element => {
  element.addEventListener('click', async () => {
    // Extract text between <b> tags or look for BF27 pattern
    const text = element.textContent || element.innerText;
    const codeMatch = text.match(/BF27/); // Adjust pattern as needed
    
    if (codeMatch) {
      try {
        await navigator.clipboard.writeText(codeMatch[0]);
        
        // Visual feedback
        const originalHTML = element.innerHTML;
        element.innerHTML = `✓ Copied code: <b>${codeMatch[0]}</b>`;
        element.style.color = '#4CAF50';
        
        setTimeout(() => {
          element.innerHTML = originalHTML;
          element.style.color = '';
        }, 2000);
        
      } catch (err) {
        console.error('Copy failed: ', err);
      }
    }
  });
});

});

</script>

 <script>
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('quantity-selector').forEach((qs) => {
    const minusBtn = qs.querySelector('.quantity-selector__button:first-of-type');
    const qtyInput = qs.querySelector('.quantity-selector__input');

    function setMinusState() {
      const qty = parseInt(qtyInput.value, 10) || 1;
      // disable if qty <= 1, enable otherwise
      minusBtn.toggleAttribute('disabled', qty <= 1);
    }

    // initial state (covers default value=1)
    setMinusState();

    // when quantity changes via typing or theme logic
    qtyInput.addEventListener('input', setMinusState);
    qtyInput.addEventListener('change', setMinusState);

    // after any +/- button click, let the theme update first, then sync state
    qs.addEventListener('click', (e) => {
      if (e.target.closest('.quantity-selector__button')) {
        setTimeout(setMinusState, 0);
      }
    });
  });
});
</script>