{%- assign ww_desktop_drawer_trade_is_customer = false -%}
{%- if customer -%}
  {%- assign ww_desktop_drawer_trade_tags = customer.tags | join: ',' | downcase -%}
  {%- if customer.metafields.trade.is_trade_customer.value == true or customer.metafields.trade.discount_percentage.value > 0 or ww_desktop_drawer_trade_tags contains 'trade' -%}
    {%- assign ww_desktop_drawer_trade_is_customer = true -%}
  {%- endif -%}
{%- endif -%}

{%- capture primary_links -%}
  {%- assign drawer_menu_group = 'primary' -%}
  {%- for link in menu.links -%}
    {%- assign link_title_downcase = link.title | strip | downcase -%}

    {%- if link_title_downcase == 'shop' -%}
      {%- assign drawer_menu_group = 'shop' -%}
      {%- continue -%}
    {%- elsif link_title_downcase == 'explore' -%}
      {%- assign drawer_menu_group = 'explore' -%}
      {%- continue -%}
    {%- endif -%}

    {%- if drawer_menu_group != 'primary' -%}
      {%- continue -%}
    {%- endif -%}

    {%- if ww_desktop_drawer_trade_is_customer and link_title_downcase contains 'end of season sale' -%}
      {%- continue -%}
    {%- endif -%}

    {%- assign drawer_link_title = link.title -%}
    {%- if ww_desktop_drawer_trade_is_customer -%}
      {%- if link_title_downcase contains 'summer sale' or link_title_downcase contains 'spring sale' -%}
        {%- assign drawer_link_title = 'Last Chance' -%}
      {%- endif -%}
    {%- endif -%}

    <li class="ww-desktop-drawer-menu__item">
      <a href="{{ link.url }}" class="ww-desktop-drawer-menu__link{% if drawer_link_title contains ' - ' %} ww-desktop-drawer-menu__link--split{% endif %}">
        {%- if drawer_link_title contains ' - ' -%}
          {%- assign title_parts = drawer_link_title | split: ' - ' -%}
          <span>{{ title_parts[0] }}</span>
          <span class="ww-desktop-drawer-menu__accent">- {{ title_parts[1] }}</span>
        {%- else -%}
          {{- drawer_link_title -}}
        {%- endif -%}
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- assign drawer_menu_promo_block = '' -%}
{%- assign drawer_menu_promo_image_index = 0 -%}

{%- for block in section.blocks -%}
  {%- assign block_menu_item_downcase = block.settings.menu_item | strip | downcase -%}

  {%- if block.type == 'mega_menu' and block_menu_item_downcase == 'shop' -%}
    {%- for i in (1..6) -%}
      {%- capture image_setting -%}image_{{ i }}{%- endcapture -%}

      {%- if block.settings[image_setting] != blank -%}
        {%- assign drawer_menu_promo_block = block -%}
        {%- assign drawer_menu_promo_image_index = i -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if drawer_menu_promo_block != '' -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if drawer_menu_promo_block == '' -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'mega_menu' -%}
      {%- for i in (1..6) -%}
        {%- capture image_setting -%}image_{{ i }}{%- endcapture -%}

        {%- if block.settings[image_setting] != blank -%}
          {%- assign drawer_menu_promo_block = block -%}
          {%- assign drawer_menu_promo_image_index = i -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if drawer_menu_promo_block != '' -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- capture drawer_menu_promo -%}
  {%- if drawer_menu_promo_block != '' and drawer_menu_promo_image_index > 0 -%}
    {%- capture promo_image_setting -%}image_{{ drawer_menu_promo_image_index }}{%- endcapture -%}
    {%- capture promo_heading_setting -%}image_{{ drawer_menu_promo_image_index }}_heading{%- endcapture -%}
    {%- capture promo_text_setting -%}image_{{ drawer_menu_promo_image_index }}_text{%- endcapture -%}
    {%- capture promo_link_setting -%}image_{{ drawer_menu_promo_image_index }}_link{%- endcapture -%}

    {%- capture drawer_menu_promo_content -%}
      <div class="ww-desktop-drawer-menu__promo-image-wrapper">
        <img class="ww-desktop-drawer-menu__promo-image" loading="lazy" sizes="360px" {% render 'image-attributes', image: drawer_menu_promo_block.settings[promo_image_setting], sizes: '280,360,520,720' %}>
      </div>

      {%- if drawer_menu_promo_block.settings[promo_heading_setting] != blank -%}
        <p class="ww-desktop-drawer-menu__promo-heading">{{ drawer_menu_promo_block.settings[promo_heading_setting] }}</p>
      {%- endif -%}

      {%- if drawer_menu_promo_block.settings[promo_text_setting] != blank -%}
        <span class="ww-desktop-drawer-menu__promo-text">{{ drawer_menu_promo_block.settings[promo_text_setting] }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if drawer_menu_promo_block.settings[promo_link_setting] != blank -%}
      <a href="{{ drawer_menu_promo_block.settings[promo_link_setting] }}" class="ww-desktop-drawer-menu__promo">
        {{- drawer_menu_promo_content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx -}}
      </a>
    {%- else -%}
      <div class="ww-desktop-drawer-menu__promo">
        {{- drawer_menu_promo_content | replace: settings.speedsize_shopify_cdn_url, settings.speedsize_url_pfx_shopify_cdn | replace: settings.speedsize_shop_domain_cdn, settings.speedsize_url_pfx_shop_domain_cdn | replace: settings.speedsize_duplicated_https_search, settings.speedsize_duplicated_https_replacement | replace: settings.speedsize_url_pfx_duplicated, settings.speedsize_url_pfx -}}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture shop_menu -%}
  {%- assign drawer_menu_group = 'primary' -%}
  {%- assign shop_category_index = 0 -%}
  {%- for link in menu.links -%}
    {%- assign link_title_downcase = link.title | strip | downcase -%}

    {%- if link_title_downcase == 'shop' -%}
      {%- assign drawer_menu_group = 'shop' -%}
      {%- continue -%}
    {%- elsif link_title_downcase == 'explore' -%}
      {%- assign drawer_menu_group = 'explore' -%}
      {%- continue -%}
    {%- endif -%}

    {%- if drawer_menu_group != 'shop' -%}
      {%- continue -%}
    {%- endif -%}

    {%- assign shop_category_index = shop_category_index | plus: 1 -%}

    <li class="ww-desktop-drawer-menu__shop-category{% if shop_category_index == 1 %} ww-desktop-drawer-menu__shop-category--default ww-desktop-drawer-menu__shop-category--is-active{% endif %}">
      <a href="{{ link.url }}" class="ww-desktop-drawer-menu__shop-category-link">{{ link.title }}</a>

      <div class="ww-desktop-drawer-menu__shop-detail{% if drawer_menu_promo != blank %} ww-desktop-drawer-menu__shop-detail--has-promo{% endif %}">
        <div class="ww-desktop-drawer-menu__shop-detail-grid">
          {%- if link.links.size > 0 -%}
            {%- for sub_link in link.links -%}
              <div class="ww-desktop-drawer-menu__shop-detail-group">
                {%- if sub_link.links.size > 0 -%}
                  <a href="{{ sub_link.url }}" class="ww-desktop-drawer-menu__shop-detail-heading">{{ sub_link.title }}</a>
                  <ul class="ww-desktop-drawer-menu__panel-list list--unstyled" role="list">
                    {%- for sub_sub_link in sub_link.links -%}
                      <li>
                        <a href="{{ sub_sub_link.url }}" class="ww-desktop-drawer-menu__panel-link">{{ sub_sub_link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <a href="{{ sub_link.url }}" class="ww-desktop-drawer-menu__shop-detail-link">{{ sub_link.title }}</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ww-desktop-drawer-menu__shop-detail-group">
              <a href="{{ link.url }}" class="ww-desktop-drawer-menu__shop-detail-link">Shop {{ link.title }}</a>
            </div>
          {%- endif -%}
        </div>

        {{- drawer_menu_promo -}}
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture explore_menu -%}
  {%- assign drawer_menu_group = 'primary' -%}
  {%- assign explore_category_index = 0 -%}
  {%- for link in menu.links -%}
    {%- assign link_title_downcase = link.title | strip | downcase -%}

    {%- if link_title_downcase == 'shop' -%}
      {%- assign drawer_menu_group = 'shop' -%}
      {%- continue -%}
    {%- elsif link_title_downcase == 'explore' -%}
      {%- assign drawer_menu_group = 'explore' -%}
      {%- continue -%}
    {%- endif -%}

    {%- if drawer_menu_group != 'explore' -%}
      {%- continue -%}
    {%- endif -%}

    {%- assign drawer_link_url = link.url -%}
    {%- if link_title_downcase == 'trade' -%}
      {%- assign drawer_link_url = '/pages/trade-show' -%}
    {%- endif -%}

    {%- assign explore_category_index = explore_category_index | plus: 1 -%}

    <li class="ww-desktop-drawer-menu__shop-category{% if explore_category_index == 1 %} ww-desktop-drawer-menu__shop-category--default ww-desktop-drawer-menu__shop-category--is-active{% endif %}">
      <a href="{{ drawer_link_url }}" class="ww-desktop-drawer-menu__shop-category-link">{{ link.title }}</a>

      <div class="ww-desktop-drawer-menu__shop-detail{% if drawer_menu_promo != blank %} ww-desktop-drawer-menu__shop-detail--has-promo{% endif %}">
        <div class="ww-desktop-drawer-menu__shop-detail-grid">
          {%- if link.links.size > 0 -%}
            {%- for sub_link in link.links -%}
              <div class="ww-desktop-drawer-menu__shop-detail-group">
                {%- if sub_link.links.size > 0 -%}
                  <a href="{{ sub_link.url }}" class="ww-desktop-drawer-menu__shop-detail-heading">{{ sub_link.title }}</a>
                  <ul class="ww-desktop-drawer-menu__panel-list list--unstyled" role="list">
                    {%- for sub_sub_link in sub_link.links -%}
                      <li>
                        <a href="{{ sub_sub_link.url }}" class="ww-desktop-drawer-menu__panel-link">{{ sub_sub_link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <a href="{{ sub_link.url }}" class="ww-desktop-drawer-menu__shop-detail-link">{{ sub_link.title }}</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="ww-desktop-drawer-menu__shop-detail-group">
              <a href="{{ drawer_link_url }}" class="ww-desktop-drawer-menu__shop-detail-link">{{ link.title }}</a>
            </div>
          {%- endif -%}
        </div>

        {{- drawer_menu_promo -}}
      </div>
    </li>
  {%- endfor -%}
{%- endcapture -%}

<desktop-navigation class="ww-desktop-drawer-menu">
  <ul class="ww-desktop-drawer-menu__list list--unstyled" role="list">
    {{- primary_links -}}

    {%- if shop_menu != blank -%}
      <li class="ww-desktop-drawer-menu__item ww-desktop-drawer-menu__item--has-panel">
        <button class="ww-desktop-drawer-menu__link" type="button">Shop</button>
        <div class="ww-desktop-drawer-menu__panel ww-desktop-drawer-menu__panel--shop">
          <div class="ww-desktop-drawer-menu__panel-inner ww-desktop-drawer-menu__panel-inner--shop">
            <div class="ww-desktop-drawer-menu__shop-layout">
              <ul class="ww-desktop-drawer-menu__shop-categories list--unstyled" role="list">
                {{- shop_menu -}}
              </ul>
            </div>
          </div>
        </div>
      </li>
    {%- endif -%}

    {%- if explore_menu != blank -%}
      <li class="ww-desktop-drawer-menu__item ww-desktop-drawer-menu__item--has-panel">
        <button class="ww-desktop-drawer-menu__link" type="button">Explore</button>
        <div class="ww-desktop-drawer-menu__panel ww-desktop-drawer-menu__panel--shop">
          <div class="ww-desktop-drawer-menu__panel-inner ww-desktop-drawer-menu__panel-inner--shop">
            <div class="ww-desktop-drawer-menu__shop-layout">
              <ul class="ww-desktop-drawer-menu__shop-categories list--unstyled" role="list">
                {{- explore_menu -}}
              </ul>
            </div>
          </div>
        </div>
      </li>
    {%- endif -%}
  </ul>
</desktop-navigation>

<script>
  (() => {
    if (window.__wwDesktopDrawerMenuReady) {
      return;
    }

    window.__wwDesktopDrawerMenuReady = true;

    const openClass = 'ww-desktop-drawer-menu__item--is-open';
    const activeCategoryClass = 'ww-desktop-drawer-menu__shop-category--is-active';
    const menus = document.querySelectorAll('.ww-desktop-drawer-menu');
    let suppressOpenUntil = 0;
    let openTimer = null;

    const closeMenus = () => {
      window.clearTimeout(openTimer);
      openTimer = null;

      document.querySelectorAll(`.${openClass}`).forEach((item) => {
        item.classList.remove(openClass);
      });

      document.querySelectorAll('.ww-desktop-drawer-menu__shop-categories').forEach((categoryList) => {
        const defaultCategory = categoryList.querySelector('.ww-desktop-drawer-menu__shop-category--default');
        categoryList.querySelectorAll(`.${activeCategoryClass}`).forEach((category) => {
          category.classList.remove(activeCategoryClass);
        });

        if (defaultCategory) {
          defaultCategory.classList.add(activeCategoryClass);
        }
      });
    };

    window.addEventListener('scroll', () => {
      suppressOpenUntil = Date.now() + 900;
      closeMenus();
    }, { passive: true });

    menus.forEach((menu) => {
      menu.addEventListener('pointerleave', closeMenus);
    });

    menus.forEach((menu) => {
      menu.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse') {
          return;
        }
        if (Math.abs(event.movementX) + Math.abs(event.movementY) < 2) {
          return;
        }
        if (Date.now() < suppressOpenUntil) {
          return;
        }
        const activeTrigger = event.target.closest('.ww-desktop-drawer-menu__item--has-panel > .ww-desktop-drawer-menu__link');
        if (!activeTrigger) {
          return;
        }
        const activeItem = activeTrigger.closest('.ww-desktop-drawer-menu__item--has-panel');
        window.clearTimeout(openTimer);
        openTimer = window.setTimeout(() => {
          document.querySelectorAll('.ww-desktop-drawer-menu__item--has-panel').forEach((item) => {
            item.classList.toggle(openClass, item === activeItem);
          });
        }, 120);
      }, { passive: true });
    });
    menus.forEach((menu) => {
      menu.addEventListener('pointerover', (event) => {
        const activeCategory = event.target.closest('.ww-desktop-drawer-menu__shop-category');
        if (!activeCategory) {
          return;
        }
        const categoryList = activeCategory.closest('.ww-desktop-drawer-menu__shop-categories');
        categoryList.querySelectorAll(`.${activeCategoryClass}`).forEach((category) => {
          category.classList.remove(activeCategoryClass);
        });
        activeCategory.classList.add(activeCategoryClass);
      }, { passive: true });
    });
    document.addEventListener('pointermove', (event) => {
      if (!event.target.closest('.ww-desktop-drawer-menu')) {
        closeMenus();
      }
    }, { passive: true });
  })();
</script>
