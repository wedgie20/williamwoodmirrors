{%- liquid
  assign fal_collection_handles = product.collections | map: 'handle' | join: ',' | prepend: ',' | append: ','
  assign is_fal_promo_product = false

  if fal_collection_handles contains ',tables-chairs-and-lighting,'
    assign is_fal_promo_product = true
  endif

  assign fal_base_price = product.price_min

  if variant != blank
    assign fal_base_price = variant.price
  endif

  assign fal_discounted_price = fal_base_price | times: 70 | divided_by: 100
  assign fal_context = context | default: 'card'
-%}

{%- if is_fal_promo_product -%}
  <span class="price price--block ww-fal-discount-price ww-fal-discount-price--{{ fal_context }}">
    <span class="visually-hidden">Price with 30% off automatically applied at checkout</span>
    {%- if product.price_varies and variant == blank -%}
      From
    {%- endif -%}
    {%- if settings.currency_code_enabled -%}
      {{- fal_discounted_price | money_with_currency -}}
    {%- else -%}
      {{- fal_discounted_price | money -}}
    {%- endif -%}
    <span class="ww-fal-discount-price__note">with 30% off at checkout</span>
  </span>
{%- endif -%}
